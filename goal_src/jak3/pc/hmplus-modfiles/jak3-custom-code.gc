(deftype stay-as-jak2 (process)
    ((jak2-select               int)
    )
    (:state-methods
        active
        die
    )
)

(defbehavior stay-as-jak2-init-by-other stay-as-jak2 ()
    (stack-size-set! (-> self main-thread) 512)
    (set! (-> self jak2-select) 0)
    (go-virtual active)
    (none)
)

(defun spawn-jak2-stayas ()
    (process-spawn stay-as-jak2 :name "stay-as-jak2" *active-pool*)
    (none)
)

(defstate active (stay-as-jak2)
    :virtual #t
    :enter (behavior ()
        (process-grab? *target* #f)
    )
    :code (behavior ()
        (loop
            (draw-mod-menu-text-custom "Which model would you like to play as?~%~%This can be changed at any time in the mod menu."
            255 90 0.325 #f #t #f)
            
            (clear *temp-string*)
            (case (-> self jak2-select)
                ((0)
                    (format *temp-string* "<COLOR_YELLOW>Jak II <COLOR_MENU-PARENT>Jak 3"))
                ((1)
                    (format *temp-string* "<COLOR_MENU-PARENT>Jak II <COLOR_YELLOW>Jak 3"))
            )
            (draw-mod-menu-text-custom *temp-string*
            255 140 0.425 #f #t #f)

            (when (cpad-pressed? 0 triangle circle)
                (cond 
                    ((not in-jak-model?)
                        (process-release? *target*)
                        (camera-unlocked)
                        (kill-by-name "proc-mask-enemyfreeze" *active-pool*)
                        (kill-by-name "stay-as-jak2" *active-pool*)
                    )
                    (else
                        (set! in-hero-menu? #t)
                        (set! in-jak-model? #f)
                        (set! in-menu? #t)
                    )
                )
                (deactivate self)
                (cpad-clear! 0 triangle circle)
            )
            (when (cpad-pressed? 0 left)
                (when (< (-> self jak2-select) 0)
                    (set! (-> self jak2-select) 1)
                )
                (when (and (> (-> self jak2-select) 0))
                    (-! (-> self jak2-select) 1)
                )
                (format #t "Selected option: ~D~%" (-> self jak2-select))
            )
            (when (cpad-pressed? 0 right)
                (when (> (-> self jak2-select) 1)
                    (set! (-> self jak2-select) 0)
                )
                (when (and (< (-> self jak2-select) 1))
                    (+! (-> self jak2-select) 1)
                )
                (format #t "Selected option: ~D~%" (-> self jak2-select))
            )
            (when (cpad-pressed? 0 x)
                (case (-> self jak2-select)
                    ((0)
                        (logior! (-> *game-info* secrets) (game-secrets jak-is-jak2))
                    )
                    ((1)
                        (logclear! (-> *game-info* secrets) (game-secrets jak-is-jak2))
                    )
                )
                ;; (kill-by-name "proc-mask-enemyfreeze" *active-pool*)
                (go-virtual die)
            )
            (suspend)
        )
    )
)

(defstate die (stay-as-jak2)
    :virtual #t
    :code (behavior ()
        (set! in-jak-model? #f)
        (set! in-menu? #f)
        (process-release? *target*)
        (camera-unlocked)
        (initialize! *game-info* 'dead (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
        (kill-by-name "proc-mask-enemyfreeze" *active-pool*)
        (kill-by-name "stay-as-jak2" *active-pool*)
        (deactivate self)
        (if (= (-> *game-info* total-deaths) 0)
            (level-up-cars! 1))

    )
)


