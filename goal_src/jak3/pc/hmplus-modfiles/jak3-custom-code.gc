(defun draw-mod-menu-text-preset ((text-type int) (text string)) ;; (text-x-pos int) (text-y-pos int) (text-scale float))
    (clear matt-str)
    (clear *pc-encoded-matt-str*)
    (format matt-str text)
    (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
        (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
        (case text-type 
            ((0) ;; title
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 256 50 0.0 (font-color orange) (font-flags middle shadow kerning large))))
            (set! (-> font-ctx scale) 0.625)
            (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))

            ((1) ;; buttons
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 256 352 0.0 (font-color white) (font-flags middle shadow kerning large))))
            (set! (-> font-ctx scale) 0.325)
            (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))

            ((2) ;; menu list
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 256 150 0.0 (font-color white) (font-flags middle shadow kerning large))))
            (set! (-> font-ctx scale) 0.425)
            (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
            
            ((3) ;; left side option list
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 85 110 0.0 (font-color white) (font-flags shadow kerning large))))
            (set! (-> font-ctx scale) 0.325)
            (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))

            ((4) ;; tutorial
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 255 60 0.0 (font-color white) (font-flags middle shadow kerning large))))
            (set! (-> font-ctx scale) 0.325)
            (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))

        ;;   ((4) ;; custom
        ;;     (let ((font-ctx (new 'stack 'font-context *font-default-matrix* text-x-pos text-y-pos 0.0 (font-color white) (font-flags middle shadow kerning large))))
        ;;       (set! (-> font-ctx scale) text-scale)
        ;;       (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
    ))
    (none))

(defun draw-mod-menu-text-custom ((text string) (text-x-pos int) (text-y-pos int) (text-scale float) (left? symbol) (middle? symbol) (right? symbol))
    (clear matt-str)
    (clear *pc-encoded-matt-str*)
    (format matt-str text)
    (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
        (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
        (cond 
            (left?
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* text-x-pos text-y-pos 0.0 (font-color white) (font-flags shadow kerning large))))
                (set! (-> font-ctx scale) text-scale)
                (draw-string-adv *pc-encoded-matt-str* buf font-ctx))
            )
            (middle?
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* text-x-pos text-y-pos 0.0 (font-color white) (font-flags middle shadow kerning large))))
                (set! (-> font-ctx scale) text-scale)
                (draw-string-adv *pc-encoded-matt-str* buf font-ctx))
            )
            (right?
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* text-x-pos text-y-pos 0.0 (font-color white) (font-flags right shadow kerning large))))
                (set! (-> font-ctx scale) text-scale)
                (draw-string-adv *pc-encoded-matt-str* buf font-ctx))
            )
        )
    )
    (none))

(defun draw-mod-menu-background ()
  ;; 0 0 512 412 is full screen
    (with-dma-buffer-add-bucket ((s2-0 (-> *display* frames (-> *display* on-screen) global-buf))(bucket-id particles))
        ;; background border
        (draw-sprite2d-xy s2-0 
                            (- mod-menu-x 2)
                            (- mod-menu-y 2)
                            (- 512 (* 2 (- mod-menu-x 2)))
                            (- 412 (* 2 (- mod-menu-y 2)))
                            (static-rgba 0 0 0 64)
                            #x3fffff)
        ;; background
        (draw-sprite2d-xy s2-0 
                            mod-menu-x
                            mod-menu-y
                            (- 512 (* 2 mod-menu-x))
                            (- 412 (* 2 mod-menu-y))
                            (static-rgba 255 255 255 8)
                            #x3fffff)))


(defun toggle-picture-mode ()
    (cond
        ((= in-picture-mode? #f)
            (process-grab? *target* #f)
            (set-master-mode 'freeze)
            (kill-by-type hud-map *active-pool*)
            (set! *external-cam-mode* 'pad-0)
            (set! in-picture-mode? #t)
        )
        (else
            (process-release? *target*)
            (when (not (search-process-tree *active-pool* (lambda ((p process)) (type? p hud-map))))
                (process-spawn hud-map :init hud-init-by-other :name "hud-map" :to *target*)
            )
            (set-master-mode 'game)
            (set! *external-cam-mode* #f)
            (set! in-picture-mode? #f)
        )
    )
    (none)
)

(defun hmplus-black-fade ((start-time time-frame))
  (let ((t 0.0)
        (col (new 'stack-no-clear 'vector)))
    (set! t (/ (the float (- (current-time) start-time))
               (the float (seconds 0.4))))
    (when (< t 0.0) (set! t 0.0))
    (when (> t 1.0) (set! t 1.0))
    (set! (-> col x) 0.0)
    (set! (-> col y) 0.0)
    (set! (-> col z) 0.0)
    (set! (-> col w) (* 128.0 t))
    (setup *screen-filter* col col 0.0 (bucket-id tex-hud-pris2) #x3fffff #x33001 #t))
  (none)
)

(define paused-custom-music? #f)
(define global-volume-level (-> *setting-control* user-default music-volume))

(defun auto-save-delayed ()
    (set! auto-i 0)
    (set! autosave-delayed #t)
    (none)
)

(define short-delay #f)
(define stored-string "")
(define delay-i 0)

(defun delayed-play-continue ((arg0 string))
    (cond
        ((= short-delay #f)
            (set! stored-string arg0)
            (set! short-delay #t)
            (set! delay-i 0)
        )
        (else
            (send-event *target* 'continue (get-continue-by-name *game-info* arg0))
            (set! short-delay #f)
            (set! delay-i 0)
        )
    )
    (none)
)

