    (when (not (task-node-closed? (game-task-node mody-fireball)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node mody-nukeonly)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node mody-freeze)))
      (+! count 1))

    (when (not (task-node-closed? (game-task-node modb-airstrike)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node modb-ammo)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node modb-disperser)))
      (+! count 1))

    (when (not (task-node-closed? (game-task-node modd-reaper)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node modd-morpher)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node modd-random)))
      (+! count 1))

    count)
)

(defun hmplus-close-nth-preferred-gunmod! ((idx int))
  (let ((i 0)
        (done #f)
        (gunmod-idx 0))
    (when (and (not done)
               (hmplus-has-colored-weapon? 'red)
               (not (task-node-closed? (game-task-node modr-bigshot))))
      (cond
        ((= i idx)
          (task-node-close! (game-task-node modr-bigshot) #t)
          (set! drop-gun-mod #f)
          (set! gunmod-idx 0)
          (set! done #t))
        (else
          (+! i 1))))

    (when (and (not done)
               (hmplus-has-colored-weapon? 'red)
               (not (task-node-closed? (game-task-node modr-missles))))
      (cond
        ((= i idx)
          (task-node-close! (game-task-node modr-missles) #t)
          (set! drop-gun-mod #f)
          (set! gunmod-idx 1)
          (set! done #t))
        (else
          (+! i 1))))

    (when (and (not done)
               (hmplus-has-colored-weapon? 'red)
               (not (task-node-closed? (game-task-node modr-shield))))
      (cond
        ((= i idx)
          (task-node-close! (game-task-node modr-shield) #t)
          (set! drop-gun-mod #f)
          (set! gunmod-idx 2)
          (set! done #t))
        (else
          (+! i 1))))

    (when (and (not done)
               (hmplus-has-colored-weapon? 'yellow)
               (not (task-node-closed? (game-task-node mody-fireball))))
      (cond
        ((= i idx)
          (task-node-close! (game-task-node mody-fireball) #t)
          (set! drop-gun-mod #f)
          (set! gunmod-idx 3)
          (set! done #t))
        (else
          (+! i 1))))

    (when (and (not done)
               (hmplus-has-colored-weapon? 'yellow)
               (not (task-node-closed? (game-task-node mody-nukeonly))))
      (cond
        ((= i idx)
          (task-node-close! (game-task-node mody-nukeonly) #t)
          (set! drop-gun-mod #f)
          (set! gunmod-idx 4)
          (set! done #t))
        (else
          (+! i 1))))

    (when (and (not done)
               (hmplus-has-colored-weapon? 'yellow)
