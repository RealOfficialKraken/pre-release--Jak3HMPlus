                        )
    (set! (-> *overide-mood-color-table*
                            data
                            (the-as uint (logand (-> *time-of-day-context* mode) (time-of-day-palette-id unk0 unk1 unk2)))
                            lgt-color
                            y
                            )
                        0.0
                        )
    (set! (-> *overide-mood-color-table*
                            data
                            (the-as uint (logand (-> *time-of-day-context* mode) (time-of-day-palette-id unk0 unk1 unk2)))
                            lgt-color
                            z
                            )
                        1.0
                        )
    (set! (-> *overide-mood-color-table*
                            data
                            (the-as uint (logand (-> *time-of-day-context* mode) (time-of-day-palette-id unk0 unk1 unk2)))
                            lgt-color
                            w
                            )
                        1.0
                        )
    (none)
  )

(defun launch-pre-mmenu ()
  (when (not hmplus-intro-active?)
    (set! hmplus-intro-active? #t)
    (set! hmplus-intro-phase 0)
    (set! hmplus-intro-frame 0)
    (set! (-> *setting-control* user-current music-volume) 0.0)
    (when *target*
      (send-event *target* 'draw #f)
      (send-event *target* 'continue
        (get-continue-by-name *game-info* "desertb-intro-start"))))
  (none)
)

(defun launch-mmenu ()
    (initialize! *game-info* 'game (the-as game-save #f) "desert-bd-start" (the-as resetter-spec #f))
    (logior! (-> *game-info* secrets) (game-secrets jak-is-jak2))
    (stop 'game)
    (start 'game (get-current-continue-forced *game-info*))
    (set! (-> *game-info* mode) 'play)
    (send-event (ppointer->process *time-of-day*) 'change 'hour 8)
    (send-event (ppointer->process *time-of-day*) 'change 'ratio 0.0)
    (setup *screen-filter*
        (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0)
        (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0)
        0.0
        (bucket-id tex-hud-pris2)
        #x3fffff #x33001 #f)
    (when (= disable-darkworld-in-mainmenu #f)
        (send-event (ppointer->process *time-of-day*) 'change 'hour 19)
        (set! (-> *time-of-day-context* mode) (the-as time-of-day-palette-id 5))
        (set! (-> *time-of-day-context* overide-enable) #t)
        (set! (-> *mood-control* overide-weather-flag) #t)
        (dark-weather-override)
    )
    (process-release? *target*)
    (when (!= globalrandi 0)
        (set! globalrandi 0)
    )
    (set! pause-menu-blocked? #f)
    (set! mainmenu-camera #t)
    (none)
)

(defun launch-disclaimer ()
    (initialize! *game-info* 'game (the-as game-save #f) "desert-bd-start" (the-as resetter-spec #f))
    (set! in-disclaimer? #t)
    (set! disable-targbar #t)
    (none)
)

  
(defskelgroup skel-dm-skyship dm-ship dm-ship-lod0-jg dm-ship-idle-ja
              ((dm-ship-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 90999999)
              :origin-joint-index 3
              :global-effects 32
              )

#|(deftype dm-skyship (process-drawable)
  ((size          vector)
   (pos           vector)
   )
  (:state-methods
    idle
    )
  )

  (defstate idle (dm-skyship)
    :virtual #t
    :code (behavior ()
        (suspend)
    )
  )

  (defbehavior dm-skyship-init-by-other dm-skyship ((vec vector))
    (vector-copy! (-> self root trans) vec)
    (quaternion-identity! (-> self root quat))
    (vector-identity! (-> self root scale))
    (go (method-of-object self idle))
  )|#

  (defun spawn-precursor-man ((vec vector))
    (let ((man (process-spawn manipy
          :init
          manipy-init
          vec
          #f
          (art-group-get-by-name *level* "skel-entity-boss-floater" (the (pointer level) #f))
          #f
          0
          #f
          :name "man-eb"
          :from *default-dead-pool*
          ))
            (veccy (new 'stack-no-clear 'vector))
            )
        (when (ppointer->process man)
          (send-event (ppointer->process man) 'shadow #t)
          (set! (-> veccy x) 2.0)
          (set! (-> veccy y) 2.0)
          (set! (-> veccy z) 2.0)
          (send-event (ppointer->process man) 'scale veccy)
          (send-event (ppointer->process man) 'max-vis-dist 9999999.0)
            )
      )
    (none)
  )

  (defun die-jak-fall ()
    (send-event
          *target*
          'attack-invinc
          #f
          (static-attack-info :mask (vehicle-impulse-factor) ((id (new-attack-id))
                                                              (damage 2.0)
                                                              (vehicle-damage-factor 1.0)
                                                              (vehicle-impulse-factor 1.0)
                                                              (mode 'endlessfall)
                                                              )
                              )
          )
          (none)
  )

  (defun lightjak-get-off-part ((vec vector))
    (set! (-> *launch-matrix* trans quad) (-> vec quad))
    (if (logtest? (-> *part-group-id-table* 176 flags) (sp-group-flag sp13))
              (part-tracker-spawn
                part-tracker-subsampler
                :to *active-pool*
                :group (-> *part-group-id-table* 176))
              (part-tracker-spawn 
                part-tracker 
                :to *active-pool*
                :group (-> *part-group-id-table* 176))
              )
    (none)
  )

  (defun jak-refill! ()
    (send-event *target* 'get-pickup (pickup-type ammo-yellow) 9999.0)
    (send-event *target* 'get-pickup (pickup-type ammo-red) 9999.0)
    (if (or
            (logtest? (-> *game-info* features) (game-feature gun-blue-1))
            (logtest? (-> *game-info* features) (game-feature gun-blue-2))
            (logtest? (-> *game-info* features) (game-feature gun-blue-3))
        )
        (send-event *target* 'get-pickup (pickup-type ammo-blue) 9999.0)
    )
    (if (or
            (logtest? (-> *game-info* features) (game-feature gun-dark-1))
            (logtest? (-> *game-info* features) (game-feature gun-dark-2))
            (logtest? (-> *game-info* features) (game-feature gun-dark-3))
        )
        (send-event *target* 'get-pickup (pickup-type ammo-dark) 9999.0)
    )
    (send-event *target* 'get-pickup (pickup-type eco-pill-dark) 100.0)
    (send-event *target* 'get-pickup (pickup-type eco-pill-light) 100.0)
    (none)
  )

  (defun jak-refill-slight! ()
    (send-event *target* 'get-pickup (pickup-type ammo-yellow) 1.0)
    (send-event *target* 'get-pickup (pickup-type ammo-red) 1.0)
    (if (or
            (logtest? (-> *game-info* features) (game-feature gun-blue-1))
            (logtest? (-> *game-info* features) (game-feature gun-blue-2))
            (logtest? (-> *game-info* features) (game-feature gun-blue-3))
        )
        (send-event *target* 'get-pickup (pickup-type ammo-blue) 1.0)
    )
    (if (or
            (logtest? (-> *game-info* features) (game-feature gun-dark-1))
            (logtest? (-> *game-info* features) (game-feature gun-dark-2))
            (logtest? (-> *game-info* features) (game-feature gun-dark-3))
        )
        (send-event *target* 'get-pickup (pickup-type ammo-dark) 1.0)
    )
    (when (rand-vu-percent? 0.4)
        (if (rand-vu-percent? 0.5)
            (send-event *target* 'get-pickup (pickup-type eco-pill-light) 100.0)
            (send-event *target* 'get-pickup (pickup-type eco-pill-dark) 100.0)
        )
    )
    (none)
  )

  (defun init-entity-1! ()
    (let ((ent-pos (new-stack-vector0)))
        (set! (-> ent-pos quad) (-> (target-pos 0) quad))
        (+! (-> ent-pos y) (meters 8))
        (set-vector! (-> *target* control trans) (-> ent-pos x) (-> ent-pos y) (-> ent-pos z) 1.0)
        (spawn-precursor-man ent-pos)
        (lightjak-get-off-part ent-pos)
        (process-grab? *target* #f)
        (persist-with-delay *setting-control* 'gun (seconds 0.5) 'gun #f 0.0 0)
        (set! in-dialogue? #t)
        (disable-hudmap)
        (set! log-id 42)
        (set! log-sec 0)
        (set! di-s1 "<COLOR_RED>Corruption")
        (set! di-s2 "<COLOR_RED>An Unknown Date and Time...")
        (set! di-s3 "<COLOR_RED>")
        (set! di-s4 "<COLOR_RED>")
        (send-event *target* 'draw #f)
        (set-vector! stored-target-vector (-> ent-pos x) (-> ent-pos y) (-> ent-pos z) 1.0)
        (auto-save-delayed)
    )
    (none)
  )
