(when
    (and
        (= load-delay-1 #t)
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
    )
    (+! load-i 1)
    (when (= load-i 1)
        (set! xp-draw-override #t)
    )
