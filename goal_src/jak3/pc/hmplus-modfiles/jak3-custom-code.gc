            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 8)
            (set! di-s1 "<COLOR_PINK>You hear that, dear sister?")
            (set! di-s2 "<COLOR_PINK>Samos was wrong.")
            (set! di-s3 "<COLOR_PINK>We can show him the power ourselves,")
            (set! di-s4 "<COLOR_PINK>when we reshape the world from the ashes.")
