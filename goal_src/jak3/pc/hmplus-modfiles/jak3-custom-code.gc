(defun hmplus-roll-valid-gun-mod! ()
    (let ((preferred-count (hmplus-preferred-gunmod-count))
        (fallback-count 0)
        (pick 0))
    (cond
        ((> preferred-count 0)
            (set! pick (rand-vu-int-count preferred-count))
            (hmplus-close-nth-preferred-gunmod! pick)
        )
        (else
            (set! fallback-count (hmplus-fallback-gunmod-count))
            (if (> fallback-count 0)
                (begin
                (set! pick (rand-vu-int-count fallback-count))
                (hmplus-close-nth-fallback-gunmod! pick))
                (begin
                (set! drop-gun-mod #f)
                (blank-hint! "Congrats!~%You already have all Super Gun Mods" 340 600))))))
  (none)
)

(defun draw-welcome-screen ()
    (draw-mod-menu-text-custom "<COLOR_ORANGE>Welcome to HeroMode+"
    256 50 0.425 #f #t #f)

    (draw-mod-menu-text-custom 
"~%~%~%
Main missions are now <COLOR_RED>very difficult<COLOR_WHITE> and certain outlier levels~%
even more so, but leveling up can make a difference!~%

Your levels unlock more things the higher they get.~%
Fighting enemies will become easier, and crates will drop~%
with better chances. Enemies also have a level, so be~%
careful treading into certain areas. Information about~%
your levels can be accessed in the <COLOR_ORANGE>Skills<COLOR_WHITE> tab.~%

<COLOR_CYAN>Super Gun Mods<COLOR_WHITE> are new additions that add extra heat to~%
your firepower. They only mod weapons of the specified~%
color type, and they become more powerful with each one~%
attached. They can be found very rarely in <COLOR_PINK>black crates<COLOR_WHITE>,~%
or by completing certain challenges in the future.~%

Have fun!~%

- Kraken"
    256 50 0.300 #f #t #f)
)




(defun fast-travel-action ()
    (set! (-> *run-attack-mods* align-speed) 2.0)
    (set! (-> *run-attack-mods* impact-fric) 0.0)
    (lightjak-get-off-part (target-pos 0))
    (send-event *target* 'draw #f)
    (remove-setting-by-arg0 *setting-control* 'mode-name)
    (set! camera-locked? #f)
    (set! in-menu? #f)
    (set! in-modifiers? #f)
    (when (= (-> *game-info* total-deaths) 0)
        (level-up-cars! 1))
    (cond
        ((and (= menu-index 0) (task-node-closed? (game-task-node desert-course-race-resolution)))
            (delayed-play-continue "wasdoors-city"))

        ((and (= menu-index 1) (task-node-closed? (game-task-node temple-oracle-resolution)))
            (delayed-play-continue "templex-start"))

        ((and (= menu-index 2) (task-node-closed? (game-task-node city-port-fight-resolution)))
            (delayed-play-continue "ctyport-hiphog-no-hiphog"))

        ((and (= menu-index 3) (task-node-closed? (game-task-node city-protect-hq-resolution)))
            (delayed-play-continue "ctyslumc-freehq-exit"))

        ((and (= menu-index 4) (task-node-closed? (game-task-node city-blow-tower-resolution)))
            (delayed-play-continue "towera-start"))

        (else
            (format #t "ERROR AT MODIFIER MENU SLOT ~D, PLEASE CONTACT DEV" menu-index)))
    (none)
)

(defun fast-travel-confirm ()
  (cond
    ((and (= menu-index 0) (task-node-closed? (game-task-node desert-course-race-resolution)))
      (fast-travel-action))

    ((and (= menu-index 1) (task-node-closed? (game-task-node temple-oracle-resolution)))
      (fast-travel-action))

    ((and (= menu-index 2) (task-node-closed? (game-task-node city-port-fight-resolution)))
      (fast-travel-action))

    ((and (= menu-index 3) (task-node-closed? (game-task-node city-protect-hq-resolution)))
      (fast-travel-action))

    ((and (= menu-index 4) (task-node-closed? (game-task-node city-blow-tower-resolution)))
      (fast-travel-action))

    (else
      (format #t "ERROR AT MODIFIER MENU SLOT ~D, PLEASE CONTACT DEV" menu-index)))
  (none)
)

(defun arena-select-confirm! ()
    (let ((vec (new 'static 'vector :x (meters 2328.5561) :y (meters 51.7746) :z (meters -510.6119) :w 1.0)))
        (kill-by-name "kraken-timer" *active-pool*)
        (set! *kraken-timer* #f)
        (set! arena-delay-blockers #t)
        (set! arena-delay 0)
        ;(send-event *camera* 'teleport-to-vector-start-string vec)
        (lightjak-get-off-part (target-pos 0))
        (camera-unlocked)
        (set! global-marauder-count 0)
        (set! in-arena-fight? #t)
        (set! pause-menu-blocked? #f)
        (set! in-arena-menu? #f)
        (set! enemy-noto 1)
        (case menu-index
            ((0)
                (task-node-close! (game-task-node arena-replay-1-introduction) #t)
                (set-vector! (-> *target* control trans) (meters 2321.3464) (meters 11.9021) (meters -446.5651) 1.0)
            )
            ((1)
                (task-node-close! (game-task-node arena-replay-2-introduction) #t)
                (set-vector! (-> *target* control trans) (meters 2299.8308) (meters 11.3778) (meters -440.6308) 1.0)
            )
            ((2)
                (task-node-close! (game-task-node arena-replay-3-introduction) #t)
                (set-vector! (-> *target* control trans) (meters 2324.8325) (meters 11.9021) (meters -457.8798) 1.0)
            )
            ((3)
                (task-node-close! (game-task-node arena-replay-1-introduction) #t)
                (task-node-close! (game-task-node arena-replay-2-introduction) #t)
                (task-node-close! (game-task-node arena-replay-3-introduction) #t)
                (set-vector! (-> *target* control trans) (meters 2328.2661) (meters 13.4661) (meters -450.7846) 1.0)
                (arena-death-dome-grenades)
            )
        )
        (summon-arena-event)
        (spawn-kraken-timer)
    )
)




