    )
    (set-vector! (-> *target* control trans) (-> stored-target-vector x) (-> stored-target-vector y) (-> stored-target-vector z) 1.0)
    (when (cpad-pressed? 0 x)
        (+! log-sec 1)
        (when (= log-sec 1)
            (set! di-s1 "<COLOR_PINK>It is to my understanding that")
            (set! di-s2 "<COLOR_PINK>Dark Eco cannot be controlled.")
            (set! di-s3 "<COLOR_PINK>Samos, the old and wise green sage")
            (set! di-s4 "<COLOR_PINK>said so.")
        )
        (when (= log-sec 2)
            (set! di-s1 "<COLOR_RED>You must open your eyes, my fellow apprentice.")
            (set! di-s2 "<COLOR_RED>Dark Eco can be controlled.")
            (set! di-s3 "<COLOR_RED>I have learned it's secrets.")
            (set! di-s4 "<COLOR_RED>I have used it to stop life, and to start life.")
        )
        (when (= log-sec 3)
