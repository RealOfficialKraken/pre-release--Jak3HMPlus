(defun activate-heromode! ()
    (set! hero-level-count notoriety-level)
    (set! hero-level-xp-count (-> *game-info* karma))
    (set! guns-level-count guns-level)
    (set! guns-level-xp-count (-> *game-info* buzzer-total))
    (set! cars-level-count cars-level)
    (set! cars-level-xp-count (-> *game-info* fuel))
    (set! orba-count (-> *game-info* skill))
    (set! heromode-tick (-> *game-info* crates-opened))
    (when (logtest? (-> *game-info* features) (game-feature gun-red-2))
        (set! has-red-2? #t)
    )
    (when (logtest? (-> *game-info* features) (game-feature gun-red-3))
        (set! has-red-3? #t)
    )
    (when (logtest? (-> *game-info* features) (game-feature gun-yellow-2))
        (set! has-yellow-2? #t)
    )
    (when (logtest? (-> *game-info* features) (game-feature gun-yellow-3))
        (set! has-yellow-3? #t)
    )
    (when (logtest? (-> *game-info* features) (game-feature gun-blue-1))
        (set! has-blue-1? #t)
    )
    (when (logtest? (-> *game-info* features) (game-feature gun-blue-2))
        (set! has-blue-2? #t)
    )
    (when (logtest? (-> *game-info* features) (game-feature gun-blue-3))
        (set! has-blue-3? #t)
    )
    (when (logtest? (-> *game-info* features) (game-feature gun-dark-1))
        (set! has-dark-1? #t)
    )
    (when (logtest? (-> *game-info* features) (game-feature gun-dark-2))
        (set! has-dark-2? #t)
    )
    (when (logtest? (-> *game-info* features) (game-feature gun-dark-3))
        (set! has-dark-3? #t)
    )
    (when (task-node-closed? (game-task-node pet-flitter))
        (set! has-pet-flitter? #t)
    )
    (when (task-node-closed? (game-task-node pet-spiky-frog))
        (set! has-pet-spiky-frog? #t)
    )
    (when (task-node-closed? (game-task-node pet-rat))
        (set! has-pet-rat? #t)
    )
    (when (task-node-closed? (game-task-node pet-manta))
        (set! has-pet-manta? #t)
    )
    (when (task-node-closed? (game-task-node pet-neo-wasp))
        (set! has-pet-neo-wasp? #t)
    )
    (when (task-node-closed? (game-task-node pet-kangarat))
        (set! has-pet-kangarat? #t)
    )
    (when (task-node-closed? (game-task-node pet-mantis))
        (set! has-pet-mantis? #t)
    )
    (when (task-node-closed? (game-task-node pet-terra))
        (set! has-pet-terra? #t)
    )
    (when (task-node-closed? (game-task-node pet-scouter))
        (set! has-pet-scouter? #t)
    )
    (when (task-node-closed? (game-task-node pet-dogat))
        (set! has-pet-dogat? #t)
    )
    (set! going-heromode? #t)
    (set! hmp-i 0)
)

(defun nice-try ()
    (let ((rnd (rand-vu-int-range 1 6)))
        (when (= rnd 1)
            (set! nice-string "NICE TRY")
        )
        (when (= rnd 2)
            (set! nice-string "SURELY NEXT TIME IT'LL WORK")
        )
        (when (= rnd 3)
            (set! nice-string "MAYBE IF YOU TRY AGAIN~%YOU'LL GO THROUGH")
        )
        (when (= rnd 4)
            (set! nice-string "GO AHEAD~%TRY AGAIN")
        )
        (when (= rnd 5)
            (set! nice-string "DO IT AGAIN,~%IT MIGHT WORK THIS TIME")
        )
        (when (= rnd 6)
            (set! nice-string "IM SURE NEXT TIME WILL WORK")
        )
    )
    (set! nice-try-dude #t)
    (none)
)

(defun toggle-inf-fall ()
    (cond
        ((= inf-fall? #f)
            (set! (-> *TARGET-bank* fall-far) (meters 9999))
            (set! (-> *TARGET-bank* fall-far-inc) (meters 9999))
            (set! inf-fall? #t)
        )
        ((= inf-fall? #t)
            (set! (-> *TARGET-bank* fall-far) (meters 30))
            (set! (-> *TARGET-bank* fall-far-inc) (meters 20))
            (set! inf-fall? #f)
        )
    )
    (none)
)

(defun peacemaker-burst! ()
    (set! pm-burst #t)
    (set! pmi 0)
    (none)
)

(defun pick-random-anchor ()
    (let ((rnd (rand-vu-int-range 1 4))) ;;only pick city for now
        (when (= rnd 1)
            (set! in-desertf-anchor? #t)
            (task-node-open! (game-task-node desertf-anchor-introduction) #t)
            (task-node-close! (game-task-node desertf-anchor-resolution) #t)
        )
        (when (= rnd 2)
            (set! in-desertc-anchor? #t)
            (task-node-open! (game-task-node desertc-anchor-introduction) #t)
            (task-node-close! (game-task-node desertc-anchor-resolution) #t)
        )
        (when (= rnd 3)
            (set! in-desertg-anchor? #t)
            (task-node-open! (game-task-node desertg-anchor-introduction) #t)
            (task-node-close! (game-task-node desertg-anchor-resolution) #t)
        )
        (when (= rnd 4)
            (set! in-ctyinda-anchor? #t)
            (task-node-open! (game-task-node ctyinda-anchor-introduction) #t)
            (task-node-close! (game-task-node ctyinda-anchor-resolution) #t)
        )
    )
    (none)
)

(defun spawn-gun-upgrade ((vec vector) (amount float))
    (birth-pickup-at-point vec (pickup-type gun-yellow-1) amount #t *entity-pool* (the-as fact-info #f))
    (none)
)

(defun r3-hint ()
    (set! r3-hinti -100)
    (set! r3-hinti2 0)
    (set! hint-string "<COLOR_YELLOW>R3")
    (set! r3-hints #t)
    (none)
)

