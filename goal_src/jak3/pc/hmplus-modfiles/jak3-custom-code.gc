;;;;;;;;;;;;;;;;;;;;;;;; mod menu

(when 
(and 
(cpad-pressed? 0 r3) ;enter virtual menu
*target*
(= (paused?) #f)
(= (pause-allowed?) #t)
(not *scene-player*)
(= in-menu? #f)
(= in-vin-shop? #f)
(= menu-unlocked? #t)
(= in-modifiers? #f)
(= in-gunmods? #f)
(= in-superpowers? #f)
(= on-vehicle? #f)
(= in-dialogue? #f)
;; (= draw-arena-select #f)
(= in-arena-fight? #f)
(= in-satbattle? #f)
(> (-> *target* fact health) 0.0)
(not (focus-test? *target* mech))
(!= (-> *target* next-state name) 'target-turret-stance)
(task-node-closed? (game-task-node arena-fight-1-resolution))
(not (task-node-open? (game-task-node city-blow-barricade-resolution)))
(not (search-process-tree *active-pool* (lambda ((p process)) (type? p final-boss-hm))))
(not (search-process-tree *active-pool* (lambda ((p process)) (type? p stay-as-jak2))))
(jak-on-elevator?)
(not (focus-test? *target* pilot))
)
(disable-hudmap)
(set! in-menu? #t)
(if (= cars-level 0)
    (set! in-welcome-screen? #t)
    (set! in-hero-menu? #t)
)

(camera-locked #f #t #f)
(set! menu-index 0)
(set! menu-type 0)
(sound-play "menu-back")
(cpad-clear! 0 r3)
(freeze-enemies-in-menu!)
)

(when 
(or (and 
    (cpad-pressed? 0 triangle) ;exit virtual menu
    *target*
    (= (paused?) #f)
    (= (pause-allowed?) #t)
    (not *scene-player*)
    (not in-welcome-screen?)
    in-hero-menu?
)
(and 
    (cpad-pressed? 0 r3)
    (= in-menu? #t)
    (= (paused?) #f)
    (not in-welcome-screen?)
)
)
(set! in-hero-menu? #f)
(set! in-menu? #f)
(set! in-modifiers? #f)
(set! in-gunmods? #f)
(set! in-superpowers? #f)
(set! in-skill? #f)
(set! in-pets? #f)
(enable-hudmap)
(kill-by-name "proc-mask-enemyfreeze" *active-pool*)
(camera-unlocked)
(when (= (-> *game-info* total-deaths) 0)
    (level-up-cars! 1)
)
(sound-play "menu-back")
(cpad-clear! 0 r3)
(cpad-clear! 0 triangle)
)



;;  draw mod menu
(when 
    (and 
    (not (paused?))
    (not *scene-player*)
    pause-allowed?
    in-menu?)

    (mod-menu-controls)
    (draw-mod-menu-background)

    (when (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
        (clear *temp-string*)
        (format *temp-string* "<COLOR_RED>Prestige Level ~D"
        (the int (-> *game-info* crates-opened))
        )
        (draw-mod-menu-text-custom *temp-string*
        255 72 0.325 #f #t #f)
    )

    (when (and 
    ;; (!= cars-level 0)
    in-hero-menu?
    )
        (set! menu-index-max 4)
        (draw-mod-menu-text-preset 0 "<COLOR_ORANGE>Hero Menu")
        (draw-mod-menu-text-preset 1 "<PAD_X> Confirm   <PAD_TRIANGLE> Exit")
        (case menu-index
            ((0)
                (draw-mod-menu-text-preset 2 "<COLOR_YELLOW>Super Gun Mods<COLOR_MENU-PARENT>~%~%Skills~%~%Fast Travel~%~%Jak Model~%~%Pets"))
            ((1)
                (draw-mod-menu-text-preset 2 "<COLOR_MENU-PARENT>Super Gun Mods~%~%<COLOR_YELLOW>Skills<COLOR_MENU-PARENT>~%~%Fast Travel~%~%Jak Model~%~%Pets"))
            ((2)
                (draw-mod-menu-text-preset 2 "<COLOR_MENU-PARENT>Super Gun Mods~%~%Skills~%~%<COLOR_YELLOW>Fast Travel<COLOR_MENU-PARENT>~%~%Jak Model~%~%Pets"))
            ((3)
                (draw-mod-menu-text-preset 2 "<COLOR_MENU-PARENT>Super Gun Mods~%~%Skills~%~%Fast Travel~%~%<COLOR_YELLOW>Jak Model<COLOR_MENU-PARENT>~%~%Pets"))
            ((4)
                (draw-mod-menu-text-preset 2 "<COLOR_MENU-PARENT>Super Gun Mods~%~%Skills~%~%Fast Travel~%~%Jak Model~%~%<COLOR_YELLOW>Pets<COLOR_MENU-PARENT>"))
        )
    )

    (when in-gunmods?
        (set! menu-index-max 11)
        (draw-mod-menu-text-preset 0 "<COLOR_ORANGE>Super Gun Mods")
        (draw-mod-menu-text-preset 1 "<PAD_X> Toggle   <PAD_TRIANGLE> Back")
        (draw-gunmod-menu!)
    )

    (when in-superpowers?
        (set! menu-index-max 2)
        (draw-mod-menu-text-preset 0 "<COLOR_ORANGE>Skills")
        (draw-mod-menu-text-preset 1 "<PAD_X> Confirm   <PAD_TRIANGLE> Back")
        (clear matt-str)
        (clear *temp-string*)
        (case menu-index
            ((0)
                (format matt-str "<COLOR_YELLOW>Hero Level ~d~%~%<COLOR_MENU-PARENT>Gun Level ~d~%~%Vehicle Level ~d"
                notoriety-level
                guns-level
                cars-level))

            ((1)
                (format matt-str "<COLOR_MENU-PARENT>Hero Level ~d~%~%<COLOR_YELLOW>Gun Level ~d<COLOR_MENU-PARENT>~%~%Vehicle Level ~d"
                notoriety-level
                guns-level
                cars-level))

            ((2)
                (format matt-str "<COLOR_MENU-PARENT>Hero Level ~d~%~%Gun Level ~d~%~%<COLOR_YELLOW>Vehicle Level ~d"
                notoriety-level
                guns-level
                cars-level)))

        (cat-string<-string *temp-string* matt-str)
        (draw-mod-menu-text-preset 2 *temp-string*)
    )

    (when in-skill?
        (set! menu-index-max 0)
        (draw-mod-menu-text-preset 0 "<COLOR_ORANGE>Skills")
        (draw-mod-menu-text-preset 1 "<PAD_TRIANGLE> Back")
        ;; hero level
        (if (>= notoriety-level 10)
            (set! skill-noto-string1 "<COLOR_GREEN>+3% increased HP per level")
            (set! skill-noto-string1 "<COLOR_RED>LOCKED"))

        (if (>= notoriety-level 25)
            (set! skill-noto-string2 "<COLOR_GREEN>Hero Level affects Weapon Damage")
            (set! skill-noto-string2 "<COLOR_RED>LOCKED"))

        (if (>= notoriety-level 40)
            (set! skill-noto-string3 "<COLOR_GREEN>15x increased Melee Damage")
            (set! skill-noto-string3 "<COLOR_RED>LOCKED"))
            
        (if (>= notoriety-level 60)
            (set! skill-noto-string4 "<COLOR_GREEN>Gain Ammo/Eco when hitting enemies")
            (set! skill-noto-string4 "<COLOR_RED>LOCKED"))

        ;; gun level
        (if (>= guns-level 4)
            (set! skill-guns-string1 "<COLOR_GREEN>Gain more ammo from pickups")
            (set! skill-guns-string1 "<COLOR_RED>LOCKED"))
        
        (if (>= guns-level 9)
            (set! skill-guns-string2 "<COLOR_GREEN>Fire rate increased per level on semi-auto weapons")
            (set! skill-guns-string2 "<COLOR_RED>LOCKED"))
        
        (if (>= guns-level 16)
            (set! skill-guns-string3 "<COLOR_GREEN>6% chance to fire a double projectile")
            (set! skill-guns-string3 "<COLOR_RED>LOCKED"))
        
        (if (>= guns-level 20)
            (set! skill-guns-string4 "<COLOR_GREEN>Huge ammo bags")
            (set! skill-guns-string4 "<COLOR_RED>LOCKED"))

        ;; vehicle level
        (if (>= cars-level 2)
            (set! skill-cars-string1 "<COLOR_GREEN>Turbo pickups can repair vehicle")
            (set! skill-cars-string1 "<COLOR_RED>LOCKED"))

        (if (>= cars-level 6)
            (set! skill-cars-string2 "<COLOR_GREEN>+34% vehicle boost recharge speed")
            (set! skill-cars-string2 "<COLOR_RED>LOCKED"))

        (if (>= cars-level 14)
            (set! skill-cars-string3 "<COLOR_GREEN>+12% vehicle boost speed")
            (set! skill-cars-string3 "<COLOR_RED>LOCKED"))

        (clear *temp-string*)
        (case menu-index
            ((0)
                (format *temp-string* 
"<COLOR_ORANGE>Hero Level ~d~%

<COLOR_WHITE>Upgrade your core abilities
to even the odds.

<COLOR_YELLOW>Complete missions and level up other skills to earn XP.~%

<COLOR_ORANGE>Tier 1 (Lv. 10)~%~s~%
<COLOR_ORANGE>Tier 2 (Lv. 25)~%~s~%
<COLOR_ORANGE>Tier 3 (Lv. 40)~%~s~%
<COLOR_ORANGE>Tier 4 (Lv. 60)~%~S"
                notoriety-level
                skill-noto-string1
                skill-noto-string2
                skill-noto-string3
                skill-noto-string4))

            ((1)
                (format *temp-string* 
"<COLOR_RED>Gun Level ~d~%

<COLOR_WHITE>Upgrade your weapons to fire faster,
bigger, and stronger.

<COLOR_YELLOW>Deplete ammo to earn XP.~%

<COLOR_ORANGE>Tier 1 (Lv. 4)~%~s~%
<COLOR_ORANGE>Tier 2 (Lv. 9)~%~s~%
<COLOR_ORANGE>Tier 3 (Lv. 16)~%~s~%
<COLOR_ORANGE>Tier 4 (Lv. 20)~%~s"
                guns-level
                skill-guns-string1
                skill-guns-string2
                skill-guns-string3
                skill-guns-string4))

            ((2)
                (format *temp-string* 
"<COLOR_PINK>Vehicle Level ~d~%

<COLOR_WHITE>Upgrade your vehicle boost and
weapon damage by leveling up.

<COLOR_YELLOW>Earn Hero XP while on a vehicle to earn XP.~%

<COLOR_ORANGE>Tier 1 (Lv. 2)~%~s~%
<COLOR_ORANGE>Tier 2 (Lv. 6)~%~s~%
<COLOR_ORANGE>Tier 3 (Lv. 14)~%~s"
                cars-level
                skill-cars-string1
                skill-cars-string2
                skill-cars-string3))
        )
        (draw-mod-menu-text-custom *temp-string*
        256 90 0.325 #f #t #f)

        (set! noto-draw-x (- noto-bar-x-pos (/ xp-bar-width 2)))
        (set! noto-draw-y 102)
        (set! guns-draw-x (- noto-bar-x-pos (/ xp-bar-width 2)))
        (set! guns-draw-y 102)
        (set! car-draw-x (- noto-bar-x-pos (/ xp-bar-width 2)))
        (set! car-draw-y 102)
        
        (draw-XP-bar)
