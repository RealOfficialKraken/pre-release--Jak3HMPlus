            ))

            ((3)
            (format matt-str "<COLOR_MENU-PARENT>~S~%~%~S~%~%~S~%~%<COLOR_YELLOW>~S<COLOR_MENU-PARENT>~%~%~S"
            warp-s1
            warp-s2
            warp-s3
            warp-s4
            warp-s5
            ))

            ((4)
            (format matt-str "<COLOR_MENU-PARENT>~S~%~%~S~%~%~S~%~%~S~%~%<COLOR_YELLOW>~S"
            warp-s1
            warp-s2
            warp-s3
            warp-s4
            warp-s5
            ))
        )
        (clear *temp-string*)
        (cat-string<-string *temp-string* matt-str)
        (draw-mod-menu-text-preset 2 *temp-string*)
    )
    (when in-jak-model?
        (set! menu-index-max 0)
        (draw-mod-menu-text-preset 0 "Jak Model")
        (draw-mod-menu-text-preset 1 "<PAD_X> Confirm   <PAD_TRIANGLE> Back")
    )
    (when in-pets?
        (set! menu-index-max 9)
        (draw-mod-menu-text-preset 0 "Pets")
        (draw-mod-menu-text-preset 1 "<PAD_X> Toggle   <PAD_TRIANGLE> Back")
        (draw-mod-menu-text-custom "Loyal little companions for emotional support.~%~%Can you collect them all?" 
        256 90 0.325 #f #t #f)
    )
)


(when 
    (and 
        (= (-> *game-info* total-deaths) 0)
        (= menu-unlocked? #t)
        (= on-vehicle? #f)
        (not *scene-player*)
        in-welcome-screen?
        in-menu?
    )
    (draw-welcome-screen)
    )

;; when in-debug?
(when (and in-debug? *debug-segment*)
    (cond 
        (in-desert-game-task?
            (draw-mod-menu-text-custom "<COLOR_WHITE>in-desert-game-task? <COLOR_GREEN>#t"
            510 70 0.325 #f #f #t))
        (else
            (draw-mod-menu-text-custom "<COLOR_WHITE>in-desert-game-task? <COLOR_RED>#f"
            510 70 0.325 #f #f #t))
    )
    (cond 
        (hud-timer-on?
            (draw-mod-menu-text-custom "<COLOR_WHITE>hud-timer-on? <COLOR_GREEN>#t"
            510 80 0.325 #f #f #t))
        (else
            (draw-mod-menu-text-custom "<COLOR_WHITE>hud-timer-on? <COLOR_RED>#f"
            510 80 0.325 #f #f #t))
    )

    (clear *temp-string*)
    (format *temp-string* "<COLOR_WHITE>cdr-satbattle = <COLOR_YELLOW>~d<COLOR_ORANGE>/6000"
    cdr-i
    )
    (draw-mod-menu-text-custom *temp-string*
    510 90 0.325 #f #f #t)

    (clear *temp-string*)
    (format *temp-string* "<COLOR_GREEN>Mod Script Active!~%~%<COLOR_YELLOW>continue-deaths = <COLOR_ORANGE>~D~%<COLOR_YELLOW>task-deaths = <COLOR_ORANGE>~D~%<COLOR_YELLOW>total-deaths = <COLOR_ORANGE>~D~%<COLOR_RED>enemy-noto = ~d~%<COLOR_RED>crates-opened (hm tick)=~d"
    cdr-i
    )
    (draw-mod-menu-text-custom *temp-string*
    510 1 0.325 #f #f #t)
)

(when 
    (and
        (= desert-spawn-mission-deserta #t) ;exit the task marauder mission when far away
        (task-node-closed? (game-task-node desert-spawn-task-deserta-goto-artifact))
        (>= (vector-vector-distance (new 'static 'vector
                    :x (meters 2539.2421)
                    :y (meters 23.0453)
                    :z (meters 3332.9597)
                    :w 1.0
                    )
                     (target-pos 0)) 2500000.0)
    )
    (task-node-open! (game-task-node desert-spawn-task-deserta-goto-artifact) #t)
    (set! desert-spawn-mission-deserta #f)
    )

(when 
    (and
        (= desert-spawn-mission-oasis #t) ;exit the task marauder mission when far away
        (task-node-closed? (game-task-node desert-spawn-task-oasis-goto-artifact))
        (>= (vector-vector-distance (new 'static 'vector
                    :x (meters 638.2655)
                    :y (meters 14.8769)
                    :z (meters 2522.8432)
                    :w 1.0
                    )
                        (target-pos 0)
                        )
                        2500000.0
                        )
    )
    (task-node-open! (game-task-node desert-spawn-task-oasis-goto-artifact) #t)
    (set! desert-spawn-mission-oasis #f)
)

;; new skills unlocked
(when
    (and
        (= r3-hints #t)
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
    )
        (+! r3-hinti 1)
        (let ((ani-num 0))
            (clear *temp-string*)
            (format matt-str "~s(R3)<COLOR_WHITE> New Skills Unlocked!"
            hint-string
            )
            (when (< r3-hinti 0)
                (set! ani-num r3-hinti)
            )
            (draw-mod-menu-text-custom *temp-string*
            ani-num 270 0.325 #t #f #f)
        )
        (+! r3-hinti2 1)
        (when (>= r3-hinti2 35)
        (cond
            ((string= hint-string "<COLOR_YELLOW>")
                (set! hint-string "<COLOR_ORANGE>")
                (set! r3-hinti2 0)
            )
            (else
                (set! hint-string "<COLOR_YELLOW>")
                (set! r3-hinti2 0)
            )
        )
        (when (>= r3-hinti 800)
            (set! r3-hints #f)
        )
        (when (= in-menu? #t)
            (set! r3-hints #f)
        )
    )
)

(when
    (and
        (task-node-open? (game-task-node desert-interceptors-attack-exclude))
        (= weather-dark-mode #f)
    )
    (task-node-close! (game-task-node desert-interceptors-attack-exclude) #t)
)
(when
    (and
        (not (task-node-open? (game-task-node desert-interceptors-attack-exclude)))
        (= weather-dark-mode #t)
        (= tpfb-active #f)
    )
    (task-node-open! (game-task-node desert-interceptors-attack-exclude) #t)
)

;quest params for kleiver
(when (and (not (paused?))
    (or draw-active-quest?
        (not in-menu?)
    ))
    (when (and (< anim-quest 0) (< anim-quest-i 300))
        (+! anim-quest 1)
    )
    (when (and (>= anim-quest 0) (<= anim-quest-i 300))
        (+! anim-quest-i 1)
    )
    (when (and (> anim-quest -30) (>= anim-quest-i 300))
        (-! anim-quest 1)
    )
    (when (or (<= anim-quest -30) in-menu?)
        (set! draw-active-quest? #f)
    )
    (when 
        (and
            (not (paused?))
            (task-node-closed? (game-task-node wascity-gungame-introduction))
            (not (task-node-closed? (game-task-node wascity-gungame-resolution)))
        )
        (clear *temp-string*)
        (cond 
            ((task-node-open? (game-task-node wascity-kleeverquest-lavatoad))
                (format *temp-string* "<COLOR_ORANGE>Active Quest:~%~%<COLOR_WHITE>~d/16 Gather Lava Toad Skins"
                (-> *game-info* side-enemies-killed?)
                )
            )
            ((task-node-open? (game-task-node wascity-kleeverquest-mantaray))
                    (format *temp-string* "<COLOR_ORANGE>Active Quest:~%~%<COLOR_WHITE>~d/8 Slay Albino Mantas"
                (-> *game-info* side-enemies-killed?)
                )
            )
            ((task-node-open? (game-task-node wascity-kleeverquest-marauders))
                (format *temp-string* "<COLOR_ORANGE>Active Quest:~%~%<COLOR_WHITE>Find the Artifact"
                )
            )
            ((task-node-open? (game-task-node wascity-kleeverquest-bruteboss))
                (format *temp-string* "<COLOR_ORANGE>Active Quest:~%~%<COLOR_WHITE>Slay the Goredrinker"
                (-> *game-info* side-enemies-killed?)
                )
            )
            (else
                (format *temp-string* "<COLOR_GREEN>Active Quest Completed~%~%<COLOR_WHITE>Return to Kleiver"
                (-> *game-info* side-enemies-killed?)
                )
            )
        )
        (draw-mod-menu-text-custom *temp-string* 
        (+ (* anim-quest 10) 20) 60 0.325 #t #f #f)
    )
)
;; reset anim-quest draw timer
(when
    (and
        *target*
        (not *scene-player*)
        (not (paused?))
        (pause-allowed?)
        (cpad-pressed? 0 l3)
        draw-active-quest?
        (> anim-quest-i 0)
    )
    (set! anim-quest-i 0)
)


;; kleiver quests
(when
    (and
        (not (paused?))
        (not in-menu?)
        (<= (vector-vector-distance 
                (new 'static 'vector
                :x (meters 1594.60)
                :y (meters 21.1)
                :z (meters -411.96)
                :w 1.0) 
                (target-pos 0)
                )
                30000.0)
        (or
            (task-node-open? (game-task-node wascity-gungame-introduction))
            (task-node-open? (game-task-node wascity-kleeverquest-lavatoad-res))
            (task-node-open? (game-task-node wascity-kleeverquest-mantaray-res))
            (task-node-open? (game-task-node wascity-kleeverquest-marauders-res))
            (task-node-open? (game-task-node wascity-kleeverquest-bruteboss-res))
        )
    )
    (draw-mod-menu-text-preset 1 "<PAD_TRIANGLE> Talk to Kleiver")

    (when (cpad-pressed? 0 triangle)
        (disable-hudmap)
        (set! log-sec 0)
        (set! in-dialogue? #t)
        (camera-locked #f #f #f)
        (set-vector! 
            (-> *target* control trans) 
            (meters 1601.7684) 
            (meters 25.36) 
            (meters -426.1642) 
            1.0)
        (send-event *camera* 
                    'teleport-to-vector-start-string 
                    (new 'static 'vector 
                    :x (meters 1593.6910) 
                    :y (meters 23.9904) 
                    :z (meters -408.8620))
        )
        (cond 
            ((task-node-open? (game-task-node wascity-gungame-introduction))
                (set! log-id 1)
                (set! (-> *game-info* side-enemies-killed?) 0)
            )
            ((task-node-open? (game-task-node wascity-kleeverquest-lavatoad-res))
                (set! log-id 2)
                (mission-complete? 230)
            )
            ((task-node-open? (game-task-node wascity-kleeverquest-mantaray-res))
                (set! log-id 3)
                (mission-complete? 250)
            )
            ((task-node-open? (game-task-node wascity-kleeverquest-marauders-res))
                (set! log-id 4)
                (mission-complete? 500)
            )
            ((task-node-open? (game-task-node wascity-kleeverquest-bruteboss-res))
                (set! log-id 5)
                (mission-complete? 1500)
            )
        )
    )
)
;; kleiver quest dialogue
(when (and 
    in-dialogue?
    (>= log-id 1)
    (<= log-id 5)
    (not (paused?))
    )
    (send-event *camera* 
                'teleport-to-vector-start-string 
                (new 'static 'vector 
                :x (meters 1593.6910) 
                :y (meters 23.9904) 
                :z (meters -408.8620))
    )
    (when (cpad-pressed? 0 x)
        (+! log-sec 1)
        (cpad-clear! 0 x)
    )
    (cond 
    ((= log-id 1) ;; lava toad quest introduction
        (when (= log-sec 0)
            (set! di-s1 "So, you boys want me to join you on a quest?")
            (set! di-s2 "Well I don't think I've got the guts for it, pal.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 1)
            (set! di-s1 "I don't know if you bone-heads can tell, but all")
            (set! di-s2 "of our desert vehicles have an automatic scanner.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 2)
            (set! di-s1 "It'll always keep an eye out for desert artifacts,")
            (set! di-s2 "so I don't need your advice.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 3)
            (set! di-s1 "We also have a real BIG puppy right here,")
            (set! di-s2 "in the city.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 4)
            (set! di-s1 "In fact, I might have something for the both of us...")
            (set! di-s2 "But you're gonna do something for ME, first.")
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 5)
            (set! di-s1 "I'll take it you're alright with that.")
            (set! di-s2 "")
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 6)
            (set! di-s1 "This might even win you some new toys for")
            (set! di-s2 "your effort.")
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 7)
            (set! di-s1 "I've got me good eyes lookin on a new set")
            (set! di-s2 "of flashy ivories.")
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 8)
            (set! di-s1 "There ain't much life out there in the desert,")
            (set! di-s2 "but I've traveled inside of this harsh volcano.")
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 9)
            (set! di-s1 "If you can find it, there are some buggers")
            (set! di-s2 "who's skin can work as a fine set of armor.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 10)
            (set! di-s1 "Go get me 16 of those Lava Toads, and I'll")
            (set! di-s2 "see about this speck I have scanned.")
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 11)
            (set! in-dialogue? #f)
            (camera-unlocked)
            (set! log-id 0)
            (set-vector! 
            (-> *target* control trans) 
            (meters 1593.8527) 
            (meters 21.6836) 
            (meters -408.5743) 
            1.0)
            (task-node-close! (game-task-node wascity-gungame-introduction) #t)
            (process-spawn hud-map :init hud-init-by-other :name "hud-map" :to *target*)
            (draw-active-quest)
        )
    )

    ((= log-id 2) ;; mantaray quest introduction
        (when (= log-sec 0)
            (set! di-s1 "Mmm, good ivories make good money, too.")
            (set! di-s2 "Maybe ya can get the rest for me.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 1)
            (set! di-s1 "There is a rarity in collecting manta skins.")
            (set! di-s2 "") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 2)
            (set! di-s1 "But there be an even rarer one:")
            (set! di-s2 "the <COLOR_YELLOW>Albino Manta<COLOR_WHITE>.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 3)
            (set! di-s1 "To really make this new armor, ya need to")
            (set! di-s2 "hunt down 8 albinos for me, then I'll lead") 
            (set! di-s3 "you guys to a nice artifact out in the desert.")
            (set! di-s4 "")
        )
        (when (= log-sec 4)
            (set! di-s1 "I last saw them back in that volcano")
            (set! di-s2 "hiding around other mantas.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 5)
            (set! in-dialogue? #f)
            (camera-unlocked)
            (set! log-id 0)
            (set-vector! 
            (-> *target* control trans) 
            (meters 1593.8527) 
            (meters 21.6836) 
            (meters -408.5743) 
            1.0)
            (process-spawn hud-map :init hud-init-by-other :name "hud-map" :to *target*)
            (task-node-close! (game-task-node wascity-kleeverquest-lavatoad-res) #t)
            (draw-active-quest)
        )
    )

    ((= log-id 3) ;; artifact quest introduction
        (when (= log-sec 0)
            (set! di-s1 "Aye, this is nice... and fresh.")
            (set! di-s2 "") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 1)
            (set! di-s1 "You boys don't understand")
            (set! di-s2 "how much this means to me.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 2)
            (set! di-s1 "HA! You bone-chewers actually fell for that.")
            (set! di-s2 "") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 3)
            (set! di-s1 "You did me fine with these though,")
            (set! di-s2 "so I'll make ya a deal.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 4)
            (set! di-s1 "There's a real knuckle dragger out there")
            (set! di-s2 "who keeps messing with our catches.")
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 5)
            (set! di-s1 "Their vehicles are getting stronger,")
            (set! di-s2 "and they are starting to beat us to artifacts.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 6)
            (set! di-s1 "So instead of giving you the artifact I've")
            (set! di-s2 "had me eye on, I'll give you a different one.") 
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 7)
            (set! di-s1 "This artifact is completely safe.")
            (set! di-s2 "Go get 'em, heroes!")
            (set! di-s3 "")
            (set! di-s4 "")
        )
        (when (= log-sec 8)
            (set! in-dialogue? #f)
            (camera-unlocked)
            (set! log-id 0)
            (set-vector! 
            (-> *target* control trans) 
            (meters 1593.8527) 
            (meters 21.6836) 
            (meters -408.5743) 
            1.0)
            (process-spawn hud-map :init hud-init-by-other :name "hud-map" :to *target*)
            (task-node-close! (game-task-node wascity-kleeverquest-mantaray-res) #t)
            (draw-active-quest)
        )
    )

    ((= log-id 4) ;; goredrinker quest introduction
        (when (= log-sec 0)
                (set! di-s1 "Mates you were completely outnumbered,")
                (set! di-s2 "yet ya bested 'em and came out stronger.") 
                (set! di-s3 "I admire that.")
                (set! di-s4 "")
            )
            (when (= log-sec 1)
                (set! di-s1 "Maybe you're top enough to best the Goredrinker.")
                (set! di-s2 "He's been a rabid dog since those gateways") 
                (set! di-s3 "started opening.")
                (set! di-s4 "")
            )
            (when (= log-sec 2)
                (set! di-s1 "Those portals over there, they ain't ours.")
                (set! di-s2 "Something big is going on...") 
                (set! di-s3 "")
                (set! di-s4 "")
            )
            (when (= log-sec 3)
                (set! di-s1 "You could be of use to us.")
                (set! di-s2 "But for the final time, you'll prove") 
                (set! di-s3 "yourself by taking on the Goredrinker.")
                (set! di-s4 "")
            )
            (when (= log-sec 4)
                (set! di-s1 "Damas and I are the only ones who have bested him")
                (set! di-s2 "so far, and he keeps coming back in the same spot.")
                (set! di-s3 "")
                (set! di-s4 "")
            )
            (when (= log-sec 5)
                (set! di-s1 "Slay the Goredrinker at least once, then I'll come along.")
                (set! di-s2 "But you'll also have to get Damas on board, too.") 
                (set! di-s3 "")
                (set! di-s4 "")
            )
            (when (= log-sec 6)
                (set! di-s1 "I'm not going unless he is coming with.")
                (set! di-s2 "") 
                (set! di-s3 "")
                (set! di-s4 "")
            )
            (when (= log-sec 7)
                (set! di-s1 "Here's the hideaway.")
                (set! di-s2 "")
                (set! di-s3 "")
                (set! di-s4 "")
            )
            (when (= log-sec 8)
                (set! in-dialogue? #f)
                (camera-unlocked)
                (set! log-id 0)
                (set-vector! 
                (-> *target* control trans) 
                (meters 1593.8527) 
                (meters 21.6836) 
                (meters -408.5743) 
                1.0)
                (process-spawn hud-map :init hud-init-by-other :name "hud-map" :to *target*)
                (task-node-close! (game-task-node wascity-kleeverquest-marauders-res) #t)
                (draw-active-quest)
            )
        )

        ((= log-id 5) ;; goredrinker quest res
            (when (= log-sec 0)
                (set! di-s1 "Nice work boys, get some good toys out of this?")
                (set! di-s2 "") 
                (set! di-s3 "")
                (set! di-s4 "")
            )
            (when (= log-sec 1)
                (set! di-s1 "Well I don't care.")
                (set! di-s2 "Go talk to Damas and get him to") 
                (set! di-s3 "come with you.")
                (set! di-s4 "")
