            (set! di-s2 "<COLOR_RED>")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 4)
            (set! di-s1 "<COLOR_PINK>Even if we did control it for ourselves, our old")
            (set! di-s2 "<COLOR_PINK>incompetent friends will get in our way.")
            (set! di-s3 "<COLOR_PINK>It's just no use.")
            (set! di-s4 "<COLOR_PINK>")
        )
        (when (= log-sec 5)
            (set! di-s1 "<COLOR_RED>All in good time, friends.")
            (set! di-s2 "<COLOR_RED>You will understand.")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
