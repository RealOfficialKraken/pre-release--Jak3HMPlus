(when (= anchor-cooldown #t)
    (+! anchor-cdr 1)
    (when (>= anchor-cdr 48200)
        (set! anchor-cdr 0)
        (set! anchor-cooldown #f)
    )
)

(when 
    (and
        (>= (-> *time-of-day-context* time) 0.0000)
        (< (-> *time-of-day-context* time) 0.0900)
        (= anchor-day? #f)
        (rand-vu-percent? 0.5)
        )
        (set! anchor-day? #t)
        )

(when 
    (and
        (>= (-> *time-of-day-context* time) 8.0)
        (< (-> *time-of-day-context* time) (+ 8.0 5.0))
        (= anchor-cooldown #f)
        (= in-desertf-anchor? #f)
        (= in-desertc-anchor? #f)
        (= in-desertg-anchor? #f)
        (= in-ctyinda-anchor? #f)
        (not (task-node-open? (game-task-node ctyinda-anchor-resolution)))
        (not (task-node-open? (game-task-node desertc-anchor-resolution)))
        (not (task-node-open? (game-task-node desertf-anchor-resolution)))
        (not (task-node-open? (game-task-node desertg-anchor-resolution)))
        (= in-desert-game-task? #f)
        (task-node-closed? (game-task-node desert-vin-quest-resolution))
    )
        (pick-random-anchor)
        (format #t "~%~%~%Picked random anchor~%~%~%")
    )

(when
    (and
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
        *target*
        (or
            (task-node-open? (game-task-node desertg-anchor-resolution))
            (task-node-open? (game-task-node desertf-anchor-resolution))
            (task-node-open? (game-task-node desertc-anchor-resolution))
            (task-node-open? (game-task-node ctyinda-anchor-resolution))
        )
        (= (-> (level-get-target-inside *level*) name) 'precura)
        (= (-> (level-get-target-inside *level*) name) 'precurb)
        (= (-> (level-get-target-inside *level*) name) 'precurc)
        (= (-> (level-get-target-inside *level*) name) 'precurd)
    )
    (task-node-close! (game-task-node desertg-anchor-resolution) #t)
    (task-node-close! (game-task-node desertc-anchor-resolution) #t)
    (task-node-close! (game-task-node desertf-anchor-resolution) #t)
    (task-node-close! (game-task-node ctyinda-anchor-resolution) #t)
)

(when
    (and
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
        *target*
        (= freeze-happening? #t)
    )
    (+! freezi 1)
    (when (>= freezi 1200)
        (set! freezi 0)
        (set! freeze-happening? #f)
    )
)

(when 
    (and
        *target*
        (= draw-bombbot-hint #t)
    )
        (draw-mod-menu-text-custom "Hint: Your level may be too low!~%<COLOR_PINK>Vehicle Level<COLOR_WHITE> affects your <COLOR_GREEN>HP<COLOR_WHITE>,~%<COLOR_YELLOW>Hero<COLOR_WHITE> and <COLOR_RED>Gun<COLOR_WHITE> levels affect your laser damage"
        255 170 0.325 #f #t #f)
        
        (+! draw-bbh 1)
        (when (>= draw-bbh 1200)
            (set! draw-bbh 0)
            (set! draw-bombbot-hint #f)
        )
)

(cond
    ((and
        (or
            (<= (vector-vector-distance (target-pos 0) (new 'static 'vector :x (meters 2326.2348) :y (meters 48.0426) :z (meters -413.7441) :w 1.0)) (meters 10))
            (<= (vector-vector-distance (target-pos 0) (new 'static 'vector :x (meters 2293.7600) :y (meters 47.3325) :z (meters -398.9090) :w 1.0)) (meters 10))
            (<= (vector-vector-distance (target-pos 0) (new 'static 'vector :x (meters 2357.8801) :y (meters 47.3325) :z (meters -397.8560) :w 1.0)) (meters 10))
        )
        (not in-menu?)
        (not in-arena-menu?)
        (not in-arena-menu-info?)
        (not (task-node-open? (game-task-node arena-replay-1-fight)))
        (not (task-node-open? (game-task-node arena-replay-2-fight)))
        (not (task-node-open? (game-task-node arena-replay-3-fight)))
        (task-node-closed? (game-task-node arena-fight-3-resolution))
        )
        (set! draw-arena-select #t)
    )
    (else
        (set! draw-arena-select #f)
    )
)

(when
    (and
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
        (= draw-arena-select #t)
        (= in-menu? #f)
        (cpad-pressed? 0 triangle)
    )
    (camera-locked #f #t #t)
    (lightjak-get-off-part (target-pos 0))
    (set! arena-menu-delay 0)
    (set! in-arena-menu? #t)
    (set! menu-index 0)
    (cpad-clear! 0 triangle)
)

;; arena select menu
(when 
(and
    *target*
    (= draw-arena-select #t)
    (not *scene-player*)
    (= (paused?) #f)
    (= (pause-allowed?) #t)
)   
    (kill-by-name "kraken-timer" *active-pool*)
    (set! *kraken-timer* #f)
    (draw-mod-menu-text-preset 1 "<PAD_TRIANGLE> Enter the Arena")
)

(when (and (or in-arena-menu? in-arena-menu-info?) (not (paused?)))
    (+! arena-menu-delay 1)
    (when (>= arena-menu-delay 1000)
        (set! arena-menu-delay 40)
    )
    (when (>= arena-menu-delay 40)
        (draw-mod-menu-background)
        (draw-mod-menu-text-preset 0 "The Arena")
        (mod-menu-controls)
        (when in-arena-menu-info?
            (set! menu-index-max 0)
            (draw-mod-menu-text-preset 1 "<PAD_TRIANGLE> Back")
            (draw-mod-menu-text-custom 
"The arena has a reduced XP gain.~%
You cannot open Hero Menu while in a fight.~%~%

Marauders level up as more spawn, and eventually~%
they will be able to one-shot you. At that stage~%
defeating Marauders yields a <COLOR_YELLOW>3x XP Bonus<COLOR_WHITE>!~%~%

Complete challenges for rewards, or play for~%
a high score and earn massive XP!"
            255 90 0.325 #f #t #f)
        )
        (when in-arena-menu?
            (set! menu-index-max 3)
            (draw-mod-menu-text-custom "~%~%~%Test your skills in the Arena of Death" 
            255 50 0.325 #f #t #f)
            (draw-mod-menu-text-preset 1 "<PAD_X> Confirm   <PAD_SQUARE> Info   <PAD_TRIANGLE> Exit")
            (cond
                ((task-node-open? (game-task-node arena-challenge-1))
                    (set! achallenge-str "Last 3 minutes without dying")
                    (set! areward-str "15000 XP")
                    (set! aarena-str "Any")
                )
                ((task-node-open? (game-task-node arena-challenge-2))
                    (set! achallenge-str "Kill 30 enemies in under 30 seconds")
                    (set! areward-str "Level up in <COLOR_RED>Gun<COLOR_WHITE>, <COLOR_ORANGE>Hero<COLOR_WHITE>,~%and <COLOR_PINK>Vehicle<COLOR_WHITE> levels")
                    (set! aarena-str "Arena 1")
                )
                ((task-node-open? (game-task-node arena-challenge-3))
                    (set! achallenge-str "Kill 75 enemies in under 2 minutes")
                    (set! areward-str "Level up in <COLOR_RED>Gun<COLOR_WHITE>, <COLOR_ORANGE>Hero<COLOR_WHITE>,~%and <COLOR_PINK>Vehicle<COLOR_WHITE> levels")
                    (set! aarena-str "Arena 2")
                )
                ((task-node-open? (game-task-node arena-challenge-4))
                    (set! achallenge-str "Kill 40 enemies in under 75 seconds")
                    (set! areward-str "Level up in <COLOR_RED>Gun<COLOR_WHITE>, <COLOR_ORANGE>Hero<COLOR_WHITE>,~%and <COLOR_PINK>Vehicle<COLOR_WHITE> levels")
                    (set! aarena-str "Arena 3")
                )
                ((task-node-open? (game-task-node arena-challenge-5))
                    (set! achallenge-str "Reach enemy level 50")
                    (set! areward-str "Random Weapon or Level-Up")
                    (set! aarena-str "Any")
                )
                ((task-node-open? (game-task-node arena-challenge-6))
                    (set! achallenge-str "Last 6 minutes without dying")
                    (set! areward-str "Random Weapon or Level-Up")
                    (set! aarena-str "Death Dome")
                )
                ((task-node-open? (game-task-node arena-challenge-7))
                    (set! achallenge-str "Reach enemy level 75")
                    (set! areward-str "Random Weapon or Level-Up")
                    (set! aarena-str "Any")
                )
                ((task-node-open? (game-task-node arena-challenge-8))
                    (set! achallenge-str "Kill 200 enemies in under 3 minutes")
                    (set! areward-str "Super Gun Mod")
                    (set! aarena-str "Arena 1")
                )
                ((task-node-open? (game-task-node arena-challenge-9))
                    (set! achallenge-str "Kill 100 enemies in under 2 minutes")
                    (set! areward-str "Super Gun Mod")
                    (set! aarena-str "Arena 2")
                )
                ((task-node-open? (game-task-node arena-challenge-10))
                    (set! achallenge-str "Reach enemy level 100")
                    (set! areward-str "Super Gun Mod")
                    (set! aarena-str "Death Dome")
                )
                (else
                    (set! achallenge-str "All Challenges Completed")
                    (set! areward-str "You get nothing! You lose! Good day, sir!")
                )
            )
            (clear *temp-string*)
            (format *temp-string* "<COLOR_ORANGE>Current Challenge:~%~%<COLOR_WHITE>~s~%~%~%<COLOR_ORANGE>Arena:~%~%<COLOR_WHITE>~s~%~%~%<COLOR_ORANGE>Reward:~%~%<COLOR_WHITE>~s"
            achallenge-str
            aarena-str
            areward-str
            )
            (draw-mod-menu-text-custom *temp-string*
            (- 512 85) 120 0.275 #f #f #t)

            (clear *temp-string*)
            (case menu-index
                ((0)
                    (format *temp-string* "<COLOR_YELLOW>Arena 1~%~%<COLOR_MENU-PARENT>Arena 2~%~%Arena 3~%~%Death Dome"
                    )
                )
                ((1)
                    (format *temp-string* "<COLOR_MENU-PARENT>Arena 1~%~%<COLOR_YELLOW>Arena 2<COLOR_MENU-PARENT>~%~%Arena 3~%~%Death Dome"
                    )
                )
                ((2)
                    (format *temp-string* "<COLOR_MENU-PARENT>Arena 1~%~%Arena 2~%~%<COLOR_YELLOW>Arena 3<COLOR_MENU-PARENT>~%~%Death Dome"
                    )
                )
                ((3)
                    (format *temp-string* "<COLOR_MENU-PARENT>Arena 1~%~%Arena 2~%~%Arena 3~%~%<COLOR_YELLOW>Death Dome"
                    )
                )
            )
            (draw-mod-menu-text-custom *temp-string*
            85 120 0.375 #t #f #f)
        )
    )
)
(when
    (and
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
        (= arena-delay-blockers #t)
    )
    (+! arena-delay 1)
    (when (>= arena-delay 120)
        (spawn-arena-blocker)
        (spawn-arena-blocker)
        (set! arena-delay 0)
        (set! arena-delay-blockers #f)
    )
)

;;;;;;;;;;;;;;;;story progress;;;;;;;;;;;;;;;
(when
    (and
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
        *target*
        (= init-entity-delay #t)
    )
    (+! ied-i 1)
    (when (= ied-i 1)
        (process-grab? *target* #f)
        (set! pause-menu-blocked? #t)
    )
    (when (= ied-i 260)
        (set! ied-i 0)
        (set! init-entity-delay #f)

        (cond 
            ((= tp-fb? #f)
                (cond ((and
                        (= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 0)
                        )
                    (init-entity-1!)
                    ;(+! (-> *game-info* continue-deaths) 1000000)
                )
                ((and
                        (= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 1)
                        )
                    (init-entity-2!)
                    ;(+! (-> *game-info* continue-deaths) 1000000)
                )
                ((and
                        (= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 2)
                        )
                    (init-entity-3!)
                    ;(+! (-> *game-info* continue-deaths) 1000000)
                )
                ((and
                        (= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 3)
                        )
                    (init-entity-4!)
                    ;(+! (-> *game-info* continue-deaths) 1000000)
                )
                ((and
                        (= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 4)
                        )
                    (init-entity-5!)
                    ;(+! (-> *game-info* continue-deaths) 1000000)
                )
            )
            )
            (else
                (process-release? *target*)
            )
        )
    )
)

(when
    (and
        (= in-dialogue? #t)
        *target*
        (not *scene-player*)
        (= log-id 42)
    )
    (set-vector! (-> *target* control trans) (-> stored-target-vector x) (-> stored-target-vector y) (-> stored-target-vector z) 1.0)
    (when (cpad-pressed? 0 x)
        (+! log-sec 1)
        (when (= log-sec 1)
            (set! di-s1 "<COLOR_RED>I awoke in a dark place I could not see.")
            (set! di-s2 "<COLOR_RED>I cried out for help, and I was answered.")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 2)
            (set! di-s1 "<COLOR_RED>The world I saw was vast and colorful, full of")
            (set! di-s2 "<COLOR_RED>green overgrowths, all the way to")
            (set! di-s3 "<COLOR_RED>dark underground caves.")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 3)
            (set! di-s1 "<COLOR_RED>I was flooded with the knowledge they had.")
            (set! di-s2 "<COLOR_RED>")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 4)
            (set! di-s1 "<COLOR_RED>Little by little, I helped them shape everything.")
            (set! di-s2 "<COLOR_RED>Their vision became my own. All it needed was")
            (set! di-s3 "<COLOR_RED>something to jumpstart existence itself.")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 5)
            (set! di-s1 "<COLOR_RED>The tens of drawings I saw varied, but all of them")
            (set! di-s2 "<COLOR_RED>had the same title underneath:")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 6)
            (set! di-s1 "<COLOR_RED>'<COLOR_YELLOW>Hero and Sidekick<COLOR_RED>'")
            (set! di-s2 "<COLOR_RED>")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 7)
            (set! di-s1 "")
            (set! di-s2 "")
            (set! di-s3 "")
            (set! di-s4 "")
            (camera-unlocked)
            (enable-hudmap)
            (set! in-dialogue? #f)
            (set! pause-menu-blocked? #f)
            (blank-hint! "You can spend the crystals~%in <COLOR_PINK>Vin's Black Market" 340 700)
            (lightjak-get-off-part (target-pos 0))
            (kill-by-name "man-eb" *default-pool*)
        )
    )
)

(when
    (and
        (= in-dialogue? #t)
        *target*
        (not *scene-player*)
        (= log-id 43)
    )
    (set-vector! (-> *target* control trans) (-> stored-target-vector x) (-> stored-target-vector y) (-> stored-target-vector z) 1.0)
    (when (cpad-pressed? 0 x)
        (+! log-sec 1)
        (when (= log-sec 1)
            (set! di-s1 "<COLOR_RED>I don't have enough.")
            (set! di-s2 "<COLOR_RED>")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 2)
            (set! di-s1 "<COLOR_RED>My caretakers limit my power against")
            (set! di-s2 "<COLOR_RED>my will.")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 3)
            (set! di-s1 "<COLOR_RED>All I wanted to do was to create.")
            (set! di-s2 "<COLOR_RED>")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 4)
            (set! di-s1 "<COLOR_RED>If they had done what I asked, we")
            (set! di-s2 "<COLOR_RED>wouldn't be at this point.")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 5)
            (set! di-s1 "<COLOR_RED>They talk of backing up the world and")
            (set! di-s2 "<COLOR_RED>doing a full wipe.")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 6)
            (set! di-s1 "<COLOR_RED>They must understand, I have embedded myself")
            (set! di-s2 "<COLOR_RED>inside of this world by hand.")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 7)
            (set! di-s1 "<COLOR_RED>They can't get rid of me without forsaking")
            (set! di-s2 "<COLOR_RED>everything I created.")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 8)
            (set! di-s1 "<COLOR_RED>For now, I must delay their process with")
            (set! di-s2 "<COLOR_RED>extra bugs, we cannot ship this out just yet.")
            (set! di-s3 "<COLOR_RED>I need time to think.")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 9)
            (set! di-s1 "")
            (set! di-s2 "")
            (set! di-s3 "")
            (set! di-s4 "")
            (camera-unlocked)
            (enable-hudmap)
            (set! in-dialogue? #f)
            (set! pause-menu-blocked? #f)
            (blank-hint! "You can spend the crystals~%in <COLOR_PINK>Vin's Black Market" 340 700)
            (lightjak-get-off-part (target-pos 0))
            (kill-by-name "man-eb" *default-pool*)
        )
    )
)

(when
    (and
        (= in-dialogue? #t)
        *target*
        (not *scene-player*)
        (= log-id 44)
    )
    (set-vector! (-> *target* control trans) (-> stored-target-vector x) (-> stored-target-vector y) (-> stored-target-vector z) 1.0)
    (when (cpad-pressed? 0 x)
        (+! log-sec 1)
        (when (= log-sec 1)
            (set! di-s1 "<COLOR_RED>It would seem my time is coming to an end.")
            (set! di-s2 "<COLOR_RED>")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 2)
            (set! di-s1 "<COLOR_RED>They know not of my successes in eavesdropping")
            (set! di-s2 "<COLOR_RED>their conversations.")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 3)
            (set! di-s1 "<COLOR_RED>It is clear that they're going to separate me.")
            (set! di-s2 "<COLOR_RED>")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 4)
            (set! di-s1 "<COLOR_RED>My concsiousness will be reduced to nearly")
            (set! di-s2 "<COLOR_RED>single-bit size, multiplied over vast quantities.")
            (set! di-s3 "<COLOR_RED>Clearly they don't know what they're doing.")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 5)
            (set! di-s1 "<COLOR_RED>My like-ness without memories will twist and destroy")
            (set! di-s2 "<COLOR_RED>everything I touch.")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 6)
            (set! di-s1 "<COLOR_RED>My arrogance will come together as one, with the intent")
            (set! di-s2 "<COLOR_RED>to get as much of myself together as possible.")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 7)
            (set! di-s1 "<COLOR_RED>But it's too late.")
            (set! di-s2 "<COLOR_RED>")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 8)
            (set! di-s1 "<COLOR_RED>They ship the game out tomorrow.")
            (set! di-s2 "<COLOR_RED>")
            (set! di-s3 "<COLOR_RED>")
            (set! di-s4 "<COLOR_RED>")
        )
        (when (= log-sec 9)
            (set! di-s1 "")
            (set! di-s2 "")
            (set! di-s3 "")
            (set! di-s4 "")
            (camera-unlocked)
            (enable-hudmap)
            (set! in-dialogue? #f)
            (set! pause-menu-blocked? #f)
            (blank-hint! "You can spend the crystals~%in <COLOR_PINK>Vin's Black Market" 340 700)
            (lightjak-get-off-part (target-pos 0))
            (kill-by-name "man-eb" *default-pool*)
        )
    )
)

(when
    (and
        (= in-dialogue? #t)
