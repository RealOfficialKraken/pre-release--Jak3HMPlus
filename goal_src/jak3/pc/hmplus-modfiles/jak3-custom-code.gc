(defun gunmod-menu-append-item! ((dst string) (text string) (selected symbol) (idx int))
  (gunmod-menu-color-check idx)
  (if selected
    (and
      (set! gunmod-menu-text-color "<COLOR_WHITE>")
      (cat-string<-string dst gunmod-menu-text-color))
    (cat-string<-string dst gunmod-menu-text-color)
    )
  (cat-string<-string dst text)
  (common-menu-newline! dst)
  (none))


