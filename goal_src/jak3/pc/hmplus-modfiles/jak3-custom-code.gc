        (when (= log-sec 6)
            (set! di-s1 "<COLOR_RED>There are ancient precursor silos locked")
            (set! di-s2 "<COLOR_RED>deep beneath the ground.")
            (set! di-s3 "<COLOR_RED>They were made for us to find, dear friends.")
