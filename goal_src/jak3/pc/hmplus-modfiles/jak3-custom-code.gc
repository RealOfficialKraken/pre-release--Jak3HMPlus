        (task-node-closed? (game-task-node factory-boss-resolution))
    )
    (factory-level)
)

(when
    (and
        (= going-heromode? #f)
        (!= (-> *game-info* crates-opened) 0.0)
        (not (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
    )
    (set! (-> *game-info* crates-opened) 0.0)
)

(when (= going-heromode? #t)
    (+! hmp-i 1)
    (when (= hmp-i 30)
        (initialize! *game-info* 'game (the-as game-save #f) "wasstada-jump-training" (the-as resetter-spec #f))
    )
    (when
        (and
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (= (pause-allowed?) #t)
            (>= hmp-i 35)
            (= (-> *game-info* civilians-killed) 0.0)
        )
        (set! (-> *game-info* total-trys) hero-level-count)
        (set! (-> *game-info* karma) hero-level-xp-count)
        (set! (-> *game-info* total-deaths) cars-level-count)
        (set! (-> *game-info* fuel) cars-level-xp-count)
        (set! (-> *game-info* auto-save-count) guns-level-count)
        (set! (-> *game-info* buzzer-total) guns-level-xp-count)
        (send-event *target* 'get-pickup (pickup-type skill) orba-count)
        (set! (-> *game-info* crates-opened) heromode-tick)
        (logior! (-> *game-info* secrets) (game-secrets hero-mode))
        (when has-red-2?
            (give-weapon! "red-2" 1)
        )
        (when has-red-3?
            (give-weapon! "red-3" 1)
        )
        (when has-yellow-2?
            (give-weapon! "yellow-2" 1)
        )
        (when has-yellow-3?
            (give-weapon! "yellow-3" 1)
        )
        (when has-blue-1?
            (give-weapon! "blue-1" 1)
        )
        (when has-blue-2?
            (give-weapon! "blue-2" 1)
        )
        (when has-blue-3?
            (give-weapon! "blue-3" 1)
        )
        (when has-dark-1?
            (give-weapon! "dark-1" 1)
        )
        (when has-dark-2?
            (give-weapon! "dark-2" 1)
        )
        (when has-dark-3?
            (give-weapon! "dark-3" 1)
        )
        (when has-pet-flitter?
            (task-node-close! (game-task-node pet-flitter) #t)
        )
        (when has-pet-spiky-frog?
            (task-node-close! (game-task-node pet-spiky-frog) #t)
        )
        (when has-pet-rat?
            (task-node-close! (game-task-node pet-rat) #t)
        )
        (when has-pet-manta?
            (task-node-close! (game-task-node pet-manta) #t)
        )
        (when has-pet-neo-wasp?
            (task-node-close! (game-task-node pet-neo-wasp) #t)
        )
        (when has-pet-kangarat?
            (task-node-close! (game-task-node pet-kangarat) #t)
        )
        (when has-pet-mantis?
            (task-node-close! (game-task-node pet-mantis) #t)
        )
        (when has-pet-terra?
            (task-node-close! (game-task-node pet-terra) #t)
        )
        (when has-pet-scouter?
            (task-node-close! (game-task-node pet-scouter) #t)
        )
        (when has-pet-dogat?
            (task-node-close! (game-task-node pet-dogat) #t)
        )
        (set! hmp-i 0)
        (activate-progress *dproc* 'select-save)
        (+! (-> *game-info* crates-opened) 1.0)
        (task-node-close! (game-task-node arena-training-1-introduction) #t)
        (set! going-heromode? #f)
    )
)

(when
    (and
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
        (not (search-process-tree *active-pool* (lambda ((p process)) (type? p neo-sat))))
        (task-node-open? (game-task-node desert-rescue-satellite-fight))
        (!= (-> (level-get-target-inside *level*) name) 'desertc)
        (!= (-> (level-get-target-inside *level*) name) 'deserte)
        (!= (-> (level-get-target-inside *level*) name) 'desert)
    )
    (task-node-open! (game-task-node desert-rescue-introduction) #t)
)

(when
    (and
        (= weather-dark-mode #t)
        *dark-forest*
        (or
            (= (-> (level-get-target-inside *level*) name) 'wascitya)
            (= (-> (level-get-target-inside *level*) name) 'wascityb)
        )
    )
    (kill-by-name "darkworld-tower" *dark-tower-dead-pool*)
    (kill-by-name "darkworld-orb" *default-pool*)
    (set! *dark-forest* #f)
)
(when
    (and
        (= weather-dark-mode #t)
        (not *dark-forest*)
        (!= (-> (level-get-target-inside *level*) name) 'wascitya)
        (!= (-> (level-get-target-inside *level*) name) 'wascityb)
        (not in-vin-intro?)
    )
    (spawn-dark-world-forest)
)
(none)
)
