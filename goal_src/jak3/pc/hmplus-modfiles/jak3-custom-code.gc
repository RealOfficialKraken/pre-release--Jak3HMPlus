            (set! gunmod-blue-1s "O Ammo Shark"))
        (set! gunmod-blue-1s "   ?????????"))
    
    (if (task-node-closed? (game-task-node modb-disperser))
        (if gunmod-disperser
            (set! gunmod-blue-2s "< Disperser")
            (set! gunmod-blue-2s "O Disperser"))
        (set! gunmod-blue-2s "   ?????????"))
    
    (if (task-node-closed? (game-task-node modb-airstrike))
        (if gunmod-airstrike
            (set! gunmod-blue-3s "< Rocket Targeter")
            (set! gunmod-blue-3s "O Rocket Targeter"))
        (set! gunmod-blue-3s "   ?????????"))

    (if (task-node-closed? (game-task-node modd-morpher))
        (if gunmod-morpher
            (set! gunmod-dark-1s "< Multi-Burst")
            (set! gunmod-dark-1s "O Multi-Burst"))
        (set! gunmod-dark-1s "   ?????????"))
    
    (if (task-node-closed? (game-task-node modd-random))
        (if gunmod-randomshot
            (set! gunmod-dark-2s "< Random Shot")
            (set! gunmod-dark-2s "O Random Shot"))
        (set! gunmod-dark-2s "   ?????????"))
    
    (if (task-node-closed? (game-task-node modd-reaper))
        (if gunmod-reaper
            (set! gunmod-dark-3s "< Reaper")
            (set! gunmod-dark-3s "O Reaper"))
        (set! gunmod-dark-3s "   ?????????"))

    ;; gunmod option list
    
    (clear *temp-string*)
    (cat-string<-string *temp-string* "<COLOR_RED>RED:")
    (common-menu-newline! *temp-string*)
    (common-menu-newline! *temp-string*)
    (gunmod-menu-append-item! *temp-string* gunmod-red-1s (= menu-index 0) 0)
    (gunmod-menu-append-item! *temp-string* gunmod-red-2s (= menu-index 1) 1)
    (gunmod-menu-append-item! *temp-string* gunmod-red-3s (= menu-index 2) 2)
    (common-menu-newline! *temp-string*)
    (cat-string<-string *temp-string* "<COLOR_YELLOW>YELLOW:")
    (common-menu-newline! *temp-string*)
    (common-menu-newline! *temp-string*)
    (gunmod-menu-append-item! *temp-string* gunmod-yellow-1s (= menu-index 3) 3)
    (gunmod-menu-append-item! *temp-string* gunmod-yellow-2s (= menu-index 4) 4)
    (gunmod-menu-append-item! *temp-string* gunmod-yellow-3s (= menu-index 5) 5)
    (common-menu-newline! *temp-string*)
    (cat-string<-string *temp-string* "<COLOR_CYAN>BLUE:")
    (common-menu-newline! *temp-string*)
    (common-menu-newline! *temp-string*)
    (gunmod-menu-append-item! *temp-string* gunmod-blue-1s (= menu-index 6) 6)
    (gunmod-menu-append-item! *temp-string* gunmod-blue-2s (= menu-index 7) 7)
    (gunmod-menu-append-item! *temp-string* gunmod-blue-3s (= menu-index 8) 8)
    (common-menu-newline! *temp-string*)
    (cat-string<-string *temp-string* "<COLOR_PINK>DARK:")
    (common-menu-newline! *temp-string*)
    (common-menu-newline! *temp-string*)
    (gunmod-menu-append-item! *temp-string* gunmod-dark-1s (= menu-index 9) 9)
    (gunmod-menu-append-item! *temp-string* gunmod-dark-2s (= menu-index 10) 10)
    (gunmod-menu-append-item! *temp-string* gunmod-dark-3s (= menu-index 11) 11)

    (draw-mod-menu-text-custom *temp-string*
    85 90 0.325 #t #f #f)
    
    (gunmod-menu-option-hover)

    ;; gunmod description
    (draw-mod-menu-text-custom gunmod-description-title
    230 90  0.425 #t #f #f)

    (draw-mod-menu-text-custom gunmod-description
    230 110  0.325 #t #f #f)

    (none)
)
    
(defun mod-menu-controls ()
    (when (and (cpad-pressed? 0 x triangle circle square r3) in-welcome-screen?)
        *target*
        (set! in-hero-menu? #t)
        (set! in-welcome-screen? #f)
        (set! menu-index 0)
        (cpad-clear! 0 x triangle circle square r3)
        (sound-play "menu-back")
    )

    (when (cpad-pressed? 0 triangle) ;; exit
        *target*
        (when in-menu?
            (when in-gunmods?
                (set! in-gunmods? #f)
                (set! in-hero-menu? #t)
                (set! menu-index 0)
            )
            (when in-superpowers?
                (set! in-superpowers? #f)
                (set! in-hero-menu? #t)
                (set! menu-index 1)
            )
            (when in-skill?
                (set! in-skill? #f)
                (set! in-superpowers? #t)
            )
            (when in-modifiers?
                (set! in-modifiers? #f)
                (set! in-hero-menu? #t)
                (set! menu-index 2)
            )
            (when in-pets?
                (set! in-pets? #f)
                (set! in-hero-menu? #t)
                (set! menu-index 4)
            )
        )
        (when in-vin-shop?
            (cpad-clear! 0 triangle)
            (close-vin-shop!)
            (set! menu-index 0)
        )
        (when in-arena-menu?
            (set! in-arena-menu? #f)
            (lightjak-get-off-part (target-pos 0))
            (camera-unlocked)
        )
        (when in-arena-menu-info?
            (set! in-arena-menu? #t)
            (set! in-arena-menu-info? #f)
            (set! menu-index 0)
        )
        (sound-play "menu-pick")
        (cpad-clear! 0 triangle)

    )
    (when (cpad-pressed? 0 x) ;; confirm
        *target*
        (cond
        ;; main mod menu
        ((= in-hero-menu? #t)
            (set! in-hero-menu? #f)
            (case menu-index
                ((0) ;; enter gunmods menu
                    (set! in-gunmods? #t)
                    (set! menu-index 0)
                )
                ((1) ;; enter superpowers menu
                    (set! in-superpowers? #t)
                    (set! menu-index 0)
                )
                ((2) ;; enter fast travel menu
                    (set! in-modifiers? #t)
                    (set! menu-index 0)
                )
                ((3) ;; enter jak model menu
                    (set! in-jak-model? #t)
                    (set! menu-index 0)
                    (spawn-jak2-stayas)
                )
                ((4) ;; enter pets menu
                    (set! in-pets? #t)
                    (set! menu-index 0)
                    (spawn-pet-menu)
                )
            )
        )
        ((= in-gunmods? #t)
            (gunmod-menu-toggle-option!)
        )
        ((= in-superpowers? #t)
            (set! in-skill? #t)
            (set! in-superpowers? #f)
        )
        ((= in-modifiers? #t)
            (fast-travel-confirm)
        )
        ((= in-pets? #t)
            (pet-menu-toggle-pet!)
        )
        ((= in-vin-shop? #t)
            (cpad-clear! 0 x)
            (vin-shop-confirm!)
        )    
        ((= in-arena-menu? #t)
            (set! in-arena-menu? #f)
            (set! in-arena-menu-info? #f)
            (arena-select-confirm!)
        )    
        )
        (when (> menu-index-max 0)
            (sound-play "menu-pick"))
        (cpad-clear! 0 x)
    )
    (when (cpad-pressed? 0 square) ;; square
            (when in-arena-menu?
                (set! in-arena-menu? #f)
                (set! in-arena-menu-info? #t)
                (set! menu-index 0)
            
            (sound-play "menu-pick")
            (cpad-clear! 0 square)
            )
    )
    (when (and (cpad-pressed? 0 down) (> menu-index-max 0)) ;; down
            (+! menu-index 1)
            (when (> menu-index menu-index-max)
                (set! menu-index 0))
            (sound-play "menu-back")
    )
    (when (and (cpad-pressed? 0 up) (> menu-index-max 0)) ;; up
            (-! menu-index 1)
            (when (< menu-index 0)
                (set! menu-index menu-index-max))
            (sound-play "menu-back")
    )
)

(defun draw-get-gun-popup ((idx int))
    (sound-play "special-pickup")
    (case idx
        ((0)  (blank-hint! "You received the~%<COLOR_RED>Scatter Gun" 0 0))
        ((1)  (blank-hint! "You received the~%<COLOR_RED>Wave Concussor" 0 0))
        ((2)  (blank-hint! "You received the~%<COLOR_RED>Plasmite RPG" 0 0))
        ((3)  (blank-hint! "You received the~%<COLOR_YELLOW>Blaster Mod" 0 0))
        ((4)  (blank-hint! "You received the~%<COLOR_YELLOW>Beam Reflexor" 0 0))
        ((5)  (blank-hint! "You received the~%<COLOR_YELLOW>Gyro Burster" 0 0))
        ((6)  (blank-hint! "You received the~%<COLOR_CYAN>Vulcan Fury" 0 0))
        ((7)  (blank-hint! "You received the~%<COLOR_CYAN>Arc Wielder" 0 0))
        ((8)  (blank-hint! "You received the~%<COLOR_CYAN>Needle Lazer" 0 0))
        ((9)  (blank-hint! "You received the~%<COLOR_PINK>Peace Maker" 0 0))
        ((10) (blank-hint! "You received the~%<COLOR_PINK>Mass Inverter" 0 0))
        ((11) (blank-hint! "You received the~%<COLOR_PINK>Super Nova" 0 0))
    )
)

(define anim-quest 0)
(define anim-quest-i 0)
(define draw-active-quest? #f)

(defun draw-active-quest ()
    (set! draw-active-quest? #t)
    (if (< anim-quest -29)
        (set! anim-quest -30))
    (set! anim-quest-i 0)
    (none)
)


(defun runs-jak3-every-frame () ;;START RUNNING EVERY FRAME

(when ;autosave-delayed
    (and
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
        (= in-arena-fight? #f)
        (= in-menu? #f)
        (= autosave-delayed #t)
    )
        (+! auto-i 1)
        (when (= auto-i 600)
            (auto-save-user)
            (set! auto-i 0)
            (set! autosave-delayed #f)
        )
    )


(when (and
        (= camera-locked? #t)
        (= (pause-allowed?) #t)
        (= (paused?) #f)
        *target*
        (not *scene-player*)
        (not mainmenu-camera)
      )
    (set-master-mode 'game)
)

(when *scene-player*
    (when (and (= mushroom-movies-start #f)(rand-vu-percent? 0.03)(= mushroom-movies #t)
      (set! mushroom-movies-start #t)
      (set! mushroom-var (rand-vu-int-range 1 6))
    )
  )
)

(when (and (= menu-unlocked? #f) (task-node-closed? (game-task-node arena-fight-1-resolution)))
    (set! menu-unlocked? #t)
)

(when (= uni-count1 #t)
    (+! uni 1)
    (when (= uni 30)
        (set! uni 0)
        (set! uni-count1 #f)
    )
)

(when (and 
(or
(not (logtest? (-> *game-info* features) (game-feature board)))
)
)
(logior! (-> *game-info* features) (game-feature 
                                                gun
                                                board
                                                board-launch
                                                board-zap
))
)

(when
    (and
        *target*
        (not *scene-player*)
        (= (paused?) #t)
        *debug-segment*
    )
    (when (= in-picture-mode? #f)
        ; old
        #|(clear matt-str)
        (clear *pc-encoded-matt-str*)
        (format matt-str "<COLOR_RED>Press <COLOR_BLUE>X<COLOR_WHITE>+<COLOR_PINK>Square<COLOR_RED> to go into Picture mode~%<COLOR_GREEN>Triangle<COLOR_RED> to exit"
        )
        (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
        (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
        (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
        (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 255 255 0.0 (font-color white) (font-flags middle shadow kerning large))))
        (set! (-> font-ctx scale) 0.325)
        (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))|#
        
        ; new
        ;; (draw-mod-menu-text-custom "<PAD_X>+<PAD_SQUARE> Picture mode   <PAD_TRIANGLE> Exit"
        ;; 255 255 0.325 #f #t #f)
    )
    (when
        (and
            (cpad-pressed? 0 triangle)
            (= in-picture-mode? #t)
        )
        (toggle-picture-mode)
        (set-master-mode 'game)
        (process-release? *target*)
        )
    (when
        (and
            (cpad-pressed? 0 x)
            (cpad-pressed? 0 square)
        )
        (toggle-picture-mode)
    )
)


(when
  (and
    hmplus-intro-active?
    *target*
    (not *scene-player*)
    (= (paused?) #f)
    (= (pause-allowed?) #t))
    (set! (-> *setting-control* user-current music-volume) 0.0)
  (cond
    ((= hmplus-intro-phase 0)
      (disable-hudmap)
      (send-event *target* 'draw #f)
      (set! hmplus-intro-phase 1)
      (set! hmplus-intro-frame 0)
      (process-grab? *target* #t)
      (set! pause-menu-blocked? #t)
      (set! hmplus-intro-fx-started? #f))
    ((= hmplus-intro-phase 1)
      (send-event *target* 'draw #f)
      (when (= hmplus-intro-frame 1)
        (play-sound-file "snd/made-by-kraken.wav" 30))
      (when (and (not hmplus-intro-fx-started?) (< hmplus-intro-frame 90))
        (set! hmplus-intro-fx-started? #t)
        (set! (-> *display* force-sync) (the-as uint 215))
        (persist-with-delay *setting-control* 'blur-a (seconds 4.4) 'blur-a 'abs 0.9 0)
        (sound-play "trans3"))
      (if (< hmplus-intro-frame 150)
          (let ((cam-pos (new 'stack 'vector))
                (tpos    (new 'stack 'vector))
                (j1 0.0)
                (j2 0.0)
                (j3 0.0)
                (falloff 1.0))
            (vector-copy! cam-pos hmplus-intro-cam-pos)
            (vector-copy! tpos hmplus-intro-target-pos)
            (set! falloff (- 1.0 (/ (the float hmplus-intro-frame) 150.0)))
            (set! j1 (* falloff (rand-vu-float-range -12.0 12.0)))
            (set! j2 (* falloff (rand-vu-float-range -6.0 6.0)))
            (set! j3 (* falloff (rand-vu-float-range -18.0 18.0)))
            (+! (-> cam-pos x) (meters (* 0.08 j3)))
            (+! (-> cam-pos y) (meters (* 0.05 j2)))
            (+! (-> cam-pos z) (meters (* 0.08 j1)))
            (+! (-> tpos x) (meters (* 0.20 j1)))
            (+! (-> tpos y) (meters (* 0.30 j3)))
            (+! (-> tpos z) (meters (* 0.20 j2)))
            (turn-to-scene-camera cam-pos tpos #f))
          (turn-to-scene-camera hmplus-intro-cam-pos hmplus-intro-target-pos #f))
      (when (and (>= hmplus-intro-frame 30) (< hmplus-intro-frame 470))
        (let ((draw-x 255.0)
              (draw-y 180.0)
              (text-scale 0.46)
              (spiral-start 30)
              (spiral-end 280)
              (midpoint 155)
              (spiral-frame 0)
              (spiral-len 0.0)
              (t 0.0)
              (t2 0.0)
              (radius-y 0.0)
              (angle 0.0)
              (chaos 0.0)
              (jx 0.0)
              (jy 0.0)
              (js 0.0))
          (set! spiral-frame (- hmplus-intro-frame spiral-start))
          (set! spiral-len (the float (- spiral-end spiral-start)))
          (if (< hmplus-intro-frame spiral-end)
              (begin
                (set! t (/ (the float spiral-frame) spiral-len))
                (if (< hmplus-intro-frame midpoint)
                    (begin
                      (set! t2 (/ (the float (- hmplus-intro-frame spiral-start))
                                  (the float (- midpoint spiral-start))))
                      (set! radius-y (* (- 1.0 t2) 300.0))
                      (set! angle (* t2 10.995574))
                      (set! jx (* t2 (rand-vu-float-range -18.0 18.0)))
                      (set! jy (* t2 (rand-vu-float-range -28.0 28.0)))
                      (set! js (* t2 (rand-vu-float-range -0.04 0.04)))
                      (set! draw-x (+ 255.0
                                      (* 18.0 (sin angle))
                                      jx))
                      (set! draw-y (+ 180.0
                                      radius-y
                                      (* 16.0 (cos angle))
                                      jy))
                      (set! text-scale (+ 0.46
                                          (* (- 1.0 t2) 0.32)
                                          js)))
                    (begin
                      (set! t2 (/ (the float (- hmplus-intro-frame midpoint))
                                  (the float (- spiral-end midpoint))))
                      (set! chaos (+ 0.15 (* t2 t2 1.35)))
                      (set! angle (+ 10.995574
                                     (* t2 75.39822)))
                      (set! jx (* chaos (rand-vu-float-range -55.0 55.0)))
                      (set! jy (* chaos (rand-vu-float-range -85.0 85.0)))
                      (set! js (* chaos (rand-vu-float-range -0.12 0.12)))
                      (set! draw-x (+ 255.0
                                      (* 26.0 (sin angle))
                                      jx))
                      (set! draw-y (+ 180.0
                                      (* 24.0 (cos angle))
                                      jy))
                      (set! text-scale (+ 0.46
                                          (* chaos 0.10)
                                          js))))
                (when (< text-scale 0.38)
                  (set! text-scale 0.38))
                (when (> text-scale 1.10)
                  (set! text-scale 1.10)))
              (begin
                (set! draw-x 255.0)
                (set! draw-y 180.0)
                (set! text-scale 0.46)))
          (clear matt-str)
          (clear *pc-encoded-matt-str*)
          (format matt-str "<COLOR_ORANGE>Made by <COLOR_CYAN>Kraken")
          (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
          (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf))
                                       (bucket-id debug-no-zbuf1))
            (dma-buffer-add-gs-set-flusha buf
              (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
              (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
            (let ((font-ctx
                    (new 'stack 'font-context
                      *font-default-matrix*
                      (the int draw-x)
                      (the int draw-y)
                      0.0
                      (font-color white)
                      (font-flags middle shadow kerning large))))
              (set! (-> font-ctx scale) text-scale)
              (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))))
      (+! hmplus-intro-frame 1)
        (when (and (not hmplus-intro-fading?) (>= hmplus-intro-frame 446))
        (set! hmplus-intro-fading? #t)
        (set! hmplus-intro-fade-start (current-time)))

        (when hmplus-intro-fading?
        (hmplus-black-fade hmplus-intro-fade-start))

        (when (>= hmplus-intro-frame 470)
        (set! hmplus-intro-phase 2)
        (set! hmplus-intro-frame 0)
        (set! hmplus-intro-fading? #f)))
    ((= hmplus-intro-phase 2)
      (camera-unlocked)
      (send-event *target* 'draw #t)
      (enable-hudmap)
      (set! hmplus-intro-active? #f)
      (set! hmplus-intro-phase 0)
      (set! hmplus-intro-frame 0)
      (set! hmplus-intro-fx-started? #f)
      (process-release? *target*)
      (set! pause-menu-blocked? #f)
      (launch-mmenu)
      )
    )
)


(when 
(and
*target*
(not *scene-player*)
(= (paused?) #f)
(= (pause-allowed?) #t)
(= short-delay #t)
)
    (+! delay-i 1)
    (when (= delay-i 30)
        (enable-hudmap)
        (delayed-play-continue stored-string)
    )
)


;make vin quest close after completing artifact race 1
(when
    (and
        (task-node-closed? (game-task-node desert-artifact-race-1-introduction))
        (or
            (task-node-open? (game-task-node desert-vin-quest-introduction))
            (task-node-open? (game-task-node desert-vin-quest-resolution))
        )
        (task-node-close! (game-task-node desert-vin-quest-resolution) #t)
    )
)

(when
    (and
        (task-node-open? (game-task-node arena-training-1-collect))
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
        (= asked-jak-if-jak2? #f)
    )
    (set! asked-jak-if-jak2? #t)
    (spawn-jak2-stayas)
)

(when (= mm-hint-1 #t)
    (+! mm-hint-1i 1)
    (when (not *scene-player*)
        (set! mm-hint-1 #f)
        (set! mm-hint-1i 0)
    )
    (draw-mod-menu-text-custom "Press <PAD_CIRCLE> to toggle Mushroom Movies"
    255 75 0.525 #f #t #f)

    (when (= mm-hint-1i 500)
        (set! mm-hint-1i 0)
        (set! mm-hint-1 #f)
    )
)

(when
    (and
        *scene-player*
        (cpad-pressed? 0 circle)
    )
    (cond
        ((= mushroom-movies #t)
            (set! mushroom-movies #f)
        )
        (else
            (set! mushroom-movies #t)
        )
    )
    (set! mm-hint #t)
    (set! mm-hinti 0)
)

(when
    (and
        *scene-player*
        (= mm-hint #t)
    )
    (+! mm-hinti 1)
    (when (= mm-hint-1 #t)
        (set! mm-hint-1i 0)
        (set! mm-hint-1 #f)
    )
    (when (or
            (and (> mm-hinti 0) (< mm-hinti 50))
            (and (> mm-hinti 55) (< mm-hinti 105))
          )
        (cond
            ((= mushroom-movies #t)
                (draw-mod-menu-text-custom "Mushroom Movies Enabled"
                255 75 0.425 #f #t #f)
            )
            (else
                (draw-mod-menu-text-custom "Mushroom Movies Disabled"
                255 75 0.425 #f #t #f)
            )
        )
    )
    (when (>= mm-hinti 105)
        (set! mm-hinti 0)
        (set! mm-hint #f)
    )
)

(when
    (and
        (not *scene-player*)
        (or
            (= mm-hint #t)
            (> mm-hinti 0)
        )
    )
    (set! mm-hint #f)
    (set! mm-hinti 0)
)

(when 
    (and
        (not (task-node-closed? (game-task-node factory-boss-resolution)))
        (task-node-closed? (game-task-node factory-boss-introduction))
        (!= (-> (level-get-target-inside *level*) name) 'lfacrm2)
        (!= (-> (level-get-target-inside *level*) name) 'factoryd)
    )
    (task-node-open! (game-task-node factory-assault-resolution) #t)
)

(when 
    (and
        (= in-tutorial? #t)
        (= tutorial-msg 0)
        *target*
        (not *scene-player*)
    )
        (+! tutorial-freeze 1)
        (when (= tutorial-freeze 1)
            (process-grab? *target* #f)
            (set! r3-noto #t)
            (set! anim-noto -30)
            (set! notoi 0)
        )
        (when (and (>= tutorial-freeze 20) (< tutorial-freeze 700))
