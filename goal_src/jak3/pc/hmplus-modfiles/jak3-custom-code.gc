    (and
        (not *scene-player*)
        (= (paused?) #f)
        (= (pause-allowed?) #t)
        *target*
        (= in-desertf-anchor? #t)
        (= anchor-cooldown #f)
        (task-node-closed? (game-task-node temple-climb-introduction))
        (= anchor-day? #t)
        (not (task-node-open? (game-task-node desertf-anchor-resolution)))
    )
        (task-node-open! (game-task-node desertf-anchor-resolution) #t)
)
(when 
