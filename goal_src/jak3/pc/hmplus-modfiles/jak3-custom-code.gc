        (set! load-i 0)
        (set! load-delay-1 #f)
        (set! xp-draw-override #f)
    )
    )




;; dialogue box
(when (and
    in-dialogue?
    (not (paused?))
    )
    ;; draw dialogue box
    (with-dma-buffer-add-bucket ((s2-0 (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id particles))
        ;; background border
        (draw-sprite2d-xy s2-0  20 290 (- 512 40) 88 (static-rgba 0 0 0 64) #x3fffff)
        ;; background
        (draw-sprite2d-xy s2-0  22 292 (- 512 44) 84 (static-rgba 255 255 255 8) #x3fffff)
    )
    
    (when (= log-sec 1)
         (set! dialogue-select 0)
    )
    (when (cpad-pressed? 0 x)
        ;; (+! log-sec 1)
        (sound-play "menu-pick")
    )
    (cond ((not dialogue-choice)
        (clear *temp-string*)
        (format *temp-string* "<COLOR_WHITE>~S~%~S~%~S~%~S~%~%"
        di-s1
        di-s2
        di-s3
        di-s4
        )
        (draw-mod-menu-text-custom *temp-string*
        256 300 0.325 #f #t #f)
        (draw-mod-menu-text-preset 1 "<PAD_X> Next")
        )
        (else
            (clear *temp-string*)
            (cond 
                ((= choice-given? #t)
                    ;: draw dialogue choice box
                    (with-dma-buffer-add-bucket ((s2-0 (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id particles))
                        ;; background border
                        (draw-sprite2d-xy s2-0 230 200 262 78 (static-rgba 0 0 0 64) #x3fffff)
                        ;; background
                        (draw-sprite2d-xy s2-0 232 202 258 74 (static-rgba 255 255 255 8) #x3fffff)
                    )
                    (format *temp-string* "<COLOR_WHITE>~S~%~S~%~S~%~S~%~%"
                    di-s1
                    di-s2
                    di-s3
                    di-s4
                    )
                    (draw-mod-menu-text-preset 1 "<PAD_X> Confirm   <PAD_TRIANGLE> Exit")
                )
                (else
                    (format *temp-string* "<COLOR_WHITE>~S~%~S~%~S~%~S~%~%"
                    di-s1
                    di-s2
                    di-s3
                    di-s4
                    )
                    (draw-mod-menu-text-preset 1 "<PAD_X> Next   <PAD_TRIANGLE> Exit")
                )
            )
            (draw-mod-menu-text-custom *temp-string* 
            256 300 0.325 #f #t #f)
    
            (when (and in-vin-shop? (< (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 3))
                (when (cpad-pressed? 0 triangle)
                    (close-vin-shop!)
                    (sound-play "menu-pick")
                    (cpad-clear! 0 triangle)
                )
            )

            (when (= choice-given? #t)
                (when (cpad-pressed? 0 up)
                    (cond
                        ((> dialogue-select 0)
                            (-! dialogue-select 1)
                        )
                        (else
                            (set! dialogue-select choice-max)
                        )
                    )
                    (sound-play "menu-back")
                )
                (when (cpad-pressed? 0 down)
                    (cond
                        ((and (< dialogue-select 3) (< dialogue-select choice-max))
                            (+! dialogue-select 1)
                        )
                        (else
                            (set! dialogue-select 0)
                        )
                    )
                    (sound-play "menu-back")
                )

                (clear *temp-string*)
                (cond
                    ((= dialogue-select 0)
                        (format *temp-string* "<COLOR_YELLOW>~S~%~%<COLOR_MENU-PARENT>~S~%~%~S~%~%~S"
                        di-c1
                        di-c2
                        di-c3
                        di-c4
                        )
                    )
                    ((= dialogue-select 1)
                        (format *temp-string* "<COLOR_MENU-PARENT>~S~%~%<COLOR_YELLOW>~S<COLOR_MENU-PARENT>~%~%~S~%~%~S"
                        di-c1
                        di-c2
                        di-c3
                        di-c4
                        )
                    )
                    ((= dialogue-select 2)
                        (format *temp-string* "<COLOR_MENU-PARENT>~S~%~%~S~%~%<COLOR_YELLOW>~S<COLOR_MENU-PARENT>~%~%~S"
                        di-c1
                        di-c2
                        di-c3
                        di-c4
                        )
                    )
                    ((= dialogue-select 3)
                        (format *temp-string* "<COLOR_MENU-PARENT>~S~%~%~S~%~%~S~%~%<COLOR_YELLOW>~S"
                        di-c1
                        di-c2
                        di-c3
                        di-c4
                        )
                    )
                )
                (draw-mod-menu-text-custom *temp-string*
                482 215 0.225 #f #f #t)
            )
        )
    )
)

