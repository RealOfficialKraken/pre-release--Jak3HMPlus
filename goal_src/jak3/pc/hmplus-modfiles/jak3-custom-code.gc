            (task-node-open? (game-task-node sewer-met-hum-introduction))
            (task-node-open? (game-task-node sewer-met-hum-resolution))
        )
        (<= 
            (vector-vector-distance
                (target-pos 0)
                (new 'static 'vector :x (meters -89.4857) :y (meters 8.8766) :z (meters 1302.3831) :w 1.0)
            )
            (meters 20)
        )
    )
    (task-node-close! (game-task-node sewer-met-hum-resolution) #t)
    (process-spawn
    scene-player
    :init scene-player-init
    "city-port-fight-intro"
    #t
    "ctyport-hiphog"
    :name "scene-player"
    )
)

(when
    (and
        *target*
        (not *scene-player*)
        (= in-disclaimer? #t)
        (= (pause-allowed?) #t)
    )
    (cond
        ((= (paused?) #f)
            (let ((vec1 (new-stack-vector0))
                (vec2 (new-stack-vector0))
                )
                (set! (-> vec1 y) (meters -100))
                (set! (-> vec1 x) (-> (target-pos 0) x))
                (set! (-> vec1 z) (-> (target-pos 0) z))
                (set! (-> vec1 w) 1.0)
                (set! (-> vec2 y) (meters -50))
                (set! (-> vec2 x) (-> (target-pos 0) x))
                (set! (-> vec2 z) (-> (target-pos 0) z))
                (set! (-> vec2 w) 1.0)
                (disable-hudmap)
                (turn-to-scene-camera vec2 vec1 #t)
                (when (not launch-mmenu-delay)
                    (draw-mod-menu-text-custom "<COLOR_ORANGE>Disclaimer"
                    256 50 0.625 #f #t #f)

                    (clear *temp-string*)
                    (format *temp-string* 
"<COLOR_WHITE>Welcome to HeroMode+ v~s <COLOR_CYAN>PRE-RELEASE!~%~%

<COLOR_WHITE>Let it be known that this mod is difficult.~%
The average casual Jak 3 player will have a rough time.~%
If you're still up for it, I hope you have fun!~%

<COLOR_RED>Many features are dependent on framerate being 60.~%
You should NOT change your framerate for the time being.~%

<COLOR_RED>EXPECT CRASHES"
                    mod-version
                    )
                    (draw-mod-menu-text-custom *temp-string*
                    256 80 0.325 #f #t #f)
                    (draw-mod-menu-text-preset 1 "<PAD_X> Continue")
                )
            )
            (when (or (cpad-pressed? 0 x) (cpad-pressed? 0 confirm))
                (set! launch-mmenu-delay #t)
                (set! lmmi 0)
            )
        )
        (else
            (set-master-mode 'game) ;hack to not be able to pause during disclaimer
        )
    )
)

(when 
    (and
        (= launch-mmenu-delay #t)
        *target*
        (not *scene-player*)
