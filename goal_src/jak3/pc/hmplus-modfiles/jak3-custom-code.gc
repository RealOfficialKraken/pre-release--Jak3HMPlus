  (defun drop-crate ((vec vector) (tier int))
  (let ((fact (new 'static 'fact-info))
        (tier-name "none"))
    (cond
      ((= tier 1)
        (set! tier-name "crate-tier1"))
      ((= tier 2)
        (set! tier-name "crate-tier2"))
      ((= tier 3)
        (set! tier-name "crate-tier3"))
      ((= tier 99)
        (set! tier-name "prebot-crate"))
      (else
        (set! tier-name "crate-tier1")))

    (set! (-> fact pickup-type) (the-as pickup-type #f))
    (set! (-> fact pickup-amount) 0.0)
    (when (and
            (not in-arena-fight?)
            (!= (-> (level-get-target-inside *level*) name) 'wasstada)
            (!= (-> (level-get-target-inside *level*) name) 'wasstadb)
            (!= (-> (level-get-target-inside *level*) name) 'wasstadc)
          )
        (set! (-> fact options) (actor-option fall))
    )

    (cond
      ((= tier 1)
        (process-spawn crate (the-as entity #f) vec 'urn-a fact :name tier-name *entity-pool*))
      ((= tier 2)
        (process-spawn crate (the-as entity #f) vec 'wood fact :name tier-name *entity-pool*))
      ((= tier 3)
        (process-spawn crate (the-as entity #f) vec 'metal fact :name tier-name *entity-pool*))
      ((= tier 99)
        (process-spawn crate (the-as entity #f) vec 'metal fact :name tier-name *entity-pool*))
      (else
        (process-spawn crate (the-as entity #f) vec 'urn-a fact :name tier-name *entity-pool*))))
  (none))

  (defun birth-drop1 ((vec vector))
    (let ((fact (new 'static 'fact-info))
          (rnd (rand-vu-int-range 1 5))
          (rnd-count-gem (rand-vu-int-range 1 3))
          )
        (when (rand-vu-percent? 0.00000073)
            (set! rnd 6)
        )
        (set! (-> fact options) (actor-option blocked))
        (cond
         ((= rnd 1)
            (set! (-> fact pickup-type) (pickup-type gem))
            (set! (-> fact pickup-amount) (the float rnd-count-gem))
            (set! (-> fact options) (actor-option auto-pickup suck-in))
         )
         ((= rnd 2)
            (set! (-> fact pickup-type) (pickup-type ammo-yellow))
            (set! (-> fact pickup-amount) 30.0)
         )
         ((= rnd 3)
            (set! (-> fact pickup-type) (pickup-type ammo-red))
            (set! (-> fact pickup-amount) 30.0)
         )
         ((= rnd 4)
            (cond 
                ((or
                    (logtest? (-> *game-info* features) (game-feature gun-blue-1))
                    (logtest? (-> *game-info* features) (game-feature gun-blue-2))
                    (logtest? (-> *game-info* features) (game-feature gun-blue-3))
                )
                    (set! (-> fact pickup-type) (pickup-type ammo-blue))
                )
                (else
                    (set! (-> fact pickup-type) (pickup-type ammo-yellow))
                )
            )
            (set! (-> fact pickup-amount) 50.0)
         )
         ((= rnd 5)
            (if (or
                    (logtest? (-> *game-info* features) (game-feature gun-dark-1))
                    (logtest? (-> *game-info* features) (game-feature gun-dark-2))
                    (logtest? (-> *game-info* features) (game-feature gun-dark-3))
                )
                (set! (-> fact pickup-type) (pickup-type ammo-dark))
                (set! (-> fact pickup-type) (pickup-type ammo-red))
            )
            (set! (-> fact pickup-amount) 10.0)
         )
         ((= rnd 6)
            (set! (-> fact pickup-type) (pickup-type gun-yellow-1))
            (set! (-> fact pickup-amount) 30.0)
         )
        )
        (birth-pickup-at-point vec (-> fact pickup-type) (-> fact pickup-amount) #t *entity-pool* fact)
    )
    (none)
  )

  (defun birth-drop2 ((vec vector))
    (let ((fact (new 'static 'fact-info))
          (rnd (rand-vu-int-range 1 5))
          (rnd-count-gem (rand-vu-int-range 3 7))
          (rnd-crystal (rand-vu-int-range 1 1))
          (rnd-lvl 0.0)
          )
        (when (rand-vu-percent? 0.02)
            (set! rnd 6)
        )
        (when (rand-vu-percent? 0.0025)
            (set! rnd 7)
        )
        (when (>= notoriety-level 35)
            (set! rnd-lvl 0.0007)
        )
        (when (>= notoriety-level 45)
            (set! rnd-lvl 0.0008)
        )
        (when (>= notoriety-level 55)
            (set! rnd-lvl 0.0009)
        )
        (when (>= notoriety-level 65)
            (set! rnd-lvl 0.001)
        )
        (when (rand-vu-percent? rnd-lvl)
            (set! rnd 8)
        )
        (set! (-> fact options) (actor-option blocked))
        (cond
         ((= rnd 1)
            (set! (-> fact pickup-type) (pickup-type ammo-red))
            (set! (-> fact pickup-amount) 150.0)
         )
         ((= rnd 2)
            (cond 
                ((or
                    (logtest? (-> *game-info* features) (game-feature gun-blue-1))
                    (logtest? (-> *game-info* features) (game-feature gun-blue-2))
                    (logtest? (-> *game-info* features) (game-feature gun-blue-3))
                )
                    (set! (-> fact pickup-type) (pickup-type ammo-blue))
                )
                (else
                    (set! (-> fact pickup-type) (pickup-type ammo-yellow))
                )
            )
            (set! (-> fact pickup-amount) 120.0)
         )
         ((= rnd 3)
            (cond 
                ((or
                    (logtest? (-> *game-info* features) (game-feature gun-dark-1))
                    (logtest? (-> *game-info* features) (game-feature gun-dark-2))
                    (logtest? (-> *game-info* features) (game-feature gun-dark-3))
                )
                    (set! (-> fact pickup-type) (pickup-type ammo-dark))
                )
                (else
                    (set! (-> fact pickup-type) (pickup-type ammo-yellow))
                )
            )
            (set! (-> fact pickup-amount) 50.0)
         )
         ((= rnd 4)
            (set! (-> fact pickup-type) (pickup-type gem))
            (set! (-> fact pickup-amount) (the float rnd-count-gem))
            (set! (-> fact options) (actor-option auto-pickup suck-in))
         )
         ((= rnd 5)
            (set! (-> fact pickup-type) (pickup-type eco-pill-dark))
            (set! (-> fact pickup-amount) 64.0)
            (set! (-> fact options) (actor-option auto-pickup suck-in))
         )
         ((= rnd 6)
            (set! (-> fact pickup-type) (pickup-type eco-crystal-dark-c))
            (set! (-> fact pickup-amount) (the float rnd-crystal))
         )
         ((= rnd 7)
            (set! (-> fact pickup-type) (pickup-type gun-yellow-1))
            (set! (-> fact pickup-amount) 1.0)
         )
         ((= rnd 8)
            (set! (-> fact pickup-type) (pickup-type gun-mod-upgrade))
         )
        )
        (birth-pickup-at-point vec (-> fact pickup-type) (-> fact pickup-amount) #t *entity-pool* fact)
    )
    (none)
  )

  (defun birth-drop3 ((vec vector))
    (let ((fact (new 'static 'fact-info))
          (rnd (rand-vu-int-range 1 2))
          (rnd-crystal (rand-vu-int-range 3 20))
          (rnd-count-gem (rand-vu-int-range 8 15))
          (rnd-lvl 0.0)
          )
        (when (rand-vu-percent? 0.022)
            (set! rnd 3)
        )
        (when (>= notoriety-level 35)
            (set! rnd-lvl 0.0012)
        )
        (when (>= notoriety-level 45)
            (set! rnd-lvl 0.0008)
        )
        (when (>= notoriety-level 55)
            (set! rnd-lvl 0.0009)
        )
        (when (>= notoriety-level 65)
            (set! rnd-lvl 0.001)
        )
        (when (rand-vu-percent? rnd-lvl)
            (set! rnd 4)
        )
        (set! (-> fact options) (actor-option blocked))
        (cond
         ((= rnd 1)
            (cond 
                ((>= enemy-noto 18)
                    (set! (-> fact pickup-type) (pickup-type eco-crystal-dark-c))
                    (set! (-> fact pickup-amount) (the float rnd-crystal))
                )
                (else
                    (cond 
                        ((or
                            (logtest? (-> *game-info* features) (game-feature gun-blue-1))
                            (logtest? (-> *game-info* features) (game-feature gun-blue-2))
                            (logtest? (-> *game-info* features) (game-feature gun-blue-3))
                        )
                            (set! (-> fact pickup-type) (pickup-type ammo-blue))
                        )
                        (else
                            (if (rand-vu-percent? 0.5)
                                (set! (-> fact pickup-type) (pickup-type ammo-yellow))
                                (set! (-> fact pickup-type) (pickup-type ammo-red))
                            )
                        )
                    )
                    (set! (-> fact pickup-amount) 30.0)
                )
            )
         )
         ((= rnd 2)
            (set! (-> fact pickup-type) (pickup-type gem))
            (set! (-> fact pickup-amount) (the float rnd-count-gem))
            (set! (-> fact options) (actor-option auto-pickup suck-in))
         )
         ((= rnd 3)
            (cond
                ((and
                    (logtest? (-> *game-info* features) (game-feature gun-red-1))
                    (logtest? (-> *game-info* features) (game-feature gun-red-2))
                    (logtest? (-> *game-info* features) (game-feature gun-red-3))
                    (logtest? (-> *game-info* features) (game-feature gun-yellow-1))
                    (logtest? (-> *game-info* features) (game-feature gun-yellow-2))
                    (logtest? (-> *game-info* features) (game-feature gun-yellow-3))
                    (logtest? (-> *game-info* features) (game-feature gun-blue-1))
                    (logtest? (-> *game-info* features) (game-feature gun-blue-2))
                    (logtest? (-> *game-info* features) (game-feature gun-blue-3))
                )
                    (if (rand-vu-percent? 0.2)
                        (set! (-> fact pickup-type) (pickup-type gun-mod-upgrade))
                        (set! (-> fact pickup-type) (pickup-type eco-crystal-dark-c))
                    )
                )
                (else
                    (set! (-> fact pickup-type) (pickup-type gun-yellow-1))
                )
            )
            (set! (-> fact pickup-amount) 1.0)
         )
         ((= rnd 4)
            (set! (-> fact pickup-type) (pickup-type gun-mod-upgrade))
         )
        )
        (birth-pickup-at-point vec (-> fact pickup-type) (-> fact pickup-amount) #t *entity-pool* fact)
    )
    (none)
  )

  (defun birth-drop-rage ((vec vector))
    (spawn-gun-upgrade vec 1.0)
    (none)
  )

  (defun spawn-pet-pickup ((pos vector) (pickup pickup-type))
  (let ((fact (new 'static 'fact-info)))
    (set! (-> fact pickup-type) pickup)
    (set! (-> fact pickup-amount) 1.0)
    (set! (-> fact pickup-spawn-amount) 1.0)
    (set! (-> fact options) (actor-option dont-override-fact))
    (birth-pickup-at-point
      pos
      pickup
      1.0
      #t
      *entity-pool*
      fact))
  (none))

  (defun group-drop! ((arg1 vector) (tier2-chance float) (tier3-chance float) (pet-chance float))
  (let ((vec (new-stack-vector0)))

    (vector-copy! vec arg1)
    (drop-loot-crate! vec tier2-chance tier3-chance pet-chance)

    (+! (-> vec x) (meters 3))
    (drop-loot-crate! vec tier2-chance tier3-chance pet-chance)

    (+! (-> vec x) (meters 3))
    (drop-loot-crate! vec tier2-chance tier3-chance pet-chance)

    (+! (-> vec x) (meters 3))
    (drop-loot-crate! vec tier2-chance tier3-chance pet-chance)

    (+! (-> vec x) (meters 3))
    (drop-loot-crate! vec tier2-chance tier3-chance pet-chance)

    (when (>= notoriety-level 35)
      (vector-copy! vec arg1)
      (+! (-> vec z) (meters 3))
      (+! (-> vec x) (meters -3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 35)
      (+! (-> vec x) (meters -3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 45)
      (+! (-> vec x) (meters -3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 45)
      (+! (-> vec x) (meters -3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 60)
      (+! (-> vec x) (meters -3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 60)
      (+! (-> vec x) (meters -3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    ;; third row / back toward center
    (when (>= notoriety-level 60)
      (+! (-> vec z) (meters 3))
      (+! (-> vec x) (meters 3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 75)
      (+! (-> vec x) (meters 3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 75)
      (+! (-> vec x) (meters 3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 75)
      (+! (-> vec x) (meters 3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 100)
      (+! (-> vec x) (meters 3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 100)
      (+! (-> vec x) (meters 3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance))

    (when (>= notoriety-level 100)
      (+! (-> vec x) (meters 3))
      (drop-loot-crate! vec tier2-chance tier3-chance pet-chance)))

  (none))
  
  (defun hmplus-pet-owned? ((pickup pickup-type))
  (case pickup
    (((pickup-type pet-flitter))
      (task-node-closed? (game-task-node pet-flitter)))
    (((pickup-type pet-spiky-frog))
      (task-node-closed? (game-task-node pet-spiky-frog)))
    (((pickup-type pet-rat))
      (task-node-closed? (game-task-node pet-rat)))
    (((pickup-type pet-manta))
      (task-node-closed? (game-task-node pet-manta)))
    (((pickup-type pet-neo-wasp))
      (task-node-closed? (game-task-node pet-neo-wasp)))
    (((pickup-type pet-kangarat))
      (task-node-closed? (game-task-node pet-kangarat)))
    (((pickup-type pet-mantis))
      (task-node-closed? (game-task-node pet-mantis)))
    (((pickup-type pet-terra))
      (task-node-closed? (game-task-node pet-terra)))
    (((pickup-type pet-scouter))
      (task-node-closed? (game-task-node pet-scouter)))
    (((pickup-type pet-dogat))
      (task-node-closed? (game-task-node pet-dogat)))
    (else
      #t)))

(defun hmplus-unowned-pet-count ()
  (let ((count 0))
    (when (not (task-node-closed? (game-task-node pet-flitter)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node pet-spiky-frog)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node pet-rat)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node pet-manta)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node pet-neo-wasp)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node pet-kangarat)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node pet-mantis)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node pet-terra)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node pet-scouter)))
      (+! count 1))
    (when (not (task-node-closed? (game-task-node pet-dogat)))
      (+! count 1))
    count))

(defun hmplus-nth-unowned-pet ((idx int))
  (let ((i 0)
        (done #f)
        (result (pickup-type none)))

    (when (and (not done) (not (task-node-closed? (game-task-node pet-flitter))))
      (if (= i idx)
        (begin
          (set! result (pickup-type pet-flitter))
          (set! done #t))
        (+! i 1)))

    (when (and (not done) (not (task-node-closed? (game-task-node pet-spiky-frog))))
      (if (= i idx)
        (begin
          (set! result (pickup-type pet-spiky-frog))
          (set! done #t))
        (+! i 1)))

    (when (and (not done) (not (task-node-closed? (game-task-node pet-rat))))
      (if (= i idx)
        (begin
          (set! result (pickup-type pet-rat))
          (set! done #t))
        (+! i 1)))

    (when (and (not done) (not (task-node-closed? (game-task-node pet-manta))))
      (if (= i idx)
        (begin
          (set! result (pickup-type pet-manta))
          (set! done #t))
        (+! i 1)))

    (when (and (not done) (not (task-node-closed? (game-task-node pet-neo-wasp))))
      (if (= i idx)
        (begin
          (set! result (pickup-type pet-neo-wasp))
          (set! done #t))
        (+! i 1)))

    (when (and (not done) (not (task-node-closed? (game-task-node pet-kangarat))))
      (if (= i idx)
        (begin
          (set! result (pickup-type pet-kangarat))
          (set! done #t))
        (+! i 1)))

    (when (and (not done) (not (task-node-closed? (game-task-node pet-mantis))))
      (if (= i idx)
        (begin
          (set! result (pickup-type pet-mantis))
          (set! done #t))
        (+! i 1)))

    (when (and (not done) (not (task-node-closed? (game-task-node pet-terra))))
      (if (= i idx)
        (begin
          (set! result (pickup-type pet-terra))
          (set! done #t))
        (+! i 1)))

    (when (and (not done) (not (task-node-closed? (game-task-node pet-scouter))))
      (if (= i idx)
        (begin
          (set! result (pickup-type pet-scouter))
          (set! done #t))
        (+! i 1)))

    (when (and (not done) (not (task-node-closed? (game-task-node pet-dogat))))
      (if (= i idx)
        (begin
          (set! result (pickup-type pet-dogat))
          (set! done #t))
        (+! i 1)))

    result))

(defun hmplus-pet-crate-name ((pickup pickup-type))
  (case pickup
    (((pickup-type pet-flitter)) "crate-flitter")
    (((pickup-type pet-spiky-frog)) "crate-spiky-frog")
    (((pickup-type pet-rat)) "crate-rat")
    (((pickup-type pet-manta)) "crate-manta")
    (((pickup-type pet-neo-wasp)) "crate-neo-wasp")
    (((pickup-type pet-kangarat)) "crate-kangarat")
    (((pickup-type pet-mantis)) "crate-mantis")
    (((pickup-type pet-terra)) "crate-terra")
    (((pickup-type pet-scouter)) "crate-scouter")
    (((pickup-type pet-dogat)) "crate-dogat")
    (else "crate-flitter")))

(defun drop-pet-crate ((vec vector) (pickup pickup-type))
  (let ((fact (new 'static 'fact-info)))
    (set! (-> fact pickup-type) (the-as pickup-type #f))
    (set! (-> fact pickup-amount) 0.0)

    (when (and
            (not in-arena-fight?)
            (!= (-> (level-get-target-inside *level*) name) 'wasstada)
            (!= (-> (level-get-target-inside *level*) name) 'wasstadb)
            (!= (-> (level-get-target-inside *level*) name) 'wasstadc))
      (set! (-> fact options) (actor-option fall)))

    (process-spawn
      crate
      (the-as entity #f)
      vec
      'metal
      fact
      :name (hmplus-pet-crate-name pickup)
      *entity-pool*))
  (none))

(defun spawn-pet-or-crystal-pickup ((pos vector) (pickup pickup-type))
  (if (hmplus-pet-owned? pickup)
    (let ((fact (new 'static 'fact-info))
          (rnd-crystal (rand-vu-int-range 3 20)))
      (set! (-> fact pickup-type) (pickup-type eco-crystal-dark-c))
      (set! (-> fact pickup-amount) (the float rnd-crystal))
      (set! (-> fact pickup-spawn-amount) (the float rnd-crystal))
      (set! (-> fact options) (actor-option dont-override-fact))
      (birth-pickup-at-point
        pos
        (-> fact pickup-type)
        (-> fact pickup-amount)
        #t
        *entity-pool*
        fact))
    (spawn-pet-pickup pos pickup))
  (none))

  (defun drop-loot-crate! ((vec vector) (tier2-chance float) (tier3-chance float) (pet-chance float))
  (let ((rnd 1)
        (pet-count 0)
        (pet-pick 0)
        (pet-pickup (pickup-type pet-flitter)))

    (set! pet-count (hmplus-unowned-pet-count))

    (if (and
          (> pet-count 0)
          (task-node-closed? (game-task-node arena-fight-1-resolution))
          (rand-vu-percent? pet-chance))
      (begin
        (set! pet-pick (rand-vu-int-count pet-count))
        (set! pet-pickup (hmplus-nth-unowned-pet pet-pick))
        (drop-pet-crate vec pet-pickup)
        (format #t "~%~%[][][][]~%Dropped Pet Crate"))
      (begin
        (when 
          (and 
            (rand-vu-percent? tier2-chance)
            (>= notoriety-level 10))
          (set! rnd 2))

        (when 
          (and 
            (rand-vu-percent? tier3-chance)
            (>= notoriety-level 18))
          (set! rnd 3))

        (drop-crate vec rnd)
        (format #t "~%~%[][][][]~%Dropped Tier ~D Crate" rnd))))

  (none))

  (defun drop-rage-crate ((vec vector))
    (let ((fact (new 'static 'fact-info))
          (tier-name "crate-rage")
          )
        (set! (-> fact pickup-type) (the-as pickup-type #f))
        (set! (-> fact pickup-amount) 0.0)
        (process-spawn crate (the-as entity #f) vec 'metal fact :name tier-name *entity-pool*)
    )
    (none)
  )

  (define in-cfreeze? #f)

  (defun freeze-enemies-in-menu! ()
    (process-spawn-function process
    :name "proc-mask-enemyfreeze"
  (lambda :behavior process ()
    (loop
      (set-setting! 'process-mask 'set 0.0 (process-mask enemy platform projectile death))
      (suspend)
      )))
    (none)
  )

  (defun toggle-freeze ()
    #|(cond
        ((= in-cfreeze? #f)
            (set! (-> *target* lightjak freeze-control) (ppointer->handle (process-spawn
                freeze-control
                :init freeze-control-init
                (-> *target* lightjak freeze-sound)
                :name "freeze-control"
                :to *target*
                )
                )
            )
            (set! in-cfreeze? #t)
        )
        ((= in-cfreeze? #t)
            (set! in-cfreeze? #f)
        )
    )|#
    (set! (-> *target* lightjak freeze-control) (ppointer->handle (process-spawn
                freeze-control
                :init freeze-control-init
                (-> *target* lightjak freeze-sound)
                :name "freeze-control"
                :to *target*
                )
                )
            )
    (none)
  )

  (defun toggle-freeze-2 ((arg1 symbol))
    (when
    (or (= arg1 'punch)
        (= arg1 'uppercut)
        (= arg1 'spin)
        (= arg1 'spin-air)
        (= arg1 'duck-spin)
        (= arg1 'dark-smack)
    )
  (when (not (handle->process (-> *target* lightjak freeze-control)))
    (set! (-> *target* lightjak freeze-control)
          (ppointer->handle
            (process-spawn
              freeze-control
              :init freeze-control-init
              (the-as sound-id #f)
              :name "freeze-control"
              :to *target*))))
  (set! *hmplus-hit-freeze-end-time* (+ (current-time) (seconds 6.0))))
    (none)
  )

  (defun dark-weather-override ()
    (set! (-> *overide-mood-fog-table* data (the-as uint (logand (-> *time-of-day-context* mode) (time-of-day-palette-id unk0 unk1 unk2))) fog-color x) 255.0)
    (set! (-> *overide-mood-fog-table*
                            data
                            (the-as uint (logand (-> *time-of-day-context* mode) (time-of-day-palette-id unk0 unk1 unk2)))
                            fog-color
                            y
                            )
                        0.0
                        )
    (set! (-> *overide-mood-fog-table*
                            data
                            (the-as uint (logand (-> *time-of-day-context* mode) (time-of-day-palette-id unk0 unk1 unk2)))
                            fog-color
                            z
                            )
