(in-package goal)

;my own shot in keeping track of the soundtrack and looping/alternating them

;name: kraken-volume.gc

(define-extern mainmenu-camera symbol)

(deftype kraken-volume (process)
((volume               int)
(paused??           symbol)
(track              string)
(volume-check-time time-frame)
)
(:state-methods 
dead
playing
)
(:methods
(kv-handler (_type_ process int symbol event-message-block) none)
)
)

(defbehavior kv-event-handler kraken-volume ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (kv-handler self arg0 arg1 arg2 arg3)
  (none)
  )

(defmethod kv-handler ((this kraken-volume) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
(case arg2
    (('change-music)
        (case (-> arg3 param 0)
            (('main)
                (play-main-music "ejfiseuf" (-> this volume))
                (play-main-music "snd/music/main-menu.wav" (-> this volume))
                (set! (-> this track) "main-menu")
            )
            (('in-game)
                (play-main-music "ejfiseuf" (-> this volume))
                (play-main-music "snd/music/dark-world-theme.wav" (-> this volume))
                (set! (-> this track) "dark-world-theme")
            )
            (('combat)
                (play-main-music "ejfiseuf" (-> this volume))
                (play-main-music "snd/music/combat.wav" (-> this volume))
                (set! (-> this track) "combat")
            )
        )
    )
    (('die)
        (go (method-of-object this dead))
    )
    (('test)
        (format #t "Got test from Kraken-Volume~%")
    )
)
(none)
)

(defstate dead (kraken-volume)
 :virtual #t
 :enter 
    (behavior ()
        (format #t "KV-1000 IN DYING STATE--STOPPING MUSIC~%")
        (when (not in-main-menu?)
            (play-main-music "ejfiseuf" (-> self volume))
            (stop-main-music)
        )
    )
 :code 
    (behavior ()
        (when
                (and
                    (= weather-dark-mode #f)
                    (= in-main-menu? #f)
                    (= (paused?) #f)
                    (= (pause-allowed?) #t)
                    *target*
                )
                (process-deactivate)
            )
    )
)

(defstate playing (kraken-volume)
 :virtual #t
 :event kv-event-handler
 :enter
    (behavior ()
        (cond
            ((= in-main-menu? #t)
                (play-main-music "snd/music/main-menu.wav" (-> self volume))
                (set! (-> self track) "main-menu")
            )
        )
    )
 :code
    (behavior ()
        (when
            (and
                *target*
                (not *scene-player*)
                (= (paused?) #f)
                (= (pause-allowed?) #t)
            )
            (loop
                (when (time-elapsed? (-> self volume-check-time) (seconds 1.0))
                (set! (-> self volume-check-time) (current-time))
                (when (!= (the int (* (-> *setting-control* user-current sfx-volume) 100)) (-> self volume))
                    (set! (-> self volume) (the int (* (-> *setting-control* user-current sfx-volume) 100)))
                    (play-main-music "ejfiseuf" (-> self volume))
                    (stop-main-music)
                    (cond
                    ((string= (-> self track) "combat")
                        (play-main-music "snd/music/combat.wav" (-> self volume)))
                    ((string= (-> self track) "dark-world-theme")
                        (play-main-music "snd/music/dark-world-theme.wav" (-> self volume)))
                    ((string= (-> self track) "alternate-darkworld")
                        (play-main-music "snd/music/alternate-darkworld.wav" (-> self volume)))
                    ((string= (-> self track) "main-menu")
                        (play-main-music "snd/music/main-menu.wav" (-> self volume)))
                    ((and
                        (= weather-dark-mode #f)
                        (= in-main-menu? #f)
                        (= (paused?) #f)
                        (= (pause-allowed?) #t)
                        *target*)
                        (play-main-music "ejfiseuf" (-> self volume))
                        (stop-main-music)))))
                (when 
                    (and
                        (or
                            (search-process-tree *active-pool* (lambda ((p process)) (type? p neo-sat)))
                        )
                        (not (string= (-> self track) "combat"))
                    )
                        (play-main-music "ejfiseuf" (-> self volume))
                        (stop-main-music)
                        (play-main-music "snd/music/combat.wav" (-> self volume))
                        (set! (-> self track) "combat")
                    )
                (when
                    (and
                        (or
                            (= (-> (level-get-target-inside *level*) name) 'wascitya)
                            (= (-> (level-get-target-inside *level*) name) 'wascityb)
                        )
                        (not (string= (-> self track) "alternate-darkworld"))
                    )
                    (play-main-music "ejfiseuf" (-> self volume))
                    (stop-main-music)
                    (play-main-music "snd/music/alternate-darkworld.wav" (-> self volume))
                    (set! (-> self track) "alternate-darkworld")
                )
                (when 
                    (and
                        (and
                            (!= (-> (level-get-target-inside *level*) name) 'wascitya)
                            (!= (-> (level-get-target-inside *level*) name) 'wascityb)
                        )
                        (not (search-process-tree *active-pool* (lambda ((p process)) (type? p neo-sat))))
                        (not (string= (-> self track) "dark-world-theme"))
                        (not (string= (-> self track) "main-menu"))
                    )
                        (play-main-music "ejfiseuf" (-> self volume))
                        (stop-main-music)
                        (play-main-music "snd/music/dark-world-theme.wav" (-> self volume))
                        (set! (-> self track) "dark-world-theme")
                    )
                (when
                    (or
                        (<= (-> *target* fact health) 0.0)
                    )
                    (and
                        (= weather-dark-mode #f)
                        (= in-main-menu? #f)
                        (= (paused?) #f)
                        (= (pause-allowed?) #t)
                        *target*
                    )
                    (play-main-music "ejfiseuf" (-> self volume))
                    (stop-main-music)
                    (go-virtual dead)
                )
                (when *debug-segment*
                    (format *stdcon* "kraken-volume~%vol: ~d~%track: ~s~%~%" (-> self volume) (-> self track))
                )
                (suspend)
            )
        )
    )
)

(defbehavior kraken-volume-init-by-other kraken-volume ((vol int))
    (stack-size-set! (-> self main-thread) 256)
    (set! (-> self volume) vol)
    (set! (-> self paused??) #f)
    (set! (-> self track) "none")
    (set! (-> self volume-check-time) (the-as time-frame 0))
    (go (method-of-object self playing))
    (none)
)

(defun start-menu-music! ()
    (set! *kv* (process-spawn kraken-volume (the int (* (-> *setting-control* user-current sfx-volume) 100)) :name "kv-1000"))
    (none)
)