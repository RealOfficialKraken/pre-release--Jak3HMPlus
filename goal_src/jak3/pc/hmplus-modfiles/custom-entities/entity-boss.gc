(in-package goal)

;;name: entity-boss.gc

(defun-extern quickspawn-eb vector (none))
(declare-type entity-boss nav-enemy)

;;MIDDLE OF TOP PLATFORM: (new 'static 'vector :x (meters 3496.7414) :y (meters 404.6769) :z (meters 880.2725) :w 1.0)

(deftype final-boss-hm (process)
  ((general-i             int)
  )
  (:state-methods
    active
    idle
    dead
  )
  (:methods
    (final-boss-hm-always (_type_) none)
  )
)

(defbehavior final-boss-hm-init-by-other final-boss-hm ()
  (set! (-> self general-i) 0)
  (go-virtual active)
  (none)
)

(defmethod final-boss-hm-always ((this final-boss-hm))
  (when 
    (and 
      *target*
      (< (-> *target* root trans y) (meters 390))
    )
    (die-jak-fall)
    (kill-by-name (-> this name) *default-pool*)
  )
  (none)
)

(defstate active (final-boss-hm)
  :virtual #t
  :code (behavior ()
    (loop
      (when (and
              weather-dark-mode
              (= (paused?) #f)
              (= (pause-allowed?) #t)
              *target*
              (not *scene-player*)
            )
        (+! (-> self general-i) 1)
        (when (>= (-> self general-i) 10)
          (let ((vec-tpos (new 'static 'vector :x (meters 3503) :y (meters 412) :z (meters 864) :w 1.0))
                (vec-cam (new 'static 'vector :x (meters 3515) :y (meters 404) :z (meters 835) :w 1.0))
              )
              (turn-to-scene-camera vec-cam vec-tpos #t)
              (when (or
                      (search-process-tree *active-pool* (lambda ((p process)) (type? p task-arrow-c)))
                      (search-process-tree *active-pool* (lambda ((p process)) (type? p task-arrow)))
                    )
                (kill-by-name "task-arrow-custom" *default-pool*)
                (kill-by-name "task-arrow" *default-pool*)
              )
          )
          (stop-main-music)
        )
      )
      (when (and 
              (= weather-dark-mode #f)
            )
        (toggle-dark-mode)
      )
      (when 
        (and 
          (or
            (>= (-> self general-i) 3000)
            (cpad-pressed? 0 x)
          )
          (>= (-> self general-i) 80)
          (= (paused?) #f)
          (= (pause-allowed?) #t)
          *target*
          (not *scene-player*)
        )
        (camera-unlocked)
        (lightjak-get-off-part (target-pos 0))
        (play-main-music "snd/music/final-boss.wav" (the int (* (-> *setting-control* user-current sfx-volume) 100)))
        (go-virtual idle)
      )
      (format *stdcon* "final-boss-hm in active~%general-i: ~d" (-> self general-i))
      (suspend)
    )
  )
)

(defstate idle (final-boss-hm)
  :virtual #t
  :enter (behavior ()
    (quickspawn-eb (new 'static 'vector :x (meters 3451.01) :y (meters 122.5821) :z (meters 965.09) :w 1.0))
  )
  :code (behavior ()
    (loop
      (when (and 
              (= weather-dark-mode #f)
            )
        (toggle-dark-mode)
      )
      (when (not (search-process-tree *active-pool* (lambda ((p process)) (type? p entity-boss))))
        (go-virtual active)
      )
      (format *stdcon* "final-boss-hm in idle")
      (final-boss-hm-always self)
      (suspend)
    )
  )
)

(define *m00* 30.0)

(define *m11* 20.0)

(define *mss* 1.5)

(defskelgroup skel-roboguard-test roboguard roboguard-lod0-jg roboguard-idle0-ja ;;test skeleton
              ((roboguard-lod0-mg (meters 20)) (roboguard-lod1-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 99999)
              :shadow roboguard-shadow-mg
              :origin-joint-index 3
              )

(defskelgroup skel-precursor-boss-1 precursor precursor-lod0-jg precursor-idle-ja
              ((precursor-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 8)
              :origin-joint-index 0
              )

(deftype entity-boss (nav-enemy)
  ((nav-vector            vector :inline)
   (last-thrust-vec        vector :inline)
   (max-speed             float)
   (desired-float-height  float)
   (desired-y-height      float)
   (y-movement            float)
   (bob-speed-scalar      float)
   (ground-height         float)
   (ground-offset         float)
   (should-rise?          symbol)
   (rise-speed            float)
   (target-vec            vector :inline)
   (follow-offset         vector :inline)
   (follow-point          vector :inline)
   (move-speed            float)
   (jak-high-timer       float)
   (follow-jak?          symbol)
  )
  (:state-methods
    idle2
    hostile
    dead
  )
  (:methods
    (entity-boss-method-203 (_type_ symbol) none)
    (entity-boss-method-161 (_type_) none)
    (entity-boss-method-198 (_type_) none)
    (entity-boss-manipy-track (_type_) none)
    (entity-boss-probe-ground (_type_ vector) float)
    (move-to-ground-height (_type_ float) none)
    (entity-boss-bind-idle-anim! (_type_) none)
    (entity-boss-rise-step (_type_) symbol)
    (entity-boss-reroll-follow-offset! (_type_ float) none)
  )
)

(define *entity-boss* (the (pointer entity-boss) #f))

(define *entity-boss-nav-enemy-info*
  (new 'static 'nav-enemy-info
    :use-die-falling #f
    :use-victory #f
    :use-jump-blocked #f
    :debug-draw-neck #f
    :jump-debug-draw #f
    :move-to-ground #f
    :hover-if-no-ground #t
    :idle-anim 0
    :notice-anim 0
    :hostile-anim 0
    :hit-anim 0
    :knocked-anim 0
    :knocked-land-anim 0
    :die-anim 0
    :die-falling-anim -1
    :victory-anim -1
    :notice-distance (meters 30)
    :notice-distance-delta (meters 10)
    :default-hit-points 100.0
    :gnd-collide-with (collide-spec backgnd obstacle hit-by-others-list)
    :overlaps-others-collide-with-filter (collide-spec jak bot player-list)
    :movement-gravity (meters -100)
    :friction 0.8
    :attack-mode 'generic
    :attack-damage 1
    :walk-anim 0
    :turn-anim -1
    :run-anim 0
    :taunt-anim -1
    :run-travel-speed (meters 20)
    :run-acceleration (meters 1)
    :run-turning-acceleration (meters 2)
    :walk-travel-speed (meters 20)
    :walk-acceleration (meters 1)
    :walk-turning-acceleration (meters 1)
    :maximum-rotation-rate (degrees 720)
    :notice-nav-radius (meters 1)
    :frustration-distance (meters 8)
    :frustration-time (seconds 4)
    :blocked-time (seconds 0.3)
    :circle-dist-lo 20480.0
    :circle-dist-hi 61440.0
    :nav-mesh #f
  )
)


(set! (-> *entity-boss-nav-enemy-info* fact-defaults) *fact-info-enemy-defaults*)

(defmethod entity-boss-rise-step ((this entity-boss))
  (if (-> this should-rise?)
      (begin
        (let ((he (-> this desired-y-height)))
          (+! (-> this root trans y) (* (-> this rise-speed) (seconds-per-frame)))
          (when (<= he (-> this root trans y))
            (set! (-> this root trans y) he)
            (set! (-> this y-movement) 0.0)
            (set! (-> this should-rise?) #f)
            )
          )
        #t
        )
      #f
      )
  )

(defmethod entity-boss-reroll-follow-offset! ((this entity-boss) (radius float))
  ;; Random offset around Jak in XZ, Jak is center.
  ;; No sin/cos, no negative rand range, no loop/break.

  (let* (;; sample #1 in [-1, 1] (triangular distribution, good enough for direction)
         (x1 (- (rand-vu-float-range 0.0 1.0) (rand-vu-float-range 0.0 1.0)))
         (z1 (- (rand-vu-float-range 0.0 1.0) (rand-vu-float-range 0.0 1.0)))
         (s1 (+ (* x1 x1) (* z1 z1)))

         ;; sample #2 fallback
         (x2 (- (rand-vu-float-range 0.0 1.0) (rand-vu-float-range 0.0 1.0)))
         (z2 (- (rand-vu-float-range 0.0 1.0) (rand-vu-float-range 0.0 1.0)))
         (s2 (+ (* x2 x2) (* z2 z2)))

         ;; choose a usable direction without looping
         (dx 0.0)
         (dz 0.0)
         (ds 1.0))

    (if (and (> s1 0.000001) (< s1 1.0))
        (begin (set! dx x1) (set! dz z1) (set! ds s1))
        (if (and (> s2 0.000001) (< s2 1.0))
            (begin (set! dx x2) (set! dz z2) (set! ds s2))
            ;; last resort direction
            (begin (set! dx 1.0) (set! dz 0.0) (set! ds 1.0))
        )
    )

    ;; uniform-in-disk radius
    (let* ((u (rand-vu-float-range 0.0 1.0))
           (r (* (sqrtf u) radius))
           (invlen (/ 1.0 (sqrtf ds))))

      (set! (-> this follow-offset x) (* r dx invlen))
      (set! (-> this follow-offset y) 0.0)
      (set! (-> this follow-offset z) (* r dz invlen))
      (set! (-> this follow-offset w) 1.0)
    )
  )
  (none)
)

(defmethod entity-boss-probe-ground ((this entity-boss) (pos vector))
  (let ((q (new 'stack-no-clear 'collide-query)))
    (vector+float*! (-> q start-pos) pos *up-vector* 81920.0)
    (set! (-> q move-dist quad) (the-as uint128 0))
    (set! (-> q move-dist y) -245760.0)
    (set! (-> q radius) 40.96)
    (set! (-> q collide-with) (collide-spec backgnd))
    (set! (-> q ignore-process0) #f)
    (set! (-> q ignore-process1) #f)
    (set! (-> q ignore-pat)
          (new 'static 'pat-surface
            :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> q action-mask) (collide-action solid))
    (if (>= (fill-and-probe-using-line-sphere *collide-cache* q) 0.0)
        (-> q best-other-tri intersect y)
        -40960000.0)
  )
)

(defmethod move-to-ground-height ((this entity-boss) (gnd float))
  (set! (-> this ground-height) gnd)
  (let ((miny (+ gnd (-> this ground-offset))))
    (when (< (-> this root trans y) miny)
      (set! (-> this root trans y) miny)
      (set! (-> this y-movement) 0.0)
    )
  )
  (none)
)

(define *hh0* 20.0)
(define *hh1* 8.0)
(define *hhs* 4.0)

(defmethod entity-boss-manipy-track ((this entity-boss))
    (let ((child (-> this child)))
      (send-event (ppointer->process child) 'rot-quat (-> this root quat))
      (send-event (ppointer->process child) 'trans (-> this root trans))
    )
    (none)
  )

(defmethod entity-boss-method-161 ((this entity-boss))
  ;; We keep (-> this ground-height) as the spawn/reference ground forever.
  ;; Normal hover: ground-height + desired-float-height
  ;; If Jak stays "unusually high" for a few seconds, switch to:
  ;;   JakY + desired-float-height (updated in real time)
  ;; When Jak drops back down, switch back with hysteresis.

  (let* ((dt (seconds-per-frame))
         (g0 (-> this ground-height))
         (base (+ g0 (-> this desired-float-height)))
         (jaky (-> *target* root trans y))

         ;; --- tuning knobs ---
         (high-thresh (meters 4.0))     ;; how much higher than "normal" counts as high
         (need-secs   (seconds 2.0))    ;; how long Jak must stay high before we follow
         (release-secs (seconds 1.0))   ;; how long low before we stop following
         (max-extra   (meters 10.0))    ;; cap how far above base we allow (keeps it shootable)
         )

    ;; Update timer / mode
    (if (> jaky (+ base high-thresh))
        (begin
          (+! (-> this jak-high-timer) dt)
          (when (>= (-> this jak-high-timer) need-secs)
            (set! (-> this follow-jak?) #t)
          )
        )
        (begin
          ;; decay timer when Jak isn't high
          (-! (-> this jak-high-timer) dt)
          (when (< (-> this jak-high-timer) 0.0)
            (set! (-> this jak-high-timer) 0.0)
          )
          ;; if we were following Jak, require some "low time" before releasing
          (when (and (-> this follow-jak?) (<= (-> this jak-high-timer) 0.0))
            ;; simple release window: if Jak isn't high, count down a separate release
            ;; using negative space in timer isn't safe, so just use a quick check:
            (when (<= jaky (+ base (meters 2.0))) ; hysteresis band
              ;; hold off a little by requiring "low" for release-secs
              ;; reuse timer as a low-hold accumulator:
              (+! (-> this jak-high-timer) (* -1.0 dt))
              (when (<= (-> this jak-high-timer) (- release-secs))
                (set! (-> this follow-jak?) #f)
                (set! (-> this jak-high-timer) 0.0)
              )
            )
          )
        )
    )

    ;; Choose desired height
    (if (-> this follow-jak?)
        (begin
          ;; follow Jak's height, but clamp so it doesn't go absurdly high (keeps gun viable)
          (let ((want (+ jaky (-> this desired-float-height)))
                (hi (+ base max-extra)))
            (when (> want hi) (set! want hi))
            (set! (-> this desired-y-height) want)
          )
        )
        (begin
          ;; normal hover off stored spawn-ground
          (set! (-> this desired-y-height) base)
        )
    )
  )

  ;; --- Your existing spring/bob solver (unchanged) ---
  (if (entity-boss-rise-step this)
      (none)
      (begin
        (let* ((err (- (-> this desired-y-height) (-> this root trans y)))
               (damp 0.0))
          (when (< 8192.0 (fabs (-> this y-movement)))
            (let ((t (* 0.00012207031 (+ -8192.0 (fabs (-> this y-movement))))))
              (set! damp (lerp 0.0 *hh1* (fmax 0.0 (fmin 1.0 t))))
            )
          )
          (let ((acc (* (+ (* *hh0* err) (* damp (- (-> this y-movement))))
                        *hhs*
                        (-> this bob-speed-scalar)
                        (seconds-per-frame))))
            (+! (-> this y-movement) (* acc (seconds-per-frame)))
          )
        )

        (set! (-> this root trans y)
              (+ (-> this root trans y) (* (-> this y-movement) (seconds-per-frame))))
        (none)
      )
  )
)

(defmethod entity-boss-method-203 ((this entity-boss) (use-target-vel? symbol))
  (let* ((dt (seconds-per-frame))
         (tpos (new-stack-vector0))
         (err (new 'stack-no-clear 'vector))
         (desired-vel (new 'stack-no-clear 'vector))
         (cur-vel (new 'stack-no-clear 'vector))
         (stop-radius (meters 0.30))
         (slow-radius (meters 2.00))
         (maxspd (-> this move-speed))
         (smooth (* 7.0 dt))
         )
    (vector-copy! tpos (-> *target* root trans))
    (vector-copy! (-> this target-vec) tpos)
    (vector+! (-> this follow-point) (-> this target-vec) (-> this follow-offset))
    (vector-! err (-> this follow-point) (-> this root trans))
    (set! (-> err y) 0.0)
    (let ((dist (vector-length err)))
      (if (< dist 0.0001)
          (begin
            (set! (-> desired-vel quad) (the-as uint128 0))
            (set! (-> desired-vel w) 1.0)
          )
          (begin
            (vector-normalize! err 1.0)
            (let ((spd maxspd))
              (when (< dist slow-radius)
                (set! spd (* maxspd (/ dist slow-radius)))
              )
              (vector-float*! desired-vel err spd)
            )
            (when (and use-target-vel? (> dist stop-radius))
              (let ((tv (new-stack-vector0)))
                (vector-copy! tv (-> *target* root transv))
                (set! (-> tv y) 0.0)
                (vector+! desired-vel desired-vel tv)
              )
            )
          )
      )
      (when (< dist stop-radius)
        (set! (-> desired-vel quad) (the-as uint128 0))
        (set! (-> desired-vel w) 1.0)
      )
      (vector-copy! cur-vel (-> this root transv))
      (set! (-> cur-vel y) 0.0)
      (vector-lerp! cur-vel cur-vel desired-vel smooth)
      (let* ((next (new 'stack-no-clear 'vector))
              (step (new 'stack-no-clear 'vector))
              (q    (new 'stack-no-clear 'collide-query))
              (hit? #f))
          (vector-copy! next (-> this root trans))
          (+! (-> next x) (* (-> cur-vel x) dt))
          (+! (-> next z) (* (-> cur-vel z) dt))
          (vector-! step next (-> this root trans))
          (set! (-> step y) 0.0)
          (vector-copy! (-> q start-pos) (-> this root trans))
          (set! (-> q move-dist quad) (-> step quad))
          (set! (-> q radius) (-> this root nav-radius))
          (set! (-> q collide-with) (collide-spec jak))
          (set! (-> q ignore-process0) #f)
          (set! (-> q ignore-process1) #f)
          (set! (-> q ignore-pat)
                (new 'static 'pat-surface :noentity #x1 :probe #x1))
          (set! (-> q action-mask) (collide-action solid))   ;; check for collisions
          (when (>= (fill-and-probe-using-line-sphere *collide-cache* q) 0.0)
            (set! hit? #t)
          )
          (if hit?
              (begin
                (set! (-> this root transv x) 0.0)
                (set! (-> this root transv z) 0.0)
              )
              (begin
                (set! (-> this root transv x) (-> cur-vel x))
                (set! (-> this root transv z) (-> cur-vel z))
              )
          )
        )
      (when (< 0.001 (vector-length cur-vel))
        (none)
        (vector-normalize-copy! (-> this nav-vector) cur-vel 1.0)
      )
    )
  )
  (none)
)



(defmethod entity-boss-method-198 ((this entity-boss))
(let ((v1-0 (-> this nav)))
  (logclear! (-> v1-0 flags) (nav-control-flag limit-rotation-rate output-sphere-hash))
  (logclear! (-> this nav flags) (nav-control-flag update-heading-from-facing))
  (set! (-> this enemy-flags) (the-as enemy-flag (logclear (-> this enemy-flags) (enemy-flag ef44))))
  (let ((a1-7 v1-0))
    (set! (-> a1-7 sphere-mask) (the-as uint #x1000fe))
    )
  0
  (let ((a1-9 v1-0))
    (set! (-> a1-9 nav-cull-radius) 12288.0)
    )
  0
  (logclear! (-> v1-0 flags) (nav-control-flag output-sphere-hash))
  )
(set! (-> this enemy-info callback-info) *physics-nav-callback-info*)
(let ((v1-2 this))
  (if (not (logtest? (enemy-flag ef37) (-> v1-2 enemy-flags)))
      (set! (-> v1-2 enemy-flags) (the-as enemy-flag (logior (enemy-flag ef39) (-> v1-2 enemy-flags))))
      )
  (set! (-> v1-2 enemy-flags) (the-as enemy-flag (logior (enemy-flag ef37) (-> v1-2 enemy-flags))))
  (set! (-> v1-2 nav callback-info) (-> v1-2 enemy-info callback-info))
  )
(none)
)

(defstate idle2 (entity-boss)
  :virtual #t
  :enter (behavior ()
    (logior! (-> self enemy-flags) (enemy-flag ef37))
    (entity-boss-reroll-follow-offset! self (meters 6))
  )
  :code (behavior ()
    (loop
      (entity-boss-method-203 self #t)
      (let ((ov (new 'stack-no-clear 'overlaps-others-params)))
        (set! (-> ov options) (overlaps-others-options oo0))
        (set! (-> ov collide-with-filter) (-> self enemy-info overlaps-others-collide-with-filter))
        (set! (-> ov tlist) *touching-list*)
        (integrate-for-enemy-no-mtg (-> self root) (-> self root transv) ov)
      )
      (entity-boss-manipy-track self)
      (entity-boss-method-161 self)
      (when (rand-vu-percent? 0.01)
        (entity-boss-reroll-follow-offset! self (meters 6))
      )
      (suspend)
    )
  )
)


(defmethod entity-boss-bind-idle-anim! ((this entity-boss))
  (none)
)

(defmethod init-enemy! ((this entity-boss))
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-precursor-boss" (the-as (pointer level) #f)))
    (the-as pair 0)
  )
  (let ((man (-> this child))
        (veccy (new 'stack-no-clear 'vector))
        )
    (set! man
      (process-spawn manipy
      :init
      manipy-init
      (-> this root trans)
      #f
      (art-group-get-by-name *level* "skel-precursor-boss" (the (pointer level) #f))
      #f
      0
      #f
      :name "man-eb"
      :to this
      :from *default-dead-pool*
      )
    )
    (when (ppointer->process man)
      (send-event (ppointer->process man) 'shadow #t)
      (set! (-> veccy x) 2.0)
      (set! (-> veccy y) 2.0)
      (set! (-> veccy z) 2.0)
      (send-event (ppointer->process man) 'scale veccy)
      (send-event (ppointer->process man) 'max-vis-dist 9999999.0)
        )
  )
  (setup-enemy! this *entity-boss-nav-enemy-info*)
  (set! (-> this enemy-info callback-info) *physics-nav-callback-info*)
  (set! (-> this nav callback-info) (-> this enemy-info callback-info))
  (set-vector! (-> this nav-vector) 0.0 0.0 1.0 1.0)
  (set-vector! (-> this last-thrust-vec) 0.0 0.0 0.0 1.0)
  (set! (-> this max-speed) 1000.0)
  (set! (-> this desired-float-height) (meters 6))
  (set! (-> this bob-speed-scalar) 3.0)
  (set! (-> this ground-offset) 0.0)
  (set! (-> this rise-speed) (meters 20))
  (set! (-> this should-rise?) #t)
  (set-vector! (-> this target-vec) 0.0 0.0 0.0 1.0)
  (set-vector! (-> this follow-offset) 0.0 0.0 0.0 1.0)
  (set-vector! (-> this follow-point) 0.0 0.0 0.0 1.0)
  (set! (-> this jak-high-timer) 0.0)
  (set! (-> this follow-jak?) #f)
  (set! (-> this move-speed) (meters 34))
  (let ((g (entity-boss-probe-ground this (-> this root trans))))
  (when (> g -10000000.0)
    (set! (-> this ground-height) g)
    (set! (-> this desired-y-height) (+ g (-> this desired-float-height)))
    (set! (-> this root trans y) g)
  )
)
  ;; set boss health bar
  (set! enemy-string "The Entity")
  (set! draw-enemy-noto 9999)
  (if (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
    (set! hpbar-max-hit-points (+ 123000.0 (* (the float enemy-noto) 3)))
    (set! hpbar-max-hit-points (+ 260000.0 (* (the float enemy-noto) 3)))
  )
  (when (> hpbar-hit-points hpbar-max-hit-points)
    (set! hpbar-hit-points hpbar-max-hit-points)
  )
  (set! enemy-hp #t)
  (set! (-> this hit-points) hpbar-max-hit-points)
  (logclear! (-> this draw status) (draw-control-status no-draw))
  (none)
)

(defmethod init-enemy-collision! ((this entity-boss))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing))

    (set! (-> s5-0 penetrated-by)
          (penetrate generic-attack lunge flop punch spin roll uppercut bonk tube
                     flut-attack board mech-punch dark-punch dark-smack flut))
    (let ((root (new 'process 'collide-shape-prim-group s5-0 (the-as uint 2) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 3))
      (set! (-> root prim-core collide-as) (collide-spec enemy))
      (set! (-> root prim-core collide-with)
            (collide-spec backgnd jak bot crate obstacle hit-by-others-list player-list))
      (set! (-> root prim-core action) (collide-action solid no-standon))
      (set-vector! (-> root local-sphere) 0.0 12288.0 0.0 22528.0)
      (set! (-> s5-0 root-prim) root))
    (let ((body (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> body prim-core collide-as) (collide-spec enemy))
      (set! (-> body prim-core collide-with) (collide-spec jak bot crate hit-by-others-list player-list))
      (set! (-> body prim-core action) (collide-action solid no-standon))
      (set-vector! (-> body local-sphere) 0.0 16000.0 0.0 12000.0))
    (let ((hurt (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> hurt prim-core collide-as) (collide-spec enemy))
      (set! (-> hurt prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> hurt prim-core action) (collide-action deadly no-standon solid))
      (set-vector! (-> hurt local-sphere) 0.0 10000.0 0.0 10000.0))
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((rp (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> rp prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> rp prim-core collide-with)))
    (set! (-> s5-0 max-iteration-count) (the-as uint 3))
    (set! (-> this root) s5-0))
  (none))

(deftype entity-boss-init-params (structure)
  ((pos   vector      :inline)
   (quat  quaternion  :inline))
)

(defbehavior entity-boss-init-by-other entity-boss ((arg0 entity-boss-init-params))
  (stack-size-set! (-> self main-thread) 512)
  (logior! (-> self mask) (process-mask actor-pause))
  (init-enemy-collision! self)
  (set! (-> self root trans quad) (-> arg0 pos quad))
  (quaternion-copy! (-> self root quat) (-> arg0 quat))
  (vector-identity! (-> self root scale))
  (init-enemy! self)
  (let ((nav (find-nearest-nav-mesh (-> arg0 pos) 0.0))
        (cverts (new 'static 'inline-array vector 3
                (static-vectorm 1 0 0)
                (static-vectorm 0 1 0)
                (static-vectorm 0 0 1)
                )
            )
          )
    (if nav
      (change-to nav self)
      (change-to *default-nav-mesh* self)
      )
    (set! (-> self path) (new 'process 'path-control self 'path 0.0 (the entity #f) #f))
    (set! (-> self path curve cverts) cverts)
    (set! (-> self path curve num-cverts) 3)
    (when (not nav)
      (add-process-drawable-to-nav-mesh *default-nav-mesh* self #t)
    )
  )
  (format #t "spawned process ~s~%" (-> self name))
  (logclear! (-> self draw status) (draw-control-status no-draw-temp uninited no-draw-bounds no-draw-bounds2))
  (logior! (-> self draw status) (draw-control-status no-draw no-bounds-check force-vu1))
  (go (method-of-object self idle2))
  (none)
)

(defun spawn-entity-boss ((arg0 vector) (arg1 quaternion))
  (let ((ebp (new 'static 'entity-boss-init-params)))
    (set! (-> ebp pos quad) (-> arg0 quad))
    (quaternion-copy! (-> ebp quat) arg1)
    (set! *entity-boss* (process-spawn entity-boss ebp :name "Entity-Boss"))
  )
  (none)
)

(defun quickspawn-eb ((vec vector))
  (spawn-entity-boss vec (quaternion-identity! (new 'stack-no-clear 'quaternion)))
  (none)
)

(defun spawn-eb-man ((vec vector)) ;;created as a test to see if the art-group can be loaded ingame (it can)
  (let ((veccy (new 'stack-no-clear 'vector))
        )
      (process-spawn manipy
      :init
      manipy-init
      vec
      #f
      (art-group-get-by-name *level* "skel-roboguard-test" (the (pointer level) #f))
      #f
      0
      #f
      :name "man-eb"
      )
  )
  (none)
)

(defun to-final-boss! ()
  (send-event *target* 'continue (get-continue-by-name *game-info* "desertb-dark-tower"))
  (none)
)

(defun fb-task-spawn ()
  (process-spawn final-boss-hm :name "final-boss-hm")
  (none)
)