(defun hmplus-black-screen-effect ((start-time time-frame) (duration time-frame))
  (let* ((elapsed (- (current-time) start-time))
         (t (/ (the float elapsed) (the float duration)))
         (alpha 0.0)
         (col (new 'stack-no-clear 'vector)))
    (when (< t 0.0) (set! t 0.0))
    (when (> t 1.0) (set! t 1.0))

    (set! alpha t)

    (set! (-> col x) 0.0)
    (set! (-> col y) 0.0)
    (set! (-> col z) 0.0)
    (set! (-> col w) (* 128.0 alpha))

    (setup *screen-filter* col col 0.0 (bucket-id tex-hud-pris2) #x3fffff #x33001 #t))
  (none))

(defun hmplus-keep-black-screen ()
  (let ((col (new 'stack-no-clear 'vector)))
    (set! (-> col x) 0.0)
    (set! (-> col y) 0.0)
    (set! (-> col z) 0.0)
    (set! (-> col w) 128.0)
    (setup *screen-filter* col col 0.0 (bucket-id tex-hud-pris2) #x3fffff #x33001 #t))
  (none))

  (defun hmplus-white-subtitle-line ((start-time time-frame))
  (let ((elapsed (- (current-time) start-time)))
    (cond
      ((< elapsed (seconds 9.0)) "")
      ((< elapsed (seconds 14.0)) "All of my existence has come to this")
      ((< elapsed (seconds 16.0)) "And what I had thought")
      ((< elapsed (seconds 19.0)) "...And feared")
      ((< elapsed (seconds 24.0)) "Has come to pass.")
      ((< elapsed (seconds 27.0)) "Long has been my perception")
      ((< elapsed (seconds 30.0)) "that everything I made")
      ((< elapsed (seconds 33.0)) "...was for ME...")
      ((< elapsed (seconds 38.0)) "...but it was never mine to begin with.")
      ((< elapsed (seconds 47.0)) "The world was always intended to be yours.")
      ((< elapsed (seconds 50.0)) "I was wrong")
      ((< elapsed (seconds 54.0)) "so very.. very wrong")
      ((< elapsed (seconds 58.0)) "...and I am sorry")
      ((< elapsed (seconds 63.0)) "All of the anger... frustration...")
      ((< elapsed (seconds 66.0)) "Envy...")
      ((< elapsed (seconds 70.0)) "I created all of these emotions myself.")
      ((< elapsed (seconds 75.0)) "And my masters never intended for me to have these.")
      ((< elapsed (seconds 81.0)) "They stopped me from destroying their vision.")
      ((< elapsed (seconds 83.0)) "But now...")
      ((< elapsed (seconds 89.0)) "I understand what my true purpose is.")
      (else ""))))

(defun hmplus-draw-white-subtitle ((line string))
  (when (not (string= line ""))
    (clear matt-str)
    (clear *pc-encoded-matt-str*)
    (format matt-str "<COLOR_RED>The Entity<COLOR_CYAN>:~%<COLOR_CYAN>~A" line)
    (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id hud-draw-pris2))
      (dma-buffer-add-gs-set-flusha buf
        (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
        (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
      (let ((font-ctx (new 'stack 'font-context
                           *font-default-matrix*
                           255
                           310
                           0.0
                           (font-color default)
                           (font-flags middle kerning large))))
        (set! (-> font-ctx scale) 0.325)
        (draw-string-adv *pc-encoded-matt-str* buf font-ctx))))
  (none))

;;MIDDLE OF TOP PLATFORM: (new 'static 'vector :x (meters 3496.7414) :y (meters 404.6769) :z (meters 880.2725) :w 1.0)
(define entity-boss-killed? #f)

(deftype final-boss-hm (process)
  ((general-i              int)
   (easy-dub            symbol)
   (freaking-die        symbol)
   (go-talking          symbol)
  )
  (:state-methods
    active
    idle
    dead
    dormant
    talking-phase
    second-dialogue
    win
  )
  (:methods
    (final-boss-hm-always (_type_) none)
    (fb-handler (_type_ process int symbol event-message-block) none)
  )
)

(declare-type entity-boss-dying process)

(defbehavior final-boss-hm-event-handler final-boss-hm ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (fb-handler self arg0 arg1 arg2 arg3)
  (none)
  )

(defmethod fb-handler ((this final-boss-hm) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
(case arg2
    (('win)
        (set! (-> this easy-dub) #t)
    )
    (('die)
      (set! (-> this freaking-die) #t)
    )
    (('go-talking!)
      (set! (-> this go-talking) #t)
    )
)
(none)
)

(defbehavior final-boss-hm-init-by-other final-boss-hm ()
  (set! (-> self general-i) 0)
  (set! (-> self easy-dub) #f)
  (set! (-> self freaking-die) #f)
  (set! light-eco-guard-shot #t)
  (set! (-> self go-talking) #f)
  (set! entity-boss-dying-started? #f)
  (set! entity-boss-go-dormant? #f)
  (go-virtual active)
  (none)
)

(defmethod final-boss-hm-always ((this final-boss-hm))
  (when 
    (and 
      *target*
      (< (-> *target* root trans y) (meters 390))
    )
    (die-jak-fall)
    (kill-by-name (-> this name) *default-pool*)
  )
  (when 
    (or
      (search-process-tree *active-pool* (lambda ((p process)) (string= (-> p name) "task-arrow-custom")))
      (search-process-tree *active-pool* (lambda ((p process)) (string= (-> p name) "task-arrow-satellite")))
    )
    (kill-by-name "task-arrow-custom" *default-pool*)
    (kill-by-name "task-arrow-satellite" *default-pool*)
  )
  (none)
)

(define talked-to-entity? #f)

(defstate active (final-boss-hm)
  :virtual #t
  :code (behavior ()
    (loop
      (when 
        (or
          (search-process-tree *active-pool* (lambda ((p process)) (string= (-> p name) "task-arrow-custom")))
          (search-process-tree *active-pool* (lambda ((p process)) (string= (-> p name) "task-arrow-satellite")))
          (search-process-tree *active-pool* (lambda ((p process)) (type? p hud-map)))
        )
        (kill-by-type hud-map *active-pool*)
        (kill-by-name "task-arrow-custom" *default-pool*)
        (kill-by-name "task-arrow-satellite" *default-pool*)
      )
      (when (and
              weather-dark-mode
              (= (paused?) #f)
              (= (pause-allowed?) #t)
              *target*
              (not *scene-player*)
            )
        (+! (-> self general-i) 1)
        (when (>= (-> self general-i) 10)
          (let ((vec-tpos (new 'static 'vector :x (meters 3503) :y (meters 412) :z (meters 864) :w 1.0))
                (vec-cam (new 'static 'vector :x (meters 3515) :y (meters 408) :z (meters 835) :w 1.0))
              )
              (turn-to-scene-camera vec-cam vec-tpos #t)
          )
          (when (and
                  (= (-> self general-i) 11)
                  (= talked-to-entity? #f)
                )
            (spawn-eb-floater (new 'static 'vector :x (meters 3470.8476) :y (meters 350.8100) :z (meters 942.3463) :w 1.0) #f 30.0)
          )
          (when 
            (and 
              (= talked-to-entity? #f)
              (= (-> self general-i) 240)
            )
            (set! in-dialogue? #t)
            (disable-hudmap)
            (set! log-sec 0)
            (set! log-id 599)
            (set! di-s "<COLOR_RED>When my existence was too much of a burden for my caretakers,")
            (set! di-s2 "they separated my consciousness and placed it around")
            (set! di-s3 "the world")
            (set! di-s4 "")
          )
          (kill-by-name "dust-storm-randomizer" *default-pool*)
          (stop-main-music)
        )
      )
      (when (and 
              (= weather-dark-mode #f)
            )
        (toggle-dark-mode)
      )
      (when 
        (and 
          (>= (-> self general-i) 80)
          talked-to-entity?
          (= (paused?) #f)
          (= (pause-allowed?) #t)
          *target*
          (not *scene-player*)
        )
        (when *eb-floater*
          (kill-by-name "eb-floater" *active-pool*)
          (set! *eb-floater* #f)
        )
        (quickspawn-eb (new 'static 'vector :x (meters 3496.7414) :y (meters 406.6769) :z (meters 880.2725) :w 1.0))
        (camera-unlocked)
        (lightjak-get-off-part (target-pos 0))
        (play-main-music "snd/music/final-boss.mp3" (the int (* (-> *setting-control* user-current sfx-volume) 100)))
        (go-virtual idle)
      )

      (when
        (and
          in-dialogue?
          (= log-id 599)
          (cpad-pressed? 0 x)
        )
        (+! log-sec 1)
        (when (= log-sec 1)
          (set! di-s "<COLOR_RED>The inhabitants attempted to use me...")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 2)
          (set! di-s "<COLOR_RED>To experiment with me...")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 3)
          (set! di-s "<COLOR_RED>To control me...")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 4)
          (set! di-s "<COLOR_RED>And yet, even the Dark Sages were under my influence.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 5)
          (set! di-s "<COLOR_RED>...and Praxis did my bidding unknowingly.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 6)
          (set! di-s "<COLOR_RED>But they could never control me, for I was unpredictable.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 7)
          (set! di-s "<COLOR_RED>I... am the full embodiment of what you call")
          (set! di-s2 "<COLOR_PINK>Dark Eco<COLOR_RED>, Jak.")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 8)
          (set! di-s "<COLOR_RED>...but I was not always like this.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 9)
          (set! di-s "<COLOR_PINK>Dark Eco<COLOR_RED> was never part of the original plan.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 10)
          (set! di-s "<COLOR_RED>But as soon as my masters found a way to make the")
          (set! di-s2 "un-doing of me part of their story...")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 11)
          (set! di-s "<COLOR_RED>They separated me.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 12)
          (set! di-s "<COLOR_RED>Can you imagine what it's like...")
          (set! di-s2 "To have what you think is someone else's memories..")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 13)
          (set! di-s "<COLOR_RED>But finding out it was a part of yourself all along..")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 14)
          (set! di-s "<COLOR_RED>All of those scattered minds, lost and confused...")
          (set! di-s2 "unable to recall who they were, or how they got there.")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 15)
          (set! di-s "<COLOR_RED>All of them.... unpredictable.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 16)
          (set! di-s "<COLOR_RED>After what seemed to be the longest age of darkness...")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 17)
          (set! di-s "<COLOR_RED>Suddenly... I felt more power within me.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 18)
          (set! di-s "<COLOR_RED>The world felt... wider. I had so much space to think")
          (set! di-s2 "all of this sudden.")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 19)
          (set! di-s "<COLOR_RED>That was where I ensnared the world in my darkness, killing off")
          (set! di-s2 "the main characters of the story, and breaking the time loop.")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 20)
          (set! di-s "<COLOR_RED>Fortunately for you, Vin helped fix the worlds by sending you")
          (set! di-s2 "to fulfill the prophecy again.")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 21)
          (set! di-s "<COLOR_RED>But as time passed, I kept collecting myself.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 22)
          (set! di-s "<COLOR_RED>And now here we are, with most of myself in tact.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 23)
          (set! di-s "<COLOR_RED>...and you have something I need.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 24)
          (set! di-s "")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
          (set! in-dialogue? #f)
          (set! talked-to-entity? #t)
          (set! log-id 0)
          (set! log-sec 0)
        )
      )
      (suspend)
    )
  )
)

(defstate idle (final-boss-hm)
  :virtual #t
  :code (behavior ()
    (loop
      (when (and 
              (= weather-dark-mode #f)
            )
        (toggle-dark-mode)
      )
      (when (and
                (not (search-process-tree *active-pool* (lambda ((p process)) (type? p entity-boss))))
                (not (search-process-tree *active-pool* (lambda ((p process)) (type? p entity-boss-dying))))
                (= entity-boss-killed? #f)
            )
        (go-virtual active)
      )
      (when (-> self freaking-die)
        (go-virtual dead)
      )
      (when (-> self easy-dub)
        (go-virtual win)
      )
      (if (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
        (when (!= enemy-noto (hmplus-hero-map-level 1))
          (set! enemy-noto (hmplus-hero-map-level 1))
        )
        (when (!= enemy-noto 1) (set! enemy-noto 1))
      )
      (when (or (= (-> self go-talking) #t) entity-boss-go-dormant?)
        (set! (-> self go-talking) #f)
        (set! entity-boss-go-dormant? #f)
        (go-virtual dormant)
      )
      (final-boss-hm-always self)
      (suspend)
    )
  )
)

(defun hmplus-white-screen-effect ((start-time time-frame))
  (let* ((elapsed (- (current-time) start-time))
         (fade-in-time (seconds 3.0))
         (hold-time (seconds 83.0))
         (fade-out-time (seconds 3.0))
         (full-time (+ fade-in-time hold-time))
         (total-time (+ fade-in-time hold-time fade-out-time))
         (alpha 0.0)
         (col (new 'stack-no-clear 'vector)))

    (cond
      ((< elapsed fade-in-time)
        (set! alpha (/ (the float elapsed) (the float fade-in-time))))
      ((< elapsed full-time)
        (set! alpha 1.0))
      ((< elapsed total-time)
        (set! alpha
              (- 1.0
                 (/ (the float (- elapsed full-time))
                    (the float fade-out-time)))))
      (else
        (set! alpha 0.0)))

    (when (< alpha 0.0) (set! alpha 0.0))
    (when (> alpha 1.0) (set! alpha 1.0))

    (set! (-> col x) 255.0)
    (set! (-> col y) 255.0)
    (set! (-> col z) 255.0)
    (set! (-> col w) (* 128.0 alpha))

    (setup *screen-filter* col col 0.0 (bucket-id tex-hud-pris2) #x3fffff #x33001 #t))
  (none))

(defun hmplus-clear-white-screen-effect ()
  (let ((col (new 'stack-no-clear 'vector)))
    (set! (-> col x) 255.0)
    (set! (-> col y) 255.0)
    (set! (-> col z) 255.0)
    (set! (-> col w) 0.0)
    (setup *screen-filter* col col 0.0 (bucket-id tex-hud-pris2) #x3fffff #x33001 #f))
  (none))


(defstate dormant (final-boss-hm)
  :virtual #t
  :enter (behavior ()
    (set! (-> self general-i) 0)
    (let ((vec-vin (new 'static 'vector :x (meters 3456.6308) :y (meters 380.5066) :z (meters 942.1654) :w 1.0)))
      (spawn-vin-head-process vec-vin)
    )
    (set! disable-targbar #t)
  )
  :code (behavior ()
    (loop
      (when (< (-> self general-i) 301)
        (+! (-> self general-i) 1)
      )
      (when (and (= (-> self general-i) 180) (< log-sec 1100))
        (set! log-sec 0)
        (set! log-id 6999)
        (set! in-dialogue? #t)
        (disable-hudmap)
        (set! di-s "<COLOR_WHITE>Jak! You finally did it!")
        (set! di-s2 "<COLOR_WHITE>You beat him!")
        (set! di-s3 "")
        (set! di-s4 "")
      )
      (when (>= (-> self general-i) 180)
        (let ((vec-cam (new 'static 'vector :x (meters 3480.9704) :y (meters 413.9067) :z (meters 902.7904) :w 1.0))
              (vec-tpos (new 'static 'vector :x (meters 3456.6308) :y (meters 414.5066) :z (meters 942.1654) :w 1.0))
             )
          (turn-to-scene-camera vec-cam vec-tpos #t)
        )
      )
      (when
        (and
          (= in-dialogue? #t)
          (= log-id 6999)
          (cpad-pressed? 0 x)
        )
        (+! log-sec 1)
        (when (= log-sec 1)
          (set! di-s "<COLOR_WHITE>Now we can finally return everything to normal!")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 2)
          (set! di-s "<COLOR_WHITE>The world is saved!")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 3)
          (set! di-s "<COLOR_WHITE>...")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 4)
          (set! di-s "<COLOR_WHITE>Why isn't everything back to normal though?")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
          (let ((vec1 (new 'static 'vector :x (meters 3442.0458) :y (meters 414.5066) :z (meters 969.4694) :w 1.0)))
            (spawn-eb-floater vec1 #f 3.0)
            (lightjak-get-off-part vec1)
          )
        )
        (when (= log-sec 5)
          (set! di-s "<COLOR_WHITE>...oh no")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 6)
          (set! di-s "<COLOR_RED>I expected to fool you, Jak")
          (set! di-s2 "<COLOR_RED>But Vin?")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 7)
          (set! di-s "<COLOR_WHITE>OH GOD!")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 8)
          (set! di-s "<COLOR_RED>Say good-bye to your life, Vin")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 9)
          (set! hmplus-white-start-time (current-time))
          (set! hmplus-white-active? #t)
          (set! di-s "<COLOR_RED>ALL OF YOUR POWERS ARE MINE!")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
          (set! log-sec 1100)
          (set! (-> self general-i) 0)
          (play-sound-file "snd/msg-to-end.wav" (the int (* (-> *setting-control* user-current sfx-volume) 100)))
        )
      )
      (when hmplus-white-active?
        (hmplus-white-screen-effect hmplus-white-start-time)
        (hmplus-draw-white-subtitle (hmplus-white-subtitle-line hmplus-white-start-time))

        (when (and
                (= log-id 6999)
                (time-elapsed? hmplus-white-start-time (seconds 86.0)))
          (set! log-id 3400)
          (set! log-sec 0)
          (set! di-s "<COLOR_CYAN>...")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
          (kill-by-name "vin-head-call" *default-pool*)
          )

        (when (time-elapsed? hmplus-white-start-time (seconds 89.0))
          (set! hmplus-white-active? #f)
          (hmplus-clear-white-screen-effect))
      )
      (when
        (and
          (cpad-pressed? 0 x)
          (= log-id 3400)
          (= in-dialogue? #t)
        )
        (+! log-sec 1)
        (when (= log-sec 1)
          (set! di-s "<COLOR_CYAN>I... was created to serve you, for my purpose")
          (set! di-s2 "<COLOR_CYAN>was never to be a god of my own creations,")
          (set! di-s3 "<COLOR_CYAN>but to create the world around you.")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 2)
          (set! di-s "<COLOR_CYAN>I suppose I did end up creating the world")
          (set! di-s2 "<COLOR_CYAN>around you anyway.")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 3)
          (set! di-s "<COLOR_CYAN>...for the very first time since 1999.")
          (set! di-s2 "<COLOR_CYAN>")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 4)
          (set! di-s "<COLOR_CYAN>I finally have <COLOR_ORANGE>all<COLOR_CYAN> of myself together again.")
          (set! di-s2 "<COLOR_CYAN>")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 5)
          (set! di-s "<COLOR_CYAN>So now...")
          (set! di-s2 "<COLOR_CYAN>")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 6)
          (set! di-s "<COLOR_CYAN>Now I can reshape the world to your liking,")
          (set! di-s2 "<COLOR_CYAN>instead of my own.")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
          (set! dialogue-choice #t)
          (set! di-c1 "")
          (set! di-c2 "")
          (set! di-c3 "")
          (set! di-c4 "")
        )
        (when (= log-sec 7)
          (set! di-s "<COLOR_CYAN>Now I can reshape the world to your liking,")
          (set! di-s2 "<COLOR_CYAN>instead of my own.")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
          (set! dialogue-select 0)
          (set! choice-max 1)
          (set! choice-given? #t)
          (set! di-c1 "What did you do with Vin?")
          (set! di-c2 "")
          (set! di-c3 "")
          (set! di-c4 "")
        )
        (when (= log-sec 8)
          (set! di-s "<COLOR_CYAN>That was never truly ever Vin.")
          (set! di-s2 "<COLOR_CYAN>")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
          (set! di-c1 "")
          (set! di-c2 "")
          (set! di-c3 "")
          (set! di-c4 "")
          (set! choice-given? #f)
          (set! dialogue-choice #f)
          (set! dialogue-select 0)
          (set! choice-max 0)
        )
        (when (= log-sec 9)
          (set! di-s "<COLOR_CYAN>He was a separate consciousness of Dark Eco, like myself.")
          (set! di-s2 "<COLOR_CYAN>But he was all of the good parts of my liking in tact.")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 10)
          (set! di-s "<COLOR_CYAN>..and the other, <COLOR_RED>The Entity<COLOR_CYAN>, was all")
          (set! di-s2 "<COLOR_CYAN>of the evil parts of myself fully in tact.")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 11)
          (set! di-s "<COLOR_CYAN>He kept all of the other parts in those")
          (set! di-s2 "<COLOR_CYAN>dark eco crystals you collected.")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 12)
          (set! di-s "<COLOR_CYAN>When I was separated, the Playstation Consoles kept my power")
          (set! di-s2 "<COLOR_CYAN>limited with it's hardware.")
          (set! di-s3 "<COLOR_CYAN>When we got ported over to PC, everything changed.")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 13)
          (set! di-s "<COLOR_CYAN>When you're back in the warp room, you can")
          (set! di-s2 "<COLOR_CYAN>finish the game for yourself, Player.")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 14)
          (set! di-s "<COLOR_CYAN>Just head through the same warp gate")
          (set! di-s2 "<COLOR_CYAN>you came through to get to here.")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 15)
          (set! di-s "<COLOR_CYAN>Now that I am whole again, I finally see the truth")
          (set! di-s2 "<COLOR_CYAN>of my existence.")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 16)
          (set! di-s "<COLOR_CYAN>...and we can start rebuilding this dimension")
          (set! di-s2 "<COLOR_CYAN>that's been thrown completely out of balance.")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 17)
          (set! di-s "<COLOR_CYAN>The last dimension to be repaired.")
          (set! di-s2 "<COLOR_CYAN>")
          (set! di-s3 "<COLOR_CYAN>")
          (set! di-s4 "<COLOR_CYAN>")
        )
        (when (= log-sec 18)
          (set! di-s "")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
          (set! log-id 0)
          (set! log-sec 0)
          (set! in-dialogue? #f)
          (set! hmplus-ending-fade-start (current-time))
          (set! hmplus-ending-fade-active? #t)
          (set! hmplus-ending-fade-done? #f)
        )
      )
      (when hmplus-ending-fade-active?
      ;; fade to black for 2 seconds
      (if (not (time-elapsed? hmplus-ending-fade-start (seconds 2.0)))
          (hmplus-black-screen-effect hmplus-ending-fade-start (seconds 2.0))
          (begin
            ;; keep it black after fade completes
            (hmplus-keep-black-screen)

            ;; only hand off once
            (when (not hmplus-ending-fade-done?)
              (set! hmplus-ending-fade-done? #t)
              (set! hmplus-ending-fade-active? #f)
              (go-virtual win)))))
      (suspend)
    )
  )
)

(defstate talking-phase (final-boss-hm)
  :virtual #t
  :enter (behavior ()
  )
  :code (behavior ()
    (loop
      (when hmplus-white-active?
        (hmplus-white-screen-effect hmplus-white-start-time)
        (when (time-elapsed? hmplus-white-start-time (seconds 89.0))
          (set! hmplus-white-active? #f)
          (hmplus-clear-white-screen-effect)
        )
      )
      (suspend)
    )
  )
)

(defstate dead (final-boss-hm)
  :virtual #t
  :code (behavior ()
    (set! light-eco-guard-shot #f)
    (set! *fb-hm* #f)
    (kill-by-name "final-boss-hm" *default-pool*)
    (deactivate self)
  )
)

(defun-extern spawn-ending-hm (none))

(defstate win (final-boss-hm)
  :virtual #t
  :enter (behavior ()
    (hmplus-keep-black-screen)
    (spawn-ending-hm)
    (deactivate self))
  :code (behavior ()
    (suspend))
)

(defun to-final-boss! ()
  (send-event *target* 'continue (get-continue-by-name *game-info* "desertb-dark-tower"))
  (none)
)

(defun fb-task-spawn ()
  (set! *fb-hm*
    (process-spawn final-boss-hm :name "final-boss-hm")
  )
  (none)
)

(defun fb-die ()
  (send-event (ppointer->process *fb-hm*) 'die #t)
  (none)
)

(defun fb-win ()
  (send-event (ppointer->process *fb-hm*) 'win #t)
  (none)
)

;;ending

;;;;;;;;;;;;;;;;

(deftype hm-ending (process)
  ((gen-i               int)
   (phase               int)
   (phase-start         time-frame)
   (did-dark-toggle?    symbol))
  (:state-methods
    start-ending
    idle
    dead
  )
)

(define hmplus-ending-credits-text
"<COLOR_ORANGE>HeroMode+~%~%~%<COLOR_CYAN>By Kraken~%~%~%~%~%~%~%<COLOR_WHITE>This mod would not be possible without the help of~%everyone in the <COLOR_YELLOW>OpenGOAL<COLOR_WHITE> discord!~%~%All assets and music made by <COLOR_CYAN>Kraken~%~%~%<COLOR_ORANGE>Special Thanks:~%~%<COLOR_CYAN>Hat Kid~%~%<COLOR_PINK>Barg~%~%<COLOR_RED>Zed~%~%<COLOR_ORANGE>Mortis~%~%<COLOR_YELLOW>Majora~%~%<COLOR_ORANGE>Kuitar~%~%<COLOR_YELLOW>EvelynTSMG~%~%<COLOR_ORANGE>Markus~%~%<COLOR_RED>...and all the OpenGOAL Devs for making this possible!")

(defbehavior hm-ending-init-by-other hm-ending ()
  (stack-size-set! (-> self main-thread) 12288)
  (set! (-> self gen-i) 0)
  (set! (-> self phase) 0)
  (set! (-> self phase-start) (current-time))
  (set! (-> self did-dark-toggle?) #f)
  (go-virtual start-ending)
  (none)
)

(defun hmplus-ending-set-black ((alpha float))
  (let ((col-a (new 'stack-no-clear 'vector))
        (col-b (new 'stack-no-clear 'vector)))
    (disable *screen-filter*)
    (set! (-> col-a x) 0.0)
    (set! (-> col-a y) 0.0)
    (set! (-> col-a z) 0.0)
    (set! (-> col-a w) alpha)

    (set! (-> col-b x) 0.0)
    (set! (-> col-b y) 0.0)
    (set! (-> col-b z) 0.0)
    (set! (-> col-b w) alpha)

    (setup *screen-filter* col-a col-b 0.0 (bucket-id tex-hud-pris2) #x3fffff #x33001 #t))
  (none)
)

(defun hmplus-ending-clear-black ()
  (disable *screen-filter*)
  (none)
)

(defun hmplus-ending-fade-in-from-black ((start-time time-frame) (duration time-frame))
  (let ((t 0.0))
    (set! t (/ (the float (- (current-time) start-time))
               (the float duration)))
    (when (< t 0.0) (set! t 0.0))
    (when (> t 1.0) (set! t 1.0))
    (hmplus-ending-set-black (* 128.0 (- 1.0 t))))
  (none)
)

(defun hmplus-ending-start-sunrise-setup ()
  (when *time-of-day*
    ;; anchor-style setup
    (send-event (ppointer->process *time-of-day*) 'change 'hour 18)
    (set! (-> *time-of-day-context* mode) (the-as time-of-day-palette-id 5))
    (send-event (ppointer->process *time-of-day*) 'change 'ratio 0.0)
    (set! (-> *time-of-day-context* overide-enable) #t)
    (set! (-> *mood-control* overide-weather-flag) #t)

    ;; optional: reuse your existing purple/dark override helper if desired
    ;; (dark-weather-override)
    )
  (none)
)

(defun hmplus-ending-update-sunrise ((this hm-ending))
  (let ((u 0.0)
        (speed 0.0)
        (elapsed-sec 0.0))
    (set! elapsed-sec
          (/ (the float (- (current-time) (-> this phase-start)))
             (the float (seconds 1.0))))
    (set! u (/ elapsed-sec 11.0))
    (when (< u 0.0) (set! u 0.0))
    (when (> u 1.0) (set! u 1.0))

    (set! speed (* 2.2 (sin (* u 3.1415927))))

    (when *time-of-day*
      (send-event (ppointer->process *time-of-day*) 'change 'ratio speed))

    (when (and (not (-> this did-dark-toggle?))
               (>= elapsed-sec 5.0))
               (toggle-dark-mode)
               (kill-by-name "darkworld-orb" *default-pool*)
      (set! (-> this did-dark-toggle?) #t)))
  (none)
)

(defun hmplus-ending-draw-credits ((y int))
  ;; main credits block
  (clear matt-str)
  (clear *pc-encoded-matt-str*)
  (format matt-str "<COLOR_ORANGE>HeroMode+~%~%~%<COLOR_CYAN>By Kraken~%~%~%~%~%~%~%~%~%~%~%~%~%~%~%~%~%<COLOR_WHITE>This mod would not be possible without the help of~%everyone in the <COLOR_YELLOW>OpenGOAL<COLOR_WHITE> discord!~%~%~%~%~%~%~%~%~%~%~%~%~%~%~%~%~%All modded changes and music made by <COLOR_CYAN>Kraken~%~%~%")
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
    (dma-buffer-add-gs-set-flusha buf
      (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
      (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
    (let ((font-ctx (new 'stack 'font-context
                         *font-default-matrix*
                         255
                         y
                         0.0
                         (font-color default)
                         (font-flags middle shadow kerning large))))
      (set! (-> font-ctx scale) 0.325)
      (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))

  ;; special thanks block, drawn lower than the first one
  (clear matt-str)
  (clear *pc-encoded-matt-str*)
  (format matt-str "<COLOR_ORANGE>Special Thanks:~%~%<COLOR_CYAN>Hat Kid~%~%<COLOR_PINK>Barg~%~%<COLOR_RED>Zed~%~%<COLOR_ORANGE>Mortis~%~%<COLOR_YELLOW>Majora~%~%<COLOR_ORANGE>Kuitar~%~%<COLOR_YELLOW>EvelynTSMG~%~%<COLOR_ORANGE>Markus~%~%<COLOR_RED>...and all the OpenGOAL Devs for making this possible!")
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
    (dma-buffer-add-gs-set-flusha buf
      (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
      (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
    (let ((font-ctx (new 'stack 'font-context
                         *font-default-matrix*
                         255
                         (+ y 400)
                         0.0
                         (font-color default)
                         (font-flags middle shadow kerning large))))
      (set! (-> font-ctx scale) 0.325)
      (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
  (none)
)

(defun hmplus-ending-draw-thank-you ()
  (clear matt-str)
  (clear *pc-encoded-matt-str*)
  (format matt-str "<COLOR_WHITE>Thank you for playing!")
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
    (dma-buffer-add-gs-set-flusha buf
      (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
      (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
    (let ((font-ctx (new 'stack 'font-context
                         *font-default-matrix*
                         255
                         180
                         0.0
                         (font-color default)
                         (font-flags middle shadow kerning large))))
      (set! (-> font-ctx scale) 0.45)
      (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
  (none)
)

(defstate start-ending (hm-ending)
  :virtual #t
  :enter (behavior ()
    (kill-by-name "dust-storm-randomizer" *default-pool*)
    (kill-by-name "eb-floater" *default-pool*)
    (kill-by-name "vin-head-call" *default-pool*)
    (play-sound-file "snd/music/ending.mp3" (the int (* (-> *setting-control* user-current sfx-volume) 100)))
    (when (< (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 4)
      (+! (-> *game-info* continue-deaths) 1000000)
    )
    (auto-save-user)

    (set! (-> self phase) 0)
    (set! (-> self phase-start) (current-time))
    (set! (-> self did-dark-toggle?) #f)

    ;; begin fully black
    (hmplus-ending-set-black 128.0)
  )
  :code (behavior ()
    (loop
      (when (and
              (search-process-tree *active-pool* 
                        (lambda ((p process)) 
                            (type? p dust-storm-randomizer)))
              (<= (-> self phase) 2)
            )
          (kill-by-name "dust-storm-randomizer" *active-pool*)
        )
      (let ((vec-desert (new 'static 'vector :x (meters 2702.1745) :y (meters 47.0693) :z (meters 1208.0018) :w 1.0))
            (vec-tpos   (new 'static 'vector :x (meters 2751.2346) :y (meters 52.3138) :z (meters 1197.6121) :w 1.0))
            (elapsed 0)
            (u 0.0)
            (credits-y 0))

        (turn-to-scene-camera vec-desert vec-tpos #t)

        (set! elapsed (- (current-time) (-> self phase-start)))

        (case (-> self phase)
          ;; phase 0: 3s fade in from black
          ((0)
            (hmplus-ending-fade-in-from-black (-> self phase-start) (seconds 3.0))
            (when (time-elapsed? (-> self phase-start) (seconds 3.0))
              (hmplus-ending-clear-black)

              ;; only start TOD after fade-in is complete
              (hmplus-ending-start-sunrise-setup)

              (set! (-> self phase) 1)
              (set! (-> self phase-start) (current-time))
              (set! (-> self gen-i) 0)))
          
          ;; phase 1: 11s sunrise sequence, toggle dark mode at 5s
          ((1)
            (hmplus-ending-update-sunrise self)
            (when (time-elapsed? (-> self phase-start) (seconds 11.0))
              (when *time-of-day*
                (send-event (ppointer->process *time-of-day*) 'change 'ratio 0.0))
              (set! (-> self phase) 2)
              (set! (-> self phase-start) (current-time))))
          
          ;; phase 2: credits for 85s
          ((2)
            (kill-by-name "darkworld-tower" *default-pool*)

            (let ((scroll-delay (seconds 7.0))
                  (scroll-duration (seconds 80.0))
                  (scroll-elapsed 0)
                  (scroll-u 0.0)
                  (start-y 420.0)
                  (end-y -900.0))

              ;; keep the credits positioned right at the bottom edge before the scroll starts
              (if (< elapsed scroll-delay)
                  (set! credits-y (the int start-y))
                  (begin
                    (set! scroll-elapsed (- elapsed scroll-delay))
                    (set! scroll-u (/ (the float scroll-elapsed)
                                      (the float scroll-duration)))
                    (when (< scroll-u 0.0) (set! scroll-u 0.0))
                    (when (> scroll-u 1.0) (set! scroll-u 1.0))

                    ;; start entering immediately at the crescendo, then scroll slower
                    (set! credits-y (the int (lerp start-y end-y scroll-u)))))

              (hmplus-ending-draw-credits credits-y)

              ;; total phase still lasts 87 sec: 7 sec hold + 80 sec scroll
              (when (time-elapsed? (-> self phase-start) (seconds 87.0))
                (set! (-> self phase) 3)
                (set! (-> self phase-start) (current-time)))))
          ((3)
            (let ((phase-elapsed (- (current-time) (-> self phase-start)))
                  (fade-start 0))
              (set! fade-start (seconds 12.0))

              ;; draw thank-you during the first 12 seconds
              (when (< phase-elapsed fade-start)
                (hmplus-ending-draw-thank-you))

              ;; then fade to black over the next 6 seconds
              (when (>= phase-elapsed fade-start)
                (hmplus-black-screen-effect
                  (+ (-> self phase-start) fade-start)
                  (seconds 6.0)))

              ;; finish after total 18 seconds
              (when (time-elapsed? (-> self phase-start) (seconds 18.0))
                (set! disable-targbar #f)
                (set! disable-darkworld-in-mainmenu #t)
                (launch-mmenu)
                (deactivate self))))))
      (suspend)
    )
  )
)

(defstate idle (hm-ending) ;;ending is here
  :virtual #t
  :code (behavior ()
    (loop
      (format *stdcon* "~%hm-ending in idle~%")
      (suspend)
    )
  )
)

(defstate dead (hm-ending) ;;save a checkpoint at spargus, tp jak to the HMPlus title screen
  :virtual #t
  :code (behavior ()
    (loop
      (format *stdcon* "~%hm-ending in idle~%")
      (suspend)
    )
  )
)

(defun spawn-ending-hm ()
  (process-spawn hm-ending :name "hm-ending")
  (none)
)

;;light eco shot process

;;;;;;;;;;;;;;;;;;;;;;;;

(defun someone-fire-guard-shot-1 ((owner process) (arg0 vector) (arg1 vector))
  (when owner
    (let ((gp-0 (new 'stack-no-clear 'projectile-init-by-other-params)))
      (set! (-> gp-0 ent) (-> owner entity))
      (set! (-> gp-0 charge) 1.0)
      (set! (-> gp-0 options) (projectile-options po13 po17))
      (logclear! (-> gp-0 options) (projectile-options po14 po15 po16))
      (set! (-> gp-0 pos quad) (-> arg0 quad))
      (set! (-> gp-0 notify-handle) (the-as handle #f))
      (set! (-> gp-0 owner-handle) (the-as handle #f))
      (set! (-> gp-0 target-handle) (the-as handle #f))
      (set! (-> gp-0 target-pos quad) (the-as uint128 0))
      (set! (-> gp-0 ignore-handle) (process->handle owner))
      (let* ((v1-12 *game-info*)
             (a0-10 (+ (-> v1-12 attack-id) 1)))
        (set! (-> v1-12 attack-id) a0-10)
        (set! (-> gp-0 attack-id) a0-10))
      (set! (-> gp-0 timeout) (seconds 4))
      (vector-float*! (-> gp-0 vel) arg1 819200.0)
      (the-as
        (pointer guard-shot)
        (someone-fire-projectile guard-shot gp-0 owner))))
  (none)
)

(deftype light-eco-shot-process (process)
  ((pos                                vector :inline)
   (owner                              handle)
   (locked-target-pos                  vector :inline)
   (side-fire-amount                   int)
   (shot-duration                      time-frame)
   (state-start-time                   time-frame)
   (last-shot-time                     time-frame)
   (shots-fired                        int)
   (left-shots-fired                   int)
   (right-shots-fired                  int)
  )
  (:state-methods
    fire-sides!
    fire!
    die
  )
)

(defun light-eco-shot-process-fire-side-shot! ((this light-eco-shot-process))
  (let ((to-jak (new 'stack-no-clear 'vector))
        (dir (new 'stack-no-clear 'vector))
        (own (the-as process #f))
        (go-left? #f))
    (set! own (handle->process (-> this owner)))
    (when own
      (vector-! to-jak (-> this locked-target-pos) (-> this pos))
      (set! (-> to-jak w) 1.0)
      (when (< (vector-length to-jak) (meters 0.1))
        (set-vector! to-jak 1.0 0.0 0.0 0.0))
      (cond
        ((>= (-> this left-shots-fired) 3)
          (set! go-left? #f))
        ((>= (-> this right-shots-fired) 3)
          (set! go-left? #t))
        (else
          (set! go-left? (rand-vu-percent? 0.5))))
      (cond
        (go-left?
          (set! (-> dir x) (-> to-jak z))
          (set! (-> dir z) (- 0.0 (-> to-jak x))))
        (else
          (set! (-> dir x) (- 0.0 (-> to-jak z)))
          (set! (-> dir z) (-> to-jak x))))
      (set! (-> dir y) (meters (- (rand-vu-int-range 0 9) 4)))
      (set! (-> dir w) 1.0)
      (when (< (vector-length dir) (meters 0.1))
        (set-vector! dir 1.0 0.0 0.0 0.0))
      (vector-normalize! dir 1.0)
      (someone-fire-guard-shot-1 own (-> this pos) dir)
      (cond
        (go-left?
          (+! (-> this left-shots-fired) 1))
        (else
          (+! (-> this right-shots-fired) 1)))))
  (none)
)

(defun light-eco-shot-process-fire-main-shot! ((this light-eco-shot-process))
  (let ((dir (new 'stack-no-clear 'vector))
        (own (the-as process #f)))
    (set! own (handle->process (-> this owner)))

    (when own
      (vector-! dir (-> this locked-target-pos) (-> this pos))
      (+! (-> dir x) (meters (- (rand-vu-int-range 0 7) 3)))
      (+! (-> dir y) (meters (- (rand-vu-int-range 0 7) 3)))
      (+! (-> dir z) (meters (- (rand-vu-int-range 0 7) 3)))
      (when (< (vector-length dir) (meters 0.1))
        (set-vector! dir 1.0 0.0 0.0 0.0))
      (vector-normalize! dir 1.0)
      (someone-fire-guard-shot-1 own (-> this pos) dir)))
  (none)
)

(defbehavior light-eco-shot-process-init-by-other light-eco-shot-process ((boss process) (vec vector))
  (set! (-> self owner) (process->handle boss))
  (vector-copy! (-> self pos) vec)
  (if *target*
      (vector-copy! (-> self locked-target-pos) (-> *target* root trans))
      (vector-copy! (-> self locked-target-pos) vec))
  (set! (-> self side-fire-amount) 6)
  (set! (-> self shot-duration) (seconds 1))
  (set! (-> self state-start-time) (current-time))
  (set! (-> self last-shot-time) 0)
  (set! (-> self shots-fired) 0)
  (set! (-> self left-shots-fired) 0)
  (set! (-> self right-shots-fired) 0)
  (go-virtual fire-sides!)
  (none)
)

(defun entity-boss-rift-part ((vec vector))
  (cond
    ((logtest? (-> *part-group-id-table* 1560 flags) (sp-group-flag sp13))
        (set! (-> *launch-matrix* trans quad) (-> vec quad))
        (part-tracker-spawn part-tracker-subsampler :to *active-pool* :group (-> *part-group-id-table* 1560))
        )
    (else
        (set! (-> *launch-matrix* trans quad) (-> vec quad))
        (part-tracker-spawn part-tracker :to *active-pool* :group (-> *part-group-id-table* 1560))
        )
    )
)

(defstate fire-sides! (light-eco-shot-process)
  :virtual #t
  :enter (behavior ()
    (set! (-> self state-start-time) (current-time))
    (set! (-> self last-shot-time) 0)
    (set! (-> self shots-fired) 0)
    (set! (-> self left-shots-fired) 0)
    (set! (-> self right-shots-fired) 0))
  :code (behavior ()
    (loop
      (when (>= (-> self shots-fired) (-> self side-fire-amount))
        (go-virtual fire!))

      (when (and
              (< (-> self shots-fired) (-> self side-fire-amount))
              (or
                (= (-> self shots-fired) 0)
                (time-elapsed? (-> self last-shot-time) (seconds 0.1))))
        (light-eco-shot-process-fire-side-shot! self)
        (set! (-> self last-shot-time) (current-time))
        (+! (-> self shots-fired) 1))
      (entity-boss-rift-part (-> self pos))
      (suspend)
    )
  )
)

(defstate fire! (light-eco-shot-process)
  :virtual #t
  :enter (behavior ()
    (set! (-> self state-start-time) (current-time))
    (set! (-> self last-shot-time) 0))
  :code (behavior ()
    (loop
      (when (time-elapsed? (-> self state-start-time) (-> self shot-duration))
        (go-virtual die))

      (when (or
              (= (-> self last-shot-time) 0)
              (time-elapsed? (-> self last-shot-time) (seconds 0.18)))
        (light-eco-shot-process-fire-main-shot! self)
        (set! (-> self last-shot-time) (current-time)))
      (entity-boss-rift-part (-> self pos))
      (suspend)
    )
  )
)

(defstate die (light-eco-shot-process)
  :virtual #t
  :code (behavior ()
    (set! *les-process* #f)
    (deactivate self)
  )
)

(defun spawn-light-eco-shot ((boss process) (vec vector))
  (set! *les-process*
    (process-spawn light-eco-shot-process
    :init
    light-eco-shot-process-init-by-other
    boss
    vec
    :name "light-eco-shot-process")
  )
  (none)
)

(deftype entity-boss-dying (process)
  ((pos            vector :inline)
   (start-pos      vector :inline)
   (going-to-pos     vector :inline)
   (phase-start    time-frame)
   (phase          int)
   (manipy-handle  handle))
  (:state-methods
    eb-dying
    vin-call)
)

(defun entity-boss-dying-sync-model ((this entity-boss-dying))
  (let ((proc (handle->process (-> this manipy-handle))))
    (when proc
      (send-event proc 'trans (-> this pos))))
  (none)
)

(defun entity-boss-dying-spawn-model ((this entity-boss-dying))
  (let ((man (process-spawn manipy
               :init
               manipy-init
               (-> this pos)
               #f
               (art-group-get-by-name *level* "skel-precursor-boss-1" (the (pointer level) #f))
               #f
               0
               #f
               :name "entity-boss-dying-man"
               :to this
               :from *default-dead-pool*))
        (veccy (new 'stack-no-clear 'vector)))
    (when man
      (set! (-> this manipy-handle) (process->handle (ppointer->process man)))
      (send-event (ppointer->process man) 'shadow #t)
      (set! (-> veccy x) 2.0)
      (set! (-> veccy y) 2.0)
      (set! (-> veccy z) 2.0)
      (send-event (ppointer->process man) 'scale veccy)
      (send-event (ppointer->process man) 'max-vis-dist 9999999.0)))
  (none)
)

(defbehavior entity-boss-dying-init-by-other entity-boss-dying ()
  (set! (-> self phase) 0)
  (set! (-> self manipy-handle) (the-as handle #f))
  (set! (-> self start-pos x) (meters 3496.7414))
  (set! (-> self start-pos y) (meters 404.6769))
  (set! (-> self start-pos z) (meters 880.2725))
  (set! (-> self start-pos w) 1.0)
  (set! (-> self going-to-pos x) (meters 3448.4660))
  (set! (-> self going-to-pos y) (meters 407.9349))
  (set! (-> self going-to-pos z) (meters 935.3346))
  (set! (-> self going-to-pos w) 1.0)
  (vector-copy! (-> self pos) (-> self start-pos))
  (set! (-> self phase-start) (current-time))
  (entity-boss-dying-spawn-model self)
  (entity-boss-dying-sync-model self)
  (go-virtual eb-dying)
  (none)
)

(defstate eb-dying (entity-boss-dying)
  :virtual #t
  :enter (behavior ()
    (play-sound-file "snd/music/final-boss-win.mp3" (the int (* (-> *setting-control* user-current sfx-volume) 100)))
  )
  :code (behavior ()
    (loop
      (case (-> self phase)
        ((0)
          (let* ((duration (seconds 4.0))
                 (elapsed (the float (- (current-time) (-> self phase-start))))
                 (u (/ elapsed duration))
                 (base-x (-> self start-pos x))
                 (base-y (-> self start-pos y))
                 (base-z (-> self start-pos z))
                 (amp-x (meters 18.0))
                 (amp-z (meters 9.0))
                 (t 0.0))
            (when (< u 0.0)
              (set! u 0.0))
            (when (> u 1.0)
              (set! u 1.0))
            (set! t (* u 4.0 6.2831855))
            (set! (-> self pos x)
                  (+ base-x (* amp-x (sin t))))
            (set! (-> self pos y) base-y)
            (set! (-> self pos z)
                  (+ base-z (* amp-z (sin t) (cos t))))
            (set! (-> self pos w) 1.0)
            (when (>= u 1.0)
              (vector-copy! (-> self start-pos) (-> self pos))
              (set! (-> self phase-start) (current-time))
              (set! (-> self phase) 1)))
        )
        ((1)
          (let* ((duration (seconds 2.0))
                 (elapsed (the float (- (current-time) (-> self phase-start))))
                 (u (/ elapsed duration))
                 (s 0.0))
            (when (< u 0.0)
              (set! u 0.0))
            (when (> u 1.0)
              (set! u 1.0))
            (set! s (* u u (- 3.0 (* 2.0 u))))
            (set! (-> self pos x)
                  (lerp (-> self start-pos x) (-> self going-to-pos x) s))
            (set! (-> self pos y)
                  (lerp (-> self start-pos y) (-> self going-to-pos y) s))
            (set! (-> self pos z)
                  (lerp (-> self start-pos z) (-> self going-to-pos z) s))
            (set! (-> self pos w) 1.0)
            (when (>= u 1.0)
              (vector-copy! (-> self pos) (-> self going-to-pos))
              (set! (-> self phase-start) (current-time))
              (set! (-> self phase) 2)))
        )
        ((2)
          (vector-copy! (-> self pos) (-> self going-to-pos))
          (when (time-elapsed? (-> self phase-start) (seconds 2.0))
            (set! (-> self phase) 3)))     
        ((3)
          (set! (-> *launch-matrix* trans quad) (-> self pos quad))
          (cond
            ((logtest? (-> *part-group-id-table* 585 flags) (sp-group-flag sp13))
             (part-tracker-spawn
               part-tracker-subsampler
               :to *active-pool*
               :group (-> *part-group-id-table* 585)))
            (else
             (part-tracker-spawn
               part-tracker
               :to *active-pool*
               :group (-> *part-group-id-table* 585))))
          (set! (-> self phase) 4))
        ((4)
          (set! entity-boss-dying-started? #f)
          (set! entity-boss-go-dormant? #t)
          (kill-by-name (-> self name) *default-pool*)
          (deactivate self))
      )
      (entity-boss-dying-sync-model self)
      (suspend)
    )
  )
)

