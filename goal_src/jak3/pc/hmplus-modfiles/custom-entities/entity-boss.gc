(in-package goal)

;;name: entity-boss.gc

(define *m00* 30.0)

(define *m11* 20.0)

(define *mss* 1.5)

(defskelgroup skel-roboguard-test roboguard roboguard-lod0-jg roboguard-idle0-ja ;;test skeleton
              ((roboguard-lod0-mg (meters 20)) (roboguard-lod1-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 99999)
              :shadow roboguard-shadow-mg
              :origin-joint-index 3
              )

(defskelgroup skel-precursor-boss-1 precursor precursor-lod0-jg precursor-idle-ja
              ((precursor-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 8)
              :origin-joint-index 6
              )

(deftype entity-boss (nav-enemy)
  ((nav-vector            vector :inline)
   (last-thrust-vec        vector :inline)
   (max-speed             float)
   (desired-float-height  float)
   (desired-y-height      float)
   (y-movement            float)
   (bob-speed-scalar      float)
   (ground-height         float)
   (ground-offset         float)
   (should-rise?          symbol)
   (rise-speed            float)
  )
  (:state-methods
    idle2
    hostile
    dead
  )
  (:methods
    (entity-boss-method-203 (_type_ symbol) none)
    (entity-boss-method-161 (_type_) none)
    (entity-boss-method-198 (_type_) none)
    (entity-boss-manipy-track (_type_) none)
    (entity-boss-probe-ground (_type_ vector) float)
    (move-to-ground-height (_type_ float) none)
    (entity-boss-bind-idle-anim! (_type_) none)
  )
)

(define *entity-boss* (the (pointer entity-boss) #f))

(define *entity-boss-nav-enemy-info*
  (new 'static 'nav-enemy-info
    :use-die-falling #f
    :use-victory #f
    :use-jump-blocked #f
    :debug-draw-neck #f
    :jump-debug-draw #f
    :move-to-ground #f
    :hover-if-no-ground #t
    :idle-anim 0
    :notice-anim 0
    :hostile-anim 0
    :hit-anim 0
    :knocked-anim 0
    :knocked-land-anim 0
    :die-anim 0
    :die-falling-anim -1
    :victory-anim -1
    :notice-distance (meters 30)
    :notice-distance-delta (meters 10)
    :default-hit-points 100.0
    :gnd-collide-with (collide-spec backgnd obstacle hit-by-others-list)
    :overlaps-others-collide-with-filter (collide-spec jak bot player-list)
    :movement-gravity (meters -100)
    :friction 0.8
    :attack-mode 'generic
    :attack-damage 1
    :walk-anim 0
    :turn-anim -1
    :run-anim 0
    :taunt-anim -1
    :run-travel-speed (meters 20)
    :run-acceleration (meters 1)
    :run-turning-acceleration (meters 2)
    :walk-travel-speed (meters 20)
    :walk-acceleration (meters 1)
    :walk-turning-acceleration (meters 1)
    :maximum-rotation-rate (degrees 720)
    :notice-nav-radius (meters 1)
    :frustration-distance (meters 8)
    :frustration-time (seconds 4)
    :blocked-time (seconds 0.3)
    :circle-dist-lo 20480.0
    :circle-dist-hi 61440.0
    :nav-mesh #f
  )
)


(set! (-> *entity-boss-nav-enemy-info* fact-defaults) *fact-info-enemy-defaults*)


(defmethod entity-boss-probe-ground ((this entity-boss) (pos vector))
  (let ((q (new 'stack-no-clear 'collide-query)))
    (vector+float*! (-> q start-pos) pos *up-vector* 81920.0)
    (set! (-> q move-dist quad) (the-as uint128 0))
    (set! (-> q move-dist y) -245760.0)
    (set! (-> q radius) 40.96)
    (set! (-> q collide-with) (collide-spec backgnd))
    (set! (-> q ignore-process0) #f)
    (set! (-> q ignore-process1) #f)
    (set! (-> q ignore-pat)
          (new 'static 'pat-surface
            :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> q action-mask) (collide-action solid))
    (if (>= (fill-and-probe-using-line-sphere *collide-cache* q) 0.0)
        (-> q best-other-tri intersect y)
        -40960000.0)
  )
)

(defmethod move-to-ground-height ((this entity-boss) (gnd float))
  (set! (-> this ground-height) gnd)
  (let ((miny (+ gnd (-> this ground-offset))))
    (when (< (-> this root trans y) miny)
      (set! (-> this root trans y) miny)
      (set! (-> this y-movement) 0.0)
    )
  )
  (none)
)

(define *hh0* 20.0)
(define *hh1* 8.0)
(define *hhs* 4.0)

(defmethod entity-boss-method-161 ((this entity-boss)) ;hover up and down?? (adjust this later)
  (let ((g (entity-boss-probe-ground this (-> this root trans))))
    (when (> g -10000000.0)
      (move-to-ground-height this g)
      (set! (-> this desired-y-height) (+ g (-> this desired-float-height)))
    )
  )
  (when (-> this should-rise?)
    (let ((goal (-> this desired-y-height)))
      (set! (-> this root trans y) (+ (-> this root trans y) (* (-> this rise-speed) (seconds-per-frame))))
      (when (<= goal (-> this root trans y))
        (set! (-> this root trans y) goal)
        (set! (-> this y-movement) 0.0)
        (set! (-> this should-rise?) #f)
      )
    )
    (none)
  )
  (let* ((err (- (-> this desired-y-height) (-> this root trans y)))
         (damp 0.0))
    (when (< 8192.0 (fabs (-> this y-movement)))
      (let ((t (* 0.00012207031 (+ -8192.0 (fabs (-> this y-movement))))))
        (set! damp (lerp 0.0 *hh1* (fmax 0.0 (fmin 1.0 t))))
      )
    )
    (let ((acc (* (+ (* *hh0* err) (* damp (- (-> this y-movement))))
                  *hhs*
                  (-> this bob-speed-scalar)
                  (seconds-per-frame))))
      (+! (-> this y-movement) (* acc (seconds-per-frame)))
    )
  )

  (set! (-> this root trans y) (+ (-> this root trans y) (* (-> this y-movement) (seconds-per-frame))))
  (none)
)

(defmethod entity-boss-method-203 ((this entity-boss) (use-focus-vel? symbol)) ;;hook to target position for xy movement? (adjust this later)
  (let* ((st (-> this nav state))
         (target (new 'stack-no-clear 'vector))
         (focus-vel (new-stack-vector0)))
    (set! (-> target quad) (-> this focus-pos quad))
    (set! (-> st target-pos quad) (-> target quad))
    (when use-focus-vel?
      (let ((fp (the-as process-focusable (handle->process (-> this focus handle)))))
        (when fp
          (vector-float*! focus-vel (-> fp root transv) 1.0)
        )
      )
    )
    (let ((dist (vector-vector-xz-distance (-> this root trans) target)))
      (let* ((desired (vector+float*! (new 'stack-no-clear 'vector) focus-vel (-> this nav-vector) dist))
             (to-desired (vector-! (new 'stack-no-clear 'vector) desired (-> this root transv))))
        (vector-lerp! (-> this last-thrust-vec) (-> this last-thrust-vec) to-desired (* 2.0 (seconds-per-frame)))
        (set! (-> to-desired quad) (-> this last-thrust-vec quad))
        (let* ((facing (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> this root transv) 1.0))
               (thrustn (vector-normalize-copy! (new 'stack-no-clear 'vector) to-desired 1.0))
               (align (vector-dot facing thrustn))
               (spd (vector-length (-> this root transv)))
               (mag (* (+ (* *m00* dist) (* -1.0 spd align *m11*))
                       (lerp 1.0 2.0 (fmax 0.0 (fmin 1.0 (* 0.0000061035157 (vector-length focus-vel)))))
                       *mss*
                       (seconds-per-frame))))
          (vector-normalize! to-desired (* mag (seconds-per-frame)))
        )
        (vector+! (-> this root transv) (-> this root transv) to-desired)
      )
    )
  )
  (let ((v (vector-length (-> this root transv))))
    (when (< (-> this max-speed) v)
      (vector-float*! (-> this root transv) (-> this root transv) (/ (-> this max-speed) v))
    )
  )
  (vector-v++! (-> this root trans) (-> this root transv))
  (none)
)

(defmethod entity-boss-method-198 ((this entity-boss))
(let ((v1-0 (-> this nav)))
  (logclear! (-> v1-0 flags) (nav-control-flag limit-rotation-rate output-sphere-hash))
  (logclear! (-> this nav flags) (nav-control-flag update-heading-from-facing))
  (set! (-> this enemy-flags) (the-as enemy-flag (logclear (-> this enemy-flags) (enemy-flag ef44))))
  (let ((a1-7 v1-0))
    (set! (-> a1-7 sphere-mask) (the-as uint #x1000fe))
    )
  0
  (let ((a1-9 v1-0))
    (set! (-> a1-9 nav-cull-radius) 12288.0)
    )
  0
  (logclear! (-> v1-0 flags) (nav-control-flag output-sphere-hash))
  )
(set! (-> this enemy-info callback-info) *physics-nav-callback-info*)
(let ((v1-2 this))
  (if (not (logtest? (enemy-flag ef37) (-> v1-2 enemy-flags)))
      (set! (-> v1-2 enemy-flags) (the-as enemy-flag (logior (enemy-flag ef39) (-> v1-2 enemy-flags))))
      )
  (set! (-> v1-2 enemy-flags) (the-as enemy-flag (logior (enemy-flag ef37) (-> v1-2 enemy-flags))))
  (set! (-> v1-2 nav callback-info) (-> v1-2 enemy-info callback-info))
  )
(none)
)

(defstate idle2 (entity-boss) ;;process doesn't even go here because of the joint-anim fail
  :virtual #t
  :enter (behavior ()
    (format #t "entered idle state~%")
  )
  :code (behavior ()
    (loop
      ;(nav-enemy-method-161 self (-> self nav))
      ;(entity-boss-method-203 self #t)
      ;(entity-boss-method-161 self)
      (ja-channel-set! 0)
      (ja :num! (loop! 1.0))
      (format *stdcon* "entity-boss in idle~%")
      (suspend)
    )
  )
)

(defmethod entity-boss-bind-idle-anim! ((this entity-boss))
  (none)
)

(defmethod init-enemy! ((this entity-boss))
  (setup-enemy! this *entity-boss-nav-enemy-info*)
  ;;vv this is all filler junk for later
  (set! (-> this enemy-info callback-info) *physics-nav-callback-info*)
  (set! (-> this nav callback-info) (-> this enemy-info callback-info))
  (set-vector! (-> this nav-vector) 0.0 0.0 1.0 1.0)
  (set-vector! (-> this last-thrust-vec) 0.0 0.0 0.0 1.0)
  (set! (-> this max-speed) (meters 25))
  (set! (-> this desired-float-height) (meters 6))
  (set! (-> this bob-speed-scalar) 1.0)
  (set! (-> this ground-offset) 0.0)
  (set! (-> this rise-speed) (meters 60))
  (set! (-> this should-rise?) #t)
  ;;^^
  (let ((g (entity-boss-probe-ground this (-> this root trans))))
    (when (> g -10000000.0)
      (set! (-> this root trans y) (- g (meters 0))) ;;change to below ground when you stop getting art group errors bruh
    )
  )
  ;; set boss health bar
  (set! enemy-string "The Entity")
  (set! draw-enemy-noto 9999)
  (if (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
    (set! hpbar-max-hit-points (+ 123000.0 (* (the float enemy-noto) 3)))
    (set! hpbar-max-hit-points (+ 260000.0 (* (the float enemy-noto) 3)))
  )
  (when (> hpbar-hit-points hpbar-max-hit-points)
    (set! hpbar-hit-points hpbar-max-hit-points)
  )
  (set! enemy-hp #t)
  (set! (-> this hit-points) hpbar-max-hit-points)
  (none)
)

(defmethod init-enemy-collision! ((this entity-boss))
(let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
  (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
  (set! (-> s5-0 reaction) cshape-reaction-default)
  (set! (-> s5-0 no-reaction)
        (the-as (function collide-shape-moving collide-query vector vector object) nothing)
        )
  (set! (-> s5-0 penetrated-by) (penetrate
                                  generic-attack
                                  lunge
                                  flop
                                  punch
                                  spin
                                  roll
                                  uppercut
                                  bonk
                                  tube
                                  flut-attack
                                  board
                                  mech-punch
                                  dark-punch
                                  dark-smack
                                  flut
                                  )
        )
  (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 5) 0)))
    (set! (-> s5-0 total-prims) (the-as uint 6))
    (set! (-> s4-0 prim-core collide-as) (collide-spec enemy))
    (set! (-> s4-0 prim-core collide-with) (collide-spec backgnd jak hit-by-others-list player-list))
    (set! (-> s4-0 prim-core action) (collide-action solid no-standon))
    (set-vector! (-> s4-0 local-sphere) 0.0 -20480.0 0.0 81920.0)
    (set! (-> s5-0 root-prim) s4-0)
    )
  (let ((v1-13 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
    (set! (-> v1-13 prim-core collide-as) (collide-spec enemy))
    (set! (-> v1-13 prim-core collide-with) (collide-spec backgnd jak hit-by-others-list player-list))
    (set! (-> v1-13 prim-core action) (collide-action solid deadly))
    (set-vector! (-> v1-13 local-sphere) 0.0 0.0 0.0 9420.8)
    )
  (let ((v1-15 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
    (set! (-> v1-15 prim-core collide-as) (collide-spec enemy))
    (set! (-> v1-15 prim-core collide-with) (collide-spec backgnd jak hit-by-others-list player-list))
    (set! (-> v1-15 prim-core action) (collide-action solid deadly))
    (set-vector! (-> v1-15 local-sphere) 0.0 -12288.0 0.0 5324.8)
    )
  (let ((v1-17 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
    (set! (-> v1-17 prim-core collide-as) (collide-spec enemy))
    (set! (-> v1-17 prim-core collide-with) (collide-spec backgnd jak hit-by-others-list player-list))
    (set! (-> v1-17 prim-core action) (collide-action solid))
    (set-vector! (-> v1-17 local-sphere) 0.0 -20480.0 0.0 4096.0)
    )
  (let ((v1-19 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
    (set! (-> v1-19 prim-core collide-as) (collide-spec enemy))
    (set! (-> v1-19 prim-core collide-with) (collide-spec backgnd jak hit-by-others-list player-list))
    (set-vector! (-> v1-19 local-sphere) 0.0 -32768.0 0.0 8192.0)
    )
  (let ((v1-21 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
    (set! (-> v1-21 prim-core collide-as) (collide-spec enemy))
    (set! (-> v1-21 prim-core collide-with) (collide-spec backgnd jak hit-by-others-list player-list))
    (set! (-> v1-21 prim-core action) (collide-action solid no-standon))
    (set-vector! (-> v1-21 local-sphere) 0.0 9011.2 0.0 9420.8)
    )
  (set! (-> s5-0 nav-radius) 6144.0)
  (let ((v1-23 (-> s5-0 root-prim)))
    (set! (-> s5-0 backup-collide-as) (-> v1-23 prim-core collide-as))
    (set! (-> s5-0 backup-collide-with) (-> v1-23 prim-core collide-with))
    )
  (set! (-> s5-0 max-iteration-count) (the-as uint 3))
  (set! (-> this root) s5-0)
  )
(none)
)

(deftype entity-boss-init-params (structure)
  ((pos   vector      :inline)
   (quat  quaternion  :inline))
)

(defbehavior entity-boss-init-by-other entity-boss ((arg0 entity-boss-init-params))
  (stack-size-set! (-> self main-thread) 512)
  (initialize-skeleton
    self
    (the-as skeleton-group (art-group-get-by-name *level* "skel-precursor-boss" (the-as (pointer level) #f)))
    (the-as pair 0)
  )
  (init-enemy-collision! self)
  (set! (-> self root trans quad) (-> arg0 pos quad))
  (quaternion-copy! (-> self root quat) (-> arg0 quat))
  (vector-identity! (-> self root scale))
  (init-enemy! self)
  (let ((nav (find-nearest-nav-mesh (-> arg0 pos) 0.0))
        (cverts (new 'static 'inline-array vector 3
                (static-vectorm 1 0 0)
                (static-vectorm 0 1 0)
                (static-vectorm 0 0 1)
                )
          )
        )
    (if nav
      (change-to nav self)
      (change-to *default-nav-mesh* self)
      )
    (set! (-> self path) (new 'process 'path-control self 'path 0.0 (the entity #f) #f))
    (set! (-> self path curve cverts) cverts)
    (set! (-> self path curve num-cverts) 3)
  (when (not nav)
    (add-process-drawable-to-nav-mesh *default-nav-mesh* self #t)
  )
  )
  (format #t "spawned process ~s~%" (-> self name))
  (go (method-of-object self idle))
  (none)
)

(defun spawn-entity-boss ((arg0 vector) (arg1 quaternion))
  (let ((ebp (new 'static 'entity-boss-init-params)))
    (set! (-> ebp pos quad) (-> arg0 quad))
    (quaternion-copy! (-> ebp quat) arg1)
    (set! *entity-boss* (process-spawn entity-boss ebp :name "Entity-Boss"))
  )
  (none)
)

(defun quickspawn-eb ((vec vector))
  (spawn-entity-boss vec (quaternion-identity! (new 'stack-no-clear 'quaternion)))
  (none)
)

(defun spawn-eb-man ((vec vector)) ;;created as a test to see if the art-group can be loaded ingame (it can)
  (let ((veccy (new 'stack-no-clear 'vector))
        )
      (process-spawn manipy
      :init
      manipy-init
      vec
      #f
      (art-group-get-by-name *level* "skel-precursor-boss-1" (the (pointer level) #f))
      #f
      0
      #f
      :name "man-eb"
      )
  )
  (none)
)