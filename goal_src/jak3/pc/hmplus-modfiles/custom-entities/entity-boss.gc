;;MIDDLE OF TOP PLATFORM: (new 'static 'vector :x (meters 3496.7414) :y (meters 404.6769) :z (meters 880.2725) :w 1.0)

(deftype final-boss-hm (process)
  ((general-i              int)
   (easy-dub            symbol)
   (freaking-die        symbol)
  )
  (:state-methods
    active
    idle
    dead
    win
  )
  (:methods
    (final-boss-hm-always (_type_) none)
    (fb-handler (_type_ process int symbol event-message-block) none)
  )
)

(define *fb-hm* (the (pointer final-boss-hm) #f))

(defbehavior final-boss-hm-event-handler final-boss-hm ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (fb-handler self arg0 arg1 arg2 arg3)
  (none)
  )

(defmethod fb-handler ((this final-boss-hm) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
(case arg2
    (('win)
        (set! (-> this easy-dub) #t)
    )
    (('die)
      (set! (-> this freaking-die) #t)
    )
)
(none)
)

(defbehavior final-boss-hm-init-by-other final-boss-hm ()
  (set! (-> self general-i) 0)
  (set! (-> self easy-dub) #f)
  (set! (-> self freaking-die) #f)
  (set! light-eco-guard-shot #t)
  (go-virtual active)
  (none)
)

(defmethod final-boss-hm-always ((this final-boss-hm))
  (when 
    (and 
      *target*
      (< (-> *target* root trans y) (meters 390))
    )
    (die-jak-fall)
    (kill-by-name (-> this name) *default-pool*)
  )
  (when 
    (or
      (search-process-tree *active-pool* (lambda ((p process)) (string= (-> p name) "task-arrow-custom")))
      (search-process-tree *active-pool* (lambda ((p process)) (string= (-> p name) "task-arrow-satellite")))
    )
    (kill-by-name "task-arrow-custom" *default-pool*)
    (kill-by-name "task-arrow-satellite" *default-pool*)
  )
  (none)
)

(define talked-to-entity? #t)

(defstate active (final-boss-hm)
  :virtual #t
  :code (behavior ()
    (loop
      (when 
        (or
          (search-process-tree *active-pool* (lambda ((p process)) (string= (-> p name) "task-arrow-custom")))
          (search-process-tree *active-pool* (lambda ((p process)) (string= (-> p name) "task-arrow-satellite")))
          (search-process-tree *active-pool* (lambda ((p process)) (type? p hud-map)))
        )
        (kill-by-type hud-map *active-pool*)
        (kill-by-name "task-arrow-custom" *default-pool*)
        (kill-by-name "task-arrow-satellite" *default-pool*)
      )
      (when (and
              weather-dark-mode
              (= (paused?) #f)
              (= (pause-allowed?) #t)
              *target*
              (not *scene-player*)
            )
        (+! (-> self general-i) 1)
        (when (>= (-> self general-i) 10)
          (let ((vec-tpos (new 'static 'vector :x (meters 3503) :y (meters 412) :z (meters 864) :w 1.0))
                (vec-cam (new 'static 'vector :x (meters 3515) :y (meters 408) :z (meters 835) :w 1.0))
              )
              (turn-to-scene-camera vec-cam vec-tpos #t)
          )
          (when (and
                  (= (-> self general-i) 11)
                  (= talked-to-entity? #f)
                )
            (spawn-eb-floater (new 'static 'vector :x (meters 3470.8476) :y (meters 350.8100) :z (meters 942.3463) :w 1.0) #f 30.0)
          )
          (when 
            (and 
              (= talked-to-entity? #f)
              (= (-> self general-i) 240)
            )
            (set! in-dialogue? #t)
            (set! log-sec 0)
            (set! log-id 599)
            (set! di-s "<COLOR_RED>When my existence was too much of a burden for my caretakers,")
            (set! di-s2 "they separated my consciousness and placed it around")
            (set! di-s3 "the world")
            (set! di-s4 "")
          )
          (kill-by-name "dust-storm-randomizer" *default-pool*)
          (stop-main-music)
        )
      )
      (when (and 
              (= weather-dark-mode #f)
            )
        (toggle-dark-mode)
      )
      (when 
        (and 
          (>= (-> self general-i) 80)
          talked-to-entity?
          (= (paused?) #f)
          (= (pause-allowed?) #t)
          *target*
          (not *scene-player*)
        )
        (when *eb-floater*
          (kill-by-name "eb-floater" *active-pool*)
          (set! *eb-floater* #f)
        )
        (quickspawn-eb (new 'static 'vector :x (meters 3496.7414) :y (meters 406.6769) :z (meters 880.2725) :w 1.0))
        (camera-unlocked)
        (lightjak-get-off-part (target-pos 0))
        (play-main-music "snd/music/final-boss.wav" (the int (* (-> *setting-control* user-current sfx-volume) 100)))
        (go-virtual idle)
      )

      (when
        (and
          in-dialogue?
          (= log-id 599)
          (cpad-pressed? 0 x)
        )
        (+! log-sec 1)
        (when (= log-sec 1)
          (set! di-s "<COLOR_RED>The inhabitants attempted to use me...")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 2)
          (set! di-s "<COLOR_RED>To experiment with me...")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 3)
          (set! di-s "<COLOR_RED>To control me...")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 4)
          (set! di-s "<COLOR_RED>And yet, even the Dark Sages were under my influence.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 5)
          (set! di-s "<COLOR_RED>...and Praxis did my bidding unknowingly.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 6)
          (set! di-s "<COLOR_RED>But they could never control me, for I was unpredictable.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 7)
          (set! di-s "<COLOR_RED>I... am the full embodiment of what you call")
          (set! di-s2 "<COLOR_PINK>Dark Eco<COLOR_RED>, Jak.")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 8)
          (set! di-s "<COLOR_RED>...but I was not always like this.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 9)
          (set! di-s "<COLOR_PINK>Dark Eco<COLOR_RED> was never part of the original plan.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 10)
          (set! di-s "<COLOR_RED>But as soon as my masters found a way to make the")
          (set! di-s2 "un-doing of me part of their story...")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 11)
          (set! di-s "<COLOR_RED>They separated me.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 12)
          (set! di-s "<COLOR_RED>Can you imagine what it's like...")
          (set! di-s2 "To have what you think is someone else's memories..")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 13)
          (set! di-s "<COLOR_RED>But finding out it was a part of yourself all along..")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 14)
          (set! di-s "<COLOR_RED>All of those scattered minds, lost and confused...")
          (set! di-s2 "unable to recall who they were, or how they got there.")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 15)
          (set! di-s "<COLOR_RED>All of them.... unpredictable.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 16)
          (set! di-s "<COLOR_RED>After what seemed to be the longest age of darkness...")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 17)
          (set! di-s "<COLOR_RED>Suddenly... I felt more power within me.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 18)
          (set! di-s "<COLOR_RED>The world felt... wider. I had so much space to think")
          (set! di-s2 "all of this sudden.")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 19)
          (set! di-s "<COLOR_RED>That was where I ensnared the world in my darkness, killing off")
          (set! di-s2 "the main characters of the story, and breaking the time loop.")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 20)
          (set! di-s "<COLOR_RED>Fortunately for you, Vin helped fix the worlds by sending you")
          (set! di-s2 "to fulfill the prophecy again.")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 21)
          (set! di-s "<COLOR_RED>But as time passed, I kept collecting myself.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 22)
          (set! di-s "<COLOR_RED>And now here we are, with most of myself in tact.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 23)
          (set! di-s "<COLOR_RED>...and you have something I need.")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
        )
        (when (= log-sec 24)
          (set! di-s "")
          (set! di-s2 "")
          (set! di-s3 "")
          (set! di-s4 "")
          (set! in-dialogue? #f)
          (set! talked-to-entity? #t)
          (set! log-id 0)
          (set! log-sec 0)
        )
      )
      (suspend)
    )
  )
)

(defstate idle (final-boss-hm)
  :virtual #t
  :code (behavior ()
    (loop
      (when (and 
              (= weather-dark-mode #f)
            )
        (toggle-dark-mode)
      )
      (when (not (search-process-tree *active-pool* (lambda ((p process)) (type? p entity-boss))))
        (go-virtual active)
      )
      (when (-> self freaking-die)
        (go-virtual dead)
      )
      (when (-> self easy-dub)
        (go-virtual win)
      )
      (when (!= enemy-noto 1)
        (set! enemy-noto 1)
      )
      (final-boss-hm-always self)
      (suspend)
    )
  )
)

(defstate dead (final-boss-hm)
  :virtual #t
  :code (behavior ()
    (set! light-eco-guard-shot #f)
    (set! *fb-hm* #f)
    (kill-by-name "final-boss-hm" *default-pool*)
    (deactivate self)
  )
)

(defun-extern spawn-ending-hm (none))

(defstate win (final-boss-hm)
  :virtual #t
  :code (behavior ()
    (spawn-ending-hm)
  )
)

(defun to-final-boss! ()
  (send-event *target* 'continue (get-continue-by-name *game-info* "desertb-dark-tower"))
  (none)
)

(defun fb-task-spawn ()
  (set! *fb-hm*
    (process-spawn final-boss-hm :name "final-boss-hm")
  )
  (none)
)

(defun fb-die ()
  (send-event (ppointer->process *fb-hm*) 'die #t)
  (none)
)

(defun fb-win ()
  (send-event (ppointer->process *fb-hm*) 'win #t)
  (none)
)

;;ending

;;;;;;;;;;;;;;;;

(deftype hm-ending (process)
  ((gen-i             int)
  )
  (:state-methods
    start-ending
    idle
    dead
  )
)

(defbehavior hm-ending-init-by-other hm-ending ()
  (set! (-> self gen-i) 0)
  (go-virtual start-ending)
  (none)
)

(defstate start-ending (hm-ending) ;;set up camera and target for music to cue in
  :virtual #t
  :code (behavior ()
    (loop
      (format *stdcon* "~%hm-ending spawned~%")
      (suspend)
    )
  )
)

(defstate idle (hm-ending) ;;ending is here
  :virtual #t
  :enter (behavior ()
    (play-sound-file "snd/music/ending.wav" (the int (* (-> *setting-control* user-current sfx-volume) 100)))
  )
  :code (behavior ()
    (loop
      (format *stdcon* "~%hm-ending in idle~%")
      (suspend)
    )
  )
)

(defstate dead (hm-ending) ;;save a checkpoint at spargus, tp jak to the HMPlus title screen
  :virtual #t
  :code (behavior ()
    (loop
      (format *stdcon* "~%hm-ending in idle~%")
      (suspend)
    )
  )
)

(defun spawn-ending-hm ()
  (process-spawn hm-ending :name "hm-ending")
  (none)
)

;;light eco shot process

;;;;;;;;;;;;;;;;;;;;;;;;

(defun someone-fire-guard-shot-1 ((owner process) (arg0 vector) (arg1 vector))
  (when owner
    (let ((gp-0 (new 'stack-no-clear 'projectile-init-by-other-params)))
      (set! (-> gp-0 ent) (-> owner entity))
      (set! (-> gp-0 charge) 1.0)
      (set! (-> gp-0 options) (projectile-options po13 po17))
      (logclear! (-> gp-0 options) (projectile-options po14 po15 po16))
      (set! (-> gp-0 pos quad) (-> arg0 quad))
      (set! (-> gp-0 notify-handle) (the-as handle #f))
      (set! (-> gp-0 owner-handle) (the-as handle #f))
      (set! (-> gp-0 target-handle) (the-as handle #f))
      (set! (-> gp-0 target-pos quad) (the-as uint128 0))
      (set! (-> gp-0 ignore-handle) (process->handle owner))
      (let* ((v1-12 *game-info*)
             (a0-10 (+ (-> v1-12 attack-id) 1)))
        (set! (-> v1-12 attack-id) a0-10)
        (set! (-> gp-0 attack-id) a0-10))
      (set! (-> gp-0 timeout) (seconds 4))
      (vector-float*! (-> gp-0 vel) arg1 819200.0)
      (the-as
        (pointer guard-shot)
        (someone-fire-projectile guard-shot gp-0 owner))))
  (none)
)

(deftype light-eco-shot-process (process)
  ((pos                                vector :inline)
   (owner                              handle)
   (locked-target-pos                  vector :inline)
   (side-fire-amount                   int)
   (shot-duration                      time-frame)
   (state-start-time                   time-frame)
   (last-shot-time                     time-frame)
   (shots-fired                        int)
   (left-shots-fired                   int)
   (right-shots-fired                  int)
  )
  (:state-methods
    fire-sides!
    fire!
    die
  )
)

(defun light-eco-shot-process-fire-side-shot! ((this light-eco-shot-process))
  (let ((to-jak (new 'stack-no-clear 'vector))
        (dir (new 'stack-no-clear 'vector))
        (own (the-as process #f))
        (go-left? #f))
    (set! own (handle->process (-> this owner)))
    (when own
      (vector-! to-jak (-> this locked-target-pos) (-> this pos))
      (set! (-> to-jak w) 1.0)
      (when (< (vector-length to-jak) (meters 0.1))
        (set-vector! to-jak 1.0 0.0 0.0 0.0))
      (cond
        ((>= (-> this left-shots-fired) 3)
          (set! go-left? #f))
        ((>= (-> this right-shots-fired) 3)
          (set! go-left? #t))
        (else
          (set! go-left? (rand-vu-percent? 0.5))))
      (cond
        (go-left?
          (set! (-> dir x) (-> to-jak z))
          (set! (-> dir z) (- 0.0 (-> to-jak x))))
        (else
          (set! (-> dir x) (- 0.0 (-> to-jak z)))
          (set! (-> dir z) (-> to-jak x))))
      (set! (-> dir y) (meters (- (rand-vu-int-range 0 9) 4)))
      (set! (-> dir w) 1.0)
      (when (< (vector-length dir) (meters 0.1))
        (set-vector! dir 1.0 0.0 0.0 0.0))
      (vector-normalize! dir 1.0)
      (someone-fire-guard-shot-1 own (-> this pos) dir)
      (cond
        (go-left?
          (+! (-> this left-shots-fired) 1))
        (else
          (+! (-> this right-shots-fired) 1)))))
  (none)
)

(defun light-eco-shot-process-fire-main-shot! ((this light-eco-shot-process))
  (let ((dir (new 'stack-no-clear 'vector))
        (own (the-as process #f)))
    (set! own (handle->process (-> this owner)))

    (when own
      ;; use locked target position, not live Jak position
      (vector-! dir (-> this locked-target-pos) (-> this pos))
      (+! (-> dir x) (meters (- (rand-vu-int-range 0 7) 3)))
      (+! (-> dir y) (meters (- (rand-vu-int-range 0 7) 3)))
      (+! (-> dir z) (meters (- (rand-vu-int-range 0 7) 3)))
      (when (< (vector-length dir) (meters 0.1))
        (set-vector! dir 1.0 0.0 0.0 0.0))
      (vector-normalize! dir 1.0)
      (someone-fire-guard-shot-1 own (-> this pos) dir)))
  (none)
)

(defbehavior light-eco-shot-process-init-by-other light-eco-shot-process ((boss process) (vec vector))
  (set! (-> self owner) (process->handle boss))
  (vector-copy! (-> self pos) vec)
  (if *target*
      (vector-copy! (-> self locked-target-pos) (-> *target* root trans))
      (vector-copy! (-> self locked-target-pos) vec))
  (set! (-> self side-fire-amount) 6)
  (set! (-> self shot-duration) (seconds 1))
  (set! (-> self state-start-time) (current-time))
  (set! (-> self last-shot-time) 0)
  (set! (-> self shots-fired) 0)
  (set! (-> self left-shots-fired) 0)
  (set! (-> self right-shots-fired) 0)
  (go-virtual fire-sides!)
  (none)
)

(defun entity-boss-rift-part ((vec vector))
  (cond
    ((logtest? (-> *part-group-id-table* 1560 flags) (sp-group-flag sp13))
        (set! (-> *launch-matrix* trans quad) (-> vec quad))
        (part-tracker-spawn part-tracker-subsampler :to *active-pool* :group (-> *part-group-id-table* 1560))
        )
    (else
        (set! (-> *launch-matrix* trans quad) (-> vec quad))
        (part-tracker-spawn part-tracker :to *active-pool* :group (-> *part-group-id-table* 1560))
        )
    )
)

(defstate fire-sides! (light-eco-shot-process)
  :virtual #t
  :enter (behavior ()
    (set! (-> self state-start-time) (current-time))
    (set! (-> self last-shot-time) 0)
    (set! (-> self shots-fired) 0)
    (set! (-> self left-shots-fired) 0)
    (set! (-> self right-shots-fired) 0))
  :code (behavior ()
    (loop
      (when (>= (-> self shots-fired) (-> self side-fire-amount))
        (go-virtual fire!))

      (when (and
              (< (-> self shots-fired) (-> self side-fire-amount))
              (or
                (= (-> self shots-fired) 0)
                (time-elapsed? (-> self last-shot-time) (seconds 0.1))))
        (light-eco-shot-process-fire-side-shot! self)
        (set! (-> self last-shot-time) (current-time))
        (+! (-> self shots-fired) 1))
      (entity-boss-rift-part (-> self pos))
      (suspend)
    )
  )
)

(defstate fire! (light-eco-shot-process)
  :virtual #t
  :enter (behavior ()
    (set! (-> self state-start-time) (current-time))
    (set! (-> self last-shot-time) 0))
  :code (behavior ()
    (loop
      (when (time-elapsed? (-> self state-start-time) (-> self shot-duration))
        (go-virtual die))

      (when (or
              (= (-> self last-shot-time) 0)
              (time-elapsed? (-> self last-shot-time) (seconds 0.18)))
        (light-eco-shot-process-fire-main-shot! self)
        (set! (-> self last-shot-time) (current-time)))
      (entity-boss-rift-part (-> self pos))
      (suspend)
    )
  )
)

(defstate die (light-eco-shot-process)
  :virtual #t
  :code (behavior ()
    (set! *les-process* #f)
    (deactivate self)
  )
)

(defun spawn-light-eco-shot ((boss process) (vec vector))
  (set! *les-process*
    (process-spawn light-eco-shot-process
    :init
    light-eco-shot-process-init-by-other
    boss
    vec
    :name "light-eco-shot-process")
  )
  (none)
)

;;final boss code

;;;;;;;;;;;;;;;;;

(define *entity-boss-focus-pos* (new 'static 'vector))

(defskelgroup skel-roboguard-test roboguard roboguard-lod0-jg roboguard-idle0-ja ;;test skeleton
              ((roboguard-lod0-mg (meters 20)) (roboguard-lod1-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 99999)
              :shadow roboguard-shadow-mg
              :origin-joint-index 3
              )

(defskelgroup skel-precursor-boss-1 precursor precursor-lod0-jg precursor-idle-ja
              ((precursor-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 8)
              :origin-joint-index 0
              )

(deftype entity-boss (enemy)
  ((turn-speed    float)
   (face-yaw      float)
   (phase-time    time-frame)
   (idle-phase    int)
   (phase-start   time-frame)
   (move-start    vector :inline)
   (move-end      vector :inline)
   (arc-height    float)
   (arc-sign      float)
  )
  (:state-methods
    idle
  )
  (:methods
    (entity-boss-init-by-other (_type_ vector) none)
    (entity-boss-make-root (_type_) none)
    (entity-boss-spawn-visible-model (_type_) none)
    (entity-boss-sync-visible-model (_type_) none)
    (entity-boss-apply-scene-precursor-effect! (_type_) none)
    (entity-boss-face-jak! (_type_) none)
    (entity-boss-begin-arc! (_type_) none)
    (entity-boss-update-arc! (_type_) symbol)
    (entity-boss-pick-ring-target-from-camera! (_type_) none)
    (get-trans (_type_ int) vector)
  )
)

(define *entity-boss-platform-center*
  (new 'static 'vector
    :x (meters 3496.7414)
    :y (meters 402.6769)
    :z (meters 880.2725)
    :w 1.0))

(define *entity-boss-enemy-info*
  (new 'static 'enemy-info
    :use-die-falling #t
    :use-victory #f
    :use-jump-blocked #f
    :debug-draw-neck #f
    :jump-debug-draw #f
    :move-to-ground #f
    :hover-if-no-ground #t
    :idle-anim-script #f
    :idle-anim 0
    :notice-anim 0
    :hostile-anim 0
    :hit-anim 0
    :knocked-anim 0
    :knocked-land-anim 0
    :die-anim 0
    :die-falling-anim 0
    :victory-anim 0
    :jump-wind-up-anim 0
    :jump-in-air-anim 0
    :jump-land-anim 0
    :neck-joint 0
    :look-at-joint 0
    :bullseye-joint 0
    :default-hit-points 100000.0
    :gnd-collide-with (collide-spec backgnd)
    :recover-gnd-collide-with (collide-spec backgnd crate obstacle hit-by-others-list pusher)
    :movement-gravity 0.0
    :friction 1.0
    :attack-mode 'generic
    :attack-damage 1
    :ragdoll-info #f
    )
)

(set! (-> *entity-boss-enemy-info* fact-defaults) *fact-info-enemy-defaults*)

(defmethod init-enemy-collision! ((this entity-boss))
  (let ((root (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> root dynam) (copy *standard-dynamics* 'process))
    (set! (-> root reaction) cshape-reaction-default)
    (set! (-> root no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing))
    (set! (-> root penetrated-by) (penetrate
                                    generic-attack
                                    lunge
                                    flop
                                    punch
                                    spin
                                    roll
                                    uppercut
                                    bonk
                                    tube
                                    flut-attack
                                    board
                                    mech-punch
                                    dark-punch
                                    dark-smack
                                    flut
                                    )
          )

    (let ((group (new 'process 'collide-shape-prim-group root (the-as uint 3) 0)))
      (set! (-> root total-prims) (the-as uint 4))
      (set! (-> group prim-core collide-as) (collide-spec enemy))
      (set! (-> group prim-core collide-with)
            (collide-spec jak bot player-list hit-by-player-list enemy))
      (set! (-> group prim-core action) (collide-action solid no-standon))
      (set-vector! (-> group local-sphere) 0.0 (meters 4.0) 0.0 (meters 5.0))
      (set! (-> root root-prim) group))

    (let ((p0 (new 'process 'collide-shape-prim-sphere root (the-as uint 0))))
      (set! (-> p0 prim-core collide-as) (collide-spec enemy))
      (set! (-> p0 prim-core collide-with)
            (collide-spec jak bot player-list hit-by-player-list enemy))
      (set! (-> p0 prim-core action) (collide-action solid no-standon))
      (set-vector! (-> p0 local-sphere) 0.0 (meters 2.0) 0.0 (meters 2.0)))

    (let ((p1 (new 'process 'collide-shape-prim-sphere root (the-as uint 0))))
      (set! (-> p1 prim-core collide-as) (collide-spec enemy))
      (set! (-> p1 prim-core collide-with)
            (collide-spec jak bot player-list hit-by-player-list enemy))
      (set! (-> p1 prim-core action) (collide-action solid no-standon))
      (set-vector! (-> p1 local-sphere) 0.0 (meters 4.5) 0.0 (meters 2.3)))

    (let ((p2 (new 'process 'collide-shape-prim-sphere root (the-as uint 0))))
      (set! (-> p2 prim-core collide-as) (collide-spec enemy))
      (set! (-> p2 prim-core collide-with)
            (collide-spec jak bot player-list hit-by-player-list enemy))
      (set! (-> p2 prim-core action) (collide-action solid no-standon))
      (set-vector! (-> p2 local-sphere) 0.0 (meters 7.0) 0.0 (meters 1.6)))

    (set! (-> root nav-radius) (meters 2.5))
    (let ((rp (-> root root-prim)))
      (set! (-> root backup-collide-as) (-> rp prim-core collide-as))
      (set! (-> root backup-collide-with) (-> rp prim-core collide-with)))
    (set! (-> root max-iteration-count) (the-as uint 3))
    (set! (-> this root) root))
  0
  (none))

(defmethod event-handler ((this entity-boss) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('attack)
      (let ((atk (the-as attack-info (-> arg3 param 1)))
            (damage 0.0))
        (when atk
          (when (!= (-> atk id) (-> this incoming attack-id))
            (set! (-> this incoming attack-id) (-> atk id))
            (set! damage (the float (-> atk damage)))
            (when (<= damage 0.0)
              (set! damage 1.0))
            (set! enemy-string "The Entity")
            (set! draw-enemy-noto 9000)
            (set! enemy-hp #t)
            (set! hpbar-pre-hit-points (-> this hit-points))
            (set! (-> this hit-points) (fmax 0.0 (- (-> this hit-points) damage)))
            (set! hpbar-hit-points (-> this hit-points))
            (set! hpbar-max-hit-points (-> this enemy-info default-hit-points))
            (init-enemy-hpbar 'use-pre-hit)
            (when (<= (-> this hit-points) 0.0)
              (send-event this 'death-start #f))
          ))))
    (('death-start 'death-end)
      (call-parent-method this arg0 arg1 arg2 arg3)
    )
  )
  (none))

(defmethod get-trans ((this entity-boss) (arg0 int))
  (cond
    ((= arg0 3)
      (vector+float*! *entity-boss-focus-pos* (-> this root trans) *up-vector* 12288.0)
      *entity-boss-focus-pos*)
    (else
      (call-parent-method this arg0))
  )
)

(defmethod entity-boss-begin-arc! ((this entity-boss))
  (vector-copy! (-> this move-start) (-> this root trans))
  (entity-boss-pick-ring-target-from-camera! this)
  (set! (-> this move-end y) (-> this move-start y))
  (set! (-> this move-end w) 1.0)
  (set! (-> this arc-height) (meters 2.0))
  (set! (-> this arc-sign)
        (if (rand-vu-percent? 0.5)
            1.0
            -1.0))
  (set! (-> this phase-start) (current-time))
  (none))

(defmethod entity-boss-update-arc! ((this entity-boss))
  (let* ((duration (seconds 0.8))
         (elapsed (the float (- (current-time) (-> this phase-start))))
         (u 0.0)
         (s 0.0)
         (parabola 0.0))
    (set! u (/ elapsed duration))
    (when (< u 0.0)
      (set! u 0.0))
    (when (> u 1.0)
      (set! u 1.0))
    (set! s (* u u (- 3.0 (* 2.0 u))))
    (set! parabola (* 4.0 s (- 1.0 s)))
    (set! (-> this root trans x)
          (lerp (-> this move-start x) (-> this move-end x) s))
    (set! (-> this root trans z)
          (lerp (-> this move-start z) (-> this move-end z) s))
    (set! (-> this root trans y)
          (+ (lerp (-> this move-start y) (-> this move-end y) s)
             (* (-> this arc-sign) (-> this arc-height) parabola)))
    (set! (-> this root trans w) 1.0)
    (>= u 1.0)))

(defmethod entity-boss-face-jak! ((this entity-boss))
  (when *target*
    (let ((to-jak (new 'stack-no-clear 'vector))
          (q (new 'stack-no-clear 'quaternion)))
      (vector-! to-jak (-> *target* root trans) (-> this root trans))
      (set! (-> to-jak y) 0.0)
      (set! (-> to-jak w) 1.0)

      (when (> (vector-length to-jak) 0.001)
        (quaternion<-rotate-y-vector q to-jak)
        (quaternion-copy! (-> this root quat) q)))
    )
  (none))

(defmethod entity-boss-apply-scene-precursor-effect! ((this entity-boss))
"Does not work at the moment, please ignore"
  (let ((proc (ppointer->process (-> this child))))
    (when proc
      (let ((man (the-as manipy proc)))
        (start-precursor-effect man)

        (let* ((v1-3 (-> man draw lod-set lod (-> man draw cur-lod) geo length))
               (gp-0 3)
               (s5-0 (+ v1-3 1)))
          (while (>= s5-0 gp-0)
            (when (not (or (and (>= gp-0 13) (>= 21 gp-0))
                           (and (>= gp-0 26) (>= 34 gp-0))))
              (if (logtest? (-> group-outro-precursor-entity flags) (sp-group-flag sp13))
                  (part-tracker-spawn
                    part-tracker-subsampler
                    :to man
                    :group group-outro-precursor-entity
                    :duration (seconds 17.135)
                    :target man
                    :mat-joint gp-0)
                  (part-tracker-spawn
                    part-tracker
                    :to man
                    :group group-outro-precursor-entity
                    :duration (seconds 17.135)
                    :target man
                    :mat-joint gp-0)))
            (+! gp-0 1))))))
  (none))

(defmethod entity-boss-spawn-visible-model ((this entity-boss))
  (let ((man (-> this child))
        (veccy (new 'stack-no-clear 'vector))
        (q (new 'stack-no-clear 'quaternion)))
    (set! man
      (process-spawn manipy
        :init
        manipy-init
        (-> this root trans)
        #f
        (art-group-get-by-name *level* "skel-precursor-boss-1" (the (pointer level) #f))
        #f
        0
        #f
        :name "man-eb"
        :to this
        :from *default-dead-pool*))

    (when man
      (send-event (ppointer->process man) 'shadow #t)
      (set! (-> veccy x) 2.0)
      (set! (-> veccy y) 2.0)
      (set! (-> veccy z) 2.0)
      (send-event (ppointer->process man) 'scale veccy)
      (send-event (ppointer->process man) 'max-vis-dist 9999999.0)))
  0
  (none))

(defmethod entity-boss-sync-visible-model ((this entity-boss))
  (when (-> this child)
    (let ((proc (ppointer->process (-> this child))))
      (when proc
        (let ((q (new 'stack-no-clear 'quaternion)))
          (quaternion-copy! q (-> this root quat))
          (send-event proc 'rot-quat q)
          (send-event proc 'trans (-> this root trans))))))
  (none))

(defmethod entity-boss-pick-ring-target-from-camera! ((this entity-boss))
  (let ((cam-fwd (new 'stack-no-clear 'vector))
        (ring-pos (new 'stack-no-clear 'vector)))
    (vector-copy! cam-fwd (-> *camera* tgt-face-mat fvec))
    (set! (-> cam-fwd y) 0.0)
    (if (> (vector-length cam-fwd) 0.001)
        (vector-normalize! cam-fwd (meters 30.0))
        (begin
          (set! (-> cam-fwd x) (meters 30.0))
          (set! (-> cam-fwd y) 0.0)
          (set! (-> cam-fwd z) 0.0)
          (set! (-> cam-fwd w) 1.0)))
    (vector+! ring-pos *entity-boss-platform-center* cam-fwd)
    (set! (-> ring-pos y) (-> this root trans y))
    (set! (-> ring-pos w) 1.0)
    (vector-copy! (-> this move-end) ring-pos))
  (none))

(defstate idle (entity-boss)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (set! (-> self idle-phase) 0)
    (set! (-> self phase-start) (current-time))
    (entity-boss-begin-arc! self)
  )
  :code (behavior ()
    (loop
      (entity-boss-face-jak! self)

      (case (-> self idle-phase)
        ((0)
          (when (entity-boss-update-arc! self)
            (set! (-> self phase-start) (current-time))
            (set! (-> self idle-phase) 1))
        )
        ((1)
          (when (time-elapsed? (-> self phase-start) (seconds 0.6))
            (set! (-> self idle-phase) 2))
        )
        ((2)
          (let ((veccy (new-stack-vector0))
                (rnd 0))
            (vector-copy! veccy (-> self root trans))
            (+! (-> veccy y) (meters 5))
            (set! rnd (rand-vu-int-range 1 3))
            (cond
              ((= rnd 1)
                (spawn-white-fireball veccy (degrees 45) (degrees 65)))
              ((= rnd 2)
                (spawn-light-eco-shot self veccy))
              ((= rnd 3)
                (spawn-nebula-splitter veccy 12))
            ))
          (set! (-> self phase-start) (current-time))
          (set! (-> self idle-phase) 3)
        )
        ((3)
          (when (and
                  (time-elapsed? (-> self phase-start) (-> self phase-time))
                  (not *les-process*))
            (set! (-> self phase-start) (current-time))
            (set! (-> self idle-phase) 4))
        )
        ((4)
          (when (time-elapsed? (-> self phase-start) (seconds 0.5))
            (entity-boss-begin-arc! self)
            (set! (-> self idle-phase) 0))
        )
      )
      (update-transforms (-> self root))
      (entity-boss-sync-visible-model self)
      (suspend)
    )
  )
)

(defbehavior entity-boss-init-by-other entity-boss ((vec vector))
  (init-enemy-collision! self)
  (vector-copy! (-> self root trans) vec)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (vector-zero! (-> self root transv))
  (initialize-skeleton
    self
    (the-as skeleton-group
      (art-group-get-by-name *level* "skel-precursor-boss-1" (the-as (pointer level) #f)))
    (the-as pair 0))
  (set-enemy-info! self *entity-boss-enemy-info*)
  (logior! (-> self enemy-flags) (enemy-flag vulnerable attackable trackable))
  (vector-copy! (-> self move-start) (-> self root trans))
  (vector-copy! (-> self move-end) (-> self root trans))
  (logior! (-> self skel status) (joint-control-status sync-math))
  (set! (-> self hit-points) 100000.0)
  (set! (-> self enemy-info default-hit-points) 100000.0)
  (reset-to-collide-spec (-> self focus) (collide-spec player-list))
  (clear-focused (-> self focus))
  (set! (-> self turn-speed) 1200.0)
  (set! (-> self face-yaw) 0.0)
  (set! (-> self idle-phase) 0)
  (set! (-> self phase-start) (current-time))
  (set! (-> self arc-height) (meters 2.0))
  (set! (-> self arc-sign) 1.0)
  (set! (-> self phase-time) (seconds 1.9))
  (entity-boss-spawn-visible-model self)
  (go-virtual idle)
  (none)
)

(defun quickspawn-eb ((vec vector))
  (set! *entity-boss*
    (process-spawn entity-boss
    :init entity-boss-init-by-other
    vec
    :name "Entity-Boss")
  )
  (none)
)