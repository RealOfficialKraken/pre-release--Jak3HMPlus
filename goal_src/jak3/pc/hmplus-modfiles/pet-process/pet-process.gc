;;pet-menu process

(define enabled-pet-flitter? #f)
(define enabled-pet-spiky-frog? #f)
(define enabled-pet-rat? #f)
(define enabled-pet-manta? #f)
(define enabled-pet-neo-wasp? #f)
(define enabled-pet-kangarat? #f)
(define enabled-pet-mantis? #f)
(define enabled-pet-terra? #f)
(define enabled-pet-scouter? #f)
(define enabled-pet-dogat? #f)

(define pet-flitter-s "???")
(define pet-spiky-frog-s "???")
(define pet-rat-s "???")
(define pet-manta-s "???")
(define pet-neo-wasp-s "???")
(define pet-kangarat-s "???")
(define pet-mantis-s "???")
(define pet-terra-s "???")
(define pet-scouter-s "???")
(define pet-dogat-s "???")

(defun pet-menu-toggle-pet! ((idx int))
  (case idx
    ((0)
      (when (task-node-closed? (game-task-node pet-flitter))
        (if enabled-pet-flitter?
          (begin
            (set! enabled-pet-flitter? #f)
            (kill-by-name "pet-flitter" *default-pool*))
          (begin
            (set! enabled-pet-flitter? #t)
            (spawn-pet-flitter)))))
    ((1)
      (when (task-node-closed? (game-task-node pet-spiky-frog))
        (if enabled-pet-spiky-frog?
          (begin
            (set! enabled-pet-spiky-frog? #f)
            (kill-by-name "pet-spiky-frog" *default-pool*))
          (begin
            (set! enabled-pet-spiky-frog? #t)
            (spawn-pet-spiky-frog)))))
    ((2)
      (when (task-node-closed? (game-task-node pet-rat))
        (if enabled-pet-rat?
          (begin
            (set! enabled-pet-rat? #f)
            (kill-by-name "pet-rat" *default-pool*))
          (begin
            (set! enabled-pet-rat? #t)
            (spawn-pet-rat)))))
    ((3)
      (when (task-node-closed? (game-task-node pet-manta))
        (if enabled-pet-manta?
          (begin
            (set! enabled-pet-manta? #f)
            (kill-by-name "pet-manta" *default-pool*))
          (begin
            (set! enabled-pet-manta? #t)
            (spawn-pet-manta)))))
    ((4)
      (when (task-node-closed? (game-task-node pet-neo-wasp))
        (if enabled-pet-neo-wasp?
          (begin
            (set! enabled-pet-neo-wasp? #f)
            (kill-by-name "pet-neo-wasp" *default-pool*))
          (begin
            (set! enabled-pet-neo-wasp? #t)
            (spawn-pet-neo-wasp)))))
    ((5)
      (when (task-node-closed? (game-task-node pet-kangarat))
        (if enabled-pet-kangarat?
          (begin
            (set! enabled-pet-kangarat? #f)
            (kill-by-name "pet-kangarat" *default-pool*))
          (begin
            (set! enabled-pet-kangarat? #t)
            (spawn-pet-kangarat)))))

    ((6)
      (when (task-node-closed? (game-task-node pet-mantis))
        (if enabled-pet-mantis?
          (begin
            (set! enabled-pet-mantis? #f)
            (kill-by-name "pet-mantis" *default-pool*))
          (begin
            (set! enabled-pet-mantis? #t)
            (spawn-pet-mantis)))))

    ((7)
      (when (task-node-closed? (game-task-node pet-terra))
        (if enabled-pet-terra?
          (begin
            (set! enabled-pet-terra? #f)
            (kill-by-name "pet-terra" *default-pool*))
          (begin
            (set! enabled-pet-terra? #t)
            (spawn-pet-terra)))))

    ((8)
      (when (task-node-closed? (game-task-node pet-scouter))
        (if enabled-pet-scouter?
          (begin
            (set! enabled-pet-scouter? #f)
            (kill-by-name "pet-scouter" *default-pool*))
          (begin
            (set! enabled-pet-scouter? #t)
            (spawn-pet-scouter)))))

    ((9)
      (when (task-node-closed? (game-task-node pet-dogat))
        (if enabled-pet-dogat?
          (begin
            (set! enabled-pet-dogat? #f)
            (kill-by-name "pet-dogat" *default-pool*))
          (begin
            (set! enabled-pet-dogat? #t)
            (spawn-pet-dogat)))))
  )
  (none))

(deftype pet-menu (process)
  ((men-select int)
   (men-section int)
   (men-max int))
  (:state-methods
    idle
    dead)
  (:methods
    (pet-menu-controls! (_type_) none)
    (pet-menu-draw! (_type_) none)))

(defbehavior pet-menu-init-by-other pet-menu ()
  (stack-size-set! (-> self main-thread) 2048)
  (set! (-> self men-select) 0)
  (set! (-> self men-section) 0)
  (set! (-> self men-max) 9)
  (go-virtual idle)
  (none))

(defun spawn-pet-menu ()
  (process-spawn pet-menu :name "pet-menu")
  (none))

(defmethod pet-menu-controls! ((this pet-menu))
  (when (cpad-pressed? 0 up)
    (-! (-> this men-select) 1)
    (when (< (-> this men-select) 0)
      (set! (-> this men-select) (-> this men-max))))

  (when (cpad-pressed? 0 down)
    (+! (-> this men-select) 1)
    (when (> (-> this men-select) (-> this men-max))
      (set! (-> this men-select) 0)))

  (when (or (cpad-pressed? 0 square)
          (cpad-pressed? 0 circle))
  (pet-menu-toggle-pet! (-> this men-select)))

  (none))

(defun pet-menu-newline! ((dst string))
  (cat-string<-string dst "
")
  (none))

(defun pet-menu-append-item! ((dst string) (text string) (selected symbol))
  (cat-string<-string dst text)
  (if selected
    (cat-string<-string dst "<COLOR_GREEN>(<)")
    (cat-string<-string dst "<COLOR_WHITE>(<)"))
  (pet-menu-newline! dst)
  (none))

(defmethod pet-menu-draw! ((this pet-menu))
  (if (task-node-closed? (game-task-node pet-flitter))
    (if enabled-pet-flitter?
      (set! pet-flitter-s "<COLOR_GREEN>Flitter")
      (set! pet-flitter-s "<COLOR_RED>Flitter"))
    (set! pet-flitter-s "<COLOR_WHITE>???"))

  (if (task-node-closed? (game-task-node pet-spiky-frog))
    (if enabled-pet-spiky-frog?
      (set! pet-spiky-frog-s "<COLOR_GREEN>Spiky Frog")
      (set! pet-spiky-frog-s "<COLOR_RED>Spiky Frog"))
    (set! pet-spiky-frog-s "<COLOR_WHITE>???"))

  (if (task-node-closed? (game-task-node pet-rat))
    (if enabled-pet-rat?
      (set! pet-rat-s "<COLOR_GREEN>Rat")
      (set! pet-rat-s "<COLOR_RED>Rat"))
    (set! pet-rat-s "<COLOR_WHITE>???"))

  (if (task-node-closed? (game-task-node pet-manta))
    (if enabled-pet-manta?
      (set! pet-manta-s "<COLOR_GREEN>Manta")
      (set! pet-manta-s "<COLOR_RED>Manta"))
    (set! pet-manta-s "<COLOR_WHITE>???"))

  (if (task-node-closed? (game-task-node pet-neo-wasp))
    (if enabled-pet-neo-wasp?
      (set! pet-neo-wasp-s "<COLOR_GREEN>Neo Wasp")
      (set! pet-neo-wasp-s "<COLOR_RED>Neo Wasp"))
    (set! pet-neo-wasp-s "<COLOR_WHITE>???"))

  (if (task-node-closed? (game-task-node pet-kangarat))
    (if enabled-pet-kangarat?
      (set! pet-kangarat-s "<COLOR_GREEN>Kangarat")
      (set! pet-kangarat-s "<COLOR_RED>Kangarat"))
    (set! pet-kangarat-s "<COLOR_WHITE>???"))

  (if (task-node-closed? (game-task-node pet-mantis))
    (if enabled-pet-mantis?
      (set! pet-mantis-s "<COLOR_GREEN>Mantis")
      (set! pet-mantis-s "<COLOR_RED>Mantis"))
    (set! pet-mantis-s "<COLOR_WHITE>???"))

  (if (task-node-closed? (game-task-node pet-terra))
    (if enabled-pet-terra?
      (set! pet-terra-s "<COLOR_GREEN>Terra")
      (set! pet-terra-s "<COLOR_RED>Terra"))
    (set! pet-terra-s "<COLOR_WHITE>???"))

  (if (task-node-closed? (game-task-node pet-scouter))
    (if enabled-pet-scouter?
      (set! pet-scouter-s "<COLOR_GREEN>Scouter")
      (set! pet-scouter-s "<COLOR_RED>Scouter"))
    (set! pet-scouter-s "<COLOR_WHITE>???"))

  (if (task-node-closed? (game-task-node pet-dogat))
    (if enabled-pet-dogat?
      (set! pet-dogat-s "<COLOR_GREEN>Desert Scurrier")
      (set! pet-dogat-s "<COLOR_RED>Desert Scurrier"))
    (set! pet-dogat-s "<COLOR_WHITE>???"))
    
  (with-dma-buffer-add-bucket ((s2-0 (-> *display* frames (-> *display* on-screen) global-buf))
                               (bucket-id particles))
    (draw-sprite2d-xy s2-0 0 5 768 20 (new 'static 'rgba :a #x40) #x3fffff)
    (draw-sprite2d-xy s2-0 140 25 225 293 (new 'static 'rgba :a #x40) #x3fffff)
    (draw-sprite2d-xy s2-0 0 315 730 27 (new 'static 'rgba :a #x40) #x3fffff))

    (clear matt-str)
  (clear *pc-encoded-matt-str*)

  (cat-string<-string matt-str "<COLOR_CYAN>Followers")
  (pet-menu-newline! matt-str)
  (pet-menu-newline! matt-str)

  (pet-menu-append-item! matt-str pet-flitter-s (= (-> this men-select) 0))
  (pet-menu-append-item! matt-str pet-spiky-frog-s (= (-> this men-select) 1))
  (pet-menu-append-item! matt-str pet-rat-s (= (-> this men-select) 2))
  (pet-menu-append-item! matt-str pet-manta-s (= (-> this men-select) 3))
  (pet-menu-append-item! matt-str pet-neo-wasp-s (= (-> this men-select) 4))

  (pet-menu-append-item! matt-str pet-kangarat-s (= (-> this men-select) 5))
  (pet-menu-append-item! matt-str pet-mantis-s (= (-> this men-select) 6))
  (pet-menu-append-item! matt-str pet-terra-s (= (-> this men-select) 7))
  (pet-menu-append-item! matt-str pet-scouter-s (= (-> this men-select) 8))
  (pet-menu-append-item! matt-str pet-dogat-s (= (-> this men-select) 9))

  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
    (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
    (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 255 60 0.0 (font-color default) (font-flags middle shadow kerning large))))
      (set! (-> font-ctx scale) 0.325)
      (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
      

  (none))

(defstate idle (pet-menu)
  :virtual #t
  :enter (behavior ()
    (camera-locked #f #t #f)
    (disable-hudmap))
  :code (behavior ()
    (loop
      (pet-menu-controls! self)
      (pet-menu-draw! self)
      (when (cpad-pressed? 0 triangle)
        (go-virtual dead))
      (suspend))))

(defstate dead (pet-menu)
  :virtual #t
  :code (behavior ()
    (camera-unlocked)
    (enable-hudmap)
    (kill-by-name "proc-mask-enemyfreeze" *active-pool*)
    (kill-by-name (-> self name) *default-pool*)
    (deactivate self)))