  ())

(defbehavior pet-kangarat-init-by-other pet-kangarat ()
  (set! (-> self skel-name) "skel-kangarat-pet")
  (set! (-> self victory-anim) 7)
  (set! (-> self has-victory-anim) 1)
  (set! (-> self idle-anim) 3)
  (set! (-> self walk-anim) 6)
  (set! (-> self pet-size) 0.4)
  (set! (-> self death-anim) 3)
  (set! (-> self has-death-anim) 1)
  (set! (-> self is-flying?) #f)
  (set! (-> self has-walk-anim) 1)
  (pet-process-base-shared-init! self)
  (none))

(defun spawn-pet-kangarat ()
  (process-spawn pet-kangarat :name "pet-kangarat")
  (none))

