  (add-connection
    *part-engine*
    self
    18
    self
    2203
    (new 'static 'vector :x -1597.44 :y 696.32 :z 737.28 :w 163840.0))

  (add-connection
    *part-engine*
    self
    18
    self
    2204
    (new 'static 'vector :y 1433.6 :z 1228.8 :w 163840.0))

