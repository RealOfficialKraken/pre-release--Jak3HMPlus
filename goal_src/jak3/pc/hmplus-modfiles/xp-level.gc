    (defun init-enemy-hpbar ((mode symbol))
  (let ((level-cap hpbar-max-hit-points)
        (arg1 hpbar-hit-points)
        (pre-hit hpbar-pre-hit-points)
        (new-percent 1.0)
        (pre-percent 1.0)
        (new-target? #f))
    (when (< level-cap arg1)
      (set! arg1 0.0))
    (when (< level-cap pre-hit)
      (set! pre-hit level-cap))
    (when (< pre-hit 0.0)
      (set! pre-hit 0.0))

    (when (> level-cap 0.0)
      (set! new-percent (/ arg1 level-cap))
      (when (< new-percent 0.0)
        (set! new-percent 0.0))
      (when (> new-percent 1.0)
        (set! new-percent 1.0))

      (set! pre-percent (/ pre-hit level-cap))
      (when (< pre-percent 0.0)
        (set! pre-percent 0.0))
      (when (> pre-percent 1.0)
        (set! pre-percent 1.0)))

    (set! new-target?
      (or (= enemy-hp-last-target (the-as target #f))
          (!= enemy-hp-last-target *target*)))

    (set! enemy-hp #t)
    (set! hpi 0)

    (when new-target?
      (set! enemy-hp-last-target *target*)
      (set! enemy-hp-target-swapped? #t)

      (cond
        ((= mode 'use-pre-hit)
          (set! enemy-hp-percent new-percent)
          (set! enemy-hp-display-percent pre-percent)
          (set! enemy-hp-start-percent pre-percent)
          (set! enemy-hp-target-percent new-percent)
          (set! enemy-hp-anim-timer 0.0)
          (set! enemy-hp-chip-active #t)
          (set! enemy-hp-chip-percent pre-percent)
          (set! enemy-hp-chip-timer 0.0))
        (else
          (set! enemy-hp-percent new-percent)
          (set! enemy-hp-display-percent new-percent)
          (set! enemy-hp-start-percent new-percent)
          (set! enemy-hp-target-percent new-percent)
          (set! enemy-hp-anim-timer enemy-hp-anim-duration)
          (set! enemy-hp-chip-active #f)
          (set! enemy-hp-chip-percent new-percent)
          (set! enemy-hp-chip-timer 0.0))))

    (when (not new-target?)
      (set! enemy-hp-target-swapped? #f)))
  (none))

