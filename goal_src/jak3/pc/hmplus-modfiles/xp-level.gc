                    )
                )
                (set! enemy-noto (rand-vu-int-range 10 16))
            )
            (cond ((not (task-node-closed? (game-task-node factory-boss-resolution)))
                (when ;TEMPLEA
                    (and
                        (or
                            (= (-> (level-get-target-inside *level*) name) 'templea)
                            (= (-> (level-get-target-inside *level*) name) 'templex)
                        )
                        (!= enemy-noto 11)
                    )
                    (set! enemy-noto (+ notoriety-level 3))
                )
                (when ;TEMPLEB
                    (and
                        (= (-> (level-get-target-inside *level*) name) 'templeb)
                        (!= enemy-noto 14)
                    )
                    (set! enemy-noto (+ notoriety-level 3))
                )
                (when ;TEMPLED
                    (and
                        (= (-> (level-get-target-inside *level*) name) 'templed)
                        (!= enemy-noto 50)
                    )
                    (set! enemy-noto 50)
                )
            )
                ((task-node-closed? (game-task-node factory-boss-resolution))
                    (when ;TEMPLEA
                        (and
                            (or
                                (= (-> (level-get-target-inside *level*) name) 'templea)
                                (= (-> (level-get-target-inside *level*) name) 'templex)
                            )
                            (!= enemy-noto 45)
                        )
                        (set! enemy-noto 45)
                    )
                    (when ;TEMPLEB
                        (and
                            (= (-> (level-get-target-inside *level*) name) 'templeb)
                            (!= enemy-noto 46)
                        )
                        (set! enemy-noto 46)
                    )
                    (when ;TEMPLED
                        (and
                            (= (-> (level-get-target-inside *level*) name) 'templed)
                            (!= enemy-noto 50)
                        )
                        (set! enemy-noto 50)
                    )
                )
            )
            (when ;COMBABX
                (and
                    (or 
                        (= (-> (level-get-target-inside *level*) name) 'comba)
                        (= (-> (level-get-target-inside *level*) name) 'combb)
                        (= (-> (level-get-target-inside *level*) name) 'combx)
                    )
                    (and
                        (!= enemy-noto 15)
                        (!= enemy-noto 16)
                        (!= enemy-noto 17)
                        (!= enemy-noto 18)
                    )
                )
                (set! enemy-noto (rand-vu-int-range 15 18))
            )
            (when ;MINE
                (and
                    (or 
                        (= (-> (level-get-target-inside *level*) name) 'minea)
                        (= (-> (level-get-target-inside *level*) name) 'mineb)
                        (= (-> (level-get-target-inside *level*) name) 'minec)
                    )
                )
                (when
                    (and
                        (!= enemy-noto 15)
                        (!= enemy-noto 16)
                        (!= enemy-noto 17)
                        (!= enemy-noto 18)
                        (not (task-node-closed? (game-task-node mine-boss-resolution)))
                    )
                    (set! enemy-noto (rand-vu-int-range 15 18))
                )
                (when
                    (and
                        (!= enemy-noto (+ notoriety-level 2))
                        (task-node-closed? (game-task-node mine-boss-resolution))
                    )
                    (set! enemy-noto (+ notoriety-level 2))
                )
            )
            (when ;CTYGENB
                (and
                    (= (-> (level-get-target-inside *level*) name) 'ctygenb)
                    (task-node-open? (game-task-node mine-boss-resolution))
                    (!= enemy-noto 20)
                )
                (set! enemy-noto 20)
            )
            (when ;CTYGENB
                (and
                    (= (-> (level-get-target-inside *level*) name) 'ctygenb)
                    (!= enemy-noto 17)
                )
                (set! enemy-noto 17)
            )
            (when ;SEW1
                (and
                    (or
                        (task-node-open? (game-task-node sewer-kg-met-introduction))
                        (task-node-open? (game-task-node sewer-kg-met-button0-pressed))
                        (task-node-open? (game-task-node sewer-kg-met-button1-pressed))
                        (task-node-open? (game-task-node sewer-kg-met-resolution))
                    )
                    (= (-> (level-get-target-inside *level*) name) 'sewa)
                    (!= enemy-noto 18)
                    (!= enemy-noto 19)
                )
                (set! enemy-noto (rand-vu-int-range 18 19))
            )
            (when ;SEW2
                (and
                    (task-node-open? (game-task-node sewer-hum-kg-switch-off))
                    (or
                        (= (-> (level-get-target-inside *level*) name) 'sewb)
                        (= (-> (level-get-target-inside *level*) name) 'sewc)
                        (= (-> (level-get-target-inside *level*) name) 'sewd)
                    )
                    (!= enemy-noto 45)
                )
                (set! enemy-noto 45)
            )
            (cond ;ctyport
                ((and
                    (not (task-node-open? (game-task-node city-port-assault-resolution)))
                    (= (-> (level-get-target-inside *level*) name) 'ctyport)
                    (!= enemy-noto 19)
                    (!= enemy-noto 20)
                )
                (set! enemy-noto (rand-vu-int-range 19 20))
            )
            ((task-node-open? (game-task-node city-port-assault-resolution))
                (set! enemy-noto (- notoriety-level 5))
            )
            )
            (when ;ctyinda
                (and
                    (= (-> (level-get-target-inside *level*) name) 'ctyinda)
                    (not (task-node-open? (game-task-node city-destroy-grid-resolution)))
                    (!= enemy-noto 28)
                )
                (set! enemy-noto 28)
            )
            (when ;ctyinda
                (and
                    (= (-> (level-get-target-inside *level*) name) 'ctyinda)
                    (task-node-open? (game-task-node city-destroy-grid-resolution))
                    (= enemy-noto notoriety-level)
                )
                (set! enemy-noto notoriety-level)
            )
            (when ;ctyindb
                (and
                    (= (-> (level-get-target-inside *level*) name) 'ctyindb)
                    (!= enemy-noto 33)
                )
                (set! enemy-noto 33)
            )
            (when ;ctysluma
                (and
                    (or
                        (= (-> (level-get-target-inside *level*) name) 'ctysluma)
                        (= (-> (level-get-target-inside *level*) name) 'ctyslumb)
                        (= (-> (level-get-target-inside *level*) name) 'ctyslumc)
                    )
                    (!= enemy-noto 29)
                    (!= enemy-noto 30)
                    (!= enemy-noto 31)
                    (!= enemy-noto 32)
                    (!= enemy-noto 33)
                    (!= enemy-noto 34)
                )
                (set! enemy-noto (rand-vu-int-range 29 34))
            )
            (cond ;mhcitya+mhcityb
                ((and
                    (or
                        (= (-> (level-get-target-inside *level*) name) 'mhcitya)
                        (= (-> (level-get-target-inside *level*) name) 'mhcityb)
                    )
                    (not (task-node-open? (game-task-node city-destroy-grid-resolution)))
                    (!= enemy-noto 40)
                )
                (set! enemy-noto 40)
            )
            ((and
                (task-node-open? (game-task-node city-destroy-grid-resolution))
                (or
                    (= (-> (level-get-target-inside *level*) name) 'mhcitya)
                    (= (-> (level-get-target-inside *level*) name) 'mhcityb)
                )
                (!= enemy-noto notoriety-level)
             )
                (set! enemy-noto notoriety-level)
            )
            )
            (when ;ltowera+ltowerb
                (and
                    (or
                        (= (-> (level-get-target-inside *level*) name) 'ltowera)
                        (= (-> (level-get-target-inside *level*) name) 'ltowerb)
                        (= (-> (level-get-target-inside *level*) name) 'towera)
                        (= (-> (level-get-target-inside *level*) name) 'towerb)
                    )
                    (!= enemy-noto 48)
                )
                (set! enemy-noto 48)
            )
            (when ;STADIUMA+B
                (and
                    (or
                        (= (-> (level-get-target-inside *level*) name) 'stadiuma)
                        (= (-> (level-get-target-inside *level*) name) 'stadiumb)
                        (= (-> (level-get-target-inside *level*) name) 'stadium)
                    )
                    (!= enemy-noto 50)
                )
                (set! enemy-noto 50)
            )
            (when ;FORESTA
                (and
                    (= (-> (level-get-target-inside *level*) name) 'foresta)
                    (or
                        (< enemy-noto 47)
                        (> enemy-noto 56)
                    )
                )
                (set! enemy-noto (rand-vu-int-range 47 56))
            )
            (when ;factory
                (and
                    (or
                        (= (-> (level-get-target-inside *level*) name) 'factorya)
                        (= (-> (level-get-target-inside *level*) name) 'factoryb)
                        (= (-> (level-get-target-inside *level*) name) 'factoryc)
                        (= (-> (level-get-target-inside *level*) name) 'lfacrm1)
                    )
                    (not (= (-> (level-get-target-inside *level*) name) 'factoryd))
                    (!= enemy-noto 45)
                )
                (set! enemy-noto 45)
            )
            (when ;factory-boss
                (and
                    (= (-> (level-get-target-inside *level*) name) 'factoryd)
                    (!= enemy-noto 50)
                )
                (set! enemy-noto 50)
            )
            (when ;PRECUR
                (and
                    (not (task-node-open? (game-task-node precursor-tour-introduction)))
                    (not (task-node-open? (game-task-node precursor-tour-generator-trigger)))
                    (not (task-node-open? (game-task-node precursor-tour-resolution)))
                    (or
                        (= (-> (level-get-target-inside *level*) name) 'precura)
                        (= (-> (level-get-target-inside *level*) name) 'precurb)
                        (= (-> (level-get-target-inside *level*) name) 'precurc)
                        (= (-> (level-get-target-inside *level*) name) 'precurd)
                    )
                    (!= enemy-noto 60)
                )
                (set! enemy-noto 60)
            )
            (when ;PRECUR
                (and
                    (or
                        (task-node-open? (game-task-node precursor-tour-introduction))
                        (task-node-open? (game-task-node precursor-tour-generator-trigger))
                        (task-node-open? (game-task-node precursor-tour-resolution))
                    )
                    (or
                        (= (-> (level-get-target-inside *level*) name) 'precura)
                        (= (-> (level-get-target-inside *level*) name) 'precurb)
                        (= (-> (level-get-target-inside *level*) name) 'precurc)
                        (= (-> (level-get-target-inside *level*) name) 'precurd)
                    )
                    (!= enemy-noto 40)
                )
                (set! enemy-noto 40)
            )
            (when ;DESBOSS
                (and
                    (or
                        (= (-> (level-get-target-inside *level*) name) 'deswalk)
                        (= (-> (level-get-target-inside *level*) name) 'desboss2)
                    )
                    (!= enemy-noto 50)
                )
                (set! enemy-noto 50)
            )
            (when 
            (and 
                (= start-was-uprising #t)
                (= (-> (level-get-target-inside *level*) name) 'desert)
                *target*
                (not *scene-player*)
                (= (paused?) #f)
                (= (pause-allowed?) #t)
            )
                (+! wasi 1)
                (when (= wasi 3000)
                    (+! enemy-noto 1)
                    (set! wasi 0)
                )
            )

            (when 
                (and
                    (!= (-> (level-get-target-inside *level*) name) 'desert)
                    (not (task-node-open? (game-task-node arena-replay-1-fight)))
                    (= start-was-uprising #t)
                )
                    (set! wasi 0)
                    (set! start-was-uprising #f)
                )
            )
        )


    (when 
        (and 
            (= xp-draw #t)
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (not mainmenu-camera)
            (or
                (task-node-closed? (game-task-node arena-fight-1-introduction))
                (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
            )
        ) ;gain XP
        (+! xpi 1)
        (let ((max-time 300))
            (when (and (= xpi 3)(= xp-draw-override #t))
                (process-spawn reputation-text global-root-trans global-parent-mask)
            )
            (when (= xp-draw-override #f)
                (let ((y 50))
                (when (= hud-timer-on? #f)
                            (set! y 50)
                        )
                        (when (or (= hud-timer-on? #t) (= r3-noto #t))
                            (set! y 120)
                        )
                (when (string= xp-string "<COLOR_RED>Duplicate Gun Mod found~%<COLOR_YELLOW>Level up to increase chances of higher tier weapons!")
                    (set! max-time 900)
                    (set! y 310)
                )
                (clear matt-str)
                (clear *pc-encoded-matt-str*)
                (format matt-str "~s~%<COLOR_CYAN>+~d Reputation"
                xp-string
                (the int *xp-gain*)
                )
                (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
                (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
                (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
                (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 255 y 0.0 (font-color default) (font-flags middle shadow kerning large))))
                (set! (-> font-ctx scale) 0.325)
                (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
            )
            )
            (when (= xpi max-time)
                (set! xpi 0)
                (set! xp-draw #f)
                (set! xp-draw-override #f)
            )
        )
    )

    (when ;hack to disable xp-draw when it show +0
    (and
        (not (task-node-closed? (game-task-node arena-fight-1-introduction)))
        (= xp-draw #t)
    )
        (set! xp-draw #f)
    )

    (when 
        (and 
            (= xp-draw-gun #t)
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (not mainmenu-camera)
            (= completed-tutorial? #t)
        ) ;gain XP
        (+! xp-i 1)
        (when (= xp-i 800)
            (set! xp-i 0)
            (set! xp-draw-gun #f)
        )
        (let ((y 50))
            (when (= hud-timer-on? #f)
                        (set! y 50)
                    )
                    (when (or (= hud-timer-on? #t) (= r3-noto #t))
                        (set! y 120)
                    )
                    (when (= in-vin-shop? #t)
                        (set! y 280)
                    )
            (clear matt-str)
            (clear *pc-encoded-matt-str*)
            (format matt-str "~s~%<COLOR_CYAN>+~d"
            xp-string
            (the int *xp-gain*)
            )
            (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
            (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
            (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 255 y 0.0 (font-color default) (font-flags middle shadow kerning large))))
            (set! (-> font-ctx scale) 0.325)
            (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
        )
    )

    (when (= draw-levelup-noto #t) ;Level Up
        (+! lvli 1)
        (when (= lvli 600)
            (set! lvli 0)
            (set! draw-levelup-noto #f)
        )
        (when 
            (and
                *target*
                (not *scene-player*)
                (= (paused?) #f)
                (= in-menu? #f)
            )
            (clear matt-str)
            (clear *pc-encoded-matt-str*)
            (format matt-str "<COLOR_GREEN>LEVEL UP!~%~%~s Level ~d"
            noto-string
            draw-levelup-int
            )
            (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
            (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
            (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 250 150 0.0 (font-color default) (font-flags middle shadow kerning large))))
            (set! (-> font-ctx scale) 0.325)
            (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
        )
    )
    (when
        (and
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (= (pause-allowed?) #t)
            (cpad-pressed? 0 l3)
            (not mainmenu-camera)
            (= r3-noto #f)
        )
        (set! r3-noto #t)
        (set! anim-noto -20)
        (set! notoi 0)
    )

    (when
        (and
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (= (pause-allowed?) #t)
            (cpad-pressed? 0 l3)
            (= r3-noto #t)
            (> notoi 22)
        )
        (set! notoi 22)
        (set! anim-noto 1)
    )

    (when
        (and
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (= r3-noto #t)
        )
            (+! notoi 1)
            (when (and (>= notoi 1)(<= notoi 21))
                (+! anim-noto 1)
            )
            (when (and (> notoi 21) (< notoi 353))
                (draw-XP-bar)
                (set! noto-draw-x 190)
                (set! noto-draw-y 11)
                (set! guns-draw-x 30)
                (set! guns-draw-y 11)
                (set! car-draw-x 350)
                (set! car-draw-y 11)
            )
            (when (>= notoi 370)
                (-! anim-noto 1)
            )
            (when (or (= notoi 390)(= in-menu? #t))
                (set! notoi 0)
                (set! anim-noto -30)
                (set! r3-noto #f)
                (set! xp-bar-spawned? #f)
            )
        )

    (when ;draw the notoriety level onscreen
    (and
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= r3-noto #t)
        (= in-menu? #f)
    )
        (clear matt-str)
        (clear *pc-encoded-matt-str*)
        (format matt-str "<COLOR_ORANGE>Hero Level: ~d~%~%<COLOR_YELLOW>~d/~d"
        notoriety-level
        (the int (-> *game-info* karma))
        (the int (* (+ (* notoriety-level 60) (* notoriety-level 100)) notoriety-level))
        )
        (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
        (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
        (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
        (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 255 anim-noto 0.0 (font-color default) (font-flags middle shadow kerning large))))
        (set! (-> font-ctx scale) 0.325)
        (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
    )
    (when ;draw the guns level onscreen
    (and
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= r3-noto #t)
        (= in-menu? #f)
        (or
            (task-node-closed? (game-task-node arena-fight-1-introduction))
            (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
        )
    )
        (clear matt-str)
        (clear *pc-encoded-matt-str*)
        (format matt-str "<COLOR_RED>Guns: ~d~%~%<COLOR_RED>~d/~d"
        guns-level
        (the int (-> *game-info* buzzer-total))
        (the int (* (+ (* guns-level 120) (* guns-level 200)) guns-level))
        )
        (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
        (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
        (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
        (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 90 anim-noto 0.0 (font-color default) (font-flags middle shadow kerning large))))
        (set! (-> font-ctx scale) 0.325)
        (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
    )
    (when ;draw the cars level onscreen
    (and
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= r3-noto #t)
        (= in-menu? #f)
        (!= (-> *game-info* total-deaths) 0)
    )
        (clear matt-str)
        (clear *pc-encoded-matt-str*)
        (format matt-str "<COLOR_PINK>Vehicles: ~d~%~%<COLOR_PINK>~d/~d"
        cars-level
        (the int (-> *game-info* fuel))
        (the int (* (+ (* cars-level 30) (* cars-level 175)) cars-level))
        )
        (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
        (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
        (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
        (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 410 anim-noto 0.0 (font-color default) (font-flags middle shadow kerning large))))
        (set! (-> font-ctx scale) 0.325)
        (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))
    )

    (when (and 
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (focus-test? *target* pilot)
            (not (task-node-open? (game-task-node desert-glide-templetop)))
            (not (task-node-open? (game-task-node desert-glide-resolution)))
            ) ;for the turbo meter, also referenced in wvehicle.gc and wvehicle-util.gc
            (let 
            (
                (x 7)
                (y 348)
                (progress turbo-amount-hud) ;turbo-amount-hud
                (arg3 (new 'static 'rgba 
                    :r 0
                    :g 255
                    :b 255
                    :a #x40
                    )
                    )
            )
                (with-dma-buffer-add-bucket ((s2-0 (-> *display* frames (-> *display* on-screen) global-buf))
                                    (bucket-id particles)
                                    )
            (draw-sprite2d-xy s2-0 x y 60 14 (new 'static 'rgba :a (-> arg3 a)) #x3fffff)
            (draw-sprite2d-xy s2-0 (+ x 1) (+ y 1) (the int (* 58.5 progress)) 12 arg3 #x3fffff)
            )
        )
        
    )

    (none)
)

(defun draw-targbar-hp ()
  (let ((x 7)
        (y 358)
        (progress 0.0)
        (arg3 (new 'static 'rgba
                   :r 0
                   :g 255
                   :b 0
                   :a #x40)))

    (let ((level-cap (-> *target* fact health-max))
          (arg1 (-> *target* fact health))
          (new-percent 0.0))

      (when (> level-cap 0.0)
        (set! new-percent (/ arg1 level-cap))

        (when (< new-percent 0.0)
          (set! new-percent 0.0))
        (when (> new-percent 1.0)
          (set! new-percent 1.0))

        (when (!= targbar-hp-target-percent new-percent)
          (set! targbar-hp-start-percent targbar-hp-display-percent)
          (set! targbar-hp-target-percent new-percent)
          (set! targbar-hp-anim-timer 0.0))))

    (let* ((dt (seconds-per-frame))
           (dur targbar-hp-anim-duration)
           (u 0.0)
           (inv 0.0)
           (ease 0.0))

      (when (< dur 0.001)
        (set! dur 0.001))

      (when (< targbar-hp-anim-timer dur)
        (+! targbar-hp-anim-timer dt)
        (when (> targbar-hp-anim-timer dur)
          (set! targbar-hp-anim-timer dur)))

      (set! u (/ targbar-hp-anim-timer dur))

      (when (< u 0.0)
        (set! u 0.0))
      (when (> u 1.0)
        (set! u 1.0))
      (set! inv (- 1.0 u))
      (set! ease (- 1.0 (* inv inv inv)))

      (set! targbar-hp-display-percent
            (+ targbar-hp-start-percent
               (* (- targbar-hp-target-percent targbar-hp-start-percent) ease)))

      (when (= u 1.0)
        (set! targbar-hp-display-percent targbar-hp-target-percent)))

    (when (< targbar-hp-display-percent 0.0)
      (set! targbar-hp-display-percent 0.0))
    (when (> targbar-hp-display-percent 1.0)
      (set! targbar-hp-display-percent 1.0))

    (set! progress targbar-hp-display-percent)

    (with-dma-buffer-add-bucket ((s2-0 (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id particles))
      (draw-sprite2d-xy s2-0 x y 63 14 (new 'static 'rgba :a (-> arg3 a)) #x3fffff)
      (draw-sprite2d-xy s2-0 (+ x 1) (+ y 1) (the int (* 61.0 progress)) 12 arg3 #x3fffff)))
  (none))

