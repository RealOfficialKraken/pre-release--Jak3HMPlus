;Lisp
(in-package goal)

;name: xp-level.gc

#|
(when 
        (and
            (= (/ (mod (-> *game-info* auto-save-count) 100000) 10000) 3)
            
        )

    )
    |#

    (define draw-levelup-int 0)
    (define xp-bar-spawned? #f)

    (deftype level-up-process (process-drawable)
        ((general-i             int))
        (:state-methods
            active
            die
        )
    )

    (defbehavior level-up-process-init-by-other level-up-process ((vec vector) (part? int))
        (vector-copy! (-> self root trans) vec)
        (set! (-> self general-i) 0)
        (set! (-> self part) (create-launch-control (-> *part-group-id-table* part?) self))
        (go-virtual active)
    )

    (defun spawn-level-up-process ((vec vector) (part? int))
        (process-spawn level-up-process vec part? :name "level-up-process")
    )

    (defstate active (level-up-process)
        :virtual #t
        :code (behavior ()
            (loop
                (let ((vec (new-stack-vector0)))
                    (set! (-> vec x) (-> (target-pos 0) x))
                    (set! (-> vec y) (-> (target-pos 0) y))
                    (+! (-> vec y) (meters 2.0))
                    (set! (-> vec z) (-> (target-pos 0) z))
                    (set! (-> vec w) 1.0)
                    (vector-copy! (-> self root trans) vec)
                )
                (when (< (-> self general-i) 70)
                    (+! (-> self general-i) 1)
                )
                (when (= (-> self general-i) 1)
                    (spawn (-> self part) (-> self root trans))
                )
                (when (>= (-> self general-i) 70)
                    (go-virtual die)
                )
                (suspend)
            )
        )
    )

    (defstate die (level-up-process)
        :virtual #t
        :code (behavior ()
            (kill-by-name (-> self name) *default-pool*)
            (deactivate self)
        )
    )

    (defun xp-hero-level ()
        (let ((vec (new-stack-vector0)))
            (set! (-> vec x) (-> (target-pos 0) x))
            (set! (-> vec y) (-> (target-pos 0) y))
            (+! (-> vec y) (meters 2.0))
            (set! (-> vec z) (-> (target-pos 0) z))
            (set! (-> vec w) 1.0)
            (cond
                ((logtest? (-> *part-group-id-table* 165 flags) (sp-group-flag sp13))
                    (set! (-> *launch-matrix* trans quad) (-> vec quad))
                    (part-tracker-spawn part-tracker-subsampler :to *active-pool* :group (-> *part-group-id-table* 165))
                    )
                (else
                    (set! (-> *launch-matrix* trans quad) (-> vec quad))
                    (part-tracker-spawn part-tracker :to *active-pool* :group (-> *part-group-id-table* 165))
                )
            )
            (cond
                ((logtest? (-> *part-group-id-table* 170 flags) (sp-group-flag sp13))
                    (set! (-> *launch-matrix* trans quad) (-> vec quad))
                    (part-tracker-spawn part-tracker-subsampler :to *active-pool* :group (-> *part-group-id-table* 170))
                    )
                (else
                    (set! (-> *launch-matrix* trans quad) (-> vec quad))
                    (part-tracker-spawn part-tracker :to *active-pool* :group (-> *part-group-id-table* 170))
                )
            )
        )
        (play-sound-file "snd/level-up.wav" (the int (* (-> *setting-control* user-current sfx-volume) 100)))
        (none)
    )

