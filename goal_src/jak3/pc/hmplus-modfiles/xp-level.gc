(deftype reputation-text (process)
  ((trans         vector    :inline)
   (trans-2d      vector4w  :inline)
   (on-screen?    symbol)
   (damage        int32)
   (parent-mask   process-mask)
   (font          font-context)
   (y-ofs         float)
   (xp-string     string)
   (xp-gain       float)
   (rep-string    string)
   )
  (:state-methods
    active
    )
  (:methods
    (initialize-font (_type_) font-context))
  )


(defstate active (reputation-text)
  :virtual #t

  :trans (behavior ()
    
    (when (not (logtest? (-> *kernel-context* prevent-from-run) (-> self parent-mask)))
      ;; make font float upwards
      (when 
        (and 
            (> (-> self y-ofs) 32.0) 
            (< (-> self y-ofs) 33.0)
            (<= notoriety-level (- enemy-noto 7))
        )
        (set! (-> self rep-string) "(+ Hi~+7Vg~-7Vh Level Bonus)~%~S: +~D Re~+7Vp~-7Vutation")
        (set! (-> self xp-gain) (+ (-> self xp-gain) (* (-> self xp-gain) 1.93)))
      )
      (+! (-> self y-ofs) (* 0.6 (-> self clock time-adjust-ratio)))
      )

    ;; convert 3D -> 2D screen now (result in trans-2d)
    (set! (-> self on-screen?) (transform-point-qword! (-> self trans-2d) (-> self trans)))

    ;; position font
    (set-origin! (-> self font) (+ (/ (-> self trans-2d x) 16) -1792)
                                (+ (/ (-> self trans-2d y) 16) -1855))
    (set-depth! (-> self font) (/ (-> self trans-2d z) 16))
    ;; now center (we could do this earlier but it's fine)
    (-! (-> self font origin x) (/ (-> self font width) 2))
    ;; now move it up
    (-! (-> self font origin y) (-> self y-ofs)))

  :code (behavior ()
    (let ((state-time (current-time)))
        ;; move up for a bit
        (until (>= (- (current-time) state-time) (seconds 2.5))
          (suspend))
        ;; now fade out
        (set! state-time (current-time))
        (until (>= (- (current-time) state-time) (seconds 0.5))
          (set! (-> self font alpha) (lerp-scale 1.0 0.0 (the float (- (current-time) state-time)) 0.0 (fsec 0.5)))
          (suspend))
        )
    )

  :post (behavior ()
    (when (-> self on-screen?)
      (print-game-text (string-format (-> self rep-string) (-> self xp-string) (the int (-> self xp-gain))) (-> self font) #f 44 (bucket-id debug-no-zbuf1)))
    )
  )

(defmethod relocate ((this reputation-text) (diff int))
  (if (nonzero? (-> this font))
      (&+! (-> this font) diff)
      )
  (call-parent-method this diff)
  )

(defmethod initialize-font ((self reputation-text))
  "create the font that will be used used."

  (if (zero? (-> self font))
      (set! (-> self font) (new 'process 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
  (set! (-> self xp-string) xp-string)
  (set! (-> self xp-gain) *xp-gain*)
  (set! (-> self rep-string) "~S: +~D Re~+7Vp~-7Vutation")
  (set-scale! (-> self font) 0.2)
  (set-flags! (-> self font) (font-flags shadow kerning large middle))
  (set-width! (-> self font) 350)
  (set-height! (-> self font) 350)
  )


(defbehavior reputation-text-init-by-other reputation-text ((pos vector) (parent-mask process-mask))
  "initialize reputation-text"

  ;; copy params
  (set! (-> self damage) 0)
  (set! (-> self parent-mask) parent-mask)
  (vector-copy! (-> self trans) pos)

  ;; init font
  (initialize-font self)

  ;; process settings to still render while paused
  (process-mask-clear! (-> self mask) pause)

  (go-virtual active)
  )

(defun spawn-rep-text ()
    (when (task-node-closed? (game-task-node arena-fight-1-introduction))
        (set! xp-draw #t)
        (set! xp-draw-override #t)
    )
    (none)
)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


;level-up skill

(defun level-up! ((arg0 int))
    (+! (-> *game-info* total-trys) arg0)
    (set! (-> *game-info* karma) extra-offthetop)
    (set! draw-levelup-noto #t)
    (set! noto-string "<COLOR_ORANGE>Hero<COLOR_YELLOW>")
    (set! draw-levelup-int (-> *game-info* total-trys))
    (cond
        ((>= notoriety-level 10)
            (when (!= (-> *target* fact health-max) (+ (-> *FACT-bank* health-max-default) (/ (-> *game-info* total-trys) 3)))
                (set! (-> *target* fact health-max) (+ (-> *FACT-bank* health-max-default) (/ (-> *game-info* total-trys) 3)))
            )
        )
        (else
            (set! (-> *target* fact health-max) (-> *FACT-bank* health-max-default))
        )
    )
    (set! (-> *target* fact health) (-> *target* fact health-max))
    (when
        (or
            (= notoriety-level 9)
            (= notoriety-level 24)
            (= notoriety-level 39)
            (= notoriety-level 59)
        )
        (r3-hint)
    )
    (auto-save-user)
    ;(levelup-glow-yellow)
    (xp-hero-level)
    (none)
)

(defun level-up-guns! ((arg0 int))
    (+! (-> *game-info* auto-save-count) arg0)
    (+! (-> *game-info* karma) (/ extra-offthetop 2))
    (set! (-> *game-info* buzzer-total) extra-offthetop)
    (set! draw-levelup-noto #t)
    (set! noto-string "<COLOR_RED>Guns<COLOR_YELLOW>")
    (set! draw-levelup-int (-> *game-info* auto-save-count))
    (when
        (or
            (= guns-level 3)
            (= guns-level 8)
            (= guns-level 15)
            (= guns-level 19)
        )
        (r3-hint)
    )
    (send-event *target* 'get-pickup (pickup-type ammo-yellow) 9999.0)
    (send-event *target* 'get-pickup (pickup-type ammo-red) 9999.0)
    (if (or
            (logtest? (-> *game-info* features) (game-feature gun-blue-1))
            (logtest? (-> *game-info* features) (game-feature gun-blue-2))
            (logtest? (-> *game-info* features) (game-feature gun-blue-3))
        )
        (send-event *target* 'get-pickup (pickup-type ammo-blue) 9999.0)
    )
    (if (or
            (logtest? (-> *game-info* features) (game-feature gun-dark-1))
            (logtest? (-> *game-info* features) (game-feature gun-dark-2))
            (logtest? (-> *game-info* features) (game-feature gun-dark-3))
        )
        (send-event *target* 'get-pickup (pickup-type ammo-dark) 9999.0)
    )
    (auto-save-user)
    ;(levelup-glow-red)
    (xp-guns-level)
    (none)
)

(defun level-up-cars! ((arg0 int))
    (+! (-> *game-info* total-deaths) arg0)
    (when (!= (-> *game-info* total-deaths) 1)
        (set! (-> *game-info* fuel) extra-offthetop)
        (+! (-> *game-info* karma) (/ extra-offthetop 2))
    )
    (set! draw-levelup-noto #t)
    (set! noto-string "<COLOR_PINK>Vehicle<COLOR_YELLOW>")
    (set! draw-levelup-int (-> *game-info* total-deaths))
    (when
        (or
            (= cars-level 1)
            (= cars-level 5)
            (= cars-level 13)
            (= cars-level 19)
        )
        (r3-hint)
    )
    (auto-save-user)
    ;(levelup-glow-dark)
    (xp-cars-level)
    (none)
)

;XP dist

(defun mission-complete? ((amount int)) ;default amount is 130
    (set! in-desert-game-task? #f)
    (set! (-> *game-info* side-enemies-killed?) 0)
    (+! (-> *game-info* karma) (/ (* amount notoriety-level) 10))
    (set! *xp-gain* (the float (/ (* amount notoriety-level) 10)))
    (set! xp-string "Mission Complete")
    (when (task-node-closed? (game-task-node arena-fight-1-introduction))
        (set! xp-draw #t)
    )
    (auto-save-delayed)
    (set! xpi 0)
    (none)
)

(defun vehicle-killed? ((xp-gain float))
    (+! (-> *game-info* fuel) (/ (* xp-gain enemy-noto) 2))
    (+! (-> *game-info* karma) (/ (* xp-gain enemy-noto) 4))
    (set! xp-string "Marauder Killed")
    (set! *xp-gain* (/ (* xp-gain enemy-noto) 2))
    (spawn-rep-text)
    (auto-save-delayed)
    (set! xpi 0)
    (none)
)

(defun mod-killed? ((xp-gain float))
    ;(+! (-> *game-info* karma) (* xp-gain guns-level))
    (level-up-guns! 1)
    (set! xp-string "<COLOR_RED>Duplicate Gun Mod found~%<COLOR_YELLOW>Level up to increase chances of higher tier weapons!")
    (set! *xp-gain* (* xp-gain enemy-noto))
    (set! xp-draw #t)
    (auto-save-delayed)
    (set! xp-i 0)
    (none)
)

(defun enemy-killed? ((xp-gain float))
    (when (= in-arena-fight? #t)
        (set! xp-gain (/ xp-gain 1.6))
    )

    (let ((xp-gain2 (/ (* xp-gain enemy-noto) 1.5))
          (xp-gain3 (/ (* xp-gain enemy-noto) 4)))

        (when (> xp-gain2 2500.0)
            (set! xp-gain2 2500.0)
        )

        ;; color-based xp scaling
        (set! xp-gain2 (* xp-gain2 (hmplus-enemy-xp-scale)))

        (when (> xp-gain2 2500.0)
            (set! xp-gain2 2500.0)
        )

        (when (<= notoriety-level (- enemy-noto 7))
            (set! xp-gain2 (* xp-gain2 2.93)) ;; or whatever multiplier
        )

        (set! *xp-gain* xp-gain2)
        (+! (-> *game-info* karma) xp-gain2)

        (when (focus-test? *target* pilot)
            (when (> xp-gain3 2500.0)
                (set! xp-gain3 2500.0)
            )
            (+! (-> *game-info* fuel) xp-gain3)
        )

        (set! xp-string "Enem~+7Vy~-7V Killed")
        (spawn-rep-text)
        (auto-save-delayed)
        (set! xpi 0)
    )
    (none)
)

(defun boss-killed? ((xp-gain float))
    (let ((xp-gain2 (/ (* xp-gain enemy-noto) 1.5))
          (xp-gain3 (/ (* xp-gain enemy-noto) 4)))
    (+! (-> *game-info* karma) xp-gain2)
    (set! xp-string "Boss Killed")
    (set! *xp-gain* xp-gain2)
    (auto-save-delayed)
    (when (task-node-closed? (game-task-node arena-fight-1-introduction))
        (set! xp-draw #t)
    )
    (set! xpi 0)
    )
    (none)
)

(defun side-enemy-killed? ()
    (+! (-> *game-info* side-enemies-killed?) 1)
    (set! xp-string "Current Quest")
    (set! *xp-gain* 1.0)
    (auto-save-delayed)
    (when (task-node-closed? (game-task-node arena-fight-1-introduction))
        (set! xp-draw #t)
    )
    (none)
)

(defun collect-orb-xp! ((xp-gain float))
    (+! (-> *game-info* karma) (/ (* xp-gain notoriety-level) 3.5))
    (set! xp-string "Orb Collected")
    (set! *xp-gain* (/ (* xp-gain notoriety-level) 3.5))
    (when (task-node-closed? (game-task-node arena-fight-1-introduction))
        (set! xp-draw #t)
    )
    (set! xpi 0)
    (none)
)

(defun delayed-heal ()
     (set! (-> *target* fact health-max) (+ 8.0 (/ notoriety-level 3)))
     ;(set! delayed-heal-full #t)
     ;(set! del-i 0)
    (none)
)



(defun draw-XP-bar ()
  (when
    (and
      *target*
      (not *scene-player*)
      (= (paused?) #f))
    )

  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Notoriety ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  (when
    (or
      (= in-menu? #f)
      (and
        (= in-skill? #t)
        (= menu-slot 0)))

    ;;update percent and restart animation if changed
    (let* ((level-cap (the float (* (+ (* notoriety-level 60) (* notoriety-level 100)) notoriety-level)))
           (arg1 (-> *game-info* karma))
           (new-percent 0.0))
      (when (> level-cap 0.0)
        (set! new-percent (/ arg1 level-cap))

        (when (< new-percent 0.0)
          (set! new-percent 0.0))
        (when (> new-percent 1.0)
          (set! new-percent 1.0))

        (when (!= level-percent new-percent)
          (set! level-percent new-percent)
          (set! level-start-percent level-display-percent)
          (set! level-target-percent level-percent)
          (set! level-anim-timer 0.0))))

    ;;animate displayed percent
    (let* ((dt (seconds-per-frame))
           (dur level-anim-duration)
           (u 0.0)
           (inv 0.0)
           (ease 0.0))
      (when (< dur 0.001)
        (set! dur 0.001))

      (when (< level-anim-timer dur)
        (+! level-anim-timer dt)
        (when (> level-anim-timer dur)
          (set! level-anim-timer dur)))

      (set! u (/ level-anim-timer dur))

      (when (< u 0.0)
        (set! u 0.0))
      (when (> u 1.0)
        (set! u 1.0))

      ;;ease-out anim
      (set! inv (- 1.0 u))
      (set! ease (- 1.0 (* inv inv inv)))

      (set! level-display-percent
        (+ level-start-percent
           (* (- level-target-percent level-start-percent) ease)))

      (when (= u 1.0)
        (set! level-display-percent level-target-percent)))

    (when (< level-display-percent 0.0)
      (set! level-display-percent 0.0))
    (when (> level-display-percent 1.0)
      (set! level-display-percent 1.0))

    ;;draw bar
    (let ((x noto-draw-x)
          (y noto-draw-y)
          (progress level-display-percent)
          (arg3 (new 'static 'rgba
                     :r 255
                     :g 255
                     :b 0
                     :a #x40)))
      (with-dma-buffer-add-bucket ((s2-0 (-> *display* frames (-> *display* on-screen) global-buf))
                                   (bucket-id particles))
        (draw-sprite2d-xy s2-0 x y 125 6 (new 'static 'rgba :a (-> arg3 a)) #x3fffff)
        (draw-sprite2d-xy s2-0 (+ x 1) (+ y 1) (the int (* 123.0 progress)) 4 arg3 #x3fffff))))

  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Guns ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  (when
    (or
      (= in-menu? #f)
      (and
        (= in-skill? #t)
        (= menu-slot 1)))

    (when (or
            (task-node-closed? (game-task-node arena-fight-1-introduction))
            (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
          )
      (let* ((level-cap (the float (* (+ (* guns-level 120) (* guns-level 200)) guns-level)))
             (arg1 (the float (-> *game-info* buzzer-total)))
             (new-percent 0.0))
        (when (> level-cap 0.0)
          (set! new-percent (/ arg1 level-cap))

          (when (< new-percent 0.0)
            (set! new-percent 0.0))
          (when (> new-percent 1.0)
            (set! new-percent 1.0))

          (when (!= guns-percent new-percent)
            (set! guns-percent new-percent)
            (set! guns-start-percent guns-display-percent)
            (set! guns-target-percent guns-percent)
            (set! guns-anim-timer 0.0))))
      (let* ((dt (seconds-per-frame))
             (dur guns-anim-duration)
             (u 0.0)
             (inv 0.0)
             (ease 0.0))
        (when (< dur 0.001)
          (set! dur 0.001))

        (when (< guns-anim-timer dur)
          (+! guns-anim-timer dt)
          (when (> guns-anim-timer dur)
            (set! guns-anim-timer dur)))

        (set! u (/ guns-anim-timer dur))

        (when (< u 0.0)
          (set! u 0.0))
        (when (> u 1.0)
          (set! u 1.0))
        (set! inv (- 1.0 u))
        (set! ease (- 1.0 (* inv inv inv)))

        (set! guns-display-percent
          (+ guns-start-percent
             (* (- guns-target-percent guns-start-percent) ease)))

        (when (= u 1.0)
          (set! guns-display-percent guns-target-percent)))

      (when (< guns-display-percent 0.0)
        (set! guns-display-percent 0.0))
      (when (> guns-display-percent 1.0)
        (set! guns-display-percent 1.0))
      (let ((x guns-draw-x)
            (y guns-draw-y)
            (progress guns-display-percent)
            (arg3 (new 'static 'rgba
                       :r 255
                       :g 1
                       :b 0
                       :a #x40)))
        (with-dma-buffer-add-bucket ((s2-0 (-> *display* frames (-> *display* on-screen) global-buf))
                                     (bucket-id particles))
          (draw-sprite2d-xy s2-0 x y 125 6 (new 'static 'rgba :a (-> arg3 a)) #x3fffff)
          (draw-sprite2d-xy s2-0 (+ x 1) (+ y 1) (the int (* 123.0 progress)) 4 arg3 #x3fffff)))))

  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Vehicles ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  (when
    (or
      (= in-menu? #f)
      (and
        (= in-skill? #t)
        (= menu-slot 2)))

    (when (!= (-> *game-info* total-deaths) 0)
      (let* ((level-cap (the float (* (+ (* cars-level 30) (* cars-level 175)) cars-level)))
             (arg1 (-> *game-info* fuel))
             (new-percent 0.0))
        (when (> level-cap 0.0)
          (set! new-percent (/ arg1 level-cap))

          (when (< new-percent 0.0)
            (set! new-percent 0.0))
          (when (> new-percent 1.0)
            (set! new-percent 1.0))

          (when (!= vehicle-percent new-percent)
            (set! vehicle-percent new-percent)
            (set! vehicle-start-percent vehicle-display-percent)
            (set! vehicle-target-percent vehicle-percent)
            (set! vehicle-anim-timer 0.0))))
      (let* ((dt (seconds-per-frame))
             (dur vehicle-anim-duration)
             (u 0.0)
             (inv 0.0)
             (ease 0.0))
        (when (< dur 0.001)
          (set! dur 0.001))

        (when (< vehicle-anim-timer dur)
          (+! vehicle-anim-timer dt)
          (when (> vehicle-anim-timer dur)
            (set! vehicle-anim-timer dur)))

        (set! u (/ vehicle-anim-timer dur))

        (when (< u 0.0)
          (set! u 0.0))
        (when (> u 1.0)
          (set! u 1.0))
        (set! inv (- 1.0 u))
        (set! ease (- 1.0 (* inv inv inv)))

        (set! vehicle-display-percent
          (+ vehicle-start-percent
             (* (- vehicle-target-percent vehicle-start-percent) ease)))

        (when (= u 1.0)
          (set! vehicle-display-percent vehicle-target-percent)))

      (when (< vehicle-display-percent 0.0)
        (set! vehicle-display-percent 0.0))
      (when (> vehicle-display-percent 1.0)
        (set! vehicle-display-percent 1.0))
      (let ((x car-draw-x)
            (y car-draw-y)
            (progress vehicle-display-percent)
            (arg3 (new 'static 'rgba
                       :r 255
                       :g 0
                       :b 255
                       :a #x40)))
        (with-dma-buffer-add-bucket ((s2-0 (-> *display* frames (-> *display* on-screen) global-buf))
                                     (bucket-id particles))
          (draw-sprite2d-xy s2-0 x y 125 6 (new 'static 'rgba :a (-> arg3 a)) #x3fffff)
          (draw-sprite2d-xy s2-0 (+ x 1) (+ y 1) (the int (* 123.0 progress)) 4 arg3 #x3fffff)))))

  (none)
  )

(defun hmplus-hero-clear-tier ()
  (let ((tier (the int (-> *game-info* crates-opened))))
    (when (< tier 1)
      (set! tier 1))
    tier))

(defun hmplus-hero-start-level ()
  (let* ((tier (hmplus-hero-clear-tier))
         (n (- tier 1))
         (pair-bonus (* (the int (/ n 2)) 50))
         (odd-bonus 0))
    (when (= (mod n 2) 1)
      (set! odd-bonus 30))
    (+ 60 pair-bonus odd-bonus)))

(defun hmplus-hero-end-level ()
  (let* ((tier (hmplus-hero-clear-tier))
         (n (- tier 1))
         (pair-bonus (* (the int (/ n 2)) 50))
         (odd-bonus 0))
    (when (= (mod n 2) 1)
      (set! odd-bonus 20))
    (+ 100 pair-bonus odd-bonus)))

(defun hmplus-hero-map-level ((normal-level int))
  (let ((n normal-level)
        (hero-start (hmplus-hero-start-level))
        (hero-end (hmplus-hero-end-level))
        (hero-span 0))
    (when (< n 1)
      (set! n 1))
    (when (> n 50)
      (set! n 50))

    (set! hero-span (- hero-end hero-start))

    (+ hero-start
       (the int (/ (* (- n 1) hero-span) 49)))))

(defun hmplus-hero-map-range-low ((normal-low int))
  (hmplus-hero-map-level normal-low))

(defun hmplus-hero-map-range-high ((normal-high int))
  (hmplus-hero-map-level normal-high))

(defun hmplus-hero-map-rand ((normal-low int) (normal-high int))
  (let ((low (hmplus-hero-map-range-low normal-low))
        (high (hmplus-hero-map-range-high normal-high)))
    (when (> low high)
      (let ((tmp low))
        (set! low high)
        (set! high tmp)))
    (rand-vu-int-range low high)))

(defun update-xp! ()

    (when ;the level-up recolored particle setup, since it crashes when done all at once, I want to make sure the game takes it's time on setting up these big particles
        (and 
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (= levelup-color #t)
        )
        (+! lui 1)
        (when (= lui 1)
            (cond
                ((string= levelup-string "reset")
                    (set! (-> *part-id-table* 1701 init-specs 4 initial-valuef) 160.0) ;r 1
                    (set! (-> *part-id-table* 1701 init-specs 5 initial-valuef) 0.0) ;g 1
                    (set! (-> *part-id-table* 1701 init-specs 6 initial-valuef) 255.0) ;b 1
                )
                ((string= levelup-string "noto")
                    (set! (-> *part-id-table* 1701 init-specs 5 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1701 init-specs 6 initial-valuef) 255.0) ;g
                    (set! (-> *part-id-table* 1701 init-specs 7 initial-valuef) 0.0) ;b
                )
                ((string= levelup-string "guns")
                    (set! (-> *part-id-table* 1701 init-specs 5 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1701 init-specs 6 initial-valuef) 0.0) ;g
                    (set! (-> *part-id-table* 1701 init-specs 7 initial-valuef) 0.0) ;b
                )
            )
        )
        (when (= lui 3)
            (cond
                ((string= levelup-string "reset")
                    (set! (-> *part-id-table* 1702 init-specs 5 initial-valuef) 160.0) ;r 2
                    (set! (-> *part-id-table* 1702 init-specs 6 initial-valuef) 30.0) ;g 2
                    (set! (-> *part-id-table* 1702 init-specs 7 initial-valuef) 255.0) ;b 2
                    (set! (-> *part-id-table* 1702 init-specs 8 initial-valuef) 128.0) ;a
                )
                ((string= levelup-string "noto")
                    (set! (-> *part-id-table* 1702 init-specs 5 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1702 init-specs 6 initial-valuef) 255.0) ;g
                    (set! (-> *part-id-table* 1702 init-specs 7 initial-valuef) 0.0) ;b
                    (set! (-> *part-id-table* 1702 init-specs 8 initial-valuef) (the float (+ notoriety-level 1))) ;a ;(the float (+ notoriety-level 1))
                )
                ((string= levelup-string "guns")
                    (set! (-> *part-id-table* 1702 init-specs 5 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1702 init-specs 6 initial-valuef) 0.0) ;g
                    (set! (-> *part-id-table* 1702 init-specs 7 initial-valuef) 0.0) ;b
                )
            )
        )
        (when (= lui 5)
            (cond
                ((string= levelup-string "reset")
                    (set! (-> *part-id-table* 1703 init-specs 5 initial-valuef) 20.0) ;r 3
                    (set! (-> *part-id-table* 1703 init-specs 6 initial-valuef) 40.0) ;g 3
                    (set! (-> *part-id-table* 1703 init-specs 7 initial-valuef) 128.0) ;b 3
                )
                ((string= levelup-string "noto")
                    (set! (-> *part-id-table* 1703 init-specs 5 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1703 init-specs 6 initial-valuef) 255.0) ;g
                    (set! (-> *part-id-table* 1703 init-specs 7 initial-valuef) 0.0) ;b
                )
                ((string= levelup-string "guns")
                    (set! (-> *part-id-table* 1703 init-specs 5 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1703 init-specs 6 initial-valuef) 0.0) ;g
                    (set! (-> *part-id-table* 1703 init-specs 7 initial-valuef) 0.0) ;b
                )
            )
        )
        (when (= lui 7)
            (cond
                ((string= levelup-string "reset")
                    (set! (-> *part-id-table* 1704 init-specs 5 initial-valuef) 160.0) ;r 4
                    (set! (-> *part-id-table* 1704 init-specs 6 initial-valuef) 30.0) ;g 4 
                    (set! (-> *part-id-table* 1704 init-specs 7 initial-valuef) 128.0) ;b 4
                )
                ((string= levelup-string "noto")
                    (set! (-> *part-id-table* 1704 init-specs 5 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1704 init-specs 6 initial-valuef) 255.0) ;g
                    (set! (-> *part-id-table* 1704 init-specs 7 initial-valuef) 0.0) ;b
                )
                ((string= levelup-string "guns")
                    (set! (-> *part-id-table* 1704 init-specs 5 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1704 init-specs 6 initial-valuef) 0.0) ;g
                    (set! (-> *part-id-table* 1704 init-specs 7 initial-valuef) 0.0) ;b
                )
            )
        )
        (when (= lui 9)
            (cond
                ((string= levelup-string "reset")
                    (set! (-> *part-id-table* 1705 init-specs 8 initial-valuef) 128.0) ;r 5
                    (set! (-> *part-id-table* 1705 init-specs 9 initial-valuef) 128.0) ;g 5
                    (set! (-> *part-id-table* 1705 init-specs 10 initial-valuef) 128.0) ;b 5
                )
                ((string= levelup-string "noto")
                    (set! (-> *part-id-table* 1705 init-specs 8 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1705 init-specs 9 initial-valuef) 255.0) ;g
                    (set! (-> *part-id-table* 1705 init-specs 10 initial-valuef) 0.0) ;b
                )
                ((string= levelup-string "guns")
                    (set! (-> *part-id-table* 1705 init-specs 8 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1705 init-specs 9 initial-valuef) 0.0) ;g
                    (set! (-> *part-id-table* 1705 init-specs 10 initial-valuef) 0.0) ;b
                )
            )
        )
        (when (= lui 11)
            (cond
                ((string= levelup-string "reset")
                    (set! (-> *part-id-table* 1706 init-specs 7 initial-valuef) 128.0) ;r 6
                    (set! (-> *part-id-table* 1706 init-specs 8 initial-valuef) 32.0) ;g 6
                    (set! (-> *part-id-table* 1706 init-specs 9 initial-valuef) 255.0) ;b 6
                )
                ((string= levelup-string "noto")
                    (set! (-> *part-id-table* 1706 init-specs 7 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1706 init-specs 8 initial-valuef) 255.0) ;g
                    (set! (-> *part-id-table* 1706 init-specs 9 initial-valuef) 0.0) ;b
                )
                ((string= levelup-string "guns")
                    (set! (-> *part-id-table* 1706 init-specs 7 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1706 init-specs 8 initial-valuef) 0.0) ;g
                    (set! (-> *part-id-table* 1706 init-specs 9 initial-valuef) 0.0) ;b
                )
            )
        )
        (when (= lui 13)
            (cond
                ((string= levelup-string "reset")
                    (set! (-> *part-id-table* 1707 init-specs 6 initial-valuef) 255.0) ;r 7
                    (set! (-> *part-id-table* 1707 init-specs 7 initial-valuef) 255.0) ;g 7
                    (set! (-> *part-id-table* 1707 init-specs 8 initial-valuef) 255.0) ;b 7 
                )
                ((string= levelup-string "noto")
                    (set! (-> *part-id-table* 1707 init-specs 6 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1707 init-specs 7 initial-valuef) 255.0) ;g
                    (set! (-> *part-id-table* 1707 init-specs 8 initial-valuef) 0.0) ;b
                )
                ((string= levelup-string "guns")
                    (set! (-> *part-id-table* 1707 init-specs 6 initial-valuef) 255.0) ;r
                    (set! (-> *part-id-table* 1707 init-specs 7 initial-valuef) 0.0) ;g
                    (set! (-> *part-id-table* 1707 init-specs 8 initial-valuef) 0.0) ;b    
                )
            )
        )
        (when (= lui 15)
            (cond
                ((logtest? (-> *part-group-id-table* 1777 flags) (sp-group-flag sp13))
                    (set! (-> *launch-matrix* trans quad) (-> (target-pos 0) quad))
                    (part-tracker-spawn part-tracker-subsampler :to *active-pool* :group (-> *part-group-id-table* 1777))
                    )
                (else
                    (set! (-> *launch-matrix* trans quad) (-> (target-pos 0) quad))
                    (part-tracker-spawn part-tracker :to *active-pool* :group (-> *part-group-id-table* 1777))
                    )
                )
                (set! kill-eco-delay #t)
                (set! killeci 0)
        )
    )

    (when (= kill-eco-delay #t)
        (+! killeci 1)
        (when (= killeci 777)
            (levelup-reset-color)
            (set! killeci 0)
            (set! kill-eco-delay #f)
        )
    )

    (when 
        (!= notoriety-level (-> *game-info* total-trys))
            (set! notoriety-level (-> *game-info* total-trys))
    )
    (when ;bind total-trys and notoriety-level together as a game-save stat
        (!= guns-level (-> *game-info* auto-save-count))
            (set! guns-level (-> *game-info* auto-save-count))
        )
    (when (and
            (!= cars-level (-> *game-info* total-deaths))
            (!= (-> *game-info* total-deaths) 0)
        )
            (set! cars-level (-> *game-info* total-deaths))
    )
    (when ;level up parameters NOTO
        (and
            (>= (-> *game-info* karma) (* (+ (* notoriety-level 60) (* notoriety-level 100)) notoriety-level))
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (!= (-> *game-info* karma) 0.0)
            (!= notoriety-level 0)
        )
            (set! extra-offthetop (- (-> *game-info* karma) (* (+ (* notoriety-level 60) (* notoriety-level 100)) notoriety-level)))
            (level-up! 1)
        )

        (when ;level up parameters GUNS
        (and
            (>= (-> *game-info* buzzer-total) (* (+ (* guns-level 120) (* guns-level 200)) guns-level))
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (!= (-> *game-info* buzzer-total) 0.0)
            (!= guns-level 0)
        )
            (set! extra-offthetop (- (-> *game-info* buzzer-total) (* (+ (* guns-level 120) (* guns-level 200)) guns-level)))
            (level-up-guns! 1)
        )

        (when ;level up parameters CARS
        (and
            (>= (-> *game-info* fuel) (* (+ (* cars-level 30) (* cars-level 175)) cars-level))
            *target*
            (not *scene-player*)
            (= (paused?) #f)
            (!= (-> *game-info* fuel) 0.0)
            (!= guns-level 0)
        )
            (set! extra-offthetop (- (-> *game-info* fuel) (* (+ (* cars-level 30) (* cars-level 175)) cars-level)))
            (level-up-cars! 1)
        )

        (when 
            (and
                *target*
                (not *scene-player*)
                (= (paused?) #f)
                (task-node-closed? (game-task-node arena-training-1-introduction))
                (not (task-node-closed? (game-task-node arena-training-1-collect)))
                (= (-> *game-info* karma) (the int 65))
            )
                (set! (-> *game-info* karma) 0.0)
            )

            ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;HPBAR;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

        ;NEW HP BAR:
        (when (= enemy-hp #t)
  (+! hpi 1)
  (let ((color-string "<COLOR_WHITE>Lv. "))
    (when (and
            (<= enemy-noto (+ notoriety-level 3))
            (> enemy-noto (- notoriety-level 3))
            (not (string= color-string "<COLOR_YELLOW>Lv. ")))
      (set! color-string "<COLOR_YELLOW>Lv. "))
    (when (and
            (>= enemy-noto (+ notoriety-level 3))
            (not (string= color-string "<COLOR_RED>Lv. ")))
      (set! color-string "<COLOR_RED>Lv. "))
    (when (and
            (<= enemy-noto (- notoriety-level 3))
            (> enemy-noto (- notoriety-level 7))
            (not (string= color-string "<COLOR_GREEN>Lv. ")))
      (set! color-string "<COLOR_GREEN>Lv. "))
    (when (and
            (< enemy-noto (- notoriety-level 7))
            (not (string= color-string "<COLOR_TRANSPARENT>Lv. ")))
      (set! color-string "<COLOR_TRANSPARENT>Lv. "))
    (when
      (and
        *target*
        (not *scene-player*)
        (= (paused?) #f)
        (= in-menu? #f))
      (let ((level-cap hpbar-max-hit-points)
            (arg1 hpbar-hit-points)
            (new-percent 0.0)
            (dt (seconds-per-frame)))
        (when (< level-cap arg1)
          (set! arg1 0.0))
        (when (!= level-cap 0.0)
          (set! new-percent (/ arg1 level-cap))
          (when (< new-percent 0.0)
            (set! new-percent 0.0))
          (when (> new-percent 1.0)
            (set! new-percent 1.0))

          (when (= enemy-hp-force-full-reset? #t)
            (set! enemy-hp-percent 1.0)
            (set! enemy-hp-display-percent 1.0)
            (set! enemy-hp-start-percent 1.0)
            (set! enemy-hp-target-percent 1.0)
            (set! enemy-hp-anim-timer enemy-hp-anim-duration)
            (set! enemy-hp-chip-active #f)
            (set! enemy-hp-chip-percent 1.0)
            (set! enemy-hp-chip-timer 0.0)
            (set! enemy-hp-force-full-reset? #f))

          (when (!= enemy-hp-percent new-percent)
            (when (< new-percent enemy-hp-percent)
              (when (or (= enemy-hp-chip-active #f)
                        (= enemy-hp-target-swapped? #t))
                (set! enemy-hp-chip-percent enemy-hp-display-percent))
              (set! enemy-hp-chip-active #t)
              (set! enemy-hp-chip-timer 0.0))
            (when (> new-percent enemy-hp-percent)
              (set! enemy-hp-chip-active #f)
              (set! enemy-hp-chip-percent new-percent))
            (set! enemy-hp-percent new-percent)
            (set! enemy-hp-start-percent enemy-hp-display-percent)
            (set! enemy-hp-target-percent enemy-hp-percent)
            (set! enemy-hp-anim-timer 0.0)
            (set! enemy-hp-target-swapped? #f))

          (when (= enemy-hp-chip-active #t)
            (+! enemy-hp-chip-timer dt)
            (when (> enemy-hp-chip-timer (+ enemy-hp-chip-delay enemy-hp-chip-shrink-duration))
              (set! enemy-hp-chip-active #f)
              (set! enemy-hp-chip-percent enemy-hp-display-percent)))))
      (let* ((dt (seconds-per-frame))
             (dur enemy-hp-anim-duration)
             (u 0.0)
             (inv 0.0)
             (ease 0.0))
        (when (< dur 0.001)
          (set! dur 0.001))
        (when (< enemy-hp-anim-timer dur)
          (+! enemy-hp-anim-timer dt)
          (when (> enemy-hp-anim-timer dur)
            (set! enemy-hp-anim-timer dur)))
        (set! u (/ enemy-hp-anim-timer dur))
        (when (< u 0.0)
          (set! u 0.0))
        (when (> u 1.0)
          (set! u 1.0))
        (set! inv (- 1.0 u))
        (set! ease (- 1.0 (* inv inv inv)))
        (set! enemy-hp-display-percent
              (+ enemy-hp-start-percent
                 (* (- enemy-hp-target-percent enemy-hp-start-percent) ease)))
        (when (= u 1.0)
          (set! enemy-hp-display-percent enemy-hp-target-percent)))
      (when (< enemy-hp-display-percent 0.0)
        (set! enemy-hp-display-percent 0.0))
      (when (> enemy-hp-display-percent 1.0)
        (set! enemy-hp-display-percent 1.0))
      (when (< enemy-hp-chip-percent 0.0)
        (set! enemy-hp-chip-percent 0.0))
      (when (> enemy-hp-chip-percent 1.0)
        (set! enemy-hp-chip-percent 1.0))
      (let ((health-pos 0))
        (when (= hud-timer-on? #f)
          (set! health-pos 10))
        (when (or (= hud-timer-on? #t) (= r3-noto #t))
          (set! health-pos 80))
        (when
          (and
            (= weather-dark-mode #f)
            (= onfoot-battle? #f))
          (clear matt-str)
          (clear *pc-encoded-matt-str*)
          (format matt-str "~s~%~%<COLOR_WHITE>~s~d"
                  enemy-string
                  color-string
                  draw-enemy-noto)
          (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
          (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
            (dma-buffer-add-gs-set-flusha
              buf
              (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
              (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 255 health-pos 0.0 (font-color default) (font-flags middle shadow kerning large))))
              (set! (-> font-ctx scale) 0.325)
              (draw-string-adv *pc-encoded-matt-str* buf font-ctx))))
        (when
          (or
            (= weather-dark-mode #t)
            (= onfoot-battle? #t))
          (clear matt-str)
          (clear *pc-encoded-matt-str*)
          (format matt-str "~s~%~%<COLOR_WHITE>~s<COLOR_RED>??"
                  enemy-string
                  color-string)
          (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
          (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
            (dma-buffer-add-gs-set-flusha
              buf
              (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
              (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
            (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 255 health-pos 0.0 (font-color default) (font-flags middle shadow kerning large))))
              (set! (-> font-ctx scale) 0.325)
              (draw-string-adv *pc-encoded-matt-str* buf font-ctx)))))
      (let* ((x 100)
       (y 21)
       (progress enemy-hp-display-percent)
       (chip-progress enemy-hp-chip-percent)
       (chip-u 0.0)
       (chip-height 6)
       (chip-y (+ y 1))
       (chip-alpha #x70)
       (arg3
         (let ((hp-color-t enemy-hp-display-percent)
               (r 0.0)
               (g 0.0)
               (b 0.0))
           (when (< hp-color-t 0.0)
             (set! hp-color-t 0.0))
           (when (> hp-color-t 1.0)
             (set! hp-color-t 1.0))

           (if (< hp-color-t 0.20)
            (begin
            (set! r 255.0)
            (set! g 0.0)
            (set! b 0.0))
            (let ((t (/ (- hp-color-t 0.20) 0.80)))
            (when (< t 0.5)
                (let ((t2 (/ t 0.5)))
                (set! r 255.0)
                (set! g (lerp 0.0 200.0 t2))
                (set! b 0.0)))
            (when (>= t 0.5)
                (let ((t2 (/ (- t 0.5) 0.5)))
                (set! r (lerp 255.0 0.0 t2))
                (set! g 200.0)
                (set! b 0.0)))))

           (new 'static 'rgba
             :r (the int r)
             :g (the int g)
             :b (the int b)
             :a #x40)))
       (chip-arg (new 'static 'rgba :r 255 :g 0 :b 0 :a chip-alpha)))
  (when (or (= hud-timer-on? #t) (= r3-noto #t))
    (set! y 90)
    (set! chip-y (+ y 1)))
  (when (= enemy-hp-chip-active #t)
    (when (> enemy-hp-chip-timer enemy-hp-chip-delay)
      (set! chip-u (/ (- enemy-hp-chip-timer enemy-hp-chip-delay)
                      enemy-hp-chip-shrink-duration))
      (when (< chip-u 0.0)
        (set! chip-u 0.0))
      (when (> chip-u 1.0)
        (set! chip-u 1.0))
      (set! chip-height (the int (* 6.0 (- 1.0 chip-u))))
      (set! chip-y (+ (+ y 1) (the int (* 6.0 chip-u))))
      (set! chip-alpha (the int (* 112.0 (- 1.0 chip-u))))
      (set! chip-arg (new 'static 'rgba :r 255 :g 0 :b 0 :a chip-alpha))))
  (with-dma-buffer-add-bucket ((s2-0 (-> *display* frames (-> *display* on-screen) global-buf))
                               (bucket-id particles))
    (draw-sprite2d-xy s2-0 x y 310 8 (new 'static 'rgba :a (-> arg3 a)) #x3fffff)
    (when (and (= enemy-hp-chip-active #t)
               (> chip-progress progress)
               (> chip-height 0)
               (> chip-alpha 0))
      (let ((red-w (the int (* 310.0 progress)))
            (chip-w (the int (* 310.0 chip-progress))))
        (when (> chip-w red-w)
          (draw-sprite2d-xy s2-0
                            (+ (+ x 1) red-w)
                            chip-y
                            (- chip-w red-w)
                            chip-height
                            chip-arg
                            #x3fffff))))
    (draw-sprite2d-xy s2-0
                      (+ x 1)
                      (+ y 1)
                      (the int (* 310.0 progress))
                      6
                      arg3
                      #x3fffff)))))
  (when (= hpi 400)
    (set! hpi 0)
    (set! enemy-hp #f)
    (set! enemy-hp-chip-active #f)
    (set! enemy-hp-last-target (the-as target #f))
    (set! enemy-hp-target-swapped? #f)
    (set! enemy-hp-force-full-reset? #f)))

        ;TARGBAR
        (when 
            (and
                (not *scene-player*)
                *target*
                (not (focus-test? *target* pilot))
                (= in-pre-tutorial? #f)
                (= (paused?) #f)
                (= in-vin-shop? #f)
                (not mainmenu-camera)
                (not disable-targbar)
                (not hmplus-intro-active?)
                (not in-dialogue?)
                (not in-menu?)
                (not (task-node-open? (game-task-node city-blow-tower-phase-1)))
                (not (task-node-open? (game-task-node city-blow-tower-resolution)))
                (not (search-process-tree *active-pool* (lambda ((p process)) (type? p pet-menu))))
            )
                (draw-targbar-hp)
                (draw-targbar-dark)
                (when (logtest? (-> *game-info* features) (game-feature lightjak))
                    (draw-targbar-light)
                )
                (when (>= notoriety-level 10)
                    (when (!= (-> *target* fact health-max) (+ (-> *FACT-bank* health-max-default) (/ (-> *game-info* total-trys) 3)))
                        (set! (-> *target* fact health-max) (+ (-> *FACT-bank* health-max-default) (/ (-> *game-info* total-trys) 3)))
                    )
                )
            )

        (when
            (and
                (not *scene-player*)
                (= (paused?) #f)
                (= (pause-allowed?) #t)
                *target*
                (= delayed-heal-full #t)
            )
                (+! del-i 1)
                (when 
                    (and
                        (!= (-> *target* fact health) (+ (-> *FACT-bank* health-max-default) (/ (-> *game-info* total-trys) 3)))
                        (>= del-i 0)
                        (< del-i 260)
                    )
                    (set! (-> *target* fact health) (+ (-> *FACT-bank* health-max-default) (/ (-> *game-info* total-trys) 3)))
                    (set! del-i 0)
                    (set! delayed-heal-full #f)
                )
                (when (>= del-i 260)
                    (set! (-> *target* fact health) (+ (-> *FACT-bank* health-max-default) (/ (-> *game-info* total-trys) 3)))
                    (set! del-i 0)
                    (set! delayed-heal-full #f)
                )
            )


        ;level based enemy-levels in HERO MODE

                ;level based enemy-levels in HERO MODE

        (when (and
                (not level-override)
                (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
              )

            ;; DARK WORLD
            (when
                (and
                    (task-node-closed? (game-task-node arena-training-1-introduction))
                    (= weather-dark-mode #t)
                )
                (let ((hero-dark (hmplus-hero-end-level)))
                    (when (!= enemy-noto hero-dark)
                    (set! enemy-noto hero-dark)))
            )

            (when
                (= weather-dark-mode #f)

                ;; WASDOORS
                ;; normal = 1
                (let ((hero-lvl (hmplus-hero-map-level 1)))
                    (when
                        (and
                            (= (-> (level-get-target-inside *level*) name) 'wasdoors)
                            (!= enemy-noto hero-lvl)
                        )
                        (set! enemy-noto hero-lvl)
                    )
                )

                (when
                    (not in-arena-fight?)

                    ;; before arena-fight-2-resolution
                    (when
                        (not (task-node-closed? (game-task-node arena-fight-2-resolution)))

                        ;; WASCITYA
                        ;; normal = 1
                        (let ((hero-lvl (hmplus-hero-map-level 1)))
                            (when
                                (and
                                    (not (task-node-open? (game-task-node wascity-leaper-race-resolution)))
                                    (= (-> (level-get-target-inside *level*) name) 'wascitya)
                                    (!= enemy-noto hero-lvl)
                                )
                                (set! enemy-noto hero-lvl)
                            )
                        )

                        ;; WASCITYB
                        ;; normal = 2
                        (let ((hero-lvl (hmplus-hero-map-level 2)))
                            (when
                                (and
                                    (not (task-node-open? (game-task-node wascity-leaper-race-resolution)))
                                    (= (-> (level-get-target-inside *level*) name) 'wascityb)
                                    (not (task-node-open? (game-task-node wascity-pre-game-battle)))
                                    (!= enemy-noto hero-lvl)
                                )
                                (set! enemy-noto hero-lvl)
                            )
                        )
                    )

                    ;; after arena-fight-2-resolution
                    (when
                        (task-node-closed? (game-task-node arena-fight-2-resolution))

                        ;; WASCITYA
                        ;; hero was 50-60, which maps cleanly from early-game range
                        (let ((hero-low (hmplus-hero-map-level 1))
                                (hero-high (hmplus-hero-map-level 13)))
                            (when
                                (and
                                    (= (-> (level-get-target-inside *level*) name) 'wascitya)
                                    (or
                                        (< enemy-noto hero-low)
                                        (> enemy-noto hero-high)
                                    )
                                )
                                (set! enemy-noto (hmplus-hero-map-rand 1 13))
                            )
                        )

                        ;; WASCITYB
                        ;; hero was 56-66, use a slightly later early-game band
                        (let ((hero-low (hmplus-hero-map-level 8))
                                (hero-high (hmplus-hero-map-level 20)))
                            (when
                                (and
                                    (= (-> (level-get-target-inside *level*) name) 'wascityb)
                                    (not (task-node-open? (game-task-node wascity-pre-game-battle)))
                                    (or
                                        (< enemy-noto hero-low)
                                        (> enemy-noto hero-high)
                                    )
                                )
                                (set! enemy-noto (hmplus-hero-map-rand 8 20))
                            )
                        )
                    )
                )

                ;; ARENA FIGHT 1
                ;; normal = 1
                (let ((hero-lvl (hmplus-hero-map-level 1)))
                    (when
                        (and
                            (task-node-open? (game-task-node arena-fight-1-fight))
                            (!= enemy-noto hero-lvl)
                        )
                        (set! enemy-noto hero-lvl)
                    )
                )

                ;; ARENA FIGHT 2
                ;; normal ~= early-mid anchor, mapped from 10
                (let ((hero-lvl (hmplus-hero-map-level 10)))
                    (when
                        (and
                            (task-node-open? (game-task-node arena-fight-2-fight))
                            (!= enemy-noto hero-lvl)
                        )
                        (set! enemy-noto hero-lvl)
                    )
                )

                ;; ARENA FIGHT 3
                ;; normal ~= mid anchor, mapped from 20
                (let ((hero-lvl (hmplus-hero-map-level 20)))
                    (when
                        (and
                            (task-node-open? (game-task-node arena-fight-3-fight))
                            (!= enemy-noto hero-lvl)
                        )
                        (set! enemy-noto hero-lvl)
                    )
                )

                ;; DESERT
                ;; current hero version was (+ notoriety-level 47), but you wanted this
                ;; based on crates-opened, not player level. Anchor it near endgame-mid.
                (when
                    (and
                        (= (-> (level-get-target-inside *level*) name) 'desert)
                        (not (task-node-open? (game-task-node desert-jump-mission-protect-doors)))
                        (= in-satbattle? #f)
                        (= start-was-uprising #f)
                    )
                    (let ((hero-lvl (hmplus-hero-map-level 48)))
                        (when (!= enemy-noto hero-lvl)
                        (set! enemy-noto hero-lvl)
                        (set! start-was-uprising #t)
                        (set! wasi 0))
                    )
                )

                ;; PRECUR
                ;; keep this as a late/endgame anchor
                (let ((hero-lvl (hmplus-hero-map-level 49)))
                    (when
                        (and
                            (or
                                (task-node-open? (game-task-node precursor-tour-introduction))
                                (task-node-open? (game-task-node precursor-tour-generator-trigger))
                                (task-node-open? (game-task-node precursor-tour-resolution))
                            )
                            (or
                                (= (-> (level-get-target-inside *level*) name) 'precura)
                                (= (-> (level-get-target-inside *level*) name) 'precurb)
                                (= (-> (level-get-target-inside *level*) name) 'precurc)
                                (= (-> (level-get-target-inside *level*) name) 'precurd)
                            )
                            (!= enemy-noto hero-lvl)
                        )
                        (set! enemy-noto hero-lvl)
                    )
                )

                ;; DESBOSS
                ;; final band anchor
                (let ((hero-lvl (hmplus-hero-map-level 50)))
                    (when
                        (and
                            (or
                                (= (-> (level-get-target-inside *level*) name) 'deswalk)
                                (= (-> (level-get-target-inside *level*) name) 'desboss2)
                            )
                            (!= enemy-noto hero-lvl)
                        )
                        (set! enemy-noto hero-lvl)
                    )
                )

                ;; desert escalation over time
                (when
                    (and
                        (= start-was-uprising #t)
                        (= (-> (level-get-target-inside *level*) name) 'desert)
                        *target*
                        (not *scene-player*)
                        (= (paused?) #f)
                        (= (pause-allowed?) #t)
                    )
                    (+! wasi 1)
                    (when (= wasi 3000)
                        (+! enemy-noto 1)
                        (set! wasi 0))
                )

                ;; clear desert escalation flag when leaving
                (when
                    (and
                        (!= (-> (level-get-target-inside *level*) name) 'desert)
                        (not (task-node-open? (game-task-node arena-replay-1-fight)))
                        (= start-was-uprising #t)
                    )
                    (set! wasi 0)
                    (set! start-was-uprising #f)
                )
            )
            )
        

