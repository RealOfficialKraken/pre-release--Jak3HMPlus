(in-package goal)

;name: vin-shop.gc

(define vin-objective1 "")
(define vin-objective2 "")
(define vin-objective3 "")
(define vin-objective4 "")

(define vin-shop-hint "")

(define vin-shop-cost-item-1 0)
(define vin-shop-cost-item-2 0)
(define vin-shop-cost-item-3 0)
(define vin-shop-cost-item-4 0)
(define vin-shop-cost-item-5 0)

(define vin-shop-item-1-s "Research The Entity")
(define vin-shop-item-2-s "Mass Inverter")
(define vin-shop-item-3-s "Peace Maker")
(define vin-shop-item-4-s "Random Weapon")
(define vin-shop-item-5-s "Super Gun Mod")

(define all-gunmods-purchased? #f)
(define all-guns-purchased? #f)

(define vin-shop-menu-text-color "<COLOR_MENU-PARENT>")

(defun-extern spawn-eb-floater vector symbol float none)


;; these are broken and weird, probably not useful anymore
#|
(defun play-story-log-1 ()
    (set! in-dialogue? #t)
    (disable-hudmap)
    (set! log-id 1337)
    (none)
)

(defun play-story-log-2 ()
    (set! in-dialogue? #t)
    (disable-hudmap)
    (set! di-s1 "Okay... This is weird. These crystals")
    (set! di-s2 "contain huge amounts of code in them.")
    (set! di-s3 "")
    (set! di-s4 "")
    (none)
)

(defun play-story-log-3 ()
    (set! in-dialogue? #t)
    (disable-hudmap)
    (set! di-s1 "Jak! I'm in your pocket. Let's complete")
    (set! di-s2 "the main missions and get to the end!")
    (set! di-s3 "")
    (set! di-s4 "")
    (set! log-id 4449)
    (set! log-sec 0)
    (none)
)

(defun play-story-log-4 ()
    (set! in-dialogue? #t)
    (disable-hudmap)
    (set! di-s1 "Great work, boys! As always,")
    (set! di-s2 "I can count on you.")
    (set! di-s3 "")
    (set! di-s4 "")
    (none)
)
|#

(defun play-default-log ()
    (cond
        ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 0)
            ;; (play-story-log-1)
            (set! log-id 1337)
            (set! log-sec 1)
        )
        ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 1)
            ;; (play-story-log-2)
            (set! log-id 1348)
            (set! log-sec 1)
        )
        ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 2)
            ;; (play-story-log-3)
            (set! log-id 4449)
            (set! log-sec 1)
            
        )
        ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 3)
            ;; (play-story-log-4)
        )
        (else
            (print "|play-default-log| Cannot Talk to Vin because YOU NEED TO SET A CONVERSATION!")
        )
    )
    (none)
)

(defun vin-shop-menu-color-check ((idx int))
    (case idx
        ((0) 
        (cond 
            ((> (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 3)
                (set! vin-shop-menu-text-color "<COLOR_GREEN>"))
            (else
                (set! vin-shop-menu-text-color "<COLOR_MENU-PARENT>"))))

        ((1) 
            (if (logtest? (-> *game-info* features) (game-feature gun-dark-2)) ; gun-dark-2 purchased?
                (set! vin-shop-menu-text-color "<COLOR_GREEN>")
                (set! vin-shop-menu-text-color "<COLOR_MENU-PARENT>")))
                
        ((2) (if (logtest? (-> *game-info* features) (game-feature gun-dark-1)) ; gun-dark-1 purchased?
                (set! vin-shop-menu-text-color "<COLOR_GREEN>")
                (set! vin-shop-menu-text-color "<COLOR_MENU-PARENT>")))
                
        ((3) (if all-guns-purchased?
            (set! vin-shop-menu-text-color "<COLOR_GREEN>")
            (set! vin-shop-menu-text-color "<COLOR_MENU-PARENT>")))

        ((4) (if all-gunmods-purchased?
            (set! vin-shop-menu-text-color "<COLOR_GREEN>")
            (set! vin-shop-menu-text-color "<COLOR_MENU-PARENT>")))
    )
    (none)
)

(defun vin-shop-menu-append-item! ((dst string) (text string) (selected? symbol) (idx int))
    (vin-shop-menu-color-check idx)
    (if selected?
        (and
            (set! vin-shop-menu-text-color "<COLOR_YELLOW>")
            (cat-string<-string dst vin-shop-menu-text-color)
        )
        (cat-string<-string dst vin-shop-menu-text-color)
    )
    (cat-string<-string dst text)
    (common-menu-newline! dst)
    (none)
)

(defun set-vin-shop-prices! ()
    (cond 
        ;; when not in hero mode
        ((not (logtest? (-> *game-info* secrets) (game-secrets hero-mode))) 
            (cond 
                ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 0)
                    (set! vin-shop-cost-item-1 10)
                    (set! vin-shop-item-1-s "10 - Research The Entity")
                )
                ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 1)
                    (set! vin-shop-cost-item-1 15)
                    (set! vin-shop-item-1-s "15 - Research The Entity")
                )
                ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 2)
                    (set! vin-shop-cost-item-1 20)
                    (set! vin-shop-item-1-s "20 - Research The Entity")
                )
                (else
                    (set! vin-shop-cost-item-1 0)
                    (set! vin-shop-item-1-s "Talk to Vin")
                )
            )

            (set! vin-shop-cost-item-2 15)
            (if (not (logtest? (-> *game-info* features) (game-feature gun-dark-2)))
                (set! vin-shop-item-2-s "15 - Mass Inverter")
                (set! vin-shop-item-2-s "Mass Inverter")
            )

            (set! vin-shop-cost-item-3 10)
            (if (not (logtest? (-> *game-info* features) (game-feature gun-dark-1)))
                (set! vin-shop-item-3-s "10 - Peace Maker")
                (set! vin-shop-item-3-s "Peace Maker")
            )
            
            (set! vin-shop-cost-item-4 10)
            (if (not all-guns-purchased?)
                (set! vin-shop-item-4-s "10 - Random Weapon")
                (set! vin-shop-item-4-s "Random Weapon")
            )   

            (set! vin-shop-cost-item-5 20)
            (if (not all-gunmods-purchased?)
                (set! vin-shop-item-5-s "20 - Super Gun Mod")
                (set! vin-shop-item-5-s "Super Gun Mod")
            )
            
        )
        ;; when in hero mode
        (else 
            (cond 
                ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 0)
                    (set! vin-shop-cost-item-1 50)
                    (set! vin-shop-item-1-s "50 - Research The Entity")
                )
                ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 1)
                    (set! vin-shop-cost-item-1 100)
                    (set! vin-shop-item-1-s "100 - Research The Entity")
                )
                ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 2)
                    (set! vin-shop-cost-item-1 150)
                    (set! vin-shop-item-1-s "150 - Research The Entity")
                ))

            (set! vin-shop-cost-item-2 65)
            (if (not (logtest? (-> *game-info* features) (game-feature gun-dark-2)))
                (set! vin-shop-item-2-s "65 - Mass Inverter")
                (set! vin-shop-item-2-s "Mass Inverter")
            )

            (set! vin-shop-cost-item-3 50)
            (if (not (logtest? (-> *game-info* features) (game-feature gun-dark-1)))
                (set! vin-shop-item-3-s "50 - Peace Maker")
                (set! vin-shop-item-3-s "Peace Maker")
            )

            (set! vin-shop-cost-item-4 100)
            (if (not all-guns-purchased?)
                (set! vin-shop-item-4-s "100 - Random Weapon")
                (set! vin-shop-item-4-s "Random Weapon")
            )   
            
            (set! vin-shop-cost-item-5 150)
            (if (not all-gunmods-purchased?)
                (set! vin-shop-item-5-s "150 - Super Gun Mod")
                (set! vin-shop-item-5-s "Super Gun Mod")
            )
        )
    )
    (none)
)

(defun vin-shop-confirm! ()
    (cond 
        ;; shop item research
        ((= menu-index 0)
            (cond ((and
                (>= vin-crystals vin-shop-cost-item-1)
                (< (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 3)
                )
                (cond
                    ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 0)
                        (set! log-id 1337)
                        (set! log-sec 1)
                        ;; (play-story-log-1)
                        
                    )
                    ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 1)
                        (set! log-id 1345)
                        (set! log-sec 1)
                        ;; (play-story-log-2)
                    )
                    ((= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 2)
                        (set! log-id 1410)
                        (set! log-sec 0)
                        ;; (play-story-log-3)
                    )
                    ;; (else
                    ;;     (set! log-id 4449)
                    ;;     (set! log-sec 1)
                    ;;     ;; (when (> (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 0)
                    ;;         ;; (play-default-log)
                    ;;     ;; )
                    ;; )
                )
                (sound-play "special-pickup")
                (-! (-> *game-info* civilians-killed) vin-shop-cost-item-1)
                (+! (-> *game-info* continue-deaths) 1000000)
                (set! in-dialogue? #t)
                (disable-hudmap)
                )
                ((>= (/ (mod (-> *game-info* continue-deaths) 10000000) 1000000) 3) ; play story log 4
                    (set! log-id 4449)
                    (set! log-sec 1)
                    (set! in-dialogue? #t)
                    (disable-hudmap)
                )
            )
        )
        ;; shop item dark2
        ((and 
            (= menu-index 1) 
            (>= vin-crystals vin-shop-cost-item-2) 
            (not (logtest? (-> *game-info* features) (game-feature gun-dark-2))))
                (-! (-> *game-info* civilians-killed) vin-shop-cost-item-2)
                (give-weapon! "dark-2" 1)
                (close-vin-shop!)
                (draw-get-gun-popup 10)
        )
        ;; shop item dark1
        ((and 
            (= menu-index 2) 
            (>= vin-crystals vin-shop-cost-item-3) 
            (not (logtest? (-> *game-info* features) (game-feature gun-dark-1))))
                (-! (-> *game-info* civilians-killed) vin-shop-cost-item-3)
                (give-weapon! "dark-1" 1)
                (close-vin-shop!)
                (draw-get-gun-popup 9)
        )
        ;; shop item random weapon
        ((and 
            (= menu-index 3) 
            (>= vin-crystals vin-shop-cost-item-4)
            (not all-guns-purchased?)
            )
            (-! (-> *game-info* civilians-killed) vin-shop-cost-item-4)
            (give-random-weapon)
            (close-vin-shop!)
        )
        ;; shop item gunmod
        ((and 
            (= menu-index 4) 
            (>= vin-crystals vin-shop-cost-item-5)
            (not all-gunmods-purchased?)
            )
            (-! (-> *game-info* civilians-killed) vin-shop-cost-item-5)
            (set! drop-gun-mod #t)
            (close-vin-shop!)
        )
    )
    (none)
)

(defun draw-vin-shop-items ()
    (clear *temp-string*)
    (vin-shop-menu-append-item! *temp-string* vin-shop-item-1-s (= menu-index 0) 0)
    (common-menu-newline! *temp-string*)
    (vin-shop-menu-append-item! *temp-string* vin-shop-item-2-s (= menu-index 1) 1)
    (common-menu-newline! *temp-string*)
    (vin-shop-menu-append-item! *temp-string* vin-shop-item-3-s (= menu-index 2) 2)
    (common-menu-newline! *temp-string*)
    (vin-shop-menu-append-item! *temp-string* vin-shop-item-4-s (= menu-index 3) 3)
    (common-menu-newline! *temp-string*)
    (vin-shop-menu-append-item! *temp-string* vin-shop-item-5-s (= menu-index 4) 4)
    ;; (format *temp-string* *temp-string*)
    (draw-mod-menu-text-custom *temp-string* 85 110 0.325 #t #f #f)
    (none)
)

(defun vin-hint-pull ((idx int))
    (case idx
        ((0) (set! vin-shop-hint "You should start by gathering <COLOR_PINK>10 Dark Crystals<COLOR_WHITE>.~%~%That should help us learn more about them."))
        ((1) (set! vin-shop-hint "Certain new missions from The Entity~%~%will reward you a Super Gun Mod."))
        ((2) (set! vin-shop-hint "You can find <COLOR_PINK>Dark Eco Crystals<COLOR_WHITE> in~%~%Tier 3 <COLOR_PINK>Black Crates<COLOR_WHITE> dropped by enemies."))
        ((3) (set! vin-shop-hint "You can backtrack to levels you usually can't~%~%through the warp room for bonus rewards."))
        ((4) (set! vin-shop-hint "Certain Super Gun Mods can only be obtained~%~%from specific enemies as loot drops."))
        ((5) (set! vin-shop-hint "If a mission is too difficult, you can always~%~%return another time when you're stronger."))
        ((6) (set! vin-shop-hint "Fend off The Entity's dark ship scouts~%~%for bonus rewards."))
        ((7) (set! vin-shop-hint "Enemies over level 100 will receive~%~%no knockback, be careful!"))
        ((8) (set! vin-shop-hint "Crate drops will increase in both quantity~%~%and quality when you level up your <COLOR_ORANGE>Hero Level<COLOR_WHITE>."))
        ((9) (set! vin-shop-hint "Enemies much higher level than you will~%~%kill you instantly. Kill them for bonus XP."))
        ((10) (set! vin-shop-hint "All mini bosses have a higher chance to drop Pets."))
        ((9999999999) (set! vin-shop-hint "~%~%"))
        (else (set! vin-shop-hint "~%~%"))
    )
    (none)
)

(defun draw-vin-shop ()
    (set-vin-shop-prices!)
    ;; (vin-shop-purchased?)
    (when *dark-forest*
        (set! *dark-forest* #f)
        (kill-by-name "darkworld-tower" *default-pool*)
        (kill-by-name "darkworld-orb" *default-pool*)
    )
    (when (!= vin-crystals (the int (-> *game-info* civilians-killed)))
        (set! vin-crystals (the int (-> *game-info* civilians-killed)))
    )
    (when 
        (and
            (task-node-closed? (game-task-node modr-bigshot))
            (task-node-closed? (game-task-node modr-shield))
            (task-node-closed? (game-task-node modr-missles))
            (task-node-closed? (game-task-node mody-fireball))
            (task-node-closed? (game-task-node mody-nukeonly))
            (task-node-closed? (game-task-node mody-freeze))
            (task-node-closed? (game-task-node modb-ammo))
            (task-node-closed? (game-task-node modb-disperser))
            (task-node-closed? (game-task-node modb-airstrike))
            (task-node-closed? (game-task-node modd-morpher))
            (task-node-closed? (game-task-node modd-random))
            (task-node-closed? (game-task-node modd-reaper))
        )
        (set! all-gunmods-purchased? #t)
    )
    (when 
        (and
            (logtest? (-> *game-info* features) (game-feature gun-red-2))
            (logtest? (-> *game-info* features) (game-feature gun-red-3))
            (logtest? (-> *game-info* features) (game-feature gun-yellow-2))
            (logtest? (-> *game-info* features) (game-feature gun-yellow-3))
            (logtest? (-> *game-info* features) (game-feature gun-blue-1))
            (logtest? (-> *game-info* features) (game-feature gun-blue-2))
            (logtest? (-> *game-info* features) (game-feature gun-blue-3))
        )
        (set! all-guns-purchased? #t)
    )
    (draw-mod-menu-background)
    (draw-mod-menu-text-preset 0 "<COLOR_PINK>Vin's Black Market")
    (draw-mod-menu-text-preset 1 "<PAD_X> Purchase   <PAD_TRIANGLE> Exit")
    (draw-mod-menu-text-custom "~%~%~%Trade your Dark Eco Crystals for goods" 255 50 0.325 #f #t #f)
    (draw-vin-shop-items)

    (clear *temp-string*)
    (format *temp-string* "<COLOR_ORANGE>Your Crystals: ~D"
    vin-crystals
    )
    (draw-mod-menu-text-custom *temp-string* 
    (- 512 90) 110 0.325  #f #f #t)

    ;; vin-shop hints
    (clear *temp-string*)
    (format *temp-string* "<COLOR_YELLOW>Hint:<COLOR_WHITE> ~S"
    vin-shop-hint
    )
    (draw-mod-menu-text-custom *temp-string*
    256 290 0.325 #f #t #f)
    (none)
)

(defun open-vin-shop! ()
    (sound-play "menu-back")
    (set! in-vin-shop? #t)
    (set! menu-index 0)
    (set! menu-index-max 4)
    (disable-hudmap)

    ;; (vin-hint-pull (rand-vu-int-range 1 9))
    (vin-hint-pull vin-hinti)
    (+! vin-hinti 1)
    (when (> vin-hinti 10)
        (set! vin-hinti 1)
    )

    (none)
)

(defun close-vin-shop! ()
    (set! in-vin-shop? #f)
    (set! di-s1 "")
    (set! di-s2 "")
    (set! di-s3 "")
    (set! di-s4 "")
    (set! in-dialogue? #f)
    (set! dialogue-choice #f)
    (set! dialogue-select 0)
    (set! choice-given? #f)
    (set! log-sec 0)
    (set! log-id 0)
    ;(spawn-dark-world-forest)
    (enable-hudmap)
    (camera-unlocked)
    (none)
)

(defun runs-shop! () ;runs every frame when (= weather-dark-mode #t)
    (let ((shop-rad-vec (new-stack-vector0)))
        (set-vector! shop-rad-vec (meters 2263.7312) (meters 30.7659) (meters 184.4911) 1.0)
        (when 
            (and
                (= (-> (level-get-target-inside *level*) name) 'wasdoors)
                *target*
                (not *scene-player*)
                (= (paused?) #f)
                (= in-vin-shop? #f)
                (= in-menu? #f)
                (= in-dialogue? #f)
                (<= (vector-vector-distance (target-pos 0) shop-rad-vec) 130000.0)
            )
            (draw-mod-menu-text-preset 1 "<PAD_TRIANGLE> Talk to Cyber Vin")
            (when (cpad-pressed? 0 triangle)
                (open-vin-shop!)
            )
            (cpad-clear! 0 triangle)
        )
        (when 
            (and 
                (= in-vin-shop? #t)
                *target*
                (not *scene-player*)
                (= in-dialogue? #f)
                (= (paused?) #f)
            )
            (let ((cam-pos (new 'static 'vector :x (meters 2265.2912) :y (meters 33.0) :z (meters 225.7977) :w 1.0))
                (tpos (new 'static 'vector :x (meters 2265.9230) :y (meters 41.4826) :z (meters 190.6130) :w 1.0))
                )
                (turn-to-scene-camera cam-pos tpos #t)
            )
            (draw-vin-shop)
            (mod-menu-controls)
        )
    )

    ; vin dialogue
    (when (and (= in-dialogue? #t) (not (paused?)))
        (when (cpad-pressed? 0 x)
            (+! log-sec 1)
            (cpad-clear! 0 x)
        )

        ;;;;;;;;;;;;;;;;;;;;;;;;;;;; section 1 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;

        (cond
            ((= log-id 1337) ;; story log 1
                (when (= log-sec 1)
                    (set! di-s1 "Great work, boys! These crystals are...")
                    (set! di-s2 "very interesting...")
                    (set! di-s3 "")
                    (set! di-s4 "")
                )
                (when (= log-sec 2)
                    (set! di-s1 "I have more knowledge to share about these")
                    (set! di-s2 "if you would like to know.")
                    (set! di-s3 "")
                    (set! di-s4 "")
                )
                (when (= log-sec 3)
                    (set! choice-max 3)
                    (set! dialogue-choice #t)
                    (set! choice-given? #t)
                    (set! di-c1 "Who are you again?")
                    (set! di-c2 "How exactly do these crystals help?")
                    (set! di-c3 "What do we know about The Entity?")
                    (set! di-c4 "Why can't you fight The Entity yourself?")
                )
                (when (= log-sec 4)
                    (cond  
                        ((= dialogue-select 0)
                            (set! log-id 1338)
                        )
                        ((= dialogue-select 1)
                            (set! log-id 1339)
                        )
                        ((= dialogue-select 2)
                            (set! log-id 1340)
                        )
                        ((= dialogue-select 3)
                            (set! log-id 1341)
                        )
                    )
                    (set! choice-given? #f)
                    (set! log-sec 1)
                )
            )

            ((= log-id 1338) ;; Who are you again?
                (when (= log-sec 1)
                    (set! di-s1 "Oh... I get it, it has been a really")
                    (set! di-s2 "long time since we last spoke.")
                    (set! di-s3 "")
                    (set! di-s4 "")
                )
                (when (= log-sec 2)
                    (set! di-s1 "I am <COLOR_CYAN>Cyber Vin<COLOR_WHITE>. When I dumped my brain")
                    (set! di-s2 "into the eco grid, I meshed together with")
                    (set! di-s3 "Dark Eco energy.")
                    (set! di-s4 "")
                )
                (when (= log-sec 3)
                    (set! di-s1 "Since then, I've used my technical ability to expand")
                    (set! di-s2 "my conscious and cast a figment model to help you")
                    (set! di-s3 "see me better.")
                    (set! di-s4 "")
                )
                (when (= log-sec 4)
                    (set! di-s1 "Being all code is super weird...")
                    (set! di-s2 "")
                    (set! di-s3 "")
                    (set! di-s4 "")
                )
                (when (= log-sec 5)
                    (set! di-s1 "But it's also super great!")
                    (set! di-s2 "I have no fear for my existence anymore!")
                    (set! di-s3 "")
                    (set! di-s4 "")
                )
                (when (= log-sec 6)
                    (set! di-s1 "That is... until I discovered <COLOR_RED>The Entity<COLOR_WHITE>.")
                    (set! di-s2 "")
                    (set! di-s3 "")
                    (set! di-s4 "")
                )
                (when (= log-sec 7)
                    (set! choice-given? #t)
                    (set! dialogue-choice #t)
                    (set! choice-max 1)
                    (set! di-c1 "Who is The Entity?")
                    (set! di-c2 "Why did you close me in this world with The Entity?")
                    (set! di-c3 "")
                    (set! di-c4 "")
                )
                (when (= log-sec 8)
                    (cond  
                        ((= dialogue-select 0)
                            (set! log-id 1340)
                        )
                        ((= dialogue-select 1)
                            (set! log-id 1342)
                        )
                    )
                    (set! choice-given? #f)
                    (set! log-sec 1)
                )
            )

            ((= log-id 1339) ; How exactly do these crystals help?
                (when (= log-sec 1)
                    (set! di-s1 "If you remember, <COLOR_RED>The Entity<COLOR_WHITE> got access to")
                    (set! di-s2 "a tremenous amount of <COLOR_PINK>Dark Eco<COLOR_WHITE>.")
                    (set! di-s3 "")
                    (set! di-s4 "")
                )
                (when (= log-sec 2)
                    (set! di-s1 "Well it seems as though he has run out of world")
                    (set! di-s2 "to spread this in, so it looks like he's")
                    (set! di-s3 "storing them in these containers.")
                    (set! di-s4 "")
                )
                (when (= log-sec 3)
