#|
(defskelgroup skel-entity-boss-floater precursor precursor-lod0-jg precursor-idle-ja
              ((precursor-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 8)
              :origin-joint-index 6
              )

(deftype entity-boss-floater (process-drawable)
    ((pos                       vector :inline)
     (should-die?                       symbol)
    )
    (:state-methods
        floating-up
        floating
        flash-out-and-die
    )
    (:methods
        (entity-boss-float (_type_) none)
        (eb-floater-event-handler (_type_ process int symbol event-message-block) none)
    )
)

(defbehavior entity-boss-floater-event-handler entity-boss-floater ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (eb-floater-event-handler self arg0 arg1 arg2 arg3)
  (none)
)

(defmethod eb-floater-event-handler ((this entity-boss-floater) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('go-die!)
      (set! (-> this should-die?) #t)))
  (none)
)

(defbehavior entity-boss-floater-init-by-other entity-boss-floater ((vec vector) (pre-int? symbol))
    (vector-copy! (-> self pos) vec)
    (set! (-> self should-die?) #f)
    (if pre-int?
        (go-virtual floating-up)
        (go-virtual floating)
    )
    (none)
)

(defun spawn-eb-floater ((vec vector) (pre-int? symbol))
    (set! *eb-floater*
        (process-spawn entity-boss-floater vec pre-int? :name "eb-floater")
    )
    (none)
)

(defstate floating-up (entity-boss-floater)
    :virtual #t
    :enter (behavior ()
        (-! (-> self pos y) (meters 15))
    )
    :code (behavior ()
        (loop
            ;;put a slow rise up for 15 meters
            ;;after its done, start floating:
            (go-virtual floating)
            (suspend)
        )
    )
)

(defstate floating (entity-boss-floater)
    :virtual #t
    :code (behavior ()
        (loop
            ;;its just floating up and down on a loop, until should-die is #t
            (when (-> self should-die? #t)
                (go-virtual flash-out-and-die)
            )
            (suspend)
        )
    )
)

(defstate flast-out-and-die (entity-boss-floater)
    :virtual #t
    :code (behavior ()
        (lightjak-get-off-part (-> self pos))
        (set! *eb-floater* #f)
        (kill-by-name "eb-floater")
        (deactivate self)
    )
)|#

(defskelgroup skel-entity-boss-floater precursor precursor-lod0-jg precursor-idle-ja
  ((precursor-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 8)
  :origin-joint-index 6
)

(deftype entity-boss-floater (process-drawable)
  ((pos         vector :inline)
   (start-pos   vector :inline)
   (float-y     float)
   (float-hold? symbol)
   (should-die? symbol))
  (:state-methods
    floating-up
    floating
    flash-out-and-die)
  (:methods
    (entity-boss-float (_type_) none)
    (eb-floater-event-handler (_type_ process int symbol event-message-block) none))
)

(defbehavior entity-boss-floater-event-handler entity-boss-floater ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (eb-floater-event-handler self arg0 arg1 arg2 arg3)
  (none)
)

(defmethod eb-floater-event-handler ((this entity-boss-floater) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('go-die!)
      (set! (-> this should-die?) #t)))
  (none)
)

(defbehavior entity-boss-floater-init-by-other entity-boss-floater ((vec vector) (pre-int? symbol) (size-eb float))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self pos) vec)
  (vector-copy! (-> self start-pos) vec)
  (vector-copy! (-> self root trans) vec)
  (set! (-> self float-hold?) #f)
  (set! (-> self root trans w) 1.0)
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self root scale) size-eb size-eb size-eb 1.0)
  (initialize-skeleton-by-name self "entity-boss-floater")
  (set! (-> self should-die?) #f)
  (set! (-> self float-y) (-> self start-pos y))
  (if pre-int?
      (go-virtual floating-up)
      (go-virtual floating))
  (none)
)

(defun spawn-eb-floater ((vec vector) (pre-int? symbol) (size-eb float))
  (set! *eb-floater*
    (process-spawn entity-boss-floater vec pre-int? size-eb :name "eb-floater"))
  (none)
)

(defun eb-floater-face-camera-y! ((this entity-boss-floater))
  (let ((to-target (new-stack-vector0))
        (from-pos  (new-stack-vector0)))
    (vector-copy! from-pos (-> this root trans))
    (if *camera-combiner*
        (vector-copy! to-target (-> *camera-combiner* trans))
        (set-vector! to-target
                     (-> from-pos x)
                     (-> from-pos y)
                     (+ (-> from-pos z) (meters 1.0))
                     1.0))
    (vector-! to-target to-target from-pos)
    (set! (-> to-target y) 0.0)
    (when (< (vector-length to-target) (meters 0.001))
      (set-vector! to-target 0.0 0.0 1.0 1.0))
    (vector-normalize! to-target 1.0)
    (quaternion-look-at! (-> this root quat) to-target *up-vector*)
    (none))
)

(defstate floating-up (entity-boss-floater)
  :virtual #t
  :post ja-post
  :enter (behavior ()
    (set-time! (-> self state-time))
    (vector-copy! (-> self pos) (-> self start-pos))
    (-! (-> self pos y) (meters 30.0))
    (vector-copy! (-> self root trans) (-> self pos))
    (set! (-> self root trans w) 1.0))
    (eb-floater-face-camera-y! self)
  :code (behavior ()
    (loop
      (let* ((dur (seconds 16.0))
             (elapsed (- (current-time) (-> self state-time)))
             (t (fmin 1.0 (/ (the float elapsed) (the float dur))))
             (ease (* t t (- 3.0 (* 2.0 t))))
             (y (lerp (-> self pos y) (-> self start-pos y) ease)))
        (set! (-> self root trans x) (-> self start-pos x))
        (set! (-> self root trans y) y)
        (set! (-> self root trans z) (-> self start-pos z))
        (set! (-> self root trans w) 1.0)
        (when (>= t 1.0)
          (set! (-> self root trans x) (-> self start-pos x))
          (set! (-> self root trans y) (-> self start-pos y))
          (set! (-> self root trans z) (-> self start-pos z))
          (set! (-> self root trans w) 1.0)
          (eb-floater-face-camera-y! self)
          (set! (-> self float-y) (-> self start-pos y))
          (go-virtual floating))
        (suspend))))
)

(defstate floating (entity-boss-floater)
  :virtual #t
  :post ja-post
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! (-> self root trans x) (-> self start-pos x))
    (set! (-> self root trans y) (-> self start-pos y))
    (set! (-> self root trans z) (-> self start-pos z))
    (set! (-> self root trans w) 1.0))
    (eb-floater-face-camera-y! self)
  :code (behavior ()
    (loop
      (let* ((dur (seconds 5.0))
             (elapsed (- (current-time) (-> self state-time)))
             (cycle (/ (the float elapsed) (the float dur)))
             (t (- cycle (floor cycle)))
             (ping (if (< t 0.5)
                       (* t 2.0)
                       (* (- 1.0 t) 2.0)))
             (ease (* ping ping (- 3.0 (* 2.0 ping))))
             (y (+ (-> self float-y) (lerp 0.0 (meters -3.0) ease))))
        (set! (-> self root trans x) (-> self start-pos x))
        (set! (-> self root trans y) y)
        (set! (-> self root trans z) (-> self start-pos z))
        (set! (-> self root trans w) 1.0)
        (eb-floater-face-camera-y! self)
        (when (= (-> self should-die?) #t)
          (go-virtual flash-out-and-die))
        (suspend))))
)

(defstate flash-out-and-die (entity-boss-floater)
  :virtual #t
  :code (behavior ()
    (lightjak-get-off-part (-> self root trans))
    (set! *eb-floater* #f)
    (kill-by-name "eb-floater" *default-pool*)
    (deactivate self))
)