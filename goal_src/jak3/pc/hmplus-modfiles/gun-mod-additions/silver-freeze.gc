(in-package goal)

;; file-name: silver-freeze.gc

(deftype silver-freeze-proc (process)
  ((victim              handle)
   (end-time            time-frame)
   (old-gravity-y       float)
   (old-gravity-max     float)
   (old-gravity-length  float)
   (old-clock           clock)
   (freeze-clock        clock))
  (:state-methods
    active)
  )

(defun silver-freeze-exempt? ((victim process))
  (if victim
      (let ((enemy-name (remap-enemy-type-name (-> victim type))))
        (or (= enemy-name 'eco-creature-small)
            (= enemy-name 'eco-creature-medium)
            (= enemy-name 'eco-creature-large)
            (= enemy-name 'entity-boss)
            (= enemy-name 'rage-ghost)))
      #f))

(defbehavior silver-freeze-proc-init-by-other silver-freeze-proc ((victim process))
  (set! (-> self victim) (process->handle victim))
  (if (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
      (set! (-> self end-time) (+ (current-time) (seconds 0.5)))
      (set! (-> self end-time) (+ (current-time) (seconds 2))))
  (set! (-> self old-gravity-y) 0.0)
  (set! (-> self old-gravity-max) 0.0)
  (set! (-> self old-gravity-length) 0.0)
  (set! (-> self old-clock) (the-as clock #f))
  (set! (-> self freeze-clock) (the-as clock #f))
  (go-virtual active)
  (none))

(defun silver-freeze-kill-procs ((victim process))
  (when victim
    (let ((p (-> *active-pool* child)))
      (while p
        (let ((next-p (-> p 0 brother)))
          (when (and (type? (ppointer->process p) silver-freeze-proc)
                     (= (-> (the-as silver-freeze-proc (ppointer->process p)) victim)
                        (process->handle victim)))
            (deactivate (the-as silver-freeze-proc (ppointer->process p))))
          (set! p next-p)))))
  (none))

(defun silver-freeze-acquire-clock ((self silver-freeze-proc) (victim process))
  (when (and victim
             (not (-> self freeze-clock))
             (< (-> victim clock index) 12))
    (dotimes (i 10)
      (when (zero? (-> *display* clock (+ i 12) ref-count))
        (set! (-> self freeze-clock) (-> *display* clock (+ i 12)))
        (set! (-> self old-clock) (-> victim clock))
        (copy! (-> self freeze-clock) (-> victim clock))
        (+! (-> victim clock ref-count) -1)
        (set! (-> self freeze-clock ref-count) 1)
        (set! (-> victim clock) (-> self freeze-clock))
        (update-rates! (-> self freeze-clock) 0.0)
        (goto done))))
  (label done)
  (none))

(defun silver-freeze-release-clock ((self silver-freeze-proc) (victim process))
  (when (-> self freeze-clock)
    (when (and victim
               (-> self old-clock)
               (= (-> victim clock) (-> self freeze-clock)))
      (+! (-> self old-clock ref-count) 1)
      (set! (-> victim clock) (-> self old-clock)))
    (set! (-> self freeze-clock ref-count) 0)
    (update-rates! (-> self freeze-clock) 1.0))
  (set! (-> self freeze-clock) (the-as clock #f))
  (set! (-> self old-clock) (the-as clock #f))
  (none))

(defun silver-freeze-reset-clocks! ()
  (dotimes (i 10)
    (let ((clk (-> *display* clock (+ i 12))))
      (set! (-> clk ref-count) 0)
      (update-rates! clk 1.0)))
  (none))

(define *silver-freeze-cleanup-end-time* (the-as time-frame 0))
(define *silver-freeze-cleanup-proc* (the-as handle #f))

(deftype silver-freeze-cleanup-proc (process)
  ()
  (:state-methods
    cleanup-active)
  )

(defun silver-freeze-any-procs-active? ()
  (let ((result #f)
        (p (-> *active-pool* child)))
    (while p
      (let ((next-p (-> p 0 brother))
            (proc (ppointer->process p)))
        (when (type? proc silver-freeze-proc)
          (set! result #t))
        (set! p next-p)))
    result))

(defbehavior silver-freeze-cleanup-proc-init silver-freeze-cleanup-proc ()
  (go-virtual cleanup-active)
  (none))

(defstate cleanup-active (silver-freeze-cleanup-proc)
  :virtual #t

  :code (behavior ()
    (until #f
      (when (and (>= (current-time) *silver-freeze-cleanup-end-time*)
                 (not (silver-freeze-any-procs-active?)))
        (silver-freeze-reset-clocks!)
        (set! *silver-freeze-cleanup-proc* (the-as handle #f))
        (deactivate self))
      (suspend))
    #f))

(defun silver-freeze-arm-cleanup! ()
  (set! *silver-freeze-cleanup-end-time* (+ (current-time) (seconds 1)))
  (when (not (handle->process *silver-freeze-cleanup-proc*))
    (set! *silver-freeze-cleanup-proc*
          (ppointer->handle
            (process-spawn
              silver-freeze-cleanup-proc
              :init silver-freeze-cleanup-proc-init
              :name "silver-freeze-cleanup-proc"
              :to *active-pool*))))
  (none))

(defun silver-freeze-apply-color ((victim process))
  (if (not (type? victim rage-ghost))
      (let ((pd (the-as process-drawable victim)))
        (when (and pd (nonzero? (-> pd draw)))
          (set! (-> pd draw color-mult quad) (the-as uint128 0))
          (set! (-> pd draw color-mult x) 0.2)
          (set! (-> pd draw color-mult y) 0.35)
          (set! (-> pd draw color-mult z) 1.0)
          (set! (-> pd draw color-mult w) 1.0)

          (set! (-> pd draw color-emissive quad) (the-as uint128 0))
          (set! (-> pd draw color-emissive x) 0.0)
          (set! (-> pd draw color-emissive y) 0.03)
          (set! (-> pd draw color-emissive z) 0.18)
          (set! (-> pd draw color-emissive w) 1.0))))
  (none))

(defun silver-freeze-clear-color ((victim process))
  (if (not (type? victim rage-ghost))
      (let ((pd (the-as process-drawable victim)))
        (when (and pd (nonzero? (-> pd draw)))
          (set! (-> pd draw color-mult quad) (the-as uint128 0))
          (set! (-> pd draw color-mult x) 1.0)
          (set! (-> pd draw color-mult y) 1.0)
          (set! (-> pd draw color-mult z) 1.0)
          (set! (-> pd draw color-mult w) 1.0)

          (set! (-> pd draw color-emissive quad) (the-as uint128 0))
          (set! (-> pd draw color-emissive x) 0.0)
          (set! (-> pd draw color-emissive y) 0.0)
          (set! (-> pd draw color-emissive z) 0.0)
          (set! (-> pd draw color-emissive w) 0.0))))
  (none))

(defun silver-freeze-hit ((victim process))
  (when victim
    (unless (silver-freeze-exempt? victim)
      (silver-freeze-arm-cleanup!)
      (silver-freeze-kill-procs victim)
      (process-spawn
        silver-freeze-proc
        :init silver-freeze-proc-init-by-other
        victim
        :name "silver-freeze-proc"
        :to *active-pool*)))
  (none))

(defstate active (silver-freeze-proc)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    #f)

  :enter (behavior ()
    (let ((victim (handle->process (-> self victim))))
      (cond
        ((not victim)
         (deactivate self))

        ((or (focus-test? (the-as process-focusable victim) dead inactive)
             (and (-> victim next-state)
                  (let ((st (-> victim next-state name)))
                    (or (= st 'die)
                        (= st 'dying)
                        (= st 'die-falling)
                        (= st 'die-fast)
                        (= st 'burnt-husk)))))
         (deactivate self))

        (else
          (silver-freeze-apply-color victim)
          (silver-freeze-acquire-clock self victim)

          (let ((pd (the-as process-drawable victim)))
            (when pd
              (let ((cm (if (type? (-> pd root) collide-shape-moving)
                            (the-as collide-shape-moving (-> pd root)))))
                (when cm
                  (set! (-> cm transv quad) (the-as uint128 0))
                  (set! (-> self old-gravity-y) (-> cm dynam gravity y))
                  (set! (-> self old-gravity-max) (-> cm dynam gravity-max))
                  (set! (-> self old-gravity-length) (-> cm dynam gravity-length))
                  (set! (-> cm dynam gravity y) 0.0)
                  (set! (-> cm dynam gravity-max) 0.0)
                  (set! (-> cm dynam gravity-length) 0.0)))))))))

    :exit (behavior ()
    (let ((victim (handle->process (-> self victim))))
      (silver-freeze-release-clock self victim)

      (when victim
        (let ((pd (the-as process-drawable victim)))
          (when pd
            (let ((cm (if (type? (-> pd root) collide-shape-moving)
                          (the-as collide-shape-moving (-> pd root)))))
              (when cm
                (set! (-> cm dynam gravity y) (-> self old-gravity-y))
                (set! (-> cm dynam gravity-max) (-> self old-gravity-max))
                (set! (-> cm dynam gravity-length) (-> self old-gravity-length))
                (set! (-> cm transv quad) (the-as uint128 0))))))

        (silver-freeze-clear-color victim))))

  :code (behavior ()
    (until #f
      (let ((victim (handle->process (-> self victim))))
        (cond
          ((not victim)
           (deactivate self))

          ((or (focus-test? (the-as process-focusable victim) dead inactive)
               (and (-> victim next-state)
                    (let ((st (-> victim next-state name)))
                      (or (= st 'die)
                          (= st 'dying)
                          (= st 'die-falling)
                          (= st 'die-fast)
                          (= st 'burnt-husk)))))
           (deactivate self))

          (else
            (silver-freeze-apply-color victim)
            (silver-freeze-acquire-clock self victim)

            (let ((pd (the-as process-drawable victim)))
              (when pd
                (let ((cm (if (type? (-> pd root) collide-shape-moving)
                              (the-as collide-shape-moving (-> pd root)))))
                  (when cm
                    (set! (-> cm transv quad) (the-as uint128 0))
                    (set! (-> cm dynam gravity y) 0.0)
                    (set! (-> cm dynam gravity-max) 0.0)
                    (set! (-> cm dynam gravity-length) 0.0)))))

            (when (>= (current-time) (-> self end-time))
              (deactivate self)))))
      (suspend))
    #f))