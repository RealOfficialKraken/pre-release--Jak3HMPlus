      (set! (-> *part-id-table* 223 init-specs 6 initial-valuef) 80.0)
      (set! (-> *part-id-table* 223 init-specs 7 initial-valuef) 30.0)
      (set! (-> *part-id-table* 223 init-specs 8 initial-valuef) 128.0)

