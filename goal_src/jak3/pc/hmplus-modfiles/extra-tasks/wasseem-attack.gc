(deftype wasseem-rift (process)
  ((rift-height         float)
   (pos                 vector :inline)
   (init-height-count   float)
   (should-raise?       symbol)
   (should-die?         symbol)
  )
  (:state-methods
    init-raise
    raise
    idle
    death-anim
    dead
  )
  (:methods
    (rift-event-handler (_type_ process int symbol event-message-block) none)
  )
)

(defun start-wasseem-rift-particle ((vec vector))
  (cond
    ((logtest? (-> *part-group-id-table* 1560 flags) (sp-group-flag sp13))
        (set! (-> *launch-matrix* trans quad) (-> vec quad))
        (part-tracker-spawn part-tracker-subsampler :to *active-pool* :group (-> *part-group-id-table* 1560))
        )
    (else
        (set! (-> *launch-matrix* trans quad) (-> vec quad))
        (part-tracker-spawn part-tracker :to *active-pool* :group (-> *part-group-id-table* 1560))
        )
    )
  (none)
)

(defbehavior wasseem-rift-event-handler wasseem-rift ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (rift-event-handler self arg0 arg1 arg2 arg3)
  (none)
  )

(defmethod relocate ((this wasseem-rift) (offset int))
  (if *wasseem-rift* (&+! *wasseem-rift* offset))
  (call-parent-method this offset)
)

(defmethod deactivate ((this wasseem-rift))
  (set! *wasseem-rift* #f)
  (call-parent-method this)
  )

(defbehavior wasseem-rift-init-by-other wasseem-rift ((vec vector))
  (stack-size-set! (-> self main-thread) 128)
  (set! (-> self should-die?) #f)
  (set! *wasseem-rift* self)
  (set! (-> self should-raise?) #f)
  (set! (-> self pos quad) (-> vec quad))
  (set! (-> self rift-height) (-> vec y))
  (set! (-> self init-height-count) 0.0)
  (go (method-of-object self init-raise))
  (none)
)

(defstate init-raise (wasseem-rift)
  :virtual #t
  :event wasseem-rift-event-handler
  :code (behavior ()
    (loop
      (cond
        ((<= (-> self init-height-count) (meters 4)) ;so long as it's under X meters, keep raising
          (+! (-> self pos y) 128.0) ;raise by X each frame
          (+! (-> self init-height-count) 128.0) ;counts how much the rift height is being offset
        )
        (else
          (go-virtual idle)
        )
      )
      (start-wasseem-rift-particle (-> self pos))
      ;(format *stdcon* "~%wasseem-rift: init-raise~%")
      (suspend)
    )
  )
)

(defstate idle (wasseem-rift)
  :virtual #t
  :event wasseem-rift-event-handler
  :enter (behavior ()
    (set! (-> self init-height-count) 0.0)
    (set! (-> self should-raise?) #f)
  )
  :code (behavior ()
    (loop
      (start-wasseem-rift-particle (-> self pos))
      (when (-> self should-raise?)
        (set! (-> self should-raise?) #f)
        (go-virtual raise)
      )
      (when (-> self should-die?)
        (go-virtual death-anim)
      )
      ;(format *stdcon* "~%wasseem-rift: idle~%")
      (suspend)
    )
  )
)

(defstate raise (wasseem-rift)
  :virtual #t
  :event wasseem-rift-event-handler
  :enter (behavior ()
    (set! (-> self init-height-count) 0.0)
    (process-spawn dark-lightning-orb (-> self pos) :name "wasseem-orb" *active-pool*)
  )
  :code (behavior ()
    (loop
      (cond
        ((<= (-> self init-height-count) (meters 2)) ;so long as it's under X meters, keep raising
          (+! (-> self pos y) 32.0) ;raise by X each frame
          (+! (-> self init-height-count) 32.0) ;counts how much the rift height is being offset
        )
        (else
          (go-virtual idle)
        )
      )
      (start-wasseem-rift-particle (-> self pos))
      (suspend)
    )
  )
  :exit (behavior ()
    (kill-by-name "wasseem-orb" *active-pool*)
  )
)

  (defmethod rift-event-handler ((this wasseem-rift) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
      (('raise)
        (set! (-> this should-raise?) #t)
      )
      (('die)
        (set! (-> this should-die?) #t)
      )
  )
  (none)
)

(defstate death-anim (wasseem-rift)
  :virtual #t
  :enter (behavior ()
    (set! (-> self init-height-count) (meters 18))
  )
  :code (behavior ()
    (loop
      (cond
        ((>= (-> self init-height-count) 0.0)
          (-! (-> self pos y) 64.0)
          (-! (-> self init-height-count) 64.0)
          (when (rand-vu-percent? 0.05)
            (cond
            ((logtest? (-> *part-group-id-table* 422 flags) (sp-group-flag sp13))
                (set! (-> *launch-matrix* trans quad) (-> self pos quad))
                (part-tracker-spawn part-tracker-subsampler :to *active-pool* :group (-> *part-group-id-table* 422))
                )
            (else
                (set! (-> *launch-matrix* trans quad) (-> self pos quad))
                (part-tracker-spawn part-tracker :to *active-pool* :group (-> *part-group-id-table* 422))
                )
            )
          )
        )
        (else
          (cond
            ((logtest? (-> *part-group-id-table* 426 flags) (sp-group-flag sp13))
                (set! (-> *launch-matrix* trans quad) (-> self pos quad))
                (part-tracker-spawn part-tracker-subsampler :to *active-pool* :group (-> *part-group-id-table* 426))
                )
            (else
                (set! (-> *launch-matrix* trans quad) (-> self pos quad))
                (part-tracker-spawn part-tracker :to *active-pool* :group (-> *part-group-id-table* 426))
                )
            )
          (go-virtual dead)
        )
      )
      (when (rand-vu-percent? 0.25)
        (start-wasseem-rift-particle (-> self pos))
      )
      (suspend)
    )
  )
)

(defstate dead (wasseem-rift)
  :virtual #t
  :code (behavior ()
      (let ((vec (new 'static 'vector :x (meters 1476.0166) :y (meters 28.3137) :z (meters -362.2517) :w 1.0))
            )
      (birth-pickup-at-point vec (pickup-type gun-mod-upgrade) 1.0 #t *entity-pool* (the-as fact-info #f))
      (task-arrow-custom vec #t)      
      )
      (deactivate self)
  )
)

(deftype task-manager-wasseem-attack (task-manager)
    ((maker-count      uint8)
     (wave             uint8)
     (increment        uint8)
    )
  (:state-methods
  active
  check-active
  win
  dead
  wait-for-grab
  )
  )

(defstate wait-for-grab (task-manager-wasseem-attack)
  :virtual #t
  :code
  (behavior ()
    ;(process-spawn leaper-boss2 (target-pos 0) :name "Skull Snapper")
    (loop 
      (when (= yellow-gun-picked-up? #t)
        (kill-by-name "task-arrow-custom" *default-pool*)
        (suspend-for (seconds 4)
          )
        (go-virtual win)
      )
      (suspend)
    )
  )
)

(defstate win (task-manager-wasseem-attack) ;ripped from was-pre-game.gc's win state
  :virtual #t
  :code (behavior ()
    (suspend-for (seconds 5))
    (let* ((v1-2 (-> *game-info* sub-task-list (game-task-node wascity-pre-game-battle)))
           (gp-0 (if (-> v1-2 manager)
                     (-> v1-2 manager manager)
                     (the-as handle #f)
                     )
                 )
           )
      (send-event (handle->process gp-0) 'complete)
      (process-spawn scene-player :init scene-player-init "wascity-pre-game-res" #t "wascityb-seem" :name "scene-player")
      (task-node-close! (game-task-node wascity-pre-game-post-game) #t)
      (task-node-close! (game-task-node wascity-pre-game-battle) #t)
      (task-node-close! (game-task-node wascity-pre-game-resolution) #t)
      )
    )
  )

  (defstate dead (task-manager-wasseem-attack)
  :virtual #t
  :code (behavior ()
      (kill-all-sat)
      (kill-by-name "wasseem-rift" *default-pool*)
      (task-node-open! (game-task-node wascity-pre-game-wait) #t)
      (when (not *traffic-manager*)
        (send-event *traffic-manager* 'spawn-all #f)
      )
      (suspend)
    )
  )


  (defstate check-active (task-manager-wasseem-attack) ;loops
    :virtual #t
    :code (behavior ()
              (loop
                (send-event *traffic-manager* 'kill-all #f)
                (let (
                  (vec1 (new 'static 'vector :x (meters 1459.8339) :y (meters 26.78) :z (meters -372.99) :w 1.0))
                  (vec2 (new 'static 'vector :x (meters 1466.5053) :y (meters 27.62) :z (meters -355.66) :w 1.0))
                  (vec3 (new 'static 'vector :x (meters 1492.99) :y (meters 26.8) :z (meters -367.22) :w 1.0))
                  (vec-behind1 (new 'static 'vector :x (meters 1483.83) :y (meters 28.88) :z (meters -336.54) :w 1.0))
                  (vec-behind2 (new 'static 'vector :x (meters 1477.10) :y (meters 28.31) :z (meters -338.5402) :w 1.0))
              )
                (when (>= (vector-vector-distance 
                              (new 'static 'vector :x (meters 1459.8339) :y (meters 26.78) :z (meters -372.99) :w 1.0)
                              (target-pos 0)
                              )
                              480000.0
                              )
                                (go-virtual dead)
                              )
                  (when (or
                          (<= the-maker-count 0)
                          (not (search-process-tree *active-pool* (lambda ((p process)) (type? p dp-bipedal))))
                        )
                      (suspend-for (seconds 0.8))
                      (+! (-> self wave) 1)
                      (+! (-> self increment) 1)
                      (when (= (-> self wave) 1)
                      (spawn-dark-maker vec1 "dp-bipedal-c")
                      (spawn-dark-maker vec3 "dp-bipedal-c")
                      (set! the-maker-count 2)
                  )
                  (when (= (-> self wave) 2)
                      (spawn-dark-maker vec1 "dp-bipedal-c")
                      (spawn-dark-maker vec2 "dp-bipedal-c")
                      (spawn-dark-maker vec3 "dp-bipedal-c")
                      (set! the-maker-count 3)
                  )
                  (when (= (-> self wave) 3)
                      (spawn-dark-maker vec1 "dp-bipedal-c")
                      (spawn-dark-maker vec2 "dp-bipedal-c")
                      (spawn-dark-maker vec-behind2 "dp-bipedal-c")
                      (set! the-maker-count 3)
                  )
                  (when (= (-> self wave) 4)
                      (spawn-dark-maker vec1 "dp-bipedal-c")
                      (spawn-dark-maker vec-behind1 "dp-bipedal-c")
                      (spawn-dark-maker vec-behind2 "dp-bipedal-c")
                      (set! the-maker-count 3)
                  )
                  (when (= (-> self wave) 5)
                      (spawn-dark-maker vec1 "dp-bipedal-c")
                      (spawn-dark-maker vec2 "dp-bipedal-c")
                      (spawn-dark-maker vec3 "dp-bipedal-c")
                      (spawn-dark-maker vec-behind1 "dp-bipedal-c")
                      (spawn-dark-maker vec-behind2 "dp-bipedal-c")
                      (set! the-maker-count 5)
                  )
                  (when (= (-> self wave) 6)
                      (spawn-dark-maker vec1 "dp-bipedal-c")
                      (spawn-dark-maker vec2 "dp-bipedal-c")
                      (spawn-dark-maker vec3 "dp-bipedal-c")
                      (spawn-dark-maker vec-behind1 "dp-bipedal-c")
                      (spawn-dark-maker vec-behind2 "dp-bipedal-c")
                      (set! the-maker-count 5)
                  )
                  (when (= (-> self wave) 7)
                      (spawn-dark-maker vec1 "dp-bipedal-c")
                      (spawn-dark-maker vec2 "dp-bipedal-c")
                      (spawn-dark-maker vec3 "dp-bipedal-c")
                      (spawn-dark-maker vec-behind1 "dp-bipedal-c")
                      (spawn-dark-maker vec-behind2 "dp-bipedal-c")
                      (set! the-maker-count 5)
                  )
                  (when (= (-> self wave) 8)
                    (set! (-> self wave) 0)
                    (+! enemy-noto 4)
                    (send-event *wasseem-rift* 'raise #t)
                  )
                  (when (or
                          (>= (-> self increment) 72)
                          (= in-debug? #t)
                        )
                    (send-event *wasseem-rift* 'die #t)
                    (go-virtual wait-for-grab)
                  )
              )
          )
          ;(format *stdcon* "task-manager: wave ~D~%task-manager: the-maker-count ~D" (-> self wave) the-maker-count)
          (suspend)
        )
    )
  )

  (defstate active (task-manager-wasseem-attack) ;sets everything up
    :virtual #t
    :code (behavior ()
        (blank-hint! "<COLOR_RED>This mission drops a Super Gun Mod!" "<COLOR_YELLOW>This mission can also be skipped for later" 240 600)
        (let ((vec 
              (new 'static 'vector
              :x (meters 1477.4195)
              :y (meters 27.6057)
              :z (meters -370.3547)
              :w 1.0
              )))
          (process-spawn wasseem-rift vec :name "wasseem-rift" *active-pool*)
        )
        (set-setting! 'music 'mineboss 0.0 0)
        (set! enemy-noto 1)
        (set! (-> self wave) 0)
        (set! (-> self increment) 0)
        (set! the-maker-count 0)
        (task-node-close! (game-task-node wascity-pre-game-resolution) #t)
        (suspend-for (seconds 0.5))
        (set-continue! *game-info* "wascityb-game" #t)
        (when *traffic-manager*
          (send-event *traffic-manager* 'kill-all #f)
        )
        (auto-save-user)
        (go-virtual check-active)
    )
    (none)
  )

  
  #| ALTERNATE CALL TO THIS TASK MANAGER BY HATKID FOR REFERENCE
  (deftype task-manager-wasseem-attack (task-manager)
  ((maker-count  uint8)
   (wave         uint8)
   (spawn-points (inline-array vector)))
  (:methods
   (check-for-spawn (_type_) object none)
   )
  (:state-methods
   active
   win
   new-wave
   )
)

   (defstate win (task-manager-wasseem-attack) ;ripped from was-pre-game.gc's win state
  :virtual #t
  :code (behavior ()
    (let* ((v1-2 (-> *game-info* sub-task-list (game-task-node wascity-pre-game-resolution)))
           (gp-0 (if (-> v1-2 manager)
                     (-> v1-2 manager manager)
                     (the-as handle #f)
                     )
                 )
           )
      (send-event (handle->process gp-0) 'complete)
      )
    )
  )

(defmethod check-for-spawn ((this task-manager-wasseem-attack))
  (when (<= the-maker-count 0)
    (case (-> this wave)
          ((1)
            (suspend-for (seconds 0.5))
            (spawn-dark-maker (-> this spawn-points 0))
            (spawn-dark-maker (-> this spawn-points 2))
            (set! the-maker-count 2)
            )
          ((2)
            (suspend-for (seconds 3))
            (spawn-dark-maker (-> this spawn-points 0))
            (spawn-dark-maker (-> this spawn-points 1))
            (spawn-dark-maker (-> this spawn-points 3))
            (set! the-maker-count 3)
            )
          ((3)
            (suspend-for (seconds 3))
            (spawn-dark-maker (-> this spawn-points 0))
            (spawn-dark-maker (-> this spawn-points 1))
            (spawn-dark-maker (-> this spawn-points 4))
            (set! the-maker-count 3)
            )
          ((4)
            (suspend-for (seconds 3))
            (spawn-dark-maker (-> this spawn-points 0))
            (spawn-dark-maker (-> this spawn-points 3))
            (spawn-dark-maker (-> this spawn-points 4))
            (set! the-maker-count 3)
            )
          ((5)
            (suspend-for (seconds 3))
            (spawn-dark-maker (-> this spawn-points 0))
            (spawn-dark-maker (-> this spawn-points 1))
            (spawn-dark-maker (-> this spawn-points 2))
            (spawn-dark-maker (-> this spawn-points 3))
            (spawn-dark-maker (-> this spawn-points 4))
            (set! the-maker-count 5)
            )
      )
  )
  (suspend)
  (none)
)

(defstate active (task-manager-wasseem-attack) ; sets everything up
  :virtual #t
  :code
  (behavior ()
    (set! (-> self wave) 0)
    (set! the-maker-count 0)
    (set! (-> self spawn-points)
          (new 'static
               'inline-array
               vector
               5
               (static-vectorm 1459.8339 26.78 -372.99)
               (static-vectorm 1463.6805 26.78 -376.08)
               (static-vectorm 1492.99 26.8 -367.22)
               (static-vectorm 1487.64 28.06 -346.1145)
               (static-vectorm 1465.36 27.78 -345.94)))
    (loop
      (when (and *target* (task-node-closed? (game-task-node wascity-pre-game-wait)))
        (when (<= the-maker-count 0)
            (+! (-> self wave) 1)
            (check-for-spawn self)
        )
        (when (and (>= (-> self wave) 6) (<= the-maker-count 0))
          (go-virtual win)
        )
        ;(format *stdcon* "task-manager: wave ~D" (-> self wave))
        ;(format *stdcon* "the-maker-count: ~D" the-maker-count)
        (suspend)
      )
    )
  )
)
  |#