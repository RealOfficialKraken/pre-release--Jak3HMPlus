                  (point-head (new 'static 'vector :x (meters -776.0646) :y (meters 39.0085) :z (meters 956.4083) :w 1.0))
                  (progress 0.0)
                  (delay-a (seconds 5.0))
                  (delay-b (seconds 2.0))
                  (curr-delay (seconds 5.0))
                  (spawn-delay 900)
                  )
                (cond
                    ((or (-> self statue-lose)
                         (and *target* (<= (-> *target* fact health) 0.0)))
                        (go-virtual lose)
                    )
                    (complete-statue-survive
                        (set! complete-statue-survive #f)
                        (go-virtual win-statue)
                    )
                    ((>= (vector-vector-distance vec (target-pos 0)) (meters 90))
                        (go-virtual lose)
                    )
                )

                (when (and *target* (not (-> self statue-lose)))
                    (when (> (-> self general-i) (-> self max-time))
                        (set! complete-statue-survive #t)
                    )

                    (set! progress (/ (the float (-> self general-i))
                  (the float (-> self max-time))))
                    (when (< progress 0.0)
                        (set! progress 0.0)
                    )
                    (when (> progress 1.0)
                        (set! progress 1.0)
                    )

                    (set! spawn-delay
                        (the int (+ 600.0 (* (- 180.0 600.0) progress)))
                    )

                    (when (<= (-> self general-i) (-> self max-time))
                        (+! (-> self general-i) 1)
                        (when (and (not *nebula-splitter*)
                                (> (-> *target* fact health) 0.0)
                                (time-elapsed? (-> self splitter-spawn-time) spawn-delay))
                            (spawn-white-fireball (-> self proj-spawn-pos) (degrees 45) (degrees 20))
                            (set-time! (-> self splitter-spawn-time))
                        )
                    )
                )
            )
            (suspend)
        )
    )
)
(defstate statue-5 (tm-forest-survive)
    :virtual #t
    :event tm-forest-survive-event-handler
    :enter (behavior ()
        (spawn-laser-spin-attack (-> self proj-spawn-pos) 3200 8)
    )
    :code
    (behavior ()
        (loop
            (let ((vec (new 'static 'vector :x (meters -696.3768) :y (meters 52.9250) :z (meters 1156.6093) :w 1.0)))
                (cond (complete-statue-survive
                    (set! complete-statue-survive #f)
                    (go-virtual win-statue)
                )
                ((>= (vector-vector-distance vec (target-pos 0)) (meters 15))
                    (go-virtual lose)
                )
                )
                (when (> (-> self general-i) (-> self max-time))
                    (set! complete-statue-survive #t)
                )
                (when (<= (-> self general-i) (-> self max-time))
                    (+! (-> self general-i) 1)
                    ;;place stuff here
                )
            )
            (format *stdcon* "tm-forest-survive: statue-5~%")
            (suspend)
        )
    )
)

(defstate win-statue (tm-forest-survive)
    :virtual #t
    :event tm-forest-survive-event-handler
    :code
    (behavior ()
        (when (and (ppointer->process *weather-flux*)
                   (not (-> self statue-lose))
                   *target*
                   (> (-> *target* fact health) 0.0))
            (send-event (ppointer->process *weather-flux*) 'win #t)
        )
        (dm-complete-statue self)
        (go-virtual waiting)
    )
)

(deftype weather-flux (process)
  ((kept-tod         float)
   (kept-cloud       float)
   (kept-fog         float)
   (win-cloud-step   float)
   (win-fog-step     float)
   (win-time         time-frame)
   (win-start-tod    float)
   (do-die           symbol)
   (do-win           symbol)
   )
  (:state-methods
    active
    dead
    win
    )
  (:methods
    (weather-event-handler (_type_ process int symbol event-message-block) none)
    )
  )

(defun weather-flux-wrap-hour ((x float))
  (let ((v x))
    (when (< v 0.0)
      (set! v (+ v 24.0))
      )
    (when (>= v 24.0)
      (set! v (- v 24.0))
      )
    v
    )
  )

(defbehavior weather-flux-event-handler weather-flux ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (weather-event-handler self arg0 arg1 arg2 arg3)
  (none)
  )

(defun weather-flux-shortest-hour-diff ((from float) (to float))
  (let ((d (- to from)))
    (when (> d 12.0)
      (set! d (- d 24.0)))
    (when (< d -12.0)
      (set! d (+ d 24.0)))
    d
    )
  )

(defun weather-flux-ratio-for-return ((hours float) (seconds float))
  (* (/ hours seconds) 1080.0)
  )

(defmethod weather-event-handler ((this weather-flux) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('die)
      (format #t "weather-flux die~%")
      (set! (-> this do-die) #t)
      )
    (('win)
      (format #t "weather-flux win~%")
      (set! (-> this do-win) #t)
      )
    )
  (none)
  )

(defbehavior weather-flux-init-by-other weather-flux ()
  (send-event (ppointer->process *time-of-day*) 'save)
  (set! (-> self kept-tod)   (-> *time-of-day-context* time))
  (set! (-> self kept-cloud) (-> *mood-control* current-interp cloud))
  (set! (-> self kept-fog)   (-> *mood-control* current-interp fog))
  (set! (-> self do-die) #f)
  (set! (-> self do-win) #f)
  (go-virtual active)
  (none)
  )

(defun spawn-weather-flux ()
  (set! *weather-flux*
    (process-spawn weather-flux :name "weather-flux"))
  (none)
  )

(defstate active (weather-flux)
  :virtual #t
  :event weather-flux-event-handler
  :enter (behavior ()
    (send-event (ppointer->process *time-of-day*) 'change 'ratio 64.0)
    (set! (-> *mood-control* overide-weather-flag) #t)
    (set! (-> *mood-control* overide cloud) 1.0)
    (set! (-> *mood-control* overide fog)   1.0)
    )
  :code (behavior ()
    (loop
      (cond
        ((-> self do-die)
            (go-virtual dead)
            )
        ((-> self do-win)
            (go-virtual win)
            )
      )
      (suspend)
      )
    )
  )

(defstate dead (weather-flux)
  :virtual #t
  :enter (behavior ()
    (set! (-> self do-die) #f)
    (set! (-> self do-win) #f)
    )
  :code (behavior ()
    (send-event (ppointer->process *time-of-day*) 'change 'ratio 1.0)
    (send-event (ppointer->process *time-of-day*) 'change 'hour (the int (-> self kept-tod)))
    (set! (-> *time-of-day-context* time) (-> self kept-tod))
    (set! (-> *mood-control* overide cloud) (-> self kept-cloud))
    (set! (-> *mood-control* overide fog)   (-> self kept-fog))
    (set! (-> *mood-control* current-interp cloud) (-> self kept-cloud))
    (set! (-> *mood-control* current-interp fog)   (-> self kept-fog))
    (set! (-> *mood-control* target-interp cloud) (-> self kept-cloud))
    (set! (-> *mood-control* target-interp fog)   (-> self kept-fog))
    (set! (-> *mood-control* speed-interp cloud) 0.0)
    (set! (-> *mood-control* speed-interp fog)   0.0)
    (set! (-> *mood-control* overide-weather-flag) #f)
    (set! *weather-flux* #f)
    (deactivate self)
    )
  )

(defstate win (weather-flux)
  :virtual #t
  :enter (behavior ()
    (set! (-> self do-win) #f)
    (set! (-> self win-start-tod) (-> *time-of-day-context* time))
    (send-event (ppointer->process *time-of-day*) 'change 'ratio 1.0)
    (set! (-> self win-cloud-step)
      (/ (fabs (- (-> *mood-control* overide cloud) (-> self kept-cloud))) 4.0))
    (set! (-> self win-fog-step)
      (/ (fabs (- (-> *mood-control* overide fog) (-> self kept-fog))) 4.0))
    (set-time! (-> self win-time))
    )
  :code (behavior ()
    (loop
      (let ((u 0.0)
            (ease 0.0)
            (d 0.0)
            (t 0.0))
        (set! u (/ (the float (- (current-time) (-> self win-time)))
                   (the float (seconds 4.0))))
        (when (< u 0.0)
          (set! u 0.0)
          )
        (when (> u 1.0)
          (set! u 1.0)
          )
        (set! ease (* u u (- 3.0 (* 2.0 u))))
        (set! d (weather-flux-shortest-hour-diff (-> self win-start-tod) (-> self kept-tod)))
        (set! t (+ (-> self win-start-tod) (* d ease)))
        (set! (-> *time-of-day-context* time) (weather-flux-wrap-hour t))
        )

      (seek! (-> *mood-control* overide cloud)
             (-> self kept-cloud)
             (* (-> self win-cloud-step) (seconds-per-frame)))
      (seek! (-> *mood-control* overide fog)
             (-> self kept-fog)
             (* (-> self win-fog-step) (seconds-per-frame)))

      (when (time-elapsed? (-> self win-time) (seconds 4.0))
        (set! (-> *time-of-day-context* time) (-> self kept-tod))
        (set! (-> *mood-control* overide cloud) (-> self kept-cloud))
        (set! (-> *mood-control* overide fog)   (-> self kept-fog))
        (set! (-> *mood-control* current-interp cloud) (-> self kept-cloud))
        (set! (-> *mood-control* current-interp fog)   (-> self kept-fog))
        (set! (-> *mood-control* target-interp cloud) (-> self kept-cloud))
        (set! (-> *mood-control* target-interp fog)   (-> self kept-fog))
        (set! (-> *mood-control* speed-interp cloud) 0.0)
        (set! (-> *mood-control* speed-interp fog)   0.0)
        (set! (-> *mood-control* overide-weather-flag) #f)
        (set! *weather-flux* #f)
        (deactivate self)
        )

      (suspend)
      )
    )
  )