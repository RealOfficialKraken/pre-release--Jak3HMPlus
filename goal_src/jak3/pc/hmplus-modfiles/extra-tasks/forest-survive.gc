(in-package goal)

;; name forest-survive.gc

(define complete-statue-survive #f)

(defun-extern spawn-nebula-splitter vector int none)
(defun-extern spawn-white-fireball vector float float none)

(define complete-statue-1 #f)
(define complete-statue-2 #f)
(define complete-statue-3 #f)
(define complete-statue-4 #f)
(define complete-statue-5 #f)

(define forest-survive-lose #f)

(deftype tm-forest-survive (process)
  ((general-i              int)
   (curr-statue            int)
   (statue-1-hit?          symbol)
   (statue-2-hit?          symbol)
   (statue-3-hit?          symbol)
   (statue-4-hit?          symbol)
   (statue-5-hit?          symbol)
   (statue-lose            symbol)
   (max-time               int)
   (proj-spawn-pos         vector :inline)
   (splitter-spawn-time    time-frame)
   (statue-3-pattern-step int)
  )
  (:methods
    (survivor-event-handler (_type_ process int symbol event-message-block) none)
    (dm-complete-statue     (_type_) none)
  )
  (:state-methods
    waiting
    statue-1
    statue-2
    statue-3
    statue-4
    statue-5
    lose
    win-statue
  )
)

(defmethod dm-complete-statue ((this tm-forest-survive))
    (cond
        ((= (-> this curr-statue) 1)
            (set! complete-statue-1 #t)
        )
        ((= (-> this curr-statue) 2)
            (set! complete-statue-2 #t)
        )
        ((= (-> this curr-statue) 3)
            (set! complete-statue-3 #t)
        )
        ((= (-> this curr-statue) 4)
            (set! complete-statue-4 #t)
        )
        ((= (-> this curr-statue) 5)
            (set! complete-statue-5 #t)
        )
    )
    (none)
)

(defbehavior tm-forest-survive-event-handler tm-forest-survive ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (survivor-event-handler self arg0 arg1 arg2 arg3)
  (none)
  )

(defmethod survivor-event-handler ((this tm-forest-survive) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
    (case arg2
        (('statue-1)
            (set! (-> this statue-1-hit?) #t)
        )
        (('statue-2)
            (set! (-> this statue-2-hit?) #t)
        )
        (('statue-3)
            (set! (-> this statue-3-hit?) #t)
        )
        (('statue-4)
            (set! (-> this statue-4-hit?) #t)
        )
        (('statue-5)
            (set! (-> this statue-5-hit?) #t)
        )
        (('lose)
            (set! (-> this statue-lose) #t)
        )
    )
    (none)
)

(defbehavior tm-forest-survive-init-by-other tm-forest-survive ()
  (set! (-> self general-i) 0)
  (set! (-> self curr-statue) 0)
  (set! (-> self statue-1-hit?) #f)
  (set! (-> self statue-2-hit?) #f)
  (set! (-> self statue-3-hit?) #f)
  (set! (-> self statue-4-hit?) #f)
  (set! (-> self statue-5-hit?) #f)
  (set! (-> self statue-lose) #f)
  (set! (-> self max-time) 0)
  (set! (-> self statue-3-pattern-step) 0)
  (set-time! (-> self splitter-spawn-time))
  (go-virtual waiting)
)

(defun spawn-forest-survive ()
    (set! *forest-survive-eh* 
        (process-spawn tm-forest-survive :name "tm-forest-survive")
    )
    (none)
)

(defstate waiting (tm-forest-survive)
    :virtual #t
    :event tm-forest-survive-event-handler
    :code
    (behavior ()
        (loop
            (cond
                ((and
                    (!= (-> (level-get-target-inside *level*) name) 'foresta)
                    (!= (-> (level-get-target-inside *level*) name) 'forestb)
                )
                    (set! *forest-survive-eh* #f)
                    (deactivate self)
                )
                ((= (-> self statue-1-hit?) #t)
                    (set! complete-statue-survive #f)
                    (set! (-> self general-i) 0)
                    (set! (-> self statue-lose) #f)
                    (set! (-> self curr-statue) 1)
                    (set! (-> self statue-1-hit?) #f)
                    (set! (-> self max-time) 3200)
                    (set-time! (-> self splitter-spawn-time))
                    (let ((vec (new 'static 'vector :x (meters -614.1850) :y (meters 33.4687) :z (meters 956.0170) :w 1.0)))
                        (vector-copy! (-> self proj-spawn-pos) vec)
                    )
                    (go-virtual statue-1)
                )
                ((= (-> self statue-2-hit?) #t)
                    (set! complete-statue-survive #f)
                    (set! (-> self general-i) 0)
                    (set! (-> self statue-lose) #f)
                    (set! (-> self curr-statue) 2)
                    (set! (-> self statue-2-hit?) #f)
                    (set! (-> self max-time) 3200)
                    (set-time! (-> self splitter-spawn-time))
                    (let ((vec (new 'static 'vector :x (meters -695.9229) :y (meters 33.5937) :z (meters 1105.7033) :w 1.0)))
                        (vector-copy! (-> self proj-spawn-pos) vec)
                    )
                    (go-virtual statue-2)
                )
                ((= (-> self statue-3-hit?) #t)
                    (set! complete-statue-survive #f)
                    (set! (-> self general-i) 0)
                    (set! (-> self statue-lose) #f)
                    (set! (-> self curr-statue) 3)
                    (set! (-> self statue-3-hit?) #f)
                    (set! (-> self max-time) 3200)
                    (set-time! (-> self splitter-spawn-time))
                    (set! (-> self statue-3-pattern-step) 0)
                    (let ((vec (new 'static 'vector :x (meters -778.7787) :y (meters 37.0955) :z (meters 944.2166) :w 1.0)))
                        (vector-copy! (-> self proj-spawn-pos) vec)
                    )
                    (go-virtual statue-3)
                )
                ((= (-> self statue-4-hit?) #t)
                    (set! complete-statue-survive #f)
                    (set! (-> self general-i) 0)
                    (set! (-> self statue-lose) #f)
                    (set! (-> self curr-statue) 4)
                    (set! (-> self statue-4-hit?) #f)
                    (set! (-> self max-time) 3200)
                    (set-time! (-> self splitter-spawn-time))
                    (set! (-> self statue-3-pattern-step) 0)
                    (let ((vec (new 'static 'vector :x (meters -830.6266) :y (meters 28.9294) :z (meters 1040.3620) :w 1.0)))
                        (vector-copy! (-> self proj-spawn-pos) vec)
                    )
                    (go-virtual statue-4)
                )
                ((= (-> self statue-5-hit?) #t)
                    (set! complete-statue-survive #f)
                    (set! (-> self general-i) 0)
                    (set! (-> self statue-lose) #f)
                    (set! (-> self curr-statue) 5)
                    (set! (-> self statue-5-hit?) #f)
                    (set! (-> self max-time) 3200)
                    (set! (-> self statue-3-pattern-step) 0)
                    (let ((vec (new 'static 'vector :x (meters -696.3768) :y (meters 52.9250) :z (meters 1156.6093) :w 1.0)))
                        (vector-copy! (-> self proj-spawn-pos) vec)
                    )
                    (set-time! (-> self splitter-spawn-time))
                    (go-virtual statue-5)
                )
            )
            (format *stdcon* "tm-forest-survive: waiting~%")
            (suspend)
        )
    )
)

(defstate lose (tm-forest-survive)
    :virtual #t
    :event tm-forest-survive-event-handler
    :enter
    (behavior ()
        (set! (-> self statue-lose) #f)
        (set! forest-survive-lose #t)
        (set! (-> self general-i) 0)
        (set! (-> self curr-statue) 0)
        (set! (-> self statue-1-hit?) #f)
        (set! (-> self statue-2-hit?) #f)
        (set! (-> self statue-3-hit?) #f)
        (set! (-> self statue-4-hit?) #f)
        (set! (-> self statue-5-hit?) #f)
        (set! (-> self statue-lose) #f)
        (set-time! (-> self splitter-spawn-time))
        (when (ppointer->process *weather-flux*)
            (send-event (ppointer->process *weather-flux*) 'die #t)
        )
        (format #t "~%Lost mission~%~%")
    )
    :code
    (behavior ()
        (go-virtual waiting)
        (set! *forest-survive-eh* #f)
    )
)

(define start-splitter-attack #f)
(define splitter-count 0)
(define splitter-max 0)

(defstate statue-1 (tm-forest-survive)
    :virtual #t
    :event tm-forest-survive-event-handler
    :code
    (behavior ()
        (loop
            (format *stdcon* "tm-forest-survive: statue-1~%")
            (let ((vec (new 'static 'vector :x (meters -620.4437) :y (meters 21.9916) :z (meters 961.8020) :w 1.0))
                  (point-head (new 'static 'vector :x (meters -614.7424) :y (meters 27.4139) :z (meters 956.2082) :w 1.0))
                  (progress 0.0)
                  (spawn-delay 900))
                (cond
                    ((or (-> self statue-lose)
                         (and *target* (<= (-> *target* fact health) 0.0)))
                        (go-virtual lose)
                    )
                    (complete-statue-survive
                        (set! complete-statue-survive #f)
                        (go-virtual win-statue)
                    )
                    ((>= (vector-vector-distance vec (target-pos 0)) (meters 50))
                        (go-virtual lose)
                    )
                )

                (when (and *target* (not (-> self statue-lose)))
                    (when (> (-> self general-i) (-> self max-time))
                        (set! complete-statue-survive #t)
                    )

                    (set! progress (/ (the float (-> self general-i))
                                      (the float (-> self max-time))))
                    (when (< progress 0.0)
                        (set! progress 0.0)
                    )
                    (when (> progress 1.0)
                        (set! progress 1.0)
                    )

                    (set! spawn-delay
                        (the int (+ 900.0 (* (- 240.0 900.0) progress)))
                    )

                    (when (<= (-> self general-i) (-> self max-time))
                        (+! (-> self general-i) 1)
                        (when (and (not *nebula-splitter*)
                                   (> (-> *target* fact health) 0.0)
                                   (time-elapsed? (-> self splitter-spawn-time) spawn-delay))
                            (spawn-nebula-splitter point-head (rand-vu-int-range 3 8))
                            (set-time! (-> self splitter-spawn-time))
                        )
                    )
                )
            )
            (suspend)
        )
    )
)

(defstate statue-2 (tm-forest-survive)
  :virtual #t
  :event tm-forest-survive-event-handler
  :code
  (behavior ()
    (loop
      (let ((vec (new 'static 'vector :x (meters -697.0499) :y (meters 23.7422) :z (meters 1094.1295) :w 1.0))
            (point-head (new 'static 'vector :x (meters -695.9229) :y (meters 24.5937) :z (meters 1105.7033) :w 1.0))
            (progress 0.0)
            (spawn-delay (seconds 2.0)))
        (cond
          ((or (-> self statue-lose)
               (and *target* (<= (-> *target* fact health) 0.0)))
           (go-virtual lose))
          (complete-statue-survive
           (set! complete-statue-survive #f)
           (go-virtual win-statue))
          ((>= (vector-vector-distance vec (target-pos 0)) (meters 50))
           (go-virtual lose)))

        (when (and *target* (not (-> self statue-lose)))
          (when (> (-> self general-i) (-> self max-time))
            (set! complete-statue-survive #t))

          (set! progress (/ (the float (-> self general-i))
                            (the float (-> self max-time))))
          (when (< progress 0.0)
            (set! progress 0.0))
          (when (> progress 1.0)
            (set! progress 1.0))
          (set! spawn-delay
            (the int (+ (seconds 2.0)
                        (* (- (seconds 0.3) (seconds 2.0)) progress))))

          (when (<= (-> self general-i) (-> self max-time))
            (+! (-> self general-i) 1)
            (when (and (not *white-fireball*) (time-elapsed? (-> self splitter-spawn-time) spawn-delay))
              (spawn-white-fireball (-> self proj-spawn-pos) (degrees 45) (degrees 20))
              (set-time! (-> self splitter-spawn-time))))))
      (format *stdcon* "tm-forest-survive: statue-2~%")
      (suspend)))
)

(defstate statue-3 (tm-forest-survive)
    :virtual #t
    :event tm-forest-survive-event-handler
    :code
    (behavior ()
        (loop
            (format *stdcon* "tm-forest-survive: statue-3~%")
            (let ((vec (new 'static 'vector :x (meters -776.0646) :y (meters 31.0085) :z (meters 956.4083) :w 1.0))
                  (point-head (new 'static 'vector :x (meters -776.0646) :y (meters 39.0085) :z (meters 956.4083) :w 1.0))
                  (progress 0.0)
                  (delay-a (seconds 3.0))
                  (delay-b (seconds 1.0))
                  (curr-delay 0))
                (cond
                    ((or (-> self statue-lose)
                         (and *target* (<= (-> *target* fact health) 0.0)))
                        (go-virtual lose)
                    )
                    (complete-statue-survive
                        (set! complete-statue-survive #f)
                        (go-virtual win-statue)
                    )
                    ((>= (vector-vector-distance vec (target-pos 0)) (meters 50))
                        (go-virtual lose)
                    )
                )

                (when (and *target* (not (-> self statue-lose)))
                    (when (> (-> self general-i) (-> self max-time))
                        (set! complete-statue-survive #t)
                    )

                    (set! progress (/ (the float (-> self general-i))
                                      (the float (-> self max-time))))
                    (when (< progress 0.0)
                        (set! progress 0.0)
                    )
                    (when (> progress 1.0)
                        (set! progress 1.0)
                    )

                    (set! delay-a
                        (the int (+ (seconds 3.0)
                                    (* (- (seconds 0.8) (seconds 3.0)) progress)))
                    )

                    (set! delay-b
                        (the int (+ (seconds 1.0)
                                    (* (- (seconds 0.2) (seconds 1.0)) progress)))
                    )

                    (cond
                        ((= (-> self statue-3-pattern-step) 0)
                            (set! curr-delay 0)
                        )
                        ((= (-> self statue-3-pattern-step) 1)
                            (set! curr-delay delay-a)
                        )
                        (else
                            (set! curr-delay delay-b)
                        )
                    )

                    (when (<= (-> self general-i) (-> self max-time))
                        (+! (-> self general-i) 1)
                        (when (and (not *white-fireball*)
                                   (not *nebula-splitter*)
                                   (> (-> *target* fact health) 0.0)
                                   (time-elapsed? (-> self splitter-spawn-time) curr-delay))
                            (cond
                                ((= (-> self statue-3-pattern-step) 0)
                                    (spawn-nebula-splitter (-> self proj-spawn-pos) (rand-vu-int-range 3 8))
                                    (set! (-> self statue-3-pattern-step) 1)
                                )
                                ((= (-> self statue-3-pattern-step) 1)
                                    (spawn-white-fireball (-> self proj-spawn-pos) (degrees 45) (degrees 20))
                                    (set! (-> self statue-3-pattern-step) 2)
                                )
                                (else
                                    (spawn-white-fireball (-> self proj-spawn-pos) (degrees 45) (degrees 20))
                                    (set! (-> self statue-3-pattern-step) 0)
                                )
                            )
                            (set-time! (-> self splitter-spawn-time))
                        )
                    )
                )
            )
            (suspend)
        )
    )
)

