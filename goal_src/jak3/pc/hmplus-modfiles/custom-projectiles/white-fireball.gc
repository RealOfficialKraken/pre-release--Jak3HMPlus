(in-package goal)

;name: white-fireball.gc

(deftype light-eco-fireball (projectile)
  ((travel-time   float)
   (elapsed       float)
   (arc-height    float)
   (explode-rad   float)
   )
  (:methods
    (impact-white-fireball (_type_) none)
    )
)

(defun light-eco-fireball-no-velocity ((arg0 projectile))
  0
  (none)
)

(defmethod setup-collision! ((this light-eco-fireball))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction)
          (the-as (function control-info collide-query vector vector collide-status)
                  cshape-reaction-just-move))
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object)
                  nothing))
    (set! (-> s5-0 penetrate-using) (penetrate))
    (set! (-> s5-0 penetrated-by) (the-as penetrate -1))

    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 0) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s4-0 prim-core collide-as) (collide-spec projectile))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak bot player-list backgnd obstacle))
      (set! (-> s4-0 prim-core action) (collide-action solid))
      (set-vector! (-> s4-0 local-sphere) 0.0 0.0 0.0 1024.0)
      (set! (-> s5-0 root-prim) s4-0))

    (set! (-> s5-0 nav-radius) 0.0)
    (set! (-> s5-0 max-iteration-count) (the-as uint 1))
    (set! (-> s5-0 event-self) #f)
    (set! (-> this root) s5-0))

  (set! (-> this root pat-ignore-mask)
        (new 'static 'pat-surface
          :noentity #x1
          :nojak #x0
          :probe #x1
          :noproj #x1
          :noendlessfall #x1
          :board #x1))
  0
  (none)
)

(defun light-eco-fireball-move ((arg0 projectile))
  (let ((this (the-as light-eco-fireball arg0)))
    (let ((dt (seconds-per-frame))
          (u 0.0)
          (dx (new 'stack-no-clear 'vector))
          (base (new 'stack-no-clear 'vector))
          (next-pos (new 'stack-no-clear 'vector))
          (prev-pos (new 'stack-no-clear 'vector))
          (disp (new 'stack-no-clear 'vector))
          (dist 0.0)
          (arc 0.0))

      (vector-copy! prev-pos (-> this root trans))

      (when (<= (-> this travel-time) 0.0)
        (vector-! dx (-> this target-pos) (-> this starting-pos))
        (set! dist (vector-length dx))
        (if (< dist 4096.0)
            (set! dist 4096.0))
        (set! (-> this travel-time) (/ dist (-> this max-speed)))
        (if (< (-> this travel-time) 0.25)
            (set! (-> this travel-time) 0.25)))

      (+! (-> this elapsed) dt)

      (set! u (/ (-> this elapsed) (-> this travel-time)))
      (if (> u 1.0)
          (set! u 1.0))

      ; straight line from start to target in full xyz
      (vector-! dx (-> this target-pos) (-> this starting-pos))
      (vector-copy! base (-> this starting-pos))
      (vector+*! base base dx u)

      ; simple parabola: 0 at ends, peak in middle
      (set! arc (* 4.0 (-> this arc-height) u (- 1.0 u)))

      (vector-copy! next-pos base)
      (+! (-> next-pos y) arc)

      (vector-! disp next-pos prev-pos)
      (if (> dt 0.00001)
          (vector-float*! (-> this root transv) disp (/ 1.0 dt))
          (vector-copy! (-> this root transv) disp))

      (projectile-move-fill-all-dirs this)
      (projectile-method-25 this)

      (when (or (>= u 1.0)
                (logtest? (-> this root status) (collide-status touch-surface touch-actor)))
        (impact-white-fireball this))))
  0
  (none)
)

(defmethod init-proj-settings! ((this light-eco-fireball))
  (vector-copy! (-> this target-pos) (-> this desired-target-pos))
  (set! (-> this attack-mode) 'eco-yellow)
  (set! (-> this explode-rad) 12288.0)
  (set! (-> this damage) 8.0)
  (set! (-> this max-speed) 135168.0)
  (set! (-> this max-hits) 1)
  (set! (-> this update-velocity) light-eco-fireball-no-velocity)
  (set! (-> this move) light-eco-fireball-move)
  (set! (-> this part) (create-launch-control (-> *part-group-id-table* 450) this))
  (set! (-> this timeout) (seconds 3.0))
  (set! (-> this arc-height) 24576.0)
  (set! (-> this elapsed) 0.0)
  (set! (-> this sound-id) (new-sound-id))
  (set! (-> this root dynam gravity y) 0.0)
  (set! (-> this root dynam gravity-length) 0.0)
  (set! (-> this root dynam gravity-max) 0.0)
  (none)
)

(defmethod projectile-method-25 ((this light-eco-fireball))
  (when (-> this part)
    (spawn (-> this part) (-> this root trans)))
  0
  (none)
)

(defmethod projectile-method-26 ((this light-eco-fireball))
  (cond
    ((logtest? (-> *part-group-id-table* 452 flags) (sp-group-flag sp13))
     (set! (-> *launch-matrix* trans quad) (-> this root trans quad))
     (part-tracker-spawn part-tracker-subsampler :to this :group (-> *part-group-id-table* 452)))
    (else
      (set! (-> *launch-matrix* trans quad) (-> this root trans quad))
      (part-tracker-spawn part-tracker :to this :group (-> *part-group-id-table* 452))))
  0
  (none)
)

(defmethod impact-white-fireball ((this light-eco-fireball))
  (projectile-method-29 this)
  (projectile-method-26 this)

  (when *target*
    (let ((dist2 (vector-vector-distance-squared (-> this root trans) (-> *target* root trans)))
          (rad (-> this explode-rad)))
      (when (< dist2 (* rad rad))
        (let ((atk (new 'stack 'attack-info)))
          (set! (-> atk mode) (-> this attack-mode))
          (set! (-> atk id) (-> this attack-id))
          (set! (-> atk mask) (attack-mask mode id))
          (set! (-> atk damage) (-> this damage))
          (logior! (-> atk mask) (attack-mask damage))
          (when (!= (-> this owner-handle) #f)
            (set! (-> atk attacker) (-> this owner-handle))
            (logior! (-> atk mask) (attack-mask attacker)))
          (send-event *target* 'attack (new 'stack-no-clear 'event-message-block) atk)))))

  (cleanup-for-death this)
  0
  (none)
)

(defun spawn-light-eco-fireball ((vec vector))
  (when *target*
    (let ((owner (the-as process-focusable *target*))
          (gp-0 (new 'stack-no-clear 'projectile-init-by-other-params))
          (aim-pos (new 'stack-no-clear 'vector))
          (to-target (new 'stack-no-clear 'vector)))

      (vector-copy! aim-pos (-> *target* root trans))
      (vector-! to-target aim-pos vec)

      (set! (-> gp-0 ent) (if owner (-> owner entity) (the-as entity #f)))
      (set! (-> gp-0 charge) 1.0)
      (set! (-> gp-0 options) (projectile-options))
      (logclear! (-> gp-0 options) (projectile-options po14 po15 po16))

      (set! (-> gp-0 notify-handle) (the-as handle #f))
      (set! (-> gp-0 owner-handle) (if owner (process->handle owner) (the-as handle #f)))
      (set! (-> gp-0 ignore-handle) (if owner (process->handle owner) (the-as handle #f)))
      (set! (-> gp-0 target-handle) (ppointer->handle *target*))
      (vector-copy! (-> gp-0 target-pos) aim-pos)

      (let* ((gi *game-info*)
             (new-id (+ (-> gi attack-id) 1)))
        (set! (-> gi attack-id) new-id)
        (set! (-> gp-0 attack-id) new-id))

      (set! (-> gp-0 timeout) (seconds 3.0))
      (vector-copy! (-> gp-0 pos) vec)
      (vector-normalize-copy! (-> gp-0 vel) to-target 1.0)

      (the-as
        (pointer light-eco-fireball)
        (spawn-projectile light-eco-fireball gp-0 *target* *default-dead-pool*))))
  (none)
)