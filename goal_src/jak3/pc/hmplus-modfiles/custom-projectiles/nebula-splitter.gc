(defpartgroup group-for-statue-explode-small
  :id 1760
  :flags (sp0 sp4)
  :bounds (static-bspherem 0 0 0 20)
  :parts ((sp-item 2279 :flags (sp3) :period (seconds 30) :length (seconds 0.017))
    )
  )

(deftype nebula-bolt (projectile)
  ((gen-i                               int)
   (phase                               int)
   (phase-time                   time-frame)
   (pre-dash                 vector :inline)
   (dash-to                  vector :inline)
  )
)

(defmethod projectile-method-24 ((this nebula-bolt))
  (set! (-> this part)
        (create-launch-control (-> *part-group-id-table* 1830) this))
  0
  (none)
)

(defmethod projectile-method-25 ((this nebula-bolt))
  (if (nonzero? (-> this part))
      (spawn (-> this part) (-> this root trans)))
  0
  (none)
)

(defmethod projectile-method-26 ((this nebula-bolt))
  0
  (none)
)

(defun nebula-bolt-explode ((this nebula-bolt))
  (let ((ep (new 'stack-no-clear 'explosion-init-params)))
  (vector-copy! (-> ep spawn-point) (-> this root trans))
  (quaternion-identity! (-> ep spawn-quat))
  (set! (-> ep radius) (meters 1.0))
  (set! (-> ep scale) 1.0)
  (set! (-> ep group) (-> *part-group-id-table* 246))
  (set! (-> ep collide-with)
        (collide-spec backgnd jak civilian obstacle vehicle-sphere hit-by-others-list player-list pusher))
  (set! (-> ep damage) (-> this damage))
  (set! (-> ep damage-scale) 1.0)
  (set! (-> ep vehicle-damage-factor) 1.0)
  (set! (-> ep vehicle-impulse-factor) 1.0)
  (set! (-> ep ignore-proc) (process->handle #f))
  (explosion-spawn ep (the-as process-drawable *default-pool*)))
  (play-sound-file "snd/splitter-hit.wav" 100)
  (projectile-method-26 this)
  (go-impact! this)
  (none)
)

(defun nebula-bolt-move ((this nebula-bolt))
  (let ((to-jak (new 'stack-no-clear 'vector))
        (fwd (new 'stack-no-clear 'vector))
        (side (new 'stack-no-clear 'vector))
        (dir (new 'stack-no-clear 'vector))
        (delta (new 'stack-no-clear 'vector))
        (to-lock (new 'stack-no-clear 'vector))
        (elapsed 0)
        (u 0.0)
        (ease 0.0)
        (sign 1.0)
        (side-weight 0.0)
        (up-amt 0.0))
    (when (<= (-> *target* fact health) 0.0)
      (projectile-method-26 this)
      (deactivate this)
    )
    (cond
      ((= (-> this phase) 0)
       (when (= (-> this gen-i) 0)
         (vector-! to-jak (target-pos 0) (-> this starting-pos))
         (set! (-> to-jak y) 0.0)
         (vector-copy! fwd to-jak)
         (if (< (vector-length fwd) 0.001)
             (set-vector! fwd 1.0 0.0 0.0 1.0)
             (vector-normalize! fwd 1.0))
         (set! (-> side x) (- (-> fwd z)))
         (set! (-> side y) 0.0)
         (set! (-> side z) (-> fwd x))
         (set! (-> side w) 1.0)
         (if (< (rand-vu-float-range 0.0 1.0) 0.5)
             (set! sign -1.0)
             (set! sign 1.0))
         (set! side-weight (* sign (rand-vu-float-range 0.35 0.85)))
         (set! up-amt (meters (rand-vu-float-range -2.0 2.0)))
         (vector-copy! dir fwd)
         (vector+*! dir dir side side-weight)
         (set! (-> dir y) 0.0)
         (vector-normalize! dir 1.0)
         (vector-copy! (-> this pre-dash) (-> this starting-pos))
         (vector+*! (-> this pre-dash) (-> this pre-dash) dir (meters 20.0))
         (set! (-> (-> this pre-dash) y) (+ (-> (-> this pre-dash) y) up-amt))
         (set! (-> this gen-i) 1)
         (set-time! (-> this phase-time)))

       (set! elapsed (- (current-time) (-> this phase-time)))

       (cond
         ((< elapsed (seconds 1.0))
          (set! u (/ (the float elapsed)
                     (the float (seconds 1.0))))
          (when (> u 1.0)
            (set! u 1.0))
          (set! ease (* u u (- 3.0 (* 2.0 u))))
          (vector-copy! (-> this root trans) (-> this starting-pos))
          (vector-! delta (-> this pre-dash) (-> this starting-pos))
          (vector+*! (-> this root trans) (-> this root trans) delta ease))

         ((< elapsed (seconds 1.3))
          (vector-copy! (-> this root trans) (-> this pre-dash)))

         (else
          (when (= (-> this gen-i) 1)
            (vector-copy! (-> this dash-to) (target-pos 0))
            (set! (-> this gen-i) 2))

          (when (= (-> this gen-i) 2)
            (vector-copy! (-> this dash-to) (target-pos 0))
            (vector-! to-lock (-> this dash-to) (-> this root trans))
            (when (<= (vector-length to-lock) (meters 9.0))
              (set! (-> this gen-i) 3)))

          (set! u (/ (the float (- elapsed (seconds 1.3)))
                     (the float (seconds 0.75))))
          (when (> u 1.0)
            (set! u 1.0))
          (set! ease (* u u))
          (vector-copy! (-> this root trans) (-> this pre-dash))
          (vector-! delta (-> this dash-to) (-> this pre-dash))
          (vector+*! (-> this root trans) (-> this root trans) delta ease)

          (when (>= u 1.0)
            (vector-copy! (-> this root trans) (-> this dash-to))
            (nebula-bolt-explode this))))

       (set-vector! (-> this root transv) 0.0 0.0 0.0 1.0))

      (else
       (set-vector! (-> this root transv) 0.0 0.0 0.0 1.0)))
    0
    (none))
)

(defmethod init-proj-settings! ((this nebula-bolt))
  (set! (-> this attack-mode) 'nebula-bolt)
  (set! (-> this damage) 2.0)
  (set! (-> this max-hits) 1)
  (set! (-> this timeout) (seconds 1200.0))
  (set! (-> this phase) 0)
  (set! (-> this gen-i) 0)
  (set-time! (-> this phase-time))
  (vector-copy! (-> this starting-pos) (-> this root trans))
  (set! (-> this stop-speed) 0.0)
  (logclear! (-> this options) (projectile-options po4))
  (set-vector! (-> this root transv) 0.0 0.0 0.0 1.0)
  (set! (-> this move) nebula-bolt-move)
  (none)
)

(defun spawn-nebula-bolt ((pos vector))
  (let ((gp-0 (new 'stack-no-clear 'projectile-init-by-other-params)))
    (set! (-> gp-0 ent) (-> *target* entity))
    (set! (-> gp-0 charge) 1.0)
    (set! (-> gp-0 options) (projectile-options))
    (logclear! (-> gp-0 options) (projectile-options po14 po15 po16))
    (set! (-> gp-0 notify-handle) (the-as handle #f))
    (set! (-> gp-0 owner-handle) (the-as handle #f))
    (set! (-> gp-0 target-handle) (the-as handle #f))
    (set! (-> gp-0 target-pos quad) (the-as uint128 0))
    (set! (-> gp-0 ignore-handle) (the-as handle #f))
    (let* ((gi *game-info*)
           (new-id (+ (-> gi attack-id) 1)))
      (set! (-> gi attack-id) new-id)
      (set! (-> gp-0 attack-id) new-id))
    (set! (-> gp-0 timeout) (seconds 1200.0))
    (vector-copy! (-> gp-0 pos) pos)
    (set-vector! (-> gp-0 vel) 0.0 0.0 0.0 1.0)
    (the-as (pointer nebula-bolt)
      (spawn-projectile nebula-bolt gp-0 *target* *default-dead-pool*))
  )
  (none)
)


(deftype nebula-splitter (process)
  ((gen-i                        int)
   (spawn-count                  int)
   (spawn-max                    int)
   (spawn-pos         vector :inline)
  )
  (:state-methods
    idle
    die
  )
)

(defbehavior nebula-splitter-init-by-other nebula-splitter ((vec vector) (amt int))
  (set! (-> self gen-i) 4)
  (set! (-> self spawn-count) 0)
  (set! (-> self spawn-max) amt)
  (vector-copy! (-> self spawn-pos) vec)
  (go-virtual idle)
  (none)
)

(defun spawn-nebula-splitter ((vec vector) (amt int))
  (play-sound-file "snd/splitter-spawn.wav" 100)
  (play-sound-file "snd/splitter-bolt.wav" 100)
  (set! *nebula-splitter*
    (process-spawn nebula-splitter vec amt :name "nebula-splitter")
  )
  (none)
)

(defstate idle (nebula-splitter)
  :virtual #t
  :code (behavior ()
  (loop
    (when (>= (-> self gen-i) 2)
      (cond
        ((< (-> self spawn-count) (-> self spawn-max))
          (spawn-nebula-bolt (-> self spawn-pos))
          (+! (-> self spawn-count) 1)
          (set! (-> self gen-i) 0)
        )
        (else
          (go-virtual die)
        )
      )
    )
    (when (< (-> self gen-i) 2)
      (+! (-> self gen-i) 1)
    )
    (when (<= (-> *target* fact health) 0.0)
      (go-virtual die)
    )
    (suspend)
  )
  )
)

(defstate die (nebula-splitter)
  :virtual #t
  :code (behavior ()
    (set! *nebula-splitter* #f)
    (kill-by-name (-> self name) *active-pool*)
    (process-deactivate)
  )
)