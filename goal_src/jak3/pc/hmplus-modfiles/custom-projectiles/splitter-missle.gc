(deftype splitter-missle (projectile)
  ((phase        int32)
   (phase-time   time-frame)
   (spawn-pos    vector :inline)
   (commit-aim   vector :inline)
   (hover-offset vector :inline)
   (dive-start   vector :inline)
   (dive-vel     vector :inline)
   )
  )

(defun splitter-missle-explode ((this splitter-missle))
  (set! (-> *launch-matrix* trans quad) (-> (-> this root) trans quad))
  (cond
    ((logtest? (-> (-> *part-group-id-table* 1742) flags) (sp-group-flag sp13))
      (part-tracker-spawn part-tracker-subsampler
                          :to *active-pool*
                          :group (-> *part-group-id-table* 1742)))
    (else
      (part-tracker-spawn part-tracker
                          :to *active-pool*
                          :group (-> *part-group-id-table* 1742))))
  (none)
)

(defmethod projectile-method-26 ((this splitter-missle))
  (splitter-missle-explode this)
  0
  (none)
  )

(defmethod deactivate ((this splitter-missle))
  (when (nonzero? (-> this part))
    (kill-particles (-> this part))
    )
  (call-parent-method this)
  (none)
  )

(defmethod play-impact-sound ((this splitter-missle) (arg0 projectile-options))
  (none)
  )

(defmethod setup-collision! ((this splitter-missle))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction)
          (the-as (function control-info collide-query vector vector collide-status)
                  cshape-reaction-just-move)
          )
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object)
                  nothing)
          )
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 0) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s4-0 prim-core collide-as) (collide-spec projectile))
      (set! (-> s4-0 prim-core collide-with)
            (collide-spec backgnd jak obstacle vehicle-sphere player-list pusher))
      (set! (-> s4-0 prim-core action) (collide-action solid))
      (set-vector! (-> s4-0 local-sphere) 0.0 0.0 0.0 2048.0)
      (set! (-> s5-0 root-prim) s4-0)
      )

    (set! (-> s5-0 nav-radius) (-> s5-0 root-prim local-sphere w))
    (set! (-> s5-0 max-iteration-count) (the-as uint 1))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )

  (set! (-> this root pat-ignore-mask)
        (new 'static 'pat-surface
             :noentity #x1
             :nojak #x0
             :probe #x1
             :noproj #x1
             :noendlessfall #x1
             :board #x1)
        )
  (none)
  )

(defun splitter-missle-move ((arg0 splitter-missle))
  (let* ((root (-> arg0 root))
         (to-jak (new 'stack-no-clear 'vector))
         (desired-point (new 'stack-no-clear 'vector))
         (delta (new 'stack-no-clear 'vector))
         (horiz-len 0.0))
    (cond
      ((= (-> arg0 phase) 0)
       (let* ((elapsed (- (current-time) (-> arg0 phase-time)))
              (t (/ (the float elapsed) (the float (seconds 1.0))))
              (rise 0.0))
         (when (< t 0.0)
           (set! t 0.0))
         (when (> t 1.0)
           (set! t 1.0))
         (set! rise (* (meters 3) t t t))
         (vector-! to-jak (-> *target* root trans) (-> arg0 spawn-pos))
         (set! (-> to-jak y) 0.0)
         (set! horiz-len (vector-length to-jak))
         (if (> horiz-len 1.0)
             (vector-normalize! to-jak (meters 14))
             (set-vector! to-jak 0.0 0.0 (meters 14) 1.0))
         (vector+! desired-point (-> arg0 spawn-pos) to-jak)
         (vector+! desired-point desired-point (-> arg0 hover-offset))
         (set! (-> desired-point y) (+ (-> arg0 spawn-pos y) rise))
         (vector-! delta desired-point (-> arg0 spawn-pos))
         (vector-float*! delta delta t)
         (vector+! (-> root trans) (-> arg0 spawn-pos) delta)
         (set-vector! (-> root transv) 0.0 0.0 0.0 1.0)
         (when (time-elapsed? (-> arg0 phase-time) (seconds 1.0))
           (set! (-> arg0 phase) 1)
           (set-time! (-> arg0 phase-time))
           (set-vector! (-> root transv) 0.0 0.0 0.0 1.0))))
      ((= (-> arg0 phase) 1)
       (set-vector! (-> root transv) 0.0 0.0 0.0 1.0)
       (when (time-elapsed? (-> arg0 phase-time) (seconds 2.0))
         (vector-copy! (-> arg0 commit-aim) (-> *target* root trans))
         (vector-copy! (-> arg0 dive-start) (-> root trans))
         (vector-! delta (-> arg0 commit-aim) (-> arg0 dive-start))
         (vector-float*! (-> arg0 dive-vel) delta
                         (/ 1.0 (* 0.0033333334 (the float (seconds 0.8)))))
         (vector-copy! (-> root transv) (-> arg0 dive-vel))
         (set! (-> arg0 phase) 2)
         (set-time! (-> arg0 phase-time))
         (logclear! (-> root status) (collide-status touch-surface touch-actor))))
      ((= (-> arg0 phase) 2)
       (vector-copy! (-> root transv) (-> arg0 dive-vel))
       (logclear! (-> root status) (collide-status touch-surface touch-actor))
       (projectile-move-fill-line-sphere arg0)
       (when (and (time-elapsed? (-> arg0 phase-time) (seconds 0.05))
                  (logtest? (-> root status) (collide-status touch-surface touch-actor)))
         (go (method-of-object arg0 impact)))
       (when (time-elapsed? (-> arg0 phase-time) (seconds 5.0))
         (go (method-of-object arg0 impact)))))
  0
  )
  (none)
)

(defmethod init-proj-settings! ((this splitter-missle))
  (set! (-> this attack-mode) 'eco-yellow)
  (set! (-> this damage) 8.0)
  (set! (-> this max-speed) 122880.0)
  (set! (-> this phase) 0)
  (set-time! (-> this phase-time))
  (vector-copy! (-> this spawn-pos) (-> this root trans))
  (vector-copy! (-> this commit-aim) (-> this root trans))
  (vector-copy! (-> this dive-start) (-> this root trans))
  (set-vector! (-> this dive-vel) 0.0 0.0 0.0 1.0)
  (set-vector! (-> this hover-offset) 0.0 0.0 0.0 1.0)
  (if (< (rand-vu-float-range 0.0 1.0) 0.5)
      (set! (-> this hover-offset x)
            (rand-vu-float-range (meters -10) (meters 10)))
      (set! (-> this hover-offset z)
            (rand-vu-float-range (meters -10) (meters 10))))
  (set! (-> this timeout) (seconds 10.2))
  (set! (-> this part) (create-launch-control (-> *part-group-id-table* 1730) this))
  (set-gravity-length (-> this root dynam) 0.0)
  (set! (-> this move) splitter-missle-move)
  (none)
)

(defun spawn-splitter-missle ((vec vector))
  (let ((gp-0 (new 'stack-no-clear 'projectile-init-by-other-params)))
    (set! (-> gp-0 ent) (the-as entity #f))
    (set! (-> gp-0 charge) 1.0)
    (set! (-> gp-0 options) (projectile-options))
    (logclear! (-> gp-0 options) (projectile-options po14 po15 po16))
    (set! (-> gp-0 pos quad) (-> vec quad))
    (set-vector! (-> gp-0 vel) 0.0 0.0 0.0 1.0)
    (set! (-> gp-0 notify-handle) (the-as handle #f))
    (set! (-> gp-0 owner-handle) (the-as handle #f))
    (set! (-> gp-0 target-handle) (ppointer->handle *target*))
    (set! (-> gp-0 target-pos quad) (the-as uint128 0))
    (set! (-> gp-0 ignore-handle) (the-as handle #f))
    (let* ((v1-0 *game-info*)
           (a0-0 (+ (-> v1-0 attack-id) 1)))
      (set! (-> v1-0 attack-id) a0-0)
      (set! (-> gp-0 attack-id) a0-0))
    (set! (-> gp-0 timeout) (seconds 10.2))
    (spawn-projectile splitter-missle gp-0 *target* *default-dead-pool*))
  (none)
  )